+#ifdef CATA_HARNESS
+// Harness instrumentation: how many sources a build gathered and how many it applied, and what the fire's own square reads at the start and the end of the build. This
+// exists because a dump showed a square with a 160-lumen source and an ambient brightness: without counters there is no telling a source that was never gathered from one
+// that was gathered and then overwritten.
+int harness_sources_added = 0;
+int harness_sources_applied = 0;
+#endif
+
 void map::generate_lightmap( const int zlev )
 {
     level_cache &map_cache = get_cache( zlev );
     auto &lm = map_cache.lm;
+#ifdef CATA_HARNESS
+    const bool trace_lightmap = getenv( "CDDA_LM_TRACE" ) != nullptr;
+    if( trace_lightmap ) {
+        std::fprintf( stderr, "LM start z=%d added=%d applied=%d\n", zlev, harness_sources_added,
+                      harness_sources_applied );
+    }
+#endif
     auto &sm = map_cache.sm;
     auto &outside_cache = map_cache.outside_cache;
     auto &prev_floor_cache = get_cache( clamp( zlev + 1, -OVERMAP_DEPTH, OVERMAP_DEPTH ) ).floor_cache;
@@ -661,10 +676,19 @@
     for( const std::pair<tripoint_bub_ms, float> &elem : lm_override ) {
         lm[elem.first.x()][elem.first.y()].fill( elem.second );
     }
+#ifdef CATA_HARNESS
+    if( trace_lightmap ) {
+        std::fprintf( stderr, "LM end z=%d added=%d applied=%d overrides=%zu\n", zlev,
+                      harness_sources_added, harness_sources_applied, lm_override.size() );
+    }
+#endif
 }
 
 void map::add_light_source( const tripoint_bub_ms &p, float luminance )
 {
+#ifdef CATA_HARNESS
+    harness_sources_added++;
+#endif
     auto &light_source_buffer = get_cache( p.z() ).light_source_buffer;
     light_source_buffer[p.x()][p.y()] = std::max( luminance, light_source_buffer[p.x()][p.y()] );
 }
@@ -1216,6 +1240,9 @@
 
 void map::apply_light_source( const tripoint_bub_ms &p, float luminance )
 {
+#ifdef CATA_HARNESS
+    harness_sources_applied++;
+#endif
     level_cache &cache = get_cache( p.z() );
     cata::mdarray<four_quadrants, point_bub_ms> &lm = cache.lm;
     cata::mdarray<float, point_bub_ms> &sm = cache.sm;
