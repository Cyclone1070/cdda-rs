+void dump_vehicle_rolling( const std::string &path )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+
+    map &here = get_map();
+    const tripoint_bub_ms origin = get_player_character().pos_bub( here );
+    for( int dx = -16; dx <= 16; dx++ ) {
+        for( int dy = -16; dy <= 16; dy++ ) {
+            const tripoint_bub_ms square = origin + tripoint_rel_ms( dx, dy, 0 );
+            here.ter_set( square, ter_id( "t_floor" ) );
+            here.furn_set( square, furn_str_id::NULL_ID() );
+        }
+    }
+
+    // Version 2 carries the parts' base item weights, so a reader can install the reference's own registry and check the coefficient rather than a guess at it.
+    std::fprintf( out, "{\"harness\":\"vehicle_rolling\",\"version\":3,\"origin\":[%d,%d,%d],"
+                  "\"cases\":[", origin.x(), origin.y(), origin.z() );
+    bool first_case = true;
+
+    // One vehicle's rolling resistance, and the wheels that make it: `vehicle::coeff_rolling_drag` (`vehicle.cpp:4655-4686`) walks `wheelcache`, which is
+    // filled from the unbroken parts carrying `WHEEL` (`vehicle.cpp:6738-6740`), and answers 50 when there are none.
+    const auto dump_case = [&]( const char *name, const vproto_id &type, bool ruin_the_wheels ) {
+        vehicle *veh = here.add_vehicle( type, origin, 0_degrees, 0, 0, false, true );
+        if( veh == nullptr ) {
+            std::fprintf( stderr, "harness: %s did not place\n", type.str().c_str() );
+            return;
+        }
+        if( ruin_the_wheels ) {
+            for( const int wheel : veh->wheelcache ) {
+                veh->set_hp( veh->part( wheel ), 0, false );
+            }
+            // A ruined wheel is still a `WHEEL` part; only `refresh` decides it is no longer in the cache, so the cache has to be rebuilt.
+            veh->refresh();
+        }
+        std::fprintf( out, "%s{\"name\":\"%s\",\"vehicle\":\"%s\",\"wheel_count\":%zu",
+                      first_case ? "" : ",", name, type.str().c_str(), veh->wheelcache.size() );
+        first_case = false;
+        std::fprintf( out, ",\"wheels\":[" );
+        bool first_wheel = true;
+        for( const int wheel : veh->wheelcache ) {
+            std::fprintf( out, "%s{\"part\":\"%s\",\"rolling_resistance\":%.9g}",
+                          first_wheel ? "" : ",", veh->part( wheel ).info().id.str().c_str(),
+                          static_cast<double>( veh->part( wheel ).info().wheel_info->rolling_resistance ) );
+            first_wheel = false;
+        }
+        std::fprintf( out, "],\"parts\":[" );
+        bool first_part = true;
+        for( int p = 0; p < veh->part_count(); p++ ) {
+            const vehicle_part &vp = veh->part( p );
+            if( vp.removed ) {
+                continue;
+            }
+            std::fprintf( out,
+                          "%s{\"index\":%d,\"part\":\"%s\",\"item\":\"%s\",\"base_mass_g\":%lld}",
+                          first_part ? "" : ",", p, vp.info().id.str().c_str(),
+                          vp.info().base_item.str().c_str(),
+                          static_cast<long long>( units::to_gram( vp.get_base().weight() ) ) );
+            first_part = false;
+        }
+        // Version 3: the two numbers this coefficient feeds, so a port can check the whole chain - wheels, engines and the cubic - on the vehicles whose mass it
+        // reproduces exactly.
+        std::fprintf( out, "],\"total_mass_g\":%lld,\"coeff_rolling_drag\":%.12g,"
+                      "\"power_w\":%d,\"max_ground_velocity\":%d}",
+                      static_cast<long long>( units::to_gram( veh->total_mass( here ) ) ),
+                      veh->coeff_rolling_drag( here ), units::to_watt( veh->total_power( here, false ) ),
+                      static_cast<int>( veh->max_ground_velocity( here, false ) ) );
+        here.destroy_vehicle( veh );
+    };
+
+    dump_case( "bicycle", vproto_id( "bicycle" ), false );
+    dump_case( "quad_bike", vproto_id( "quad_bike" ), false );
+    dump_case( "a_bicycle_with_no_usable_wheel", vproto_id( "bicycle" ), true );
+
+    std::fprintf( out, "]}\n" );
+    std::fclose( out );
+}
