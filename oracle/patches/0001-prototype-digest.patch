+/// Whether a `transform` action may be used at all, in three states of the item.
+///
+/// Reference: `iuse_transform::can_use` (`src/iuse_actor.cpp:428-475`), whose conditions are asked in a fixed order: worn, wielded, empty, the worn-mutation conflict,
+/// then the charges the item must hold, then the qualities the surroundings must offer. The first one that fails is the answer, and **its message is the answer's
+/// text** — `"You need to wield the %1$s before activating it."` and so on.
+///
+/// Three states per type, because the order is what makes the third interesting: a bare item refuses on being worn, a wielded one gets past both position rules and
+/// lands on the charges, and a wielded one with no charges is the case 69 transforms in the content can actually reach.
+void dump_transform_can_use( const std::string &path )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+    std::fprintf( out, "{\"harness\":\"transform-can-use\",\"version\":1,\n\"types\":[\n" );
+    bool first = true;
+    int count = 0;
+    avatar &u = get_avatar();
+    for( const itype *type : item_controller->all() ) {
+        if( type == nullptr ) {
+            continue;
+        }
+        for( const std::pair<const std::string, use_function> &method : type->use_methods ) {
+            const iuse_transform *transform =
+                dynamic_cast<const iuse_transform *>( method.second.get_actor_ptr() );
+            if( transform == nullptr ) {
+                continue;
+            }
+            ++count;
+            std::fprintf( out, "%s{\"id\":\"%s\",\"action\":\"%s\",\"states\":[",
+                          first ? "" : ",\n", harness_escape( type->get_id().str() ).c_str(),
+                          harness_escape( method.first ).c_str() );
+            bool first_state = true;
+            for( const char *state : { "bare", "wielded", "wielded_empty" } ) {
+                item it( type->get_id() );
+                if( std::strcmp( state, "bare" ) != 0 ) {
+                    u.set_wielded_item( it );
+                }
+                if( std::strcmp( state, "wielded_empty" ) == 0 ) {
+                    // The charges are what a worn-out tool has: none. `ammo_remaining` is what `can_use` reads.
+                    if( u.get_wielded_item() ) {
+                        u.get_wielded_item()->charges = 0;
+                        u.get_wielded_item()->ammo_set( itype_id::NULL_ID(), 0 );
+                    }
+                }
+                const ret_val<void> verdict =
+                    transform->can_use( u, u.get_wielded_item() ? *u.get_wielded_item() : it,
+                                        &get_map(), u.pos_bub() );
+                const int charges = u.get_wielded_item() ? u.get_wielded_item()->ammo_remaining() : 0;
+                std::fprintf( out, "%s{\"state\":\"%s\",\"ok\":%s,\"message\":\"%s\",\"charges\":%d}",
+                              first_state ? "" : ",", state, verdict.success() ? "true" : "false",
+                              harness_escape( verdict.str() ).c_str(), charges );
+                first_state = false;
+            }
+            std::fprintf( out, "]}" );
+            u.set_wielded_item( item() );
+            first = false;
+        }
+    }
+    std::fprintf( out, "\n],\"count\":%d}\n", count );
+    std::fclose( out );
+}
