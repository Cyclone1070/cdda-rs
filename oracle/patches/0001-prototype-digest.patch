+/// How hard everything is to break.
+///
+/// Reference: `map_common_bash_info` with its two subclasses (`src/mapdata.h:40-84`) and their loaders (`src/mapdata.cpp:376-430`). The block is one JSON object on a terrain
+/// or furniture, and half of it is **absence**: `-1` is the reference's "not given", a `str_min` of `-1` means the tile cannot be bashed at all, and `ter_set_bashed_from_above`
+/// defaults to `ter_set` rather than to nothing. A dump that printed only the fields that were present would leave the port free to invent the defaults.
+/// A group id only when it is a **name**, and a flag when it is not.
+///
+/// Reference: `map_common_bash_info::load` (`src/mapdata.cpp:407-412`) calls `item_group::load_item_group`, which accepts either a name or an inline array; an inline array
+/// becomes an anonymous group whose `str()` is not a name and not even printable. A dump that printed it anyway would hand the port a string it can never load.
+static std::string bash_group_name( const item_group_id &group )
+{
+    const std::string name = group.str();
+    const bool printable = !name.empty() && std::all_of( name.begin(), name.end(), []( char c ) {
+        return ( c >= 'a' && c <= 'z' ) || ( c >= 'A' && c <= 'Z' ) || ( c >= '0' && c <= '9' )
+               || c == '_' || c == '.' || c == '-';
+    } );
+    return printable ? name : std::string();
+}
