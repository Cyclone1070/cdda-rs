+    std::fprintf( out, "{\"harness\":\"damage\",\"version\":1,\n\"types\":[\n" );
+    bool first = true;
+    for( const itype *type : item_controller->all() ) {
+        if( type == nullptr ) {
+            continue;
+        }
+        const int max_damage = type->damage_max();
+        const int probe[] = { 0, 1, max_damage / 4, max_damage / 2, max_damage - 1, max_damage };
+        std::fprintf( out,
+                      "%s{\"id\":\"%s\",\"category\":\"%s\",\"count_by_charges\":%s,"
+                      "\"max_damage\":%d,\"degrade_increments\":%d,\"levels\":[",
+                      first ? "" : ",\n", harness_escape( type->get_id().str() ).c_str(),
+                      harness_escape( type->category_force.str() ).c_str(),
+                      type->count_by_charges() ? "true" : "false", max_damage,
+                      type->degrade_increments() );
+        for( int index = 0; index < 6; ++index ) {
+            std::fprintf( out, "%s%d", index == 0 ? "" : ",", type->damage_level( probe[index] ) );
+        }
+        std::fprintf( out, "],\"probe\":[%d,%d,%d,%d,%d,%d]}", probe[0], probe[1], probe[2], probe[3],
+                      probe[4], probe[5] );
