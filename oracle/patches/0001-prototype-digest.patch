+void dump_martial_arts( const std::string &path )
+{
+    std::ofstream out( path );
+    if( !out.is_open() ) {
+        return;
+    }
+    // Every style the data defines, **through the reference's own list** (`all_martialart_types`, `martialarts.cpp:516`), because a style that exists is one it would show a player.
+    const std::vector<matype_id> &ids = all_martialart_types();
+    out << "{\"count\":" << ids.size() << ",\"styles\":[";
+    bool first = true;
+    for( const matype_id &style_id : ids ) {
+        const martialart &style = style_id.obj();
+        if( !first ) {
+            out << ",";
+        }
+        first = false;
+        // The style itself: what it is called, what it blocks with, whether a book can teach it, and the four flags that say what it needs in hand.
+        out << "{\"id\":\"" << style.id.str() << "\",\"name\":\"" << harness_escape( style.name.translated() ) << "\""
+            << ",\"priority\":" << style.priority
+            << ",\"teachable\":" << ( style.teachable ? "true" : "false" )
+            << ",\"learn_difficulty\":" << style.learn_difficulty
+            << ",\"arm_block\":" << style.arm_block
+            << ",\"leg_block\":" << style.leg_block
+            << ",\"strictly_unarmed\":" << ( style.strictly_unarmed ? "true" : "false" )
+            << ",\"strictly_melee\":" << ( style.strictly_melee ? "true" : "false" )
+            << ",\"allow_all_weapons\":" << ( style.allow_all_weapons ? "true" : "false" )
+            << ",\"force_unarmed\":" << ( style.force_unarmed ? "true" : "false" )
+            << ",\"weapon_categories\":[";
+        bool first_category = true;
+        for( const weapon_category_id &category : style.weapon_category ) {
+            if( !first_category ) {
+                out << ",";
+            }
+            first_category = false;
+            out << "\"" << category.str() << "\"";
+        }
+        // **The static buffs by id, and the requirements each one states**: a buff is a *requirement* first and a set of bonuses second, and the requirement is the half that decides whether
+        // the buff is in play at all (`ma_buff::is_valid_character`, `martialarts.cpp:713-760`).
+        out << "],\"static_buffs\":[";
+        bool first_buff = true;
+        for( const mabuff_id &buff_id : style.static_buffs ) {
+            const ma_buff &buff = buff_id.obj();
+            if( !first_buff ) {
+                out << ",";
+            }
+            first_buff = false;
+            out << "{\"id\":\"" << buff.id.str() << "\""
+                << ",\"unarmed_allowed\":" << ( buff.reqs.unarmed_allowed ? "true" : "false" )
+                << ",\"melee_allowed\":" << ( buff.reqs.melee_allowed ? "true" : "false" )
+                << ",\"strictly_unarmed\":" << ( buff.reqs.strictly_unarmed ? "true" : "false" )
+                << ",\"wall_adjacent\":" << ( buff.reqs.wall_adjacent ? "true" : "false" )
+                << ",\"weapon_categories\":[";
+            bool first_buff_category = true;
+            for( const weapon_category_id &category : buff.reqs.weapon_categories_allowed ) {
+                if( !first_buff_category ) {
+                    out << ",";
+                }
+                first_buff_category = false;
+                out << "\"" << category.str() << "\"";
+            }
+            out << "],\"min_skill\":[";
+            bool first_skill = true;
+            for( const std::pair<skill_id, int> &need : buff.reqs.min_skill ) {
+                if( !first_skill ) {
+                    out << ",";
+                }
+                first_skill = false;
+                out << "{\"skill\":\"" << need.first.str() << "\",\"level\":" << need.second << "}";
+            }
+            out << "],\"min_damage\":[";
+            bool first_damage = true;
+            for( const std::pair<damage_type_id, int> &need : buff.reqs.min_damage ) {
+                if( !first_damage ) {
+                    out << ",";
+                }
+                first_damage = false;
+                out << "{\"type\":\"" << need.first.str() << "\",\"amount\":" << need.second << "}";
+            }
+            out << "],\"flags\":[";
+            bool first_flag = true;
+            for( const flag_id &flag : buff.reqs.req_flags ) {
+                if( !first_flag ) {
+                    out << ",";
+                }
+                first_flag = false;
+                out << "\"" << flag.str() << "\"";
+            }
+            out << "]}";
+        }
+        // **The techniques the style offers** (`martialart::techniques`, `martialarts.h:409`): a style is a set of buffs *and* a set of moves, and every move states the same kind of requirement
+        // a buff does. The reference reaches a technique by id, so the dump walks the style's own set rather than a registry the reference keeps private.
+        out << "],\"techniques\":[";
+        bool first_technique = true;
+        for( const matec_id &technique_id : style.techniques ) {
+            const ma_technique &technique = technique_id.obj();
+            if( !first_technique ) {
+                out << ",";
+            }
+            first_technique = false;
+            out << "{\"id\":\"" << technique.id.str() << "\",\"name\":\"" << harness_escape( technique.name.translated() ) << "\""
+                << ",\"weighting\":" << technique.weighting
+                << ",\"defensive\":" << ( technique.defensive ? "true" : "false" )
+                << ",\"crit_tec\":" << ( technique.crit_tec ? "true" : "false" )
+                // **The flags that decide whether a move is offered at all** (`evaluate_technique`, `melee.cpp:1446-1550`): a dummy is never offered, a counter only answers a counter, a
+                // critical-only move needs a critical, a reach move needs a reach attack, and a disarming move does nothing against a body with no weapon.
+                << ",\"dummy\":" << ( technique.dummy ? "true" : "false" )
+                << ",\"crit_ok\":" << ( technique.crit_ok ? "true" : "false" )
+                << ",\"reach_tec\":" << ( technique.reach_tec ? "true" : "false" )
+                << ",\"reach_ok\":" << ( technique.reach_ok ? "true" : "false" )
+                << ",\"dodge_counter\":" << ( technique.dodge_counter ? "true" : "false" )
+                << ",\"block_counter\":" << ( technique.block_counter ? "true" : "false" )
+                << ",\"needs_ammo\":" << ( technique.needs_ammo ? "true" : "false" )
+                << ",\"disarms\":" << ( technique.disarms ? "true" : "false" )
+                << ",\"take_weapon\":" << ( technique.take_weapon ? "true" : "false" )
+                // **What the move does to the body it lands on** (`melee.cpp:1759-1785`): each effect it may add, with the chance out of a hundred, whether it needs damage to land, and how long it
+                // lasts - plus the two durations the reference keeps as bare numbers rather than as effects, `down_dur` and `stun_dur`.
+                // **What the move aims at** (`attack_vector`, `martialarts.h:70-97`): the limbs it may strike, whether it needs a weapon in hand, how much encumbrance a limb may carry, and the
+                // flags a limb must and must not have. `choose_attack_vector` (`martialarts.cpp:1475-1560`) is the rule that reads them.
+                << ",\"attack_vectors\":[";
+            bool first_vector = true;
+            for( const attack_vector_id &vector_id : technique.attack_vectors ) {
+                const attack_vector &vector = vector_id.obj();
+                if( !first_vector ) {
+                    out << ",";
+                }
+                first_vector = false;
+                out << "{\"id\":\"" << vector.id.str() << "\",\"weapon\":" << ( vector.weapon ? "true" : "false" )
+                    << ",\"strict_limb_definition\":" << ( vector.strict_limb_definition ? "true" : "false" )
+                    << ",\"encumbrance_limit\":" << vector.encumbrance_limit
+                    << ",\"bp_hp_limit\":" << vector.bp_hp_limit
+                    << ",\"limbs\":[";
+                bool first_limb = true;
+                for( const bodypart_str_id &limb : vector.limbs ) {
+                    if( !first_limb ) {
+                        out << ",";
+                    }
+                    first_limb = false;
+                    out << "\"" << limb.str() << "\"";
+                }
+                out << "],\"limb_req\":[";
+                bool first_req = true;
+                for( const std::pair<body_part_type::type, int> &requirement : vector.limb_req ) {
+                    if( !first_req ) {
+                        out << ",";
+                    }
+                    first_req = false;
+                    out << "{\"type\":\"" << harness_limb_kind( requirement.first ) << "\",\"count\":" << requirement.second << "}";
+                }
+                out << "]}";
+            }
+            out << "]"
+                << ",\"down_dur\":" << technique.down_dur
+                << ",\"stun_dur\":" << technique.stun_dur
+                << ",\"effects\":[";
+            bool first_effect = true;
+            for( const tech_effect_data &effect : technique.tech_effects ) {
+                if( !first_effect ) {
+                    out << ",";
+                }
+                first_effect = false;
+                out << "{\"id\":\"" << effect.id.str() << "\",\"duration\":" << effect.duration
+                    << ",\"permanent\":" << ( effect.permanent ? "true" : "false" )
+                    << ",\"on_damage\":" << ( effect.on_damage ? "true" : "false" )
+                    << ",\"chance\":" << effect.chance << "}";
+            }
+            out << "]"
+                << ",\"unarmed_allowed\":" << ( technique.reqs.unarmed_allowed ? "true" : "false" )
+                << ",\"melee_allowed\":" << ( technique.reqs.melee_allowed ? "true" : "false" )
+                << ",\"strictly_unarmed\":" << ( technique.reqs.strictly_unarmed ? "true" : "false" )
+                << ",\"wall_adjacent\":" << ( technique.reqs.wall_adjacent ? "true" : "false" )
+                << ",\"weapon_categories\":[";
+            bool first_technique_category = true;
+            for( const weapon_category_id &category : technique.reqs.weapon_categories_allowed ) {
+                if( !first_technique_category ) {
+                    out << ",";
+                }
+                first_technique_category = false;
+                out << "\"" << category.str() << "\"";
+            }
+            out << "]";
+            out << "}";
+        }
+        out << "]}";
+    }
+    out << "]}";
+}
