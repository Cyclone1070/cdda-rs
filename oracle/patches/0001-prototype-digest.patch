+void dump_bash_info( const std::string &path )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+    std::fprintf( out, "{\"harness\":\"bash\",\"version\":1,\"terrain\":[\n" );
+    bool first = true;
+    for( const ter_t *ter : harness_all_terrains() ) {
+        if( !ter->bash ) {
+            continue;
+        }
+        const map_ter_bash_info &bash = *ter->bash;
+        std::fprintf( out,
+                      "%s{\"id\":\"%s\",\"str_min\":%d,\"str_max\":%d,\"str_min_blocked\":%d,"
+                      "\"str_max_blocked\":%d,\"str_min_supported\":%d,\"str_max_supported\":%d,"
+                      "\"destroy_only\":%s,\"bash_below\":%s,\"sound_vol\":%d,\"sound_fail_vol\":%d,"
+                      "\"items\":\"%s\",\"ter_set\":\"%s\",\"ter_set_bashed_from_above\":\"%s\"}",
+                      first ? "" : ",\n", harness::harness_escape( ter->id.str() ).c_str(),
+                      bash.str_min, bash.str_max, bash.str_min_blocked, bash.str_max_blocked,
+                      bash.str_min_supported, bash.str_max_supported,
+                      bash.destroy_only ? "true" : "false", bash.bash_below ? "true" : "false",
+                      bash.sound_vol, bash.sound_fail_vol,
+                      harness::harness_escape( bash_group_name( bash.drop_group ) ).c_str(),
+                      harness::harness_escape( bash.ter_set.str() ).c_str(),
+                      harness::harness_escape( bash.ter_set_bashed_from_above.str() ).c_str() );
+        first = false;
+    }
+    std::fprintf( out, "\n],\"furniture\":[\n" );
+    first = true;
+    for( const furn_t *furn : harness_all_furniture() ) {
+        if( !furn->bash ) {
+            continue;
+        }
+        const map_furn_bash_info &bash = *furn->bash;
+        std::fprintf( out,
+                      "%s{\"id\":\"%s\",\"str_min\":%d,\"str_max\":%d,\"str_min_blocked\":%d,"
+                      "\"str_max_blocked\":%d,\"str_min_supported\":%d,\"str_max_supported\":%d,"
+                      "\"destroy_only\":%s,\"bash_below\":%s,\"sound_vol\":%d,\"sound_fail_vol\":%d,"
+                      "\"items\":\"%s\",\"furn_set\":\"%s\"}",
+                      first ? "" : ",\n", harness::harness_escape( furn->id.str() ).c_str(),
+                      bash.str_min, bash.str_max, bash.str_min_blocked, bash.str_max_blocked,
+                      bash.str_min_supported, bash.str_max_supported,
+                      bash.destroy_only ? "true" : "false", bash.bash_below ? "true" : "false",
+                      bash.sound_vol, bash.sound_fail_vol,
+                      harness::harness_escape( bash_group_name( bash.drop_group ) ).c_str(),
+                      harness::harness_escape( bash.furn_set.str() ).c_str() );
+        first = false;
+    }
+    std::fprintf( out, "\n]}\n" );
+    std::fclose( out );
+}
