+/// The squares a mover is offered when it wants to get closer to a target, in the order it is offered them.
+///
+/// `squares_closer_to` (`src/line.cpp:700-733`) is what monster movement walks when it picks a step (`src/monmove.cpp:1128`), and its **order** is part of the answer: a
+/// creature takes the first square it can enter, so a different order is a different move. The four shapes are an x-dominant run, a y-dominant one, a pure diagonal with
+/// no climbing, and a climb, plus the degenerate cases where one axis does not change at all.
+void dump_squares_closer( const std::string &path )
+{
+    struct case_t {
+        tripoint from;
+        tripoint to;
+        const char *shape;
+    };
+    const std::vector<case_t> cases = {
+        { tripoint( 5, 5, 0 ), tripoint( 9, 7, 0 ), "x-dominant" },
+        { tripoint( 5, 5, 0 ), tripoint( 7, 9, 0 ), "y-dominant" },
+        { tripoint( 5, 5, 0 ), tripoint( 9, 9, 0 ), "diagonal" },
+        { tripoint( 5, 5, 0 ), tripoint( 9, 9, 3 ), "diagonal-climbing" },
+        { tripoint( 5, 5, 0 ), tripoint( 9, 7, -2 ), "x-dominant-climbing" },
+        { tripoint( 5, 5, 0 ), tripoint( 7, 9, 1 ), "y-dominant-climbing" },
+        { tripoint( 5, 5, 0 ), tripoint( 9, 5, 0 ), "straight-x" },
+        { tripoint( 5, 5, 0 ), tripoint( 5, 9, 0 ), "straight-y" },
+        { tripoint( 5, 5, 0 ), tripoint( 5, 5, 4 ), "straight-up" },
+        { tripoint( 5, 5, 0 ), tripoint( 1, 5, 0 ), "straight-x-back" },
+        { tripoint( 5, 5, 0 ), tripoint( 1, 3, 0 ), "x-dominant-back" },
+        { tripoint( 5, 5, 0 ), tripoint( 3, 1, 0 ), "y-dominant-back" },
+        { tripoint( 5, 5, 0 ), tripoint( 1, 1, 0 ), "diagonal-back" },
+        { tripoint( 5, 5, 0 ), tripoint( 5, 5, 0 ), "standing-still" },
+    };
+
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+    std::fprintf( out, "{\"harness\":\"squares-closer\",\"version\":1,\"cases\":[" );
+    bool first_case = true;
+    for( const case_t &c : cases ) {
+        const std::vector<tripoint_bub_ms> squares =
+            squares_closer_to( tripoint_bub_ms( c.from ), tripoint_bub_ms( c.to ) );
+        std::fprintf( out, "%s{\"shape\":\"%s\",\"from\":[%d,%d,%d],\"to\":[%d,%d,%d],\"squares\":[",
+                      first_case ? "" : ",", c.shape, c.from.x, c.from.y, c.from.z, c.to.x, c.to.y, c.to.z );
+        for( std::size_t i = 0; i < squares.size(); i++ ) {
+            const tripoint raw = squares[i].raw();
+            std::fprintf( out, "%s[%d,%d,%d]", i == 0 ? "" : ",", raw.x, raw.y, raw.z );
+        }
+        std::fprintf( out, "]}" );
+        first_case = false;
+    }
+    std::fprintf( out, "]}\n" );
+    std::fclose( out );
+}
