+
+/// What a blast does to a room.
+///
+/// Reference: `do_blast` (`src/explosion.cpp:185-310`), the terrain half of `explosion_handler::explosion`. The room is built square by square so that the dump is a
+/// recording of the rule rather than of mapgen, and the blast's own dice — one jitter roll per node it pops — are handed in as a list of ones, so the geometry is the
+/// unjittered one and the port can take the same list as a parameter.
+void dump_blast( const std::string &path )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+    map &here = get_map();
+    const tripoint_bub_ms origin = here.get_bub( get_avatar().pos_abs() );
+    // A room 18 squares across with a **sealed** wall around it and two interior partitions. The outer wall is `t_wall_bulkhead`, one of the seventeen impassable terrains the data
+    // gives no bash block at all: a blast cannot break it and cannot get past it, so the recording stays inside the room instead of spreading over the whole bubble. The
+    // partitions are ordinary bashable wall with a window in the middle, so the two answers — a square that breaks and a square that does not — meet in one dump.
+    constexpr int half = 9;
+    struct blast_case {
+        float power;
+        float factor;
+        bool fire;
+    };
+    // Three cases, all of them small enough that the blast stays against the wall rather than wearing it away: a power-100 blast is the one that eventually gets through, and
+    // it would then be a recording of the damage left by the earlier cases rather than of this rule.
+    const blast_case cases[] = {
+        { 60.0f, 0.8f, false },
+        { 60.0f, 0.8f, true },
+        { 20.0f, 0.5f, false },
+    };
+    // A margin of two squares is rebuilt as well, so that no case inherits damage from the one before it.
+    constexpr int margin = 2;
+    auto build_room = [&]() {
+        for( int dx = -half - margin; dx <= half + margin; dx++ ) {
+            for( int dy = -half - margin; dy <= half + margin; dy++ ) {
+                const bool outside_room = dx < -half || dx > half || dy < -half || dy > half;
+                const bool edge = dx == -half || dx == half || dy == -half || dy == half;
+                const tripoint_bub_ms at = origin + tripoint_rel_ms( dx, dy, 0 );
+                // **Nothing inside the room is destroyed by the blast in a way that changes what it can pass through.** An ordinary wall would be: the reference bashes it,
+                // it becomes open air, and the wavefront continues through the hole - which makes the recording depend on the bash rule as well as the blast rule. The
+                // interior is therefore bare floor, and the wall is the one terrain in the data that cannot be broken at all.
+                // **Nothing in the room is destroyed by the blast either.** The floor is `t_LIXA_thconc_floor`, a passable terrain the data gives no bash block, so the
+                // wavefront crosses it without changing it; `t_floor` would be destroyed into open air and then into a roof, and the squares it turns impassable would stop
+                // the blast in places a model of the terrain as it was cannot predict.
+                here.ter_set( at, ter_str_id( outside_room || edge ? "t_wall_bulkhead" : "t_LIXA_thconc_floor" ) );
+                // **The sky and the floor are sealed too.** A blast climbs: it bashes the square above, and in a room open to the sky it then travels over the wall and comes
+                // back down outside — which made the room's own level unreproducible from a model of that level alone. Bulkhead on the squares above and below confines the
+                // wavefront to the three levels this dump records.
+                here.ter_set( at + tripoint_rel_ms::above, ter_str_id( "t_wall_bulkhead" ) );
+                here.ter_set( at + tripoint_rel_ms::below, ter_str_id( "t_wall_bulkhead" ) );
+                here.furn_set( at, furn_str_id::NULL_ID() );
+                here.i_clear( at );
+                here.set_map_damage( at, 0 );
+            }
+        }
+    };
+    // The world option the falloff's diagonal depends on (`src/explosion.cpp:189`): recorded rather than assumed, because the port takes it as a parameter and a wrong guess
+    // is invisible except as a blast that stops one square early.
+    std::fprintf( out,
+                  "{\"harness\":\"blast\",\"version\":1,\"half\":%d,\"grid_half\":%d,\"trigdist\":%s,\"cases\":[\n",
+                  half, half + margin, trigdist ? "true" : "false" );
+    bool first_case = true;
+    for( const blast_case &one : cases ) {
+        build_room();
+        // The room as it was **before** the blast, and **including the margin**: what a blast does depends on where the walls are, a recording taken afterwards would be a
+        // recording of its own damage, and the margin has to be in the recording because a square's shaped-charge bonus counts how many of its eight neighbours are open -
+        // including the ones just outside the room.
+        std::vector<std::string> room_before;
+        std::vector<std::string> above_before;
+        std::vector<std::string> below_before;
+        const int grid_half = half + margin;
+        const auto grid_size = static_cast<size_t>( ( 2 * grid_half + 1 ) * ( 2 * grid_half + 1 ) );
+        room_before.reserve( grid_size );
+        above_before.reserve( grid_size );
+        below_before.reserve( grid_size );
+        for( int dy = -grid_half; dy <= grid_half; dy++ ) {
+            for( int dx = -grid_half; dx <= grid_half; dx++ ) {
+                const tripoint_bub_ms at = origin + tripoint_rel_ms( dx, dy, 0 );
+                room_before.push_back( here.ter( at ).id().str() );
+                above_before.push_back( here.ter( at + tripoint_rel_ms::above ).id().str() );
+                below_before.push_back( here.ter( at + tripoint_rel_ms::below ).id().str() );
+            }
+        }
+        std::vector<float> rolls;
+        harness_set_blast_rolls( {} );
+        harness_do_blast( &here, origin, one.power, one.factor, one.fire );
+        // Only the bashes **on the room's own level** are kept. A blast also bashes the floor under it and the air over it, and those squares are the world's - the fixture
+        // set neither — so a recording of them would be a recording of mapgen. What was left out is printed beside the room as a number rather than left silent.
+        int other_levels = 0;
+        int outside = 0;
+        for( const auto &hit : harness_blast_bashes ) {
+            if( hit.first.z() != 0 ) {
+                other_levels++;
+            } else if( std::abs( hit.first.x() ) > half || std::abs( hit.first.y() ) > half ) {
+                outside++;
+            }
+        }
+        std::fprintf( out,
+                      "%s{\"power\":%.1f,\"factor\":%.2f,\"fire\":%s,\"other_levels\":%d,\"outside\":%d,\"bashes\":[",
+                      first_case ? "" : ",\n", static_cast<double>( one.power ),
+                      static_cast<double>( one.factor ), one.fire ? "true" : "false", other_levels,
+                      outside );
+
+        bool first = true;
+        for( const auto &hit : harness_blast_bashes ) {
+            if( hit.first.z() != 0 || std::abs( hit.first.x() ) > half ||
+                std::abs( hit.first.y() ) > half ) {
+                continue;
+            }
+            std::fprintf( out, "%s[%d,%d,%d,%.4f]", first ? "" : ",",
+                          hit.first.x(), hit.first.y(), hit.first.z(),
+                          static_cast<double>( hit.second ) );
+            first = false;
+        }
+        // The wavefront's own order, before any bashing: what the queue popped, when, and how far it had travelled. This is what tells a queue that pops the wrong square
+        // from a bash that hits it with the wrong force.
+        std::fprintf( out, "],\"pops\":[" );
+        first = true;
+        for( const harness_blast_pop &pop : harness_blast_pops ) {
+            std::fprintf( out, "%s[%d,%d,%d,%.5f,%.4f]", first ? "" : ",", pop.x, pop.y, pop.z,
+                          static_cast<double>( pop.distance ), static_cast<double>( pop.force ) );
+            first = false;
+        }
+        for( const auto &[name, tiles] :
+             { std::pair<const char *, const std::vector<std::string> *>( "room", &room_before ),
+               { "above", &above_before }, { "below", &below_before } } ) {
+            std::fprintf( out, "],\"%s\":[", name );
+            first = true;
+            for( const std::string &tile : *tiles ) {
+                std::fprintf( out, "%s\"%s\"", first ? "" : ",",
+                              harness::harness_escape( tile ).c_str() );
+                first = false;
+            }
+        }
+        std::fprintf( out, "]}" );
+        first_case = false;
+    }
+    std::fprintf( out, "\n]}\n" );
+    std::fclose( out );
+}
+
+
+/// The reference's own priority queue, popping a fixed list.
+///
+/// `do_blast` orders its wavefront with `std::priority_queue< std::pair<float, tripoint>, ..., pair_greater_cmp_first >` (`src/explosion.cpp:238`), whose comparator
+/// compares the distance and **nothing else** (`src/cata_utility.h:35-41`). Equal distances therefore come out in whatever order the standard library's binary heap holds
+/// them, which is not a rule anyone can read off the comparator — so it is recorded here, separately from any blast, and the port's transcription is checked against it.
+void dump_heap_probe( const std::string &path )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+    // A fixed list with the shapes that matter: repeated distances, and distances whose order of arrival differs from their order of value.
+    const float distances[] = { 0.0f, 1.0f, 1.0f, 1.414f, 2.0f, 2.0f, 2.0f, 1.0f, 2.828f, 3.0f, 3.0f,
+                                2.414f, 1.414f, 1.414f, 4.0f, 3.414f, 3.414f, 2.0f, 5.0f, 4.414f,
+                                0.5f, 0.5f, 0.5f, 6.0f, 6.0f, 2.0f, 2.0f, 7.0f, 1.414f, 8.0f,
+                                0.25f, 0.25f, 9.0f, 9.0f, 9.0f, 3.0f, 3.0f, 10.0f, 1.0f, 0.75f };
+    std::priority_queue< std::pair<float, int>, std::vector< std::pair<float, int> >, pair_greater_cmp_first > open;
+    std::fprintf( out, "{\"harness\":\"heap\",\"version\":1,\"popped\":[" );
+    bool first = true;
+    int pushed = 0;
+    for( float distance : distances ) {
+        open.emplace( distance, pushed++ );
+        // Pop whatever is ready, in between pushes, so the heap's internal state is exercised rather than only its final drain.
+        if( pushed % 7 == 0 ) {
+            while( !open.empty() ) {
+                std::fprintf( out, "%s[%.4f,%d]", first ? "" : ",",
+                              static_cast<double>( open.top().first ), open.top().second );
+                first = false;
+                open.pop();
+            }
+        }
+    }
+    while( !open.empty() ) {
+        std::fprintf( out, "%s[%.4f,%d]", first ? "" : ",", static_cast<double>( open.top().first ),
+                      open.top().second );
+        first = false;
+        open.pop();
+    }
+    std::fprintf( out, "]}\n" );
+    std::fclose( out );
+}
+
+template<event_type Type>
+std::vector<std::string> field_order()
+{
+    std::vector<std::string> names;
+    for( const auto &field : cata::event_detail::event_spec<Type>::fields ) {
+        names.emplace_back( field.first );
+    }
+    return names;
+}
+
+std::vector<std::string> field_order_for( event_type type )
+{
+    switch( type ) {
+#define HARNESS_EVENT_ORDER( name ) case event_type::name: return field_order<event_type::name>();
+#include "harness_event_order.inc"
+#undef HARNESS_EVENT_ORDER
+        default:
+            return {};
+    }
+}
+
+void dump_events( const std::string &path )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+    std::fprintf( out, "{\"harness\":\"events\",\"version\":1,\n\"events\":[\n" );
+    bool first_event = true;
+    for( int index = 0; index < static_cast<int>( event_type::num_event_types ); ++index ) {
+        const event_type type = static_cast<event_type>( index );
+        const cata::event::fields_type fields = cata::event::get_fields( type );
+        const std::vector<std::string> order = field_order_for( type );
+        std::fprintf( out, "%s\n{\"type\":\"%s\",\"fields\":[", first_event ? "" : ",",
+                      harness_escape( io::enum_to_string( type ) ).c_str() );
+        bool first_field = true;
+        for( const std::string &name : order ) {
+            const auto found = fields.find( name );
+            std::fprintf( out, "%s{\"name\":\"%s\",\"kind\":\"%s\"}", first_field ? "" : ",",
+                          harness_escape( name ).c_str(),
+                          found == fields.end() ? "unknown"
+                          : harness_escape( io::enum_to_string( found->second ) ).c_str() );
+            first_field = false;
+        }
+        std::fprintf( out, "]}" );
+        first_event = false;
+    }
+    std::fprintf( out, "\n]}\n" );
+    std::fclose( out );
+}
