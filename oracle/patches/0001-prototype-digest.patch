+/// What chance an attack has of hitting a weak point, exactly as the reference computes it.
+///
+/// `weakpoint::hit_chance` (`weakpoint.cpp:536-578`) is a **normal distribution's tail** - `erf` for a weak point that helps the attacker, `erfc` for one that hurts the monster - multiplied by the
+/// attack type's coverage multiplier and the weak point's own coverage. The port has to reproduce that arithmetic rather than approximate a bell curve, so this dump is the table its `erf` and
+/// `erfc` are held to: a grid over skill, difficulty and coverage, for both halves of the branch, with the coverage multiplier held at one so the row is the difficulty's own answer.
+void dump_weakpoint_chance( const std::string &path )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+    std::fprintf( out, "{\"harness\":\"weakpoint-chance\",\"version\":1,\n\"rows\":[\n" );
+    const float coverages[] = { 25.0f, 50.0f, 100.0f };
+    const float difficulties[] = { -100.0f, 0.0f, 5.0f, 10.0f, 20.0f };
+    const float skills[] = { 0.0f, 1.0f, 2.0f, 5.0f, 10.0f, 15.0f, 20.0f, 30.0f };
+    bool first = true;
+    for( const bool good : { true, false } ) {
+        for( const float coverage : coverages ) {
+            for( const float difficulty : difficulties ) {
+                for( const float skill : skills ) {
+                    weakpoint wp;
+                    wp.coverage = coverage;
+                    wp.is_good = good;
+                    wp.difficulty.difficulty.fill( difficulty );
+                    wp.coverage_mult.difficulty.fill( 1.0f );
+                    weakpoint_attack attack;
+                    attack.source = nullptr;
+                    attack.target = nullptr;
+                    attack.weapon = nullptr;
+                    attack.type = weakpoint_attack::attack_type::NONE;
+                    attack.is_thrown = false;
+                    attack.is_crit = false;
+                    attack.wp_skill = skill;
+                    const float chance = wp.hit_chance( attack );
+                    std::fprintf( out,
+                                  "%s\n{\"coverage\":%.6f,\"difficulty\":%.6f,\"skill\":%.6f,"
+                                  "\"good\":%s,\"chance\":%.9f}",
+                                  first ? "" : ",", static_cast<double>( coverage ),
+                                  static_cast<double>( difficulty ), static_cast<double>( skill ),
+                                  good ? "true" : "false", static_cast<double>( chance ) );
+                    first = false;
+                }
+            }
+        }
+    }
+    std::fprintf( out, "\n]}\n" );
+    std::fclose( out );
+}
+
+/// How long each kind of butchery takes on each size of corpse, exactly as the reference works it out.
+///
+/// `butcher_time_to_cut` (`butchery.cpp:383-...`) is a table of base times by **creature size**, scaled by the tool's quality, then by the action's own multiplier and clamps, then by the corpse's
+/// flags and by what the butcher has practised. The port has to reproduce that arithmetic - the divisions truncate, the clamps are floors, and the order decides both - so this dump is the table the port
+/// is held to, one row per size, action and flag state, with the quality factor recorded so the port's own term can be checked against a row that is not zero.
+void dump_butchery( const std::string &path )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+    std::fprintf( out, "{\"harness\":\"butchery\",\"version\":1,\n\"rows\":[\n" );
+    avatar &u = get_avatar();
+    const std::pair<const char *, const char *> corpses[] = {
+        { "mon_chicken", "tiny" },
+        { "mon_turkey", "small" },
+        { "mon_zombie", "medium" },
+        { "mon_bear", "large" },
+        { "mon_fungal_wall", "huge" },
+    };
+    const std::pair<butcher_type, const char *> actions[] = {
+        { butcher_type::BLEED, "BLEED" },
+        { butcher_type::QUICK, "QUICK" },
+        { butcher_type::FULL, "FULL" },
+        { butcher_type::FIELD_DRESS, "FIELD_DRESS" },
+        { butcher_type::SKIN, "SKIN" },
+        { butcher_type::QUARTER, "QUARTER" },
+        { butcher_type::DISMEMBER, "DISMEMBER" },
+        { butcher_type::DISSECT, "DISSECT" },
+    };
+    // The flags the rule reads, as states rather than as a combination: a plain corpse, one already field dressed, one whose field dressing failed, and one already quartered.
+    const std::pair<const char *, std::vector<flag_id>> states[] = {
+        { "plain", {} },
+        { "field_dressed", { flag_FIELD_DRESS } },
+        { "field_dress_failed", { flag_FIELD_DRESS, flag_FIELD_DRESS_FAILED } },
+        { "quartered", { flag_QUARTERED } },
+    };
+    bool first = true;
+    for( const std::pair<const char *, const char *> &corpse : corpses ) {
+        const mtype_id type( corpse.first );
+        if( !type.is_valid() ) {
+            std::fprintf( stderr, "harness: no monster %s\n", corpse.first );
+            continue;
+        }
+        for( const std::pair<const char *, std::vector<flag_id>> &state : states ) {
+            item body = item::make_corpse( type );
+            for( const flag_id &flag : state.second ) {
+                body.set_flag( flag );
+            }
+            for( const std::pair<butcher_type, const char *> &action : actions ) {
+                const int moves = butcher_time_to_cut( u, body, action.first );
+                std::fprintf( out,
+                              "%s\n{\"monster\":\"%s\",\"size\":\"%s\",\"state\":\"%s\",\"action\":\"%s\","
+                              "\"moves\":%d}",
+                              first ? "" : ",", corpse.first, corpse.second, state.first, action.second, moves );
+                first = false;
+            }
+        }
+    }
+    std::fprintf( out, "\n]}\n" );
+    std::fclose( out );
+}
+
+/// What every spell's numbers are, as the reference resolved them.
+///
+/// `spell_type` holds most of its numbers as `dbl_or_var`, which is either a constant or a dice/arithmetic
+/// expression. Only the constants are dumped as numbers: an expression is written as `null`, because a loader that
+/// silently read a dice expression as its mean would be wrong in a way no test could see. The port's spells are
+/// data-driven off these numbers; what a spell *does* is `effect_name`, which is a string the port dispatches on.
+static void dump_one_number( std::FILE *out, const char *key, const dbl_or_var &value, bool &first )
+{
+    std::fprintf( out, "%s\"%s\":", first ? "" : ",", key );
+    if( value.is_constant() ) {
+        std::fprintf( out, "%.6f", static_cast<double>( value.constant() ) );
+    } else {
+        std::fprintf( out, "null" );
+    }
+    first = false;
+}
