+/// A vehicle the reference itself places, with everything a later behaviour dump needs pinned beside it - `--dump-vehicle-placement`.
+///
+/// A vehicle turned in place: where every part lands after a quarter turn, and what the hull faces.
+///
+/// The fixture is `dump_vehicle_top_speed`'s own - floor 20 squares around the avatar so terrain cannot refuse the placement, the vehicle added at the origin - and the turn is
+/// the reference's: `vehicle::turn` adds to `turn_dir` and rounds it to the steer increment (`vehicle_move.cpp:678-685`), and the parts only move when the mounts are
+/// recalculated, which `map::move_vehicle` does with `veh.precalc_mounts( 1, veh.skidding ? veh.turn_dir : facing.dir(), veh.pivot_point( *this ) )` (`map.cpp:808`).
+/// Recording both halves is the point: it pins **which** call moves the parts, not just what a turn computes.
+void dump_vehicle_turn( const std::string &path )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+
+    map &here = get_map();
+    const tripoint_bub_ms origin = get_player_character().pos_bub( here );
+    for( int dx = -20; dx <= 20; dx++ ) {
+        for( int dy = -20; dy <= 20; dy++ ) {
+            const tripoint_bub_ms square = origin + tripoint_rel_ms( dx, dy, 0 );
+            here.ter_set( square, ter_id( "t_floor" ) );
+            here.furn_set( square, furn_str_id::NULL_ID() );
+        }
+    }
+
+    std::fprintf( out, "{\"harness\":\"vehicle_turn\",\"version\":1,\"origin\":[%d,%d,%d],\"cases\":[",
+                  origin.x(), origin.y(), origin.z() );
+    bool first_case = true;
+    const auto dump_case = [&]( const char *name, const vproto_id &type, int degrees ) {
+        vehicle *veh = here.add_vehicle( type, origin, 0_degrees, 0, 0, false, true );
+        if( veh == nullptr ) {
+            std::fprintf( stderr, "harness: %s did not place\n", type.str().c_str() );
+            return;
+        }
+        if( !first_case ) {
+            std::fputc( ',', out );
+        }
+        first_case = false;
+        std::fprintf( out, "{\"name\":\"%s\",\"degrees\":%d,\"face\":%d,\"parts\":[", name, degrees,
+                      static_cast<int>( units::to_degrees( veh->face.dir() ) ) );
+        // Before the turn: what the vehicle was built as.
+        for( int p = 0; p < veh->part_count(); p++ ) {
+            const point_rel_ms mount = veh->part( p ).mount;
+            if( p > 0 ) {
+                std::fputc( ',', out );
+            }
+            std::fprintf( out, "{\"index\":%d,\"x\":%d,\"y\":%d}", p, mount.x(), mount.y() );
+        }
+        std::fprintf( out, "],\"turned\":[" );
+        veh->turn( units::from_degrees( degrees ) );
+        veh->precalc_mounts( 1, veh->face.dir(), veh->pivot_point( here ) );
+        for( int p = 0; p < veh->part_count(); p++ ) {
+            const point_rel_ms mount = veh->part( p ).mount;
+            if( p > 0 ) {
+                std::fputc( ',', out );
+            }
+            std::fprintf( out, "{\"index\":%d,\"x\":%d,\"y\":%d}", p, mount.x(), mount.y() );
+        }
+        std::fprintf( out, "],\"turn_dir\":%d,\"face_after\":%d}", static_cast<int>( units::to_degrees( veh->turn_dir ) ),
+                      static_cast<int>( units::to_degrees( veh->face.dir() ) ) );
+        here.destroy_vehicle( veh );
+    };
+    dump_case( "bicycle", vproto_id( "bicycle" ), 90 );
+    dump_case( "bicycle_reverse", vproto_id( "bicycle" ), -90 );
+    std::fprintf( out, "]}\n" );
+    std::fclose( out );
+}
+
+/// The rotation dump exercises `tileray` without a map; this one proves the **placement path** works in the harness, which every later vehicle behaviour needs: `map::add_vehicle`
+/// (`mapgen.cpp:7523-7560`) refuses a vehicle whose structural squares hit deep water or another vehicle, and it needs the dynamic data loaded (`check_mod_data`) or the prototype id
+/// does not exist. It lays floor around the avatar first so terrain cannot be the reason, places the 2-seater helicopter at the avatar's own square, and records what the reference
+/// built: the name, every part's mount and square, its spec's fuel type, and the ammo a tank happens to hold.
+void dump_vehicle_top_speed( const std::string &path )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+
+    map &here = get_map();
+    const tripoint_bub_ms origin = get_player_character().pos_bub( here );
+    for( int dx = -20; dx <= 20; dx++ ) {
+        for( int dy = -20; dy <= 20; dy++ ) {
+            const tripoint_bub_ms square = origin + tripoint_rel_ms( dx, dy, 0 );
+            here.ter_set( square, ter_id( "t_floor" ) );
+            here.furn_set( square, furn_str_id::NULL_ID() );
+        }
+    }
+
+    std::fprintf( out, "{\"harness\":\"vehicle_top_speed\",\"version\":2,\"origin\":[%d,%d,%d],"
+                  "\"cases\":[", origin.x(), origin.y(), origin.z() );
+    bool first_case = true;
+
+    // `vehicle::max_ground_velocity` (`vehicle.cpp:4234-4247`) turns three coefficients into a speed: the cubic
+    // `c_air * v^3 + c_rolling * v^2 + 33.33 * c_rolling * v - power = 0` solved by `simple_cubic_solution`
+    // (`vehicle.cpp:4163-4201`), then `mps_to_vmiph` (`vehicle_move.cpp:91-94`). The case records the three inputs beside the answer, so a port can be checked
+    // on the solver before it can measure a vehicle's own air drag or engine power.
+    const auto dump_case = [&]( const char *name, const vproto_id &type, bool ruin_wheels_and_engine = false ) {
+        vehicle *veh = here.add_vehicle( type, origin, 0_degrees, 0, 0, false, true );
+        if( veh == nullptr ) {
+            std::fprintf( stderr, "harness: %s did not place\n", type.str().c_str() );
+            return;
+        }
+        if( ruin_wheels_and_engine ) {
+            // A vehicle dragged on its frame with nothing turning: 50 as the wheel factor and 0 W, which is the corner of the cubic where `tricky_bit` goes
+            // negative and the reference takes its `std::complex` branch (`vehicle.cpp:4174-4186`).
+            for( int p = 0; p < veh->part_count(); p++ ) {
+                const std::string location = veh->part( p ).info().location;
+                const bool wheel = veh->part( p ).info().has_flag( VPFLAG_WHEEL );
+                const bool engine = veh->part( p ).info().has_flag( VPFLAG_ENGINE );
+                if( wheel || engine ) {
+                    veh->set_hp( veh->part( p ), 0, false );
+                }
+                (void)location;
+            }
+            veh->refresh();
+        }
+        const double c_air = veh->coeff_air_drag();
+        const double c_rolling = veh->coeff_rolling_drag( here );
+        const int power = units::to_watt( veh->total_power( here, false ) );
+        // A diagnostic only: which branch of `simple_cubic_solution` the three coefficients take. `tricky_bit` is negative exactly when the cubic has three real
+        // roots and the reference goes through `std::complex` (`vehicle.cpp:4174-4186`).
+        const double p = -c_rolling / ( 3 * c_air );
+        const double q = p * p * p + ( c_rolling * c_rolling * vehicles::rolling_constant_to_variable - 3 * c_air * -power ) / ( 6 * c_air * c_air );
+        const double r = c_rolling * vehicles::rolling_constant_to_variable / ( 3 * c_air );
+        const double tricky = q * q + ( r - p * p ) * ( r - p * p ) * ( r - p * p );
+        std::fprintf( out,
+                      "%s{\"name\":\"%s\",\"vehicle\":\"%s\",\"c_air\":%.17g,\"c_rolling\":%.17g,"
+                      "\"power_w\":%d,\"max_ground_velocity\":%d,\"complex\":%d,\"parts\":[",
+                      first_case ? "" : ",", name, type.str().c_str(), c_air, c_rolling, power,
+                      veh->max_ground_velocity( here, false ), tricky < 0 ? 1 : 0 );
+        // Version 2: each part's base item weight, so a port can install the reference's own registry and compute the mass its rolling drag needs.
+        bool first_part = true;
+        for( int p = 0; p < veh->part_count(); p++ ) {
+            const vehicle_part &vp = veh->part( p );
+            if( vp.removed ) {
+                continue;
+            }
+            std::fprintf( out,
+                          "%s{\"index\":%d,\"part\":\"%s\",\"item\":\"%s\",\"base_mass_g\":%lld}",
+                          first_part ? "" : ",", p, vp.info().id.str().c_str(),
+                          vp.info().base_item.str().c_str(),
+                          static_cast<long long>( units::to_gram( vp.get_base().weight() ) ) );
+            first_part = false;
+        }
+        std::fprintf( out, "]}" );
+        first_case = false;
+        here.destroy_vehicle( veh );
+    };
+
+    dump_case( "bicycle", vproto_id( "bicycle" ) );
+    dump_case( "quad_bike", vproto_id( "quad_bike" ) );
+    dump_case( "car", vproto_id( "car" ) );
+    dump_case( "pickup", vproto_id( "pickup" ) );
+    dump_case( "humvee", vproto_id( "humvee" ) );
+    dump_case( "2seater2", vproto_id( "2seater2" ) );
+    dump_case( "a_humvee_with_no_wheel_and_a_broken_engine", vproto_id( "humvee" ), true );
+    // Two cases that reach the parts of the scan the smaller vehicles do not: a ram standing alone on its mount (the only thing a protrusion test asks) and an
+    // aisle, which is the tallest thing a column can carry.
+    dump_case( "4x4_car", vproto_id( "4x4_car" ) );
+    dump_case( "pickup_technical", vproto_id( "pickup_technical" ) );
+
+    std::fprintf( out, "]}\n" );
+    std::fclose( out );
+}
