+/// Every gun's own firing numbers: `--dump-guns`.
+///
+/// Reference: `mtype`-style, the gun is the item's `gun_type` (`itype::gun`), and the reason it is dumped apart from the rest of the item is that a shot's accuracy is built from
+/// three numbers the item layer otherwise never touches: the weapon's own `dispersion`, the skill it is fired with (`gun_type::skill_used`), and its `range`. The port's ranged path is
+/// gated on the first two - `Character::get_weapon_dispersion` (`ranged.cpp:2500`) starts from `item::gun_dispersion`, which is that `dispersion` plus its gunmods.
+void dump_guns( const std::string &path )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+    std::fprintf( out, "{\"harness\":\"guns\",\"version\":8,\n\"guns\":[\n" );
+    bool first = true;
+    for( const itype *type : item_controller->all() ) {
+        if( type == nullptr || !type->gun ) {
+            continue;
+        }
+        // The gun's own blow, which is what a shot does when it lands: `item::gun_damage()` (`item.cpp:11160-11180`) is the type's `gun->damage` resolved for the barrel, and the four
+        // damage kinds the data uses for firearms are written beside it. A port that read the count as the damage would price every bullet at zero.
+        const damage_instance impact = type->gun->damage.di_considering_length( 0_mm );
+        double dam_total = 0.0;
+        int dam_bash = 0;
+        int dam_cut = 0;
+        int dam_stab = 0;
+        int dam_bullet = 0;
+        for( const damage_unit &unit : impact.damage_units ) {
+            dam_total += unit.amount;
+            const std::string &kind = unit.type.str();
+            if( kind == "bash" ) {
+                dam_bash += static_cast<int>( unit.amount );
+            } else if( kind == "cut" ) {
+                dam_cut += static_cast<int>( unit.amount );
+            } else if( kind == "stab" ) {
+                dam_stab += static_cast<int>( unit.amount );
+            } else if( kind == "bullet" ) {
+                dam_bullet += static_cast<int>( unit.amount );
+            }
+        }
+        std::fprintf( out, "%s\n{\"id\":\"%s\",\"dispersion\":%d,\"skill\":\"%s\",\"range\":%d,\"recoil\":%d,\"ammo\":\"%s\","
+                      "\"damage\":%.6g,\"damage_bash\":%d,\"damage_cut\":%d,\"damage_stab\":%d,\"damage_bullet\":%d,\"shot_spread\":%d,\"ammo_to_fire\":%d,\"handling\":%d,\"sight_dispersion\":%d,\"loudness\":%d,\"burst\":%d,\"durability\":%d}",
+                      first ? "" : ",",
+                      harness_escape( type->get_id().str() ).c_str(),
+                      type->gun->dispersion,
+                      harness_escape( type->gun->skill_used.str() ).c_str(),
+                      type->gun->range,
+                      type->gun->recoil,
+                      // A gun with no ammo type is still a gun (a thrown-only launcher), so the field is written empty rather than skipped.
+                      harness_escape( type->gun->ammo.empty() ? "" : type->gun->ammo.begin()->str() ).c_str(),
+                      dam_total, dam_bash, dam_cut, dam_stab, dam_bullet, 0, type->gun->ammo_to_fire, type->gun->handling, type->gun->sight_dispersion, type->gun->loudness, harness_burst( *type->gun ), type->gun->durability );
+        first = false;
+    }
+    std::fprintf( out, "\n]}\n" );
+    std::fclose( out );
+}
+
+
+/// One of the four "what is it" questions, asked of a real item of this type.
+///
+/// The reference answers these on an **item** and not on the type (`item.h:1663-1687`, `:2510`), and for `is_container` the difference is not academic: a gun's contents include the pockets its mods
+/// bring, so the item is a container while the type's own pocket list is not.
+static bool harness_item_predicate( const itype *proto, const char *which )
+{
+    item made( proto->get_id() );
+    if( made.is_null() ) {
+        return false;
+    }
+    const std::string question( which );
+    if( question == "container" ) {
+        return made.is_container();
+    }
+    if( question == "tool" ) {
+        return made.is_tool();
+    }
+    if( question == "gun" ) {
+        return made.is_gun();
+    }
+    if( question == "ammo" ) {
+        return made.is_ammo();
+    }
+    return false;
+}
+
+void dump_items( const std::string &path )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+    std::fprintf( out, "{\"harness\":\"items\",\"version\":3,\n\"prototypes\":[\n" );
+    bool first = true;
+    for( const itype *proto : item_controller->all() ) {
+        std::fprintf( out, "%s\n{\"id\":\"%s\",\"name\":\"%s\",\"name_plural\":\"%s\","
+                      "\"symbol\":\"%s\",\"color\":\"%s\",\"weight\":%lld,\"integral_weight\":%lld,"
+                      "\"weight_mg\":%lld,\"integral_weight_mg\":%lld,"
+                      "\"volume\":%lld,\"integral_volume\":%lld,"
+                      "\"price\":%lld,\"category\":\"%s\",\"stack_size\":%lld,\"count_by_charges\":%s,"
+                      "\"chip_resistance\":%d,\"materials\":[",
+                      first ? "" : ",", harness_escape( proto->id.str() ).c_str(),
+                      harness_escape( proto->nname( 1 ) ).c_str(),
+                      harness_escape( proto->nname( 2 ) ).c_str(),
+                      // The glyph is UTF-8 text, not a byte: a multi-byte symbol
+                      // would otherwise be dumped as its first signed byte.
+                      harness_escape( proto->sym ).c_str(),
+                      string_from_color( proto->color ).c_str(),
+                      static_cast<long long>( units::to_gram( proto->weight ) ),
+                      // **The other weight.** `item::weight( integral: true )` reads `integral_weight` instead of `weight`
+                      // (`src/item.cpp:7256-7261`), and the dump carried only one of the two, so a port could not tell what a maximally damaged item
+                      // weighs. Zero in the data means "the same as `weight`", which is how the reference's own default reads.
+                      static_cast<long long>( units::to_gram( proto->integral_weight ) ),
+                      // **Milligrams**, because grams are not enough: a charge-counted type can weigh a fraction of a gram a charge and a pile of a thousand then
+                      // weighs hundreds of grams. Twenty-four types in the data are like that, and a dump in whole grams lost them.
+                      static_cast<long long>( units::to_milligram( proto->weight ) ),
+                      static_cast<long long>( units::to_milligram( proto->integral_weight ) ),
+                      static_cast<long long>( units::to_milliliter( proto->volume ) ),
+                      // The volume's other number, the way `weight` has one: `item::volume( integral: true )` reads `integral_volume` (`src/item.cpp:7540-7544`).
+                      static_cast<long long>( units::to_milliliter( proto->integral_volume ) ),
+                      static_cast<long long>( units::to_cent( proto->price ) ),
+                      harness_escape( proto->category_force.str() ).c_str(),
+                      // **What a stack's volume is divided by.** `item::volume` multiplies a charge-counted item's volume by its charges and then **divides by
+                      // `stack_size`, rounding up a millilitre** (`src/item.cpp:7546-7562`), so a port without the divisor cannot say what a pile takes up.
+                      static_cast<long long>( proto->stack_size ),
+                      proto->count_by_charges() ? "true" : "false",
+                      // `item::chip_resistance()` (`item.cpp:9375-9409`): how well the thing resists being chipped by use, which is what
+                      // `Character::handle_melee_wear` divides the wear chance by. The **item's** figure, which is its materials' weighted by their portions.
+                      item( proto->id, calendar::turn, 1 ).chip_resistance( false ) );
+        bool first_material = true;
+        for( const std::pair<const material_id, int> &entry : proto->materials ) {
+            std::fprintf( out, "%s[\"%s\",%d]", first_material ? "" : ",",
+                          harness_escape( entry.first.str() ).c_str(), entry.second );
+            first_material = false;
+        }
+        std::fprintf( out, "],\"armor_data\":[" );
+        if( proto->armor ) {
+            bool first_row = true;
+            for( const armor_portion_data &row : proto->armor->data ) {
+                std::fprintf( out, "%s{\"covers\":[", first_row ? "" : "," );
+                bool first_cover = true;
+                for( const bodypart_str_id &bp : row.covers.value() ) {
+                    std::fprintf( out, "%s\"%s\"", first_cover ? "" : ",",
+                                  harness_escape( bp.str() ).c_str() );
+                    first_cover = false;
+                }
+                std::fprintf( out, "],\"materials\":[" );
+                bool first_row_mat = true;
+                for( const part_material &mat : row.materials ) {
+                    std::fprintf( out, "%s[\"%s\",%.4f,%d]", first_row_mat ? "" : ",",
+                                  harness_escape( mat.id.str() ).c_str(),
+                                  static_cast<double>( mat.thickness ), mat.cover );
+                    first_row_mat = false;
+                }
+                std::fprintf( out, "]}" );
+                first_row = false;
+            }
+        }
+        std::fprintf( out, "],\"flags\":[" );
+        bool first_flag = true;
+        for( const flag_id &flag : proto->get_flags() ) {
+            std::fprintf( out, "%s\"%s\"", first_flag ? "" : ",",
+                          harness_escape( flag.str() ).c_str() );
+            first_flag = false;
+        }
+        // What a fire needs to know beyond materials: whether it goes off, and whether its ammo
+        // cooks off, which is `item::will_explode_in_fire` (`src/item.cpp:13314-13325`).
+        // What eating it does, for the comestibles (`itype.cpp:151-159` and the ingest rules).
+        // Whether it is a gun, and whether it is a gun *mod*: the two flags that decide whether the reference invents a turret vehicle part for it
+        // (`veh_type.cpp:473-491`), which is where 239 of the 701 vehicle parts come from. Without them a port cannot reproduce that registry at all.
+        // **The faults this type can catch, with their weights** (`itype::faults`), which is the list `item::set_random_fault_of_type` filters and picks from
+        // (`item.cpp:7854-7868`). Emitted as its own array with its own writer, because a vararg added in the wrong place misaligns every later argument - the
+        // mistake round 1191 made with `chip_resistance`.
+        std::fprintf( out, "],\"faults\":[" );
+        {
+            bool first_fault = true;
+            for( const weighted_object<int, fault_id> &entry : proto->faults ) {
+                std::fprintf( out, "%s[\"%s\",%d]", first_fault ? "" : ",",
+                              harness_escape( entry.obj.str() ).c_str(), entry.weight );
+                first_fault = false;
+            }
+        }
+        std::fprintf( out, "],\"is_gun\":%s,\"is_gunmod\":%s,"
+                      "\"nutr\":%d,\"quench\":%d,\"charges_to_use\":%d,"
+                      "\"explode_in_fire\":%s,\"cookoff\":%s,\"special_cookoff\":%s,"
+                      // **What the item is**, as the reference's own predicates answer it (`item.h:1663-1687`, `:2510`, `item.cpp:10238-10241`). The port models a kind as facts, and these four
+                      // booleans are the facts a behaviour hangs off: a container holds things, a tool spends charges, a gun fires, a comestible feeds.
+                      "\"holds_container_pocket\":%s,\"is_tool\":%s,\"is_comestible\":%s,\"is_ammo\":%s}",
+                      proto->gun ? "true" : "false",
+                      proto->gunmod ? "true" : "false",
+                      proto->comestible ? proto->comestible->get_default_nutr() : 0,
+                      proto->comestible ? proto->comestible->quench : 0,
+                      proto->charges_to_use(),
+                      proto->explode_in_fire ? "true" : "false",
+                      proto->ammo && proto->ammo->cookoff ? "true" : "false",
+                      proto->ammo && proto->ammo->special_cookoff ? "true" : "false",
+                      // **Asked of an item, not of the type.** `item::is_container` asks the item's contents for a `CONTAINER` pocket (`item.cpp:10238-10241`), and an item's contents include the
+                      // pockets its **built-in and default mods** bring (`item::update_modified_pockets`, `item.cpp:1350-1395`) - which is why a rifle with a stocked mod is a container and its type is not.
+                      // The pocket dump asks the same way, by building the item, so the two dumps agree with each other and with the reference.
+                      harness_item_predicate( proto, "container" ) ? "true" : "false",
+                      harness_item_predicate( proto, "tool" ) ? "true" : "false",
+                      proto->comestible ? "true" : "false",
+                      harness_item_predicate( proto, "ammo" ) ? "true" : "false" );
+        first = false;
+    }
+    std::fprintf( out, "]}\n" );
+    std::fclose( out );
+}
+
+bool start_headless_game( const std::string &world_name, const std::string &start_loc,
+                          std::string &error )
+{
+    // The reference's own tests stop before this point and build a flat synthetic
+    // world instead (tests/test_main.cpp:88-168), so this follows the real new-game
+    // path as far as it can go without input; see docs/parts/headless-start.md.
+    // `avatar::create` writes a character template, so the directory has to
+    // exist before it runs; without it the reference fails writing the file and
+    // opens an error prompt (newcharacter.cpp:870 -> save_template).
+    assure_dir_exist( PATH_INFO::templatedir() );
+
+    world_generator->set_active_world( nullptr );
+    world_generator->init();
+    std::vector<mod_id> mods;
+    mods.emplace_back( "dda" );
+    WORLD *world = world_generator->make_new_world( world_name, mods );
+    if( world == nullptr ) {
+        error = "could not create world " + world_name;
+        return false;
+    }
+    world_generator->set_active_world( world );
+
+    // Calendar settings must follow the options before any turn happens.
+    calendar::set_eternal_season( get_option<bool>( "ETERNAL_SEASON" ) );
+    calendar::set_season_length( get_option<int>( "SEASON_LENGTH" ) );
+
+    g->setup();
+    get_avatar() = avatar();
+    get_avatar().create( character_type::NOW );
+    // The id is assigned by start_game itself; assigning one here makes the
+    // reference complain that the character already has one.
+
+    // Fixed start location, so the avatar's birth square is not a random draw.
+    if( !start_loc.empty() ) {
+        const start_location_id loc( start_loc );
+        if( loc.is_valid() ) {
+            get_avatar().random_start_location = false;
+            get_avatar().start_location = loc;
+        } else {
+            error = "unknown start location " + start_loc;
+            return false;
+        }
+    }
+
+    if( !g->harness_start_game() ) {
+        error = "start_game refused";
+        return false;
+    }
+    return true;
+}
