+void dump_vehicle_parts( const std::string &path )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+    // Version 2 carried what a part **is**; version 3 adds the **blueprint** a prototype is built from. An id list said a vehicle existed and nothing about what it was
+    // made of, which is every question that matters - whether it rolls, what it holds, and what it is worth.
+    //
+    // Each entry is copied out inside the loop rather than pointed at: `get_all()` may hand back a copy, and a pointer into a temporary is a bug waiting for a bigger data set.
+    struct dumped_part {
+        std::string id;
+        std::string name;
+        int durability = 0;
+        int damage_modifier = 0;
+        std::string item;
+        std::string location;
+        int size = 0;
+        int cargo_weight_modifier = 100;
+        std::string fuel_type;
+        bool fuel_store = false;
+        bool battery = false;
+        std::vector<std::string> fuel_opts;
+        std::vector<std::string> flags;
+        std::vector<std::pair<std::string, float>> damage_reduction;
+        // Version 7: what a wheel resists rolling with. `wheel_info->rolling_resistance` (`veh_type.h:142`) is a float and only wheels have one.
+        bool has_wheel_info = false;
+        double rolling_resistance = 0;
+        // Version 8: what an engine makes. `vpart_info::power` (`veh_type.h`) is a `units::power`, written as whole watts.
+        int power = 0;
+        // Version 9: how much of its power a damaged engine keeps. `engine_info::damaged_power_factor` (`veh_type.h:128`) is a float, 0 for everything that is
+        // not an engine.
+        bool has_engine_info = false;
+        double damaged_power_factor = 0;
+        // Version 10: what the part's material weighs per litre, from the base item's materials (`item::find_type( base_item )->materials`). The crash rule divides
+        // this by the obstacle's density, so it is a data fact the loader carries rather than a formula the rule invents.
+        double density = 0;
+        // Version 11: how much of its power an engine may give in safe mode. `engine_info::m2c` (`veh_type.h:125`) is the motor-to-crankshaft ratio the safe branch
+        // multiplies each engine by; -1 means "not an engine".
+        int m2c = -1;
+        // Version 12: how much power an engine draws when it runs. `vpart_info::energy_consumption` (`veh_type.h:428`) is a `units::power`; `fuel_usage` sums it per
+        // fuel type, and `consume_fuel` is that sum scaled by load and strain.
+        int energy_consumption_w = 0;
+    };
+    struct dumped_prototype {
+        std::string id;
+        std::string name;
+        std::vector<std::tuple<std::string, int, int, std::string, int>> parts;
+    };
+    std::vector<dumped_part> parts;
+    for( const vpart_info &part : vehicles::parts::get_all() ) {
+        dumped_part entry;
+        entry.id = part.id.str();
+        entry.name = part.name();
+        entry.durability = part.durability;
+        entry.damage_modifier = part.dmg_mod;
+        entry.item = part.base_item.str();
+        if( const itype *base = item::find_type( part.base_item ) ) {
+            const auto &mats = base->materials;
+            const float mat_total = base->mat_portion_total == 0 ? 1 : base->mat_portion_total;
+            double sum = 0;
+            for( const std::pair<const material_id, int> &mat_id : mats ) {
+                sum += mat_id.first->density() * ( static_cast<double>( mat_id.second ) / mat_total );
+            }
+            entry.density = mats.empty() ? 0 : sum / static_cast<double>( mats.size() );
+        }
+        entry.location = part.location;
+        entry.size = static_cast<int>( units::to_milliliter( part.size ) );
+        entry.cargo_weight_modifier = part.cargo_weight_modifier;
+        entry.power = units::to_watt( part.power );
+        if( part.engine_info ) {
+            entry.has_engine_info = true;
+            entry.damaged_power_factor = static_cast<double>( part.engine_info->damaged_power_factor );
+            entry.m2c = part.engine_info->m2c;
+        }
+        entry.energy_consumption_w = units::to_watt( part.energy_consumption );
+        if( part.wheel_info ) {
+            entry.has_wheel_info = true;
+            entry.rolling_resistance = static_cast<double>( part.wheel_info->rolling_resistance );
+        }
+        entry.fuel_type = part.fuel_type.str();
+        // What the part can hold: `vehicle_part::is_fuel_store` asks `is_tank() || is_magazine() || is_reactor()`, and `is_battery()` is the battery branch of `fuel_left`.
+        // The base item is what both questions read, so one probe of it answers them without a placed part.
+        const item base_probe( part.base_item );
+        entry.fuel_store = base_probe.is_watertight_container() || base_probe.is_magazine() ||
+                           part.has_flag( "REACTOR" );
+        entry.battery = base_probe.is_battery();
+        // An engine's usable fuels, in the order `auto_select_fuel` tries them (`vehicle_use.cpp:627-643`). `finalize` fills a single entry from `fuel_type` when the
+        // JSON names none (`veh_type.cpp:650-652`), so a real engine can carry seven, as the helicopter's turbines do.
+        if( part.engine_info ) {
+            for( const itype_id &option : part.engine_info->fuel_opts ) {
+                entry.fuel_opts.push_back( option.str() );
+            }
+        }
+        for( const std::string &flag : part.get_flags() ) {
+            entry.flags.push_back( flag );
+        }
+        for( const std::pair<const damage_type_id, float> &reduction : part.damage_reduction ) {
+            entry.damage_reduction.emplace_back( reduction.first.str(), reduction.second );
+        }
+        std::sort( entry.damage_reduction.begin(), entry.damage_reduction.end() );
+        parts.push_back( std::move( entry ) );
+    }
+    std::sort( parts.begin(), parts.end(), []( const dumped_part &lhs, const dumped_part &rhs ) {
+        return lhs.id < rhs.id;
+    } );
+    std::vector<dumped_prototype> prototypes;
+    for( const vehicle_prototype &proto : vehicles::get_all_prototypes() ) {
+        dumped_prototype entry;
+        entry.id = proto.id.str();
+        entry.name = proto.name.translated();
+        for( const vehicle_prototype::part_def &part : proto.parts ) {
+            entry.parts.emplace_back( part.part.str(), part.pos.x(), part.pos.y(), part.variant,
+                                      part.with_ammo );
+        }
+        prototypes.push_back( std::move( entry ) );
+    }
+    std::sort( prototypes.begin(), prototypes.end(),
+    []( const dumped_prototype &lhs, const dumped_prototype &rhs ) {
+        return lhs.id < rhs.id;
+    } );
+    std::fprintf( out, "{\"harness\":\"vehicles\",\"version\":12,\n\"parts\":[\n" );
+    bool first = true;
+    for( const dumped_part &part : parts ) {
+        std::fprintf( out, "%s{\"id\":", first ? "" : ",\n" );
+        std::fprintf( out, "\"%s\"", escaped( part.id ).c_str() );
+        std::fprintf( out, ",\"name\":" );
+        std::fprintf( out, "\"%s\"", escaped( part.name ).c_str() );
+        std::fprintf( out, ",\"vpart_dens\":%.9g,\"durability\":%d,\"damage_modifier\":%d,\"item\":", part.density, part.durability,
+                      part.damage_modifier );
+        std::fprintf( out, "\"%s\"", escaped( part.item ).c_str() );
+        std::fprintf( out, ",\"location\":" );
+        std::fprintf( out, "\"%s\"", escaped( part.location ).c_str() );
+        std::fprintf( out, ",\"size\":%d,\"cargo_weight_modifier\":%d,\"power\":%d,\"m2c\":%d,"
+                      "\"energy_consumption_w\":%d",
+                      part.size, part.cargo_weight_modifier, part.power, part.m2c,
+                      part.energy_consumption_w );
+        if( part.has_engine_info ) {
+            std::fprintf( out, ",\"damaged_power_factor\":%.9g", part.damaged_power_factor );
+        } else {
+            std::fprintf( out, ",\"damaged_power_factor\":null" );
+        }
+        if( part.has_wheel_info ) {
+            // Nine significant digits round-trip a float exactly, and the reference's coefficient is a float widened to double, so `1.9` printed as a
+            // decimal and read back as a double is not the same number the reference summed.
+            std::fprintf( out, ",\"rolling_resistance\":%.9g", part.rolling_resistance );
+        } else {
+            std::fprintf( out, ",\"rolling_resistance\":null" );
+        }
+        std::fprintf( out, ",\"fuel_type\":\"%s\"", escaped( part.fuel_type ).c_str() );
+        std::fprintf( out, ",\"fuel_store\":%d,\"battery\":%d", part.fuel_store ? 1 : 0,
+                      part.battery ? 1 : 0 );
+        std::fprintf( out, ",\"fuel_opts\":[" );
+        bool first_fuel = true;
+        for( const std::string &option : part.fuel_opts ) {
+            std::fprintf( out, "%s\"%s\"", first_fuel ? "" : ",", escaped( option ).c_str() );
+            first_fuel = false;
+        }
+        std::fprintf( out, "]" );
+        std::fprintf( out, ",\"flags\":[" );
+        bool first_flag = true;
+        for( const std::string &flag : part.flags ) {
+            std::fprintf( out, "%s", first_flag ? "" : "," );
+            std::fprintf( out, "\"%s\"", escaped( flag ).c_str() );
+            first_flag = false;
+        }
+        std::fprintf( out, "],\"damage_reduction\":{" );
+        bool first_kind = true;
+        for( const std::pair<std::string, float> &reduction : part.damage_reduction ) {
+            std::fprintf( out, "%s", first_kind ? "" : "," );
+            std::fprintf( out, "\"%s\"", escaped( reduction.first ).c_str() );
+            std::fprintf( out, ":%.6g", static_cast<double>( reduction.second ) );
+            first_kind = false;
+        }
+        std::fprintf( out, "}}" );
+        first = false;
+    }
+    std::fprintf( out, "\n],\"part_count\":%zu,\n\"prototypes\":[\n", parts.size() );
+    first = true;
+    for( const dumped_prototype &proto : prototypes ) {
+        std::fprintf( out, "%s{\"id\":", first ? "" : ",\n" );
+        std::fprintf( out, "\"%s\"", escaped( proto.id ).c_str() );
+        std::fprintf( out, ",\"name\":" );
+        std::fprintf( out, "\"%s\"", escaped( proto.name ).c_str() );
+        std::fprintf( out, ",\"parts\":[" );
+        bool first_part = true;
+        for( const std::tuple<std::string, int, int, std::string, int> &part : proto.parts ) {
+            std::fprintf( out, "%s{\"part\":", first_part ? "" : "," );
+            std::fprintf( out, "\"%s\"", escaped( std::get<0>( part ) ).c_str() );
+            std::fprintf( out, ",\"x\":%d,\"y\":%d,\"variant\":", std::get<1>( part ),
+                          std::get<2>( part ) );
+            std::fprintf( out, "\"%s\"", escaped( std::get<3>( part ) ).c_str() );
+            std::fprintf( out, ",\"with_ammo\":%d}", std::get<4>( part ) );
+            first_part = false;
+        }
+        std::fprintf( out, "]}" );
+        first = false;
+    }
+    std::fprintf( out, "\n],\"prototype_count\":%zu}\n", prototypes.size() );
+    std::fclose( out );
+}
