+void dump_melee_rolls( const std::string &path )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+    // `melee_hit_range` is `normal_roll( accuracy * 5, 25 )` (`melee.cpp:2912`): the only randomness in
+    // deciding whether an attack connects. Dumping it per seed pins both numbers, because a wrong mean
+    // or a wrong deviation moves every value.
+    std::fprintf( out, "{\"harness\":\"melee-rolls\",\"version\":1,\n\"samples\":[" );
+    bool first = true;
+    for( unsigned seed : { 1u, 12345u, 999u } ) {
+        for( float accuracy : { 1.0f, 2.5f, 6.0f } ) {
+            rng_set_engine_seed( seed );
+            std::fprintf( out, "%s\n{\"seed\":%u,\"accuracy\":%.6f,\"rolls\":[",
+                          first ? "" : ",", seed, static_cast<double>( accuracy ) );
+            for( int i = 0; i < 4; i++ ) {
+                std::fprintf( out, "%s%.6f", i == 0 ? "" : ",",
+                              static_cast<double>( melee::melee_hit_range( accuracy ) ) );
+            }
+            std::fprintf( out, "]}" );
+            first = false;
+        }
+    }
+    std::fprintf( out, "]}\n" );
+    std::fclose( out );
+}
