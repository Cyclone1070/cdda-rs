+void dump_mutations( const std::string &path )
+{
+    std::ofstream out( path );
+    if( !out.is_open() ) {
+        return;
+    }
+    // Every mutation the data defines, with the four sets that decide whether it can be gained and what it replaces. Asked of the loaded prototype rather than of
+    // the JSON, so the answer is the one the game works from.
+    out << "{\"mutations\":[";
+    bool first = true;
+    for( const mutation_branch &branch : mutation_branch::get_all() ) {
+        // Every branch, including the ones the data marks invalid: a threshold is `valid: false` and is named by other mutations' `threshreq`, so a dump that dropped
+        // them would leave those lists pointing at nothing.
+        if( !first ) {
+            out << ",";
+        }
+        first = false;
+        out << "{\"id\":\"" << branch.id.str() << "\",\"valid\":" << ( branch.valid ? "true" : "false" ) << ",\"points\":" << branch.points << ",\"visibility\":" << branch.visibility
+            << ",\"purifiable\":" << ( branch.purifiable ? "true" : "false" )
+            << ",\"startingtrait\":" << ( branch.startingtrait ? "true" : "false" )
+            << ",\"threshold\":" << ( branch.threshold ? "true" : "false" ) << ",\"prereqs\":[";
+        bool first_in = true;
+        for( const trait_id &need : branch.prereqs ) {
+            out << ( first_in ? "" : "," ) << "\"" << need.str() << "\"";
+            first_in = false;
+        }
+        out << "],\"threshreq\":[";
+        first_in = true;
+        for( const trait_id &need : branch.threshreq ) {
+            out << ( first_in ? "" : "," ) << "\"" << need.str() << "\"";
+            first_in = false;
+        }
+        out << "],\"prereqs2\":[";
+        first_in = true;
+        for( const trait_id &need : branch.prereqs2 ) {
+            out << ( first_in ? "" : "," ) << "\"" << need.str() << "\"";
+            first_in = false;
+        }
+        // **What switching it on costs and what switching it on does** (`mutation.h:205-290`, `mutation.cpp:821-880`): `u_activate_trait` reaches
+        // `Character::activate_mutation`, which charges one of the four costs the data names, starts a cooldown, and runs the mutation's own activation
+        // programs. None of it was in the dump, so the port could not carry out the effect at all.
+        out << "],\"starts_active\":" << ( branch.starts_active ? "true" : "false" )
+            << ",\"cost\":" << branch.cost
+            << ",\"cooldown_turns\":" << to_turns<int>( branch.cooldown )
+            << ",\"hunger\":" << ( branch.hunger ? "true" : "false" )
+            << ",\"thirst\":" << ( branch.thirst ? "true" : "false" )
+            << ",\"sleepiness\":" << ( branch.sleepiness ? "true" : "false" )
+            << ",\"mana\":" << ( branch.mana ? "true" : "false" )
+            << ",\"activated_eocs\":[";
+        first_in = true;
+        for( const effect_on_condition_id &id : branch.activated_eocs ) {
+            out << ( first_in ? "" : "," ) << "\"" << id.str() << "\"";
+            first_in = false;
+        }
+        out << "],\"deactivated_eocs\":[";
+        first_in = true;
+        for( const effect_on_condition_id &id : branch.deactivated_eocs ) {
+            out << ( first_in ? "" : "," ) << "\"" << id.str() << "\"";
+            first_in = false;
+        }
+        out << "],\"enchantments\":[";
+        first_in = true;
+        for( const enchantment_id &id : branch.enchantments ) {
+            out << ( first_in ? "" : "," ) << "\"" << id.str() << "\"";
+            first_in = false;
+        }
+        // The values of those enchantments, followed to the objects themselves: an enchantment is loaded through a factory that is not exported, so the only way to reach
+        // one is from what carries it. `constant()` answers the plain numbers the data uses; an expression would read as zero here and is dumped as such.
+        out << "],\"vitamin_cost\":" << branch.vitamin_cost << ",\"enchant_values\":[";
+        bool first_value = true;
+        for( const enchantment_id &id : branch.enchantments ) {
+            for( const auto &entry : id->values_add ) {
+                out << ( first_value ? "" : "," ) << "{\"value\":\"" << io::enum_to_string<enchant_vals::mod>( entry.first )
+                    << "\",\"add\":" << entry.second.constant() << ",\"multiply\":0}";
+                first_value = false;
+            }
+            for( const auto &entry : id->values_multiply ) {
+                out << ( first_value ? "" : "," ) << "{\"value\":\"" << io::enum_to_string<enchant_vals::mod>( entry.first )
+                    << "\",\"add\":0,\"multiply\":" << entry.second.constant() << "}";
+                first_value = false;
+            }
+        }
+        out << "],\"cancels\":[";
+        first_in = true;
+        for( const trait_id &need : branch.cancels ) {
+            out << ( first_in ? "" : "," ) << "\"" << need.str() << "\"";
+            first_in = false;
+        }
+        out << "],\"category\":[";
+        first_in = true;
+        for( const std::string &cat : branch.types ) {
+            out << ( first_in ? "" : "," ) << "\"" << cat << "\"";
+            first_in = false;
+        }
+        out << "]}";
+    }
+    out << "]}" << std::endl;
+}
