+void dump_weather_order( const std::string &path )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+    const weather_generator &generator = get_weather().get_cur_weather_gen();
+    // **Both orders, in one file**: the registry's own order and the sorted one the game tests against. The sort is stable, so the registry order is what decides
+    // every tie - `mist` and `fog` share priority 15 and the game keeps them in the order the data declares - and a test that only had the sorted list would
+    // have no way to tell a stable sort from a lucky one.
+    std::fprintf( out, "{\"harness\":\"weather_order\",\"version\":1,\"registry\":[\n" );
+    bool first_registry = true;
+    for( const weather_type &type : weather_types::get_all() ) {
+        std::fprintf( out, "%s{\"id\":\"%s\",\"priority\":%d,\"required\":[", first_registry ? "" : ",\n",
+                      harness::harness_escape( type.id.str() ).c_str(), type.priority );
+        bool first_required = true;
+        for( const weather_type_id &required : type.required_weathers ) {
+            std::fprintf( out, "%s\"%s\"", first_required ? "" : ",",
+                          harness::harness_escape( required.str() ).c_str() );
+            first_required = false;
+        }
+        std::fprintf( out, "]}" );
+        first_registry = false;
+    }
+    std::fprintf( out, "\n],\"order\":[\n" );
+    bool first = true;
+    for( const weather_type_id &id : generator.sorted_weather ) {
+        std::fprintf( out, "%s{\"id\":\"%s\",\"priority\":%d,\"required\":[", first ? "" : ",\n",
+                      harness::harness_escape( id.str() ).c_str(), id->priority );
+        bool first_required = true;
+        for( const weather_type_id &required : id->required_weathers ) {
+            std::fprintf( out, "%s\"%s\"", first_required ? "" : ",",
+                          harness::harness_escape( required.str() ).c_str() );
+            first_required = false;
+        }
+        std::fprintf( out, "]}" );
+        first = false;
+    }
+    std::fprintf( out, "\n]}\n" );
+    std::fclose( out );
+}
