+/// Every ammunition's own blow: `--dump-ammo`.
+///
+/// Reference: `islot_ammo::shot_damage`, `count` and `shot_spread` (`itype.h:1090-1101`), which `item::gun_damage( true )` adds to a gun's own damage when a shot is fired. **This is where a
+/// firearm's damage actually lives**: the gun table's own `damage` is zero for every firearm, so a port that read the gun alone would fire blanks. `count` is the pellets a single round puts in
+/// the air, and `shot_spread` is the angle between them.
+/// The ammunition type a round belongs to, as the reference states it (`islot_ammo::type`, `itype.h:1063` - **one** type a round, not a set).
+///
+/// The round ids and the ammunition types are **different namespaces**: a pipe shotgun takes `"shot"`, and the rounds it can fire are `shot_bird`, `shot_00` and the rest. A port that
+/// assumed the two agreed would work for `223` and fail for every shotgun.
+static std::string harness_ammo_type( const islot_ammo &ammo )
+{
+    return ammo.type.str();
+}
+
+/// How many shots a gun's default firing mode makes: `islot_gun::modes` (`itype.h:826`) holds at least a `DEFAULT` entry, and its `qty` is the burst size a trigger pull makes
+/// (`item::burst_size`, `item.cpp:11640-11650`). A gun whose data states no mode at all answers **one**, which is what a single-shot weapon is.
+static int harness_burst( const islot_gun &gun )
+{
+    const auto found = gun.modes.find( gun_mode_id( "DEFAULT" ) );
+    if( found == gun.modes.end() ) {
+        return 1;
+    }
+    return std::max( found->second.qty(), 1 );
+}
+
+/// A round's ammunition effects, comma separated: `islot_ammo::ammo_effects` (`itype.h:1100`), the set `item::ammo_effects` folds into a gun's own (`item.cpp:11963-11979`).
+///
+/// These are the flags that change what a shot does to the *world* rather than to its target: `BLACKPOWDER` fouls a gun far faster, `NON_FOULING` not at all, `INCENDIARY` sets fires,
+/// `FLARE` lights the way. The port reads them by name rather than as a bitmask, because the data names them.
+static std::string harness_effects( const std::set<ammo_effect_str_id> &effects )
+{
+    std::string joined;
+    for( const auto &effect : effects ) {
+        if( !joined.empty() ) {
+            joined += ",";
+        }
+        joined += effect.str();
+    }
+    return joined;
+}
+
+void dump_ammo( const std::string &path )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+    std::fprintf( out, "{\"harness\":\"ammo\",\"version\":5,\n\"ammo\":[\n" );
+    bool first = true;
+    for( const itype *type : item_controller->all() ) {
+        if( type == nullptr || !type->ammo ) {
+            continue;
+        }
+        double dam_total = 0.0;
+        int dam_bash = 0;
+        int dam_cut = 0;
+        int dam_stab = 0;
+        int dam_bullet = 0;
+        // A round's blow is `ammo->damage`, not `shot_damage`: the second is the **per-pellet** figure that `item_factory.cpp:527-532` patches only for shot, and reading it for a rifle round
+        // reports zero for every cartridge the port cares about. The two are dumped side by side so the difference is visible rather than inferred.
+        for( const damage_unit &unit : type->ammo->damage.damage_units ) {
+            dam_total += unit.amount;
+            const std::string &kind = unit.type.str();
+            if( kind == "bash" ) {
+                dam_bash += static_cast<int>( unit.amount );
+            } else if( kind == "cut" ) {
+                dam_cut += static_cast<int>( unit.amount );
+            } else if( kind == "stab" ) {
+                dam_stab += static_cast<int>( unit.amount );
+            } else if( kind == "bullet" ) {
+                dam_bullet += static_cast<int>( unit.amount );
+            }
+        }
+        std::fprintf( out, "%s\n{\"id\":\"%s\",\"damage\":%.6g,\"damage_bash\":%d,\"damage_cut\":%d,\"damage_stab\":%d,"
+                      "\"damage_bullet\":%d,\"count\":%d,\"shot_spread\":%d,\"recovery_chance\":%d,\"shot_damage\":%.6g,\"recoil\":%d,\"ammo_types\":\"%s\",\"loudness\":%d,\"effects\":\"%s\"}",
+                      first ? "" : ",",
+                      harness_escape( type->get_id().str() ).c_str(),
+                      dam_total, dam_bash, dam_cut, dam_stab, dam_bullet,
+                      type->ammo->count,
+                      type->ammo->shot_spread,
+                      type->ammo->recovery_chance,
+                      static_cast<double>( type->ammo->shot_damage.total_damage() ),
+                      type->ammo->recoil,
+                      harness_ammo_type( *type->ammo ).c_str(),
+                      type->ammo->loudness,
+                      harness_effects( type->ammo->ammo_effects ).c_str() );
+        first = false;
+    }
+    std::fprintf( out, "\n]}\n" );
+    std::fclose( out );
+}
