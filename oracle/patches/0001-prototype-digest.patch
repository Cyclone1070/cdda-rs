+
+/// What actually happens when a square is bashed.
+///
+/// Reference: `map::bash_ter_furn` (`src/map.cpp:3932-4245`) reached through `map::bash`'s own sequence. The roll is passed in, not drawn, because `bash()` takes it from the
+/// global rng (`map.cpp:4245`) and every answer would then depend on how many draws came before it.
+///
+/// The fixtures avoid the two things this dump does not want to model: terrain that supports a roof (destroying one outdoors calls `collapse_at`) and blocks with an
+/// `explosive` charge. What remains is the decision itself — whether the hit breaks anything, how much damage a failed hit leaves behind, and what the square becomes.
+void dump_bash( const std::string &path )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+    map &here = get_map();
+    struct fixture {
+        const char *ter;
+        const char *furn;
+        int str_min;
+    };
+    // `t_floor` is flagged INDOORS, which is what keeps its destruction from calling `collapse_at`; the rest carry no `SUPPORTS_ROOF` at all.
+    const fixture fixtures[] = {
+        { "t_floor", "f_null", 50 },
+        { "t_grass", "f_null", 50 },
+        { "t_pavement", "f_null", 50 },
+        { "t_chainfence", "f_null", 10 },
+        { "t_floor", "f_table", 12 },
+        { "t_floor", "f_bookcase", 6 },
+        { "t_floor", "f_chair", 6 },
+        { "t_floor", "f_counter", 12 },
+    };
+    struct hit_params {
+        int str;
+        float roll;
+        bool destroy;
+        bool bash_floor;
+        int times;
+    };
+    std::fprintf( out, "{\"harness\":\"bash_hits\",\"version\":1,\"hits\":[\n" );
+    bool first = true;
+    for( std::size_t f = 0; f < std::size( fixtures ); f++ ) {
+        const fixture &one = fixtures[f];
+        std::vector<hit_params> cases = {
+            { 1, 0.5f, false, false, 1 },
+            { 10, 0.5f, false, false, 1 },
+            { 60, 0.5f, false, false, 1 },
+            { one.str_min + 1, 0.0f, false, false, 1 },
+            { one.str_min + 1, 1.0f, false, false, 1 },
+            { 999, 0.5f, false, false, 1 },
+            { 999, 0.5f, true, false, 1 },
+            // The same hit five times: a failed bash that exceeds `str_min` adds at least one point of damage to the square, and the damage is what makes the next hit
+            // easier - which is the only state `bash` carries between calls.
+            { one.str_min + 1, 0.5f, false, false, 5 },
+        };
+        if( std::string( one.ter ) == "t_grass" ) {
+            // A floor that can be bashed **below**: without `bash_floor` it is not the tile that gets bashed at all.
+            cases.push_back( { 999, 0.5f, true, true, 1 } );
+        }
+        for( std::size_t k = 0; k < cases.size(); k++ ) {
+            const hit_params &hit = cases[k];
+            // **Bubble coordinates**, and the ids resolved as **string ids**: `ter_id( "t_floor" )` is the legacy integer registry and yields `t_null` for a terrain that only
+            // has a string id, which is how the first recording came out with every square reported as `t_null`.
+            // **`pos_bub()` carries an absolute coordinate**, so subtracting from it lands outside the map and every write is silently dropped. The fixture is built in
+            // absolute coordinates and converted once, which is what `get_bub` is for.
+            const tripoint_abs_ms where = get_avatar().pos_abs() +
+                                          tripoint_rel_ms( static_cast<int>( k ) - 4, static_cast<int>( f ) - 4, 0 );
+            const tripoint_bub_ms p = here.get_bub( where );
+            // **The square below is part of the fixture.** A floor's strength depends on whether the tile under it supports a roof, and the terrain a destroyed square becomes
+            // depends on it too — so leaving it to be "whatever the world had there" would make the dump a recording of the seed rather than of the rule.
+            here.ter_set( p + tripoint_rel_ms::below, ter_str_id( "t_rock_floor" ) );
+            here.ter_set( p, ter_str_id( one.ter ) );
+            here.furn_set( p, furn_str_id( one.furn ) );
+            here.i_clear( p );
+            here.set_map_damage( p, 0 );
+            const std::string below_before = here.ter( p + tripoint_rel_ms::below ).id().str();
+            for( int step = 0; step < hit.times; step++ ) {
+                bash_params params{};
+                params.strength = hit.str;
+                params.silent = true;
+                params.destroy = hit.destroy;
+                params.bash_floor = hit.bash_floor;
+                params.roll = hit.roll;
+                const bash_params result = here.harness_bash( p, params );
+                std::fprintf( out,
+                              "%s{\"ter\":\"%s\",\"furn\":\"%s\",\"x\":%d,\"y\":%d,\"str\":%d,\"roll\":%.3f,"
+                              "\"destroy\":%s,\"bash_floor\":%s,\"step\":%d,"
+                              "\"below\":\"%s\",\"below_before\":\"%s\",\"ter_after\":\"%s\",\"furn_after\":\"%s\",\"damage\":%d,"
+                              "\"did_bash\":%s,\"success\":%s,\"bashed_solid\":%s,\"items\":%d}",
+                              first ? "" : ",\n", one.ter, one.furn, static_cast<int>( k ), static_cast<int>( f ),
+                              hit.str, static_cast<double>( hit.roll ),
+                              hit.destroy ? "true" : "false", hit.bash_floor ? "true" : "false", step,
+                              harness::harness_escape( here.ter( p + tripoint_rel_ms::below ).id().str() ).c_str(),
+                              harness::harness_escape( below_before ).c_str(),
+                              harness::harness_escape( here.ter( p ).id().str() ).c_str(),
+                              harness::harness_escape( here.furn( p ).id().str() ).c_str(),
+                              here.get_map_damage( p ),
+                              result.did_bash ? "true" : "false", result.success ? "true" : "false",
+                              result.bashed_solid ? "true" : "false",
+                              static_cast<int>( here.i_at( p ).size() ) );
+                first = false;
+            }
+            // A square that keeps what it was bashed into would poison the next case, so it is put back.
+            here.ter_set( p, ter_str_id( one.ter ) );
+            here.furn_set( p, furn_str_id( one.furn ) );
+            here.i_clear( p );
+            here.set_map_damage( p, 0 );
+        }
+    }
+    std::fprintf( out, "\n]}\n" );
+    std::fclose( out );
+}
