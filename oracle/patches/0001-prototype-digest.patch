+/// The cells a line walks, in three dimensions.
+///
+/// `line_to` (`src/line.cpp:241-257`) is `bresenham`'s nine-branch walk over `tripoint`s, and its branches are chosen by which of the three axis distances is largest and
+/// which are equal - so a sample that misses a branch proves nothing about that branch. The table below names one endpoint pair per branch, then repeats a few of them with
+/// different starting error terms, because `t` and `t2` decide which neighbour is taken first when the walk is exactly on a tie.
+void dump_line( const std::string &path )
+{
+    struct case_t {
+        tripoint from;
+        tripoint to;
+        int t;
+        int t2;
+        const char *branch;
+    };
+    const std::vector<case_t> cases = {
+        // a.z == 0 and a.x == a.y: an exact diagonal on one level.
+        { tripoint( 10, 10, 0 ), tripoint( 14, 14, 0 ), 0, 0, "flat-diagonal" },
+        // a.z == 0 and a.x > a.y.
+        { tripoint( 10, 10, 0 ), tripoint( 16, 12, 0 ), 0, 0, "flat-x" },
+        // a.z == 0 and a.y > a.x.
+        { tripoint( 10, 10, 0 ), tripoint( 12, 16, 0 ), 0, 0, "flat-y" },
+        // a.x == a.y == a.z: the perfect three-dimensional diagonal.
+        { tripoint( 5, 5, 0 ), tripoint( 9, 9, 4 ), 0, 0, "diagonal-3d" },
+        // a.z is the largest.
+        { tripoint( 5, 5, 0 ), tripoint( 6, 7, 9 ), 0, 0, "z-dominant" },
+        // a.x == a.y with a smaller a.z.
+        { tripoint( 5, 5, 0 ), tripoint( 9, 9, 3 ), 0, 0, "xy-equal" },
+        // a.x == a.z.
+        { tripoint( 5, 5, 0 ), tripoint( 9, 6, 4 ), 0, 0, "xz-equal" },
+        // a.y == a.z.
+        { tripoint( 5, 5, 0 ), tripoint( 6, 9, 4 ), 0, 0, "yz-equal" },
+        // a.x is the largest, with a smaller a.z (the last branch: dy > dx >= dz is the mirror).
+        { tripoint( 5, 5, 0 ), tripoint( 12, 9, 2 ), 0, 0, "x-dominant" },
+        { tripoint( 5, 5, 0 ), tripoint( 8, 12, 2 ), 0, 0, "y-dominant" },
+        // The same pairs with error terms that are not zero, and with both signs, because a tie is settled by them.
+        { tripoint( 10, 10, 0 ), tripoint( 14, 14, 0 ), 2, 0, "flat-diagonal" },
+        { tripoint( 10, 10, 0 ), tripoint( 14, 14, 0 ), -2, 0, "flat-diagonal" },
+        { tripoint( 10, 10, 0 ), tripoint( 16, 12, 0 ), 3, 0, "flat-x" },
+        { tripoint( 10, 10, 0 ), tripoint( 16, 12, 0 ), -3, 0, "flat-x" },
+        { tripoint( 10, 10, 0 ), tripoint( 12, 16, 0 ), 2, -1, "flat-y" },
+        { tripoint( 5, 5, 0 ), tripoint( 6, 7, 9 ), 2, -2, "z-dominant" },
+        { tripoint( 5, 5, 0 ), tripoint( 12, 9, 2 ), -1, 1, "x-dominant" },
+        { tripoint( 5, 5, 0 ), tripoint( 8, 12, 2 ), 1, -1, "y-dominant" },
+        // A line that goes nowhere at all: one cell, and it is the origin.
+        { tripoint( 7, 7, 0 ), tripoint( 7, 7, 0 ), 0, 0, "empty" },
+        // Downward and negative coordinates, so the signs are exercised too.
+        { tripoint( -3, 4, 2 ), tripoint( -7, -4, -3 ), 0, 0, "z-dominant" },
+    };
+
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+    std::fprintf( out, "{\"harness\":\"line\",\"version\":1,\"cases\":[" );
+    bool first_case = true;
+    for( const case_t &c : cases ) {
+        const std::vector<tripoint> cells = line_to( c.from, c.to, c.t, c.t2 );
+        std::fprintf( out,
+                      "%s{\"branch\":\"%s\",\"from\":[%d,%d,%d],\"to\":[%d,%d,%d],\"t\":%d,\"t2\":%d,\"cells\":[",
+                      first_case ? "" : ",", c.branch, c.from.x, c.from.y, c.from.z, c.to.x, c.to.y, c.to.z, c.t, c.t2 );
+        for( std::size_t i = 0; i < cells.size(); i++ ) {
+            std::fprintf( out, "%s[%d,%d,%d]", i == 0 ? "" : ",", cells[i].x, cells[i].y, cells[i].z );
+        }
+        std::fprintf( out, "]}" );
+        first_case = false;
+    }
+    std::fprintf( out, "]}\n" );
+    std::fclose( out );
+}
