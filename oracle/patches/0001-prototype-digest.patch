+void dump_constructions( const std::string &path )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+    std::fprintf( out, "{\"harness\":\"constructions\",\"version\":1,\n\"constructions\":[\n" );
+    bool first = true;
+    for( const construction &built : get_constructions() ) {
+        std::fprintf( out,
+                      "%s{\"id\":\"%s\",\"group\":\"%s\",\"category\":\"%s\",\"time\":%d,"
+                      "\"post_terrain\":\"%s\",\"pre_terrain\":[",
+                      first ? "" : ",\n",
+                      harness_escape( built.id.id().str() ).c_str(),
+                      harness_escape( built.group.str() ).c_str(),
+                      harness_escape( built.category.str() ).c_str(),
+                      built.time,
+                      harness_escape( built.post_terrain ).c_str() );
+        bool first_pre = true;
+        for( const std::string &pre : built.pre_terrain ) {
+            std::fprintf( out, "%s\"%s\"", first_pre ? "" : ",", harness_escape( pre ).c_str() );
+            first_pre = false;
+        }
+        std::fprintf( out, "],\"skills\":[" );
+        bool first_skill = true;
+        for( const std::pair<const skill_id, int> &skill : built.required_skills ) {
+            std::fprintf( out, "%s[\"%s\",%d]", first_skill ? "" : ",",
+                          harness_escape( skill.first.str() ).c_str(), skill.second );
+            first_skill = false;
+        }
+        std::fprintf( out, "],\"requirements\":\"%s\",\"using\":[",
+                      harness_escape( built.requirements.str() ).c_str() );
+        bool first_using = true;
+        for( const std::pair<requirement_id, int> &req : built.reqs_using ) {
+            std::fprintf( out, "%s[\"%s\",%d]", first_using ? "" : ",",
+                          harness_escape( req.first.str() ).c_str(), req.second );
+            first_using = false;
+        }
+        // **What it takes**, resolved through the reference's own requirement group: every alternative of every component, the tools, and the qualities. The group is
+        // where `using` and the inline `components`/`qualities` members end up (`src/construction.cpp:2221`), so this is the answer a crafter is judged against.
+        const requirement_data &needs = *built.requirements;
+        std::fprintf( out, "],\"components\":[" );
+        bool first_group = true;
+        for( const std::vector<item_comp> &group : needs.get_components() ) {
+            std::fprintf( out, "%s[", first_group ? "" : "," );
+            bool first_alternative = true;
+            for( const item_comp &one : group ) {
+                std::fprintf( out, "%s[\"%s\",%d]", first_alternative ? "" : ",",
+                              harness_escape( one.type.str() ).c_str(), one.count );
+                first_alternative = false;
+            }
+            std::fprintf( out, "]" );
+            first_group = false;
+        }
+        std::fprintf( out, "],\"tools\":[" );
+        first_group = true;
+        for( const std::vector<tool_comp> &group : needs.get_tools() ) {
+            std::fprintf( out, "%s[", first_group ? "" : "," );
+            bool first_alternative = true;
+            for( const tool_comp &one : group ) {
+                std::fprintf( out, "%s[\"%s\",%d]", first_alternative ? "" : ",",
+                              harness_escape( one.type.str() ).c_str(), one.count );
+                first_alternative = false;
+            }
+            std::fprintf( out, "]" );
+            first_group = false;
+        }
+        std::fprintf( out, "],\"qualities\":[" );
+        first_group = true;
+        for( const std::vector<quality_requirement> &group : needs.get_qualities() ) {
+            std::fprintf( out, "%s[", first_group ? "" : "," );
+            bool first_alternative = true;
+            for( const quality_requirement &one : group ) {
+                std::fprintf( out, "%s[\"%s\",%d,%d]", first_alternative ? "" : ",",
+                              harness_escape( one.type.str() ).c_str(), one.level, one.count );
+                first_alternative = false;
+            }
+            std::fprintf( out, "]" );
+            first_group = false;
+        }
+        std::fprintf( out, "],\"pre_note\":\"%s\",\"vehicle_start\":%s}",
+                      harness_escape( built.pre_note.translated() ).c_str(),
+                      built.vehicle_start ? "true" : "false" );
+        first = false;
+    }
+    std::fprintf( out, "\n]}\n" );
+    std::fclose( out );
+}
