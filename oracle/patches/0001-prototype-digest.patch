+/// Every construction the game defines: what it builds, what it takes and how long it takes.
+///
+/// Reference: `construction` (`src/construction.h:44-90`). The port needs the parts that decide behaviour - the **result** (`post_terrain`), the tile it applies to
+/// (`pre_terrain`), the time in moves, the required skills and the requirement group it draws its components and tools from - and the parts a player sees: its group and
+/// category. The special functions are named here as strings, which is the only thing the port can carry today: they are C function pointers in the reference.
+void dump_build_check( const std::string &path )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+    // **Four inventories that separate the three ways a build can fail.** One has no tools, one has no components, one has both and the last has neither, so a
+    // construction whose answer is the same everywhere is not evidence of anything and the gate can say which of the three checks decided each row.
+    struct scenario {
+        const char *name;
+        std::vector<std::pair<const char *, int>> items;
+    };
+    const std::vector<scenario> scenarios = {
+        { "empty", {} },
+        {
+            "tools_only", {
+                { "hammer", 1 }, { "saw", 1 }, { "crowbar", 1 }, { "wrench", 1 },
+                { "screwdriver", 1 }, { "hacksaw", 1 }, { "shovel", 1 }, { "paint_brush", 1 },
+            }
+        },
+        {
+            "materials_only", {
+                { "2x4", 40 }, { "nail", 400 }, { "duct_tape", 20 }, { "sheet_metal", 12 },
+                { "pipe", 8 }, { "rope_6", 6 }, { "brick", 60 }, { "mortar_build", 4 },
+                { "water", 6 }, { "log", 6 }, { "wood_panel", 8 }, { "long_pole", 4 },
+            }
+        },
+        {
+            // **A kit that only a charge count can refuse.** Nothing here is missing except the grinder's charges, which are more than the two hundred one
+            // dismantling wants - and more is enough, because the reference's `charges_of` is asked with a limit and comes back clamped to it.
+            "grinder", {
+                { "angle_grinder", 400 }, { "hammer", 1 }, { "chisel", 1 }, { "crowbar", 1 }, { "shovel", 1 },
+            }
+        },
+        {
+            // **Tools that spend charges**, which is the branch a kit of hammers cannot reach: a positive count in a tool group is a number of charges and the kit
+            // must hold exactly that many, not at least that many.
+            "charged", {
+                { "welder", 100 }, { "angle_grinder", 100 }, { "oxy_torch", 20 }, { "soldering_iron", 50 },
+                { "2x4", 40 }, { "nail", 400 }, { "sheet_metal", 12 }, { "pipe", 8 }, { "scrap", 20 },
+                { "steel_lump", 6 }, { "rope_6", 6 }, { "hammer", 1 },
+            }
+        },
+        {
+            // **Everything at once**, so that a construction which is only held back by a charge count comes out true and the charge rule decides something.
+            "stocked", {
+                { "hammer", 1 }, { "saw", 1 }, { "crowbar", 1 }, { "wrench", 1 },
+                { "screwdriver", 1 }, { "hacksaw", 1 }, { "shovel", 1 }, { "paint_brush", 1 },
+                { "welder", 400 }, { "angle_grinder", 400 }, { "oxy_torch", 200 }, { "soldering_iron", 200 },
+                { "2x4", 40 }, { "nail", 400 }, { "duct_tape", 20 }, { "sheet_metal", 12 },
+                { "pipe", 8 }, { "rope_6", 6 }, { "brick", 60 }, { "mortar_build", 4 },
+                { "water", 6 }, { "log", 6 }, { "wood_panel", 8 }, { "long_pole", 4 },
+                { "scrap", 20 }, { "steel_lump", 6 }, { "wire", 20 }, { "cable", 10 },
+            }
+        },
+        {
+            "workshop", {
+                { "hammer", 1 }, { "saw", 1 }, { "crowbar", 1 }, { "wrench", 1 },
+                { "screwdriver", 1 }, { "hacksaw", 1 }, { "shovel", 1 }, { "paint_brush", 1 },
+                { "2x4", 40 }, { "nail", 400 }, { "duct_tape", 20 }, { "sheet_metal", 12 },
+                { "pipe", 8 }, { "rope_6", 6 }, { "brick", 60 }, { "mortar_build", 4 },
+                { "water", 6 }, { "log", 6 }, { "wood_panel", 8 }, { "long_pole", 4 },
+            }
+        },
+    };
+    std::fprintf( out, "{\"harness\":\"build-check\",\"version\":1,\n\"inventories\":[" );
+    bool first_scenario = true;
+    for( const scenario &one : scenarios ) {
+        std::fprintf( out, "%s{\"name\":\"%s\",\"items\":[", first_scenario ? "" : ",", one.name );
+        bool first_item = true;
+        for( const auto &entry : one.items ) {
+            std::fprintf( out, "%s[\"%s\",%d]", first_item ? "" : ",", entry.first, entry.second );
+            first_item = false;
+        }
+        std::fprintf( out, "]}" );
+        first_scenario = false;
+    }
+    // **What the kit itself says**, so a wrong answer can be told apart from a wrong question: how many hammers there are, how many charges of nails, and whether the
+    // quality the woodwork needs is seen.
+    std::fprintf( out, "],\n\"probe\":[\n" );
+    bool first_probe = true;
+    for( const scenario &one : scenarios ) {
+        inventory kit;
+        for( const auto &entry : one.items ) {
+            // **A count is items or charges, and which one depends on the item.** `item( id, turn, n )` makes a single item whose count is `n`, which is the number
+            // of charges for an item counted by charge and merely a number for anything else - so a kit of forty planks is forty `add_item` calls, not one.
+            const item proto( itype_id( entry.first ), calendar::turn, entry.second );
+            if( proto.count_by_charges() ) {
+                kit.add_item( proto );
+            } else {
+                for( int i = 0; i < entry.second; ++i ) {
+                    kit.add_item( item( itype_id( entry.first ), calendar::turn ) );
+                }
+            }
+        }
+        std::fprintf( out,
+                      "%s{\"inventory\":\"%s\",\"hammer\":%d,\"saw\":%d,\"nail\":%d,\"rope_6\":%d,"
+                      "\"hammer_quality\":%s,\"saw_quality\":%s,\"has_rope\":%d}",
+                      first_probe ? "" : ",\n", one.name,
+                      kit.amount_of( itype_id( "hammer" ) ), kit.amount_of( itype_id( "saw" ) ),
+                      kit.charges_of( itype_id( "nail" ) ), kit.charges_of( itype_id( "rope_6" ) ),
+                      kit.has_quality( quality_id( "HAMMER" ), 1, 1 ) ? "true" : "false",
+                      kit.has_quality( quality_id( "SAW_W" ), 2, 1 ) ? "true" : "false",
+                      kit.has_components( itype_id( "rope_6" ), 2, is_crafting_component ) ? 1 : 0 );
+        first_probe = false;
+    }
+    std::fprintf( out, "],\n\"rows\":[\n" );
+    bool first_row = true;
+    for( const scenario &one : scenarios ) {
+        inventory kit;
+        for( const auto &entry : one.items ) {
+            // **A count is items or charges, and which one depends on the item.** `item( id, turn, n )` makes a single item whose count is `n`, which is the number
+            // of charges for an item counted by charge and merely a number for anything else - so a kit of forty planks is forty `add_item` calls, not one.
+            const item proto( itype_id( entry.first ), calendar::turn, entry.second );
+            if( proto.count_by_charges() ) {
+                kit.add_item( proto );
+            } else {
+                for( int i = 0; i < entry.second; ++i ) {
+                    kit.add_item( item( itype_id( entry.first ), calendar::turn ) );
+                }
+            }
+        }
+        for( const construction &built : get_constructions() ) {
+            const bool ok = built.requirements->can_make_with_inventory( kit, is_crafting_component );
+            std::fprintf( out, "%s{\"construction\":\"%s\",\"inventory\":\"%s\",\"ok\":%s}",
+                          first_row ? "" : ",\n", harness_escape( built.id.id().str() ).c_str(), one.name,
+                          ok ? "true" : "false" );
+            first_row = false;
+        }
+    }
+    std::fprintf( out, "\n]}\n" );
+    std::fclose( out );
+}
