+/// Every terrain's and furniture's examine action, with the actor's data resolved.
+///
+/// Reference: `map_data_common_t::examine_func` and `examine_actor` (`src/mapdata.h:500-505`). The JSON's `"examine_action"` fills one or the other: a **bare name**
+/// becomes a hardcoded function (`iexamine_functions_from_string`), and an **object** becomes an `iexamine_actor` that carries data. 73 names are spelled as bare
+/// names in the content and 4 as objects.
+///
+/// The bare name is recovered by **pointer identity**: the reference keeps no name beside its function pointer, so the table is walked and the entry whose
+/// function matches is the answer. That is exact rather than a guess, because `iexamine_functions_from_string` hands back the same pointer for the same name.
+void dump_examine_actions( const std::string &path )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+    std::fprintf( out, "{\"harness\":\"examine-actions\",\"version\":1,\n\"tiles\":[\n" );
+    bool first = true;
+    int count = 0;
+    std::string name;
+    auto name_of = [&]( const map_data_common_t & tile ) -> std::string {
+        if( tile.harness_examine_actor() ) {
+            return tile.harness_examine_actor()->type;
+        }
+        for( const std::pair<const std::string, iexamine_examine_function> &entry :
+             harness_examine_function_names() ) {
+            if( entry.second == tile.harness_examine_function() ) {
+                return entry.first;
+            }
+        }
+        return "";
+    };
+    auto walk = [&]( const auto &registry, const char *kind ) {
+        for( const auto *pointer : registry ) {
+            const map_data_common_t &tile = *pointer;
+            const std::string tile_id = pointer->id.str();
+            if( !tile.harness_examine_function() && !tile.harness_examine_actor() ) {
+                continue;
+            }
+            ++count;
+            std::fprintf( out, "%s{\"kind\":\"%s\",\"id\":\"%s\",\"action\":\"%s\",\"fields\":{",
+                          first ? "" : ",\n", kind, harness_escape( tile_id ).c_str(),
+                          harness_escape( name_of( tile ) ).c_str() );
+            bool wrote = false;
+            auto put_string = [&]( const char *key, const std::string &value ) {
+                std::fprintf( out, "%s\"%s\":\"%s\"", wrote ? "," : "", key,
+                              harness_escape( value ).c_str() );
+                wrote = true;
+            };
+            auto put_int = [&]( const char *key, long long value ) {
+                std::fprintf( out, "%s\"%s\":%lld", wrote ? "," : "", key, value );
+                wrote = true;
+            };
+            auto put_bool = [&]( const char *key, bool value ) {
+                std::fprintf( out, "%s\"%s\":%s", wrote ? "," : "", key, value ? "true" : "false" );
+                wrote = true;
+            };
+            ( void )put_string;
+            ( void )put_int;
+            ( void )put_bool;
+            std::fprintf( out, "}}" );
+            first = false;
+        }
+    };
+    walk( harness_all_terrains(), "ter" );
+    walk( harness_all_furniture(), "furn" );
+    std::fprintf( out, "\n],\"count\":%d}\n", count );
+    std::fclose( out );
+}
