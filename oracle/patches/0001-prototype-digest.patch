+void dump_noise( const std::string &path, int radius )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+    // The forest noise field, exactly as place_forests asks for it: the values, not the terrain they produce, so a
+    // port of the noise can be checked against the reference rather than against its own output.
+    const tripoint_abs_omt centre = project_to<coords::omt>( get_map().get_abs_sub() );
+    const overmap *om = overmap_buffer.get_existing( project_to<coords::om>( centre.xy() ) );
+    if( om == nullptr ) {
+        std::fprintf( out, "{\"harness\":\"noise\",\"version\":1,\"error\":\"no overmap\"}\n" );
+        std::fclose( out );
+        return;
+    }
+    const point_abs_omt base = om->global_base_point();
+    const om_noise::om_noise_layer_forest forest( base, g->get_seed() );
+    std::fprintf( out, "{\"harness\":\"noise\",\"version\":1,\"radius\":%d,\"centre\":[%d,%d],\"seed\":%u,\"rows\":[\n",
+                  radius, centre.x(), centre.y(), static_cast<unsigned>( g->get_seed() ) );
+    bool first = true;
+    for( int dy = -radius; dy <= radius; dy++ ) {
+        std::fprintf( out, "%s[", first ? "" : ",\n" );
+        for( int dx = -radius; dx <= radius; dx++ ) {
+            // The layer samples in overmap-local coordinates and converts to global itself, so the absolute point is
+            // shifted back to the overmap's own origin first.
+            const point_om_omt local( centre.x() + dx - base.x(), centre.y() + dy - base.y() );
+            std::fprintf( out, "%s%.6f", dx == -radius ? "" : ",", static_cast<double>( forest.noise_at( local ) ) );
+        }
+        std::fprintf( out, "]" );
+        first = false;
+    }
+    std::fprintf( out, "\n]}\n" );
+    std::fclose( out );
+}
+
+void dump_overmap( const std::string &path, int radius )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+    // The centre comes from the map's absolute position: in a headless start the avatar's overmap position reads
+    // as the origin, while the map knows where it really is.
+    const tripoint_abs_omt centre = project_to<coords::omt>( get_map().get_abs_sub() );
+    std::fprintf( out, "{\"harness\":\"overmap\",\"version\":1,\"radius\":%d,\"centre\":[%d,%d],\"rows\":[\n",
+                  radius, centre.x(), centre.y() );
+    bool first = true;
+    for( int dy = -radius; dy <= radius; dy++ ) {
+        std::string row;
+        for( int dx = -radius; dx <= radius; dx++ ) {
+            const tripoint_abs_omt p( centre.x() + dx, centre.y() + dy, centre.z() );
+            row += overmap_buffer.ter( p )->get_symbol( om_vision_level::full );
+        }
+        std::fprintf( out, "%s\"%s\"", first ? "" : ",\n", harness::harness_escape( row ).c_str() );
+        first = false;
+    }
+    std::fprintf( out, "\n]}\n" );
+    std::fclose( out );
+}
+
+void dump_frame( const std::string &path, int radius )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+    const avatar &u = get_avatar();
+    const tripoint_bub_ms centre = u.pos_bub();
+    map &here = get_map();
+    std::fprintf( out, "{\"harness\":\"frame\",\"version\":1,\"radius\":%d,\n", radius );
+    std::fprintf( out, "\"centre\":[%d,%d],\"squares\":[\n", centre.x(), centre.y() );
+    bool first = true;
+    for( int dy = -radius; dy <= radius; dy++ ) {
+        for( int dx = -radius; dx <= radius; dx++ ) {
+            const tripoint_bub_ms p( centre.x() + dx, centre.y() + dy, centre.z() );
+            const ter_t &terrain = here.ter( p ).obj();
+            const furn_t &furniture = here.furn( p ).obj();
+            // What a player sees is the terrain, or the furniture standing on it, or the item lying
+            // there, or the field - in that order, which is the order the interface draws them.
+            std::string glyph = utf32_to_utf8( terrain.symbol() );
+            if( !furniture.id.is_null() && furniture.symbol() != 0 ) {
+                glyph = furniture.symbol();
+            }
+            const map_stack items = here.i_at( p );
+            if( !items.empty() && !items.begin()->symbol().empty() ) {
+                glyph = items.begin()->symbol();
+            }
+            std::fprintf( out,
+                          "%s{\"x\":%d,\"y\":%d,\"glyph\":\"%s\",\"ter\":\"%s\","
+                          "\"furn\":\"%s\",\"items\":%d,\"light\":%.6f}",
+                          first ? "" : ",\n", p.x(), p.y(), harness_escape( glyph ).c_str(),
+                          harness_escape( terrain.id.str() ).c_str(),
+                          harness_escape( furniture.id.str() ).c_str(),
+                          static_cast<int>( items.size() ),
+                          static_cast<double>( here.ambient_light_at( p ) ) );
+            first = false;
+        }
+    }
+    std::fprintf( out, "\n]}\n" );
+    std::fclose( out );
+}
+
+void dump_state( const std::string &path )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+    const avatar &u = get_avatar();
+    const time_point now = calendar::turn;
+
+    cata_default_random_engine probe = rng_get_engine();
+    std::fprintf( out, "{\"harness\":\"state\",\"version\":1,\n" );
+    std::fprintf( out, "\"rng_next\":[" );
+    for( int i = 0; i < 4; i++ ) {
+        std::fprintf( out, "%s%llu", i == 0 ? "" : ",",
+                      static_cast<unsigned long long>( probe() ) );
+    }
+    std::fprintf( out, "],\n" );
+
+    std::fprintf( out,
+                  "\"turn\":%d,\"season\":%d,\"day_of_season\":%d,\"hour\":%d,\n",
+                  to_turn<int>( now ), static_cast<int>( season_of_year( now ) ),
+                  day_of_season<int>( now ), hour_of_day<int>( now ) );
+
+    const tripoint_abs_ms pos = u.pos_abs();
+    std::fprintf( out,
+                  "\"avatar\":{\"pos_abs\":[%d,%d,%d],\"str\":%d,\"dex\":%d,\"int\":%d,"
+                  "\"per\":%d,\"hp\":%d,\"moves\":%d},\n",
+                  pos.x(), pos.y(), pos.z(), u.str_max, u.dex_max, u.int_max, u.per_max,
+                  static_cast<int>( u.get_hp() ), static_cast<int>( u.get_moves() ) );
+
+    // The reality bubble, hashed tile by tile: terrain, furniture, and how many
+    // items lie on the square. This is the first digest that compares worlds
+    // rather than environments.
+    std::vector<std::string> rows;
+    const tripoint_bub_ms center = u.pos_bub();
+    for( const tripoint_bub_ms &p : g->harness_map().points_in_radius( center, 60 ) ) {
+        std::string row = string_format( "%d,%d,%d|%s|%s|%zu", p.x(), p.y(), p.z(),
+                                         g->harness_map().ter( p ).id().str(), g->harness_map().furn( p ).id().str(),
+                                         g->harness_map().i_at( p ).size() );
+        rows.push_back( std::move( row ) );
+    }
+    std::fprintf( out,
+                  "\"bubble\":{\"radius\":60,\"tiles\":%zu,\"digest\":\"%016llx\"},\n",
+                  rows.size(),
+                  static_cast<unsigned long long>( digest_strings( rows ) ) );
+
+    std::size_t creatures = 0;
+    for( Creature &critter : g->all_creatures() ) {
+        static_cast<void>( critter );
+        creatures++;
+    }
+    std::fprintf( out, "\"creatures\":%zu}\n", creatures );
+    std::fclose( out );
+}
+
+// The field sweep, run one turn at a time, with every field written out.
+//
+// This is the environment-only session the P2 exit gate asks for: a fire is placed on a square, the map's own
+// `process_fields` runs a turn at a time, and after each turn every field entry within the radius is written down
+// with its type, intensity and age. There are no creatures and no items in the session, so what the port has to
+// reproduce is exactly what the field processor does - nothing else can move.
+void dump_field_series( const std::string &path, const point &offset, int intensity, int turns,
+                        int radius, const point &items_at,
+                        const std::vector<std::pair<point, std::string>> &terrain,
+                        const std::vector<std::pair<point, std::string>> &furniture )
+{
+    const tripoint_bub_ms fire = get_avatar().pos_bub() + tripoint( offset, 0 );
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+    for( const std::pair<point, std::string> &change : terrain ) {
+        g->harness_map().ter_set( get_avatar().pos_bub() + tripoint( change.first, 0 ),
+                                  ter_id( change.second ) );
+    }
+    for( const std::pair<point, std::string> &change : furniture ) {
+        g->harness_map().furn_set( get_avatar().pos_bub() + tripoint( change.first, 0 ),
+                                   furn_id( change.second ) );
+    }
+    g->harness_map().add_field( fire, fd_fire, intensity, 0_turns, false );
+    // One flammable item, placed where a fixture wants a square to catch that the ground itself would refuse. A plank is the smallest thing certain to burn and
+    // needs nothing else to be true about the world.
+    if( items_at != point( INT_MIN, INT_MIN ) ) {
+        static const itype_id itype_2x4( "2x4" );
+        g->harness_map().add_item_or_charges( get_avatar().pos_bub() + tripoint( items_at, 0 ),
+                                              item( itype_2x4 ) );
+    }
+    // Where in the reference's dice stream the session begins. `CDDA_RNG_TRACE` records every draw the whole run makes,
+    // world generation included, so a replay needs the offset to slice its own dice out of that file.
+    std::fprintf( out,
+                  "{\"harness\":\"field-series\",\"version\":1,\"radius\":%d,\"draw_start\":%llu,",
+                  radius, rng_draws_so_far() );
+    const tripoint_bub_ms center = get_avatar().pos_bub();
+    // The terrain of the **whole** radius, not just of the squares that carry a field. A replay needs the ground under every square the fire might care
+    // about - the fuel branch, the spread rule, whether smoke may rise - and a dump that lists terrain only where fields are leaves the rest of the map
+    // a guess, which is exactly the part a port would get wrong without noticing.
+    std::fprintf( out, "\"grid\":[" );
+    bool first_square = true;
+    for( const tripoint_bub_ms &p : g->harness_map().points_in_radius( center, radius ) ) {
+        const ter_id &ter = g->harness_map().ter( p );
+        const furn_id &frn = g->harness_map().furn( p );
+        // The items on a square are part of the answer too: the spread rule's last disjunct is
+        // `one_in( 5 ) && get_item_count() > 0 && flammable_items_at( ... )`, so a replay has to know whether anything burnable is lying there.
+        std::fprintf( out,
+                      "%s{\"x\":%d,\"y\":%d,\"z\":%d,\"ter\":\"%s\",\"furn\":\"%s\","
+                      "\"items\":%zu,\"items_burn\":%d}",
+                      first_square ? "" : ",", p.x(), p.y(), p.z(),
+                      harness::harness_escape( ter.id().str() ).c_str(),
+                      harness::harness_escape( frn.id().str() ).c_str(),
+                      g->harness_map().i_at( p ).size(),
+                      g->harness_map().flammable_items_at( p ) ? 1 : 0 );
+        first_square = false;
+    }
+    std::fprintf( out, "],\n\"turns\":[" );
+    for( int turn = 0; turn <= turns; turn++ ) {
+        std::fprintf( out, "%s{\"turn\":%d,\"fields\":[", turn == 0 ? "" : ",\n", turn );
+        bool first = true;
+        for( const tripoint_bub_ms &p : g->harness_map().points_in_radius( center, radius ) ) {
+            const field &fld = g->harness_map().field_at( p );
+            // The terrain under the field is part of the answer, not decoration: the fire processor's fuel accounting
+            // branches on the terrain's flags, and two runs that differ only in the ground under a fire will disagree
+            // about its age. Without this in the dump there is no way to tell which branch ran.
+            const ter_id &ter = g->harness_map().ter( p );
+            const furn_id &frn = g->harness_map().furn( p );
+            for( const auto &entry : fld ) {
+                std::fprintf( out,
+                              "%s{\"x\":%d,\"y\":%d,\"z\":%d,\"type\":\"%s\",\"intensity\":%d,\"age\":%d,"
+                              "\"ter\":\"%s\",\"furn\":\"%s\"}",
+                              first ? "" : ",", p.x(), p.y(), p.z(),
+                              harness::harness_escape( entry.second.get_field_type().id().str() ).c_str(),
+                              entry.second.get_field_intensity(),
+                              to_turns<int>( entry.second.get_field_age() ),
+                              harness::harness_escape( ter.id().str() ).c_str(),
+                              harness::harness_escape( frn.id().str() ).c_str() );
+                first = false;
+            }
+        }
+        // Scent has nothing to do with fields, but an environment session that ignores it cannot compare one.
+        std::fprintf( out, "],\"scent\":[" );
+        first = true;
+        for( const tripoint_bub_ms &p : g->harness_map().points_in_radius( center, radius ) ) {
+            const int value = get_scent().get( p );
+            if( value != 0 ) {
+                std::fprintf( out, "%s[%d,%d,%d]", first ? "" : ",", p.x(), p.y(), value );
+                first = false;
+            }
+        }
+        std::fprintf( out, "]}" );
+        if( turn < turns ) {
+            g->harness_map().process_fields();
+        }
+    }
+    std::fprintf( out, "\n]}\n" );
+    std::fclose( out );
+}
+
+} // namespace harness
+
+namespace harness
+{
+
+// Every resolved monster type, with the fields the port loads first.
+void dump_monsters( const std::string &path )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot open %s\n", path.c_str() );
+        return;
+    }
+    std::fprintf( out, "{\"harness\":\"monsters\",\"version\":1,\n\"prototypes\":[\n" );
+    bool first = true;
+    for( const mtype &proto : MonsterGenerator::generator().get_all_mtypes() ) {
+        std::fprintf( out, "%s\n{\"id\":\"%s\",\"name\":\"%s\",\"symbol\":\"%s\",\"color\":\"%s\","
+                      "\"bodytype\":\"%s\",\"hp\":%d,\"speed\":%d,\"diff\":%d,\"melee_skill\":%d,"
+                      "\"dodge\":%d,\"morale\":%d,\"aggression\":%d,\"weight\":%lld,\"volume\":%lld,"
+                      "\"species\":[",
+                      first ? "" : ",", harness_escape( proto.id.str() ).c_str(),
+                      harness_escape( proto.nname( 1 ) ).c_str(),
+                      harness_escape( proto.sym ).c_str(),
+                      string_from_color( proto.color ).c_str(),
+                      harness_escape( proto.bodytype ).c_str(),
+                      proto.hp, proto.speed, proto.difficulty_base, proto.melee_skill,
+                      proto.sk_dodge, proto.morale, proto.agro,
+                      static_cast<long long>( units::to_gram( proto.weight ) ),
+                      static_cast<long long>( units::to_milliliter( proto.volume ) ) );
+        bool first_species = true;
+        for( const species_id &entry : proto.species ) {
+            std::fprintf( out, "%s\"%s\"", first_species ? "" : ",",
+                          harness_escape( entry.str() ).c_str() );
+            first_species = false;
+        }
+        std::fprintf( out, "],\"categories\":[" );
+        bool first_category = true;
+        for( const std::string &entry : proto.categories ) {
+            std::fprintf( out, "%s\"%s\"", first_category ? "" : ",",
+                          harness_escape( entry ).c_str() );
+            first_category = false;
+        }
+        std::fprintf( out, "],\"materials\":[" );
+        bool first_material = true;
+        for( const std::pair<const material_id, int> &entry : proto.mat ) {
+            std::fprintf( out, "%s[\"%s\",%d]", first_material ? "" : ",",
+                          harness_escape( entry.first.str() ).c_str(), entry.second );
+            first_material = false;
+        }
+        // `creature_size` has no `enum_to_string` specialisation linked into this build, so the size is named
+        // here rather than guessed at with a cast.
+        const char *size_name = "medium";
+        switch( proto.size ) {
+            case creature_size::tiny:  size_name = "tiny";  break;
+            case creature_size::small: size_name = "small"; break;
+            case creature_size::medium: size_name = "medium"; break;
+            case creature_size::large: size_name = "large"; break;
+            case creature_size::huge:  size_name = "huge";  break;
+            default: break;
+        }
+        std::fprintf( out, "],\"harvest\":\"%s\",\"dissect\":\"%s\",\"size\":\"%s\"}",
+                      harness_escape( proto.harvest.str() ).c_str(),
+                      harness_escape( proto.dissect.str() ).c_str(),
+                      size_name );
+        first = false;
+    }
+    std::fprintf( out, "\n]}\n" );
+    std::fclose( out );
+}
+
+}  // namespace harness
