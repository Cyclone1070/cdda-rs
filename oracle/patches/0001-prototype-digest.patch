+void dump_vehicle_armour( const std::string &path )
+{
+    static const std::string structure_location( "structure" );
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+
+    map &here = get_map();
+    const tripoint_bub_ms origin = get_player_character().pos_bub( here );
+    for( int dx = -12; dx <= 12; dx++ ) {
+        for( int dy = -12; dy <= 12; dy++ ) {
+            const tripoint_bub_ms square = origin + tripoint_rel_ms( dx, dy, 0 );
+            here.ter_set( square, ter_id( "t_floor" ) );
+            here.furn_set( square, furn_str_id::NULL_ID() );
+        }
+    }
+
+    std::fprintf( out, "{\"harness\":\"vehicle_armour\",\"version\":1,\"origin\":[%d,%d,%d],"
+                  "\"cases\":[", origin.x(), origin.y(), origin.z() );
+    bool first_case = true;
+
+    // One vehicle, a wall in front of its leading structure part, and what the reference says would take the hit.
+    const auto dump_vehicle = [&]( const char *name, const vproto_id &type ) {
+        vehicle *veh = here.add_vehicle( type, origin, 0_degrees, 0, 0, false, true );
+        if( veh == nullptr ) {
+            std::fprintf( stderr, "harness: %s did not place\n", type.str().c_str() );
+            return;
+        }
+        // The leading structure part is the one furthest forward; the wall goes in the square its own move would take.
+        int leading = -1;
+        for( int p = 0; p < veh->part_count(); p++ ) {
+            const vehicle_part &vp = veh->part( p );
+            if( vp.removed || vp.info().location != structure_location ) {
+                continue;
+            }
+            if( leading < 0 || vp.mount.x() > veh->part( leading ).mount.x() ) {
+                leading = p;
+            }
+        }
+        const tripoint_bub_ms wall =
+            veh->bub_part_pos( here, leading ) + tripoint_rel_ms( 1, 0, 0 );
+        here.ter_set( wall, ter_id( "t_wall" ) );
+
+        const auto ask = [&]( const char *case_name, const char *plate_state ) {
+            veh->precalc_mounts( 1, 0_degrees, veh->pivot_point( here ) );
+            std::vector<veh_collision> colls;
+            const bool hit = veh->collision(
+                                 here, colls, tripoint_rel_ms( 1, 0, 0 ) - veh->pivot_displacement(), true, false );
+            std::fprintf( out,
+                          "%s{\"name\":\"%s\",\"vehicle\":\"%s\",\"wall_at\":[%d,%d,%d],\"lead_part\":%d,"
+                          "\"hit\":%d",
+                          first_case ? "" : ",", case_name, type.str().c_str(), wall.x(), wall.y(), wall.z(),
+                          leading, hit ? 1 : 0 );
+            first_case = false;
+            if( hit && !colls.empty() ) {
+                const veh_collision &coll = colls.front();
+                std::fprintf( out, ",\"reported\":\"%s\",\"reported_index\":%d,\"type\":\"%d\"",
+                              veh->part( coll.part ).info().id.str().c_str(), coll.part,
+                              static_cast<int>( coll.type ) );
+            }
+            if( plate_state != nullptr ) {
+                std::fprintf( out, ",\"plates\":\"%s\"", plate_state );
+            }
+            std::fprintf( out, "}" );
+        };
+
+        ask( name, nullptr );
+        // Break whatever took the hit and ask again: the swap only counts an unbroken plate (`part_with_feature( part, ARMOR, true )`).
+        std::vector<veh_collision> probe;
+        veh->collision( here, probe, tripoint_rel_ms( 1, 0, 0 ) - veh->pivot_displacement(), true,
+                        false );
+        if( !probe.empty() ) {
+            // `set_hp( part, 0 )` is the reference's own way to ruin a part: it sets the damage to the maximum, which is what `is_broken()` tests.
+            veh->set_hp( veh->part( probe.front().part ), 0, false );
+            ask( "a_broken_plate_does_not_take_it", "broken" );
+        }
+        here.destroy_vehicle( veh );
+        here.ter_set( wall, ter_id( "t_floor" ) );
+    };
+
+    dump_vehicle( "armour_takes_the_hit", vproto_id( "quad_bike" ) );
+    dump_vehicle( "a_bicycle_has_no_plate", vproto_id( "bicycle" ) );
+
+    std::fprintf( out, "]}\n" );
+    std::fclose( out );
+}
