+void dump_weather_manager( const std::string &path, int hours )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+    weather_manager &weather = get_weather();
+    std::fprintf( out, "{\"harness\":\"weather-manager\",\"version\":1,\"seed\":%u,\n\"steps\":[\n",
+                  g->get_seed() );
+    for( int hour = 0; hour < hours; hour++ ) {
+        if( hour > 0 ) {
+            calendar::turn += 1_hours;
+        }
+        // Label the dice so a port can be driven by exactly the draws the manager made, in the order it made them.
+        const std::string mark = string_format( "weather.manager.hour.%d", hour );
+        rng_mark( mark.c_str() );
+        weather.update_weather();
+        const w_point &point = *weather.weather_precise;
+        // **The inputs as well as the answers**, for the same reason the generator's series carries them: a recorded temperature is only replayable if the port knows where the
+        // player stood, which season it was, and what seed the noise field took.
+        const tripoint_abs_ms where = get_player_character().pos_abs();
+        const season_effective_time moment( calendar::turn );
+        const double year_fraction = time_past_new_year( moment.t ) / calendar::year_length();
+        // **The double under the float**, so a port can be held to the arithmetic rather than to the rounding. The terms come with it: a total that differs can be
+        // traced to the day's cosine, the seasonality or the noise without another recording.
+        const std::array<double, 8> terms = harness_weather_temperature_terms(
+                weather.get_cur_weather_gen(), where, calendar::turn, g->get_seed() );
+        std::fprintf( out,
+                      // The temperature is a `float`, and a float needs seventeen significant digits to round-trip: nine decimal places truncates it, and a gate that
+                      // compares the stored value cannot ask for exactness against a number the file itself rounded.
+                      "%s{\"hour\":%d,\"turn\":%lld,\"weather\":\"%s\",\"temperature\":%.17g,"
+                      "\"humidity\":%.17g,\"pressure\":%.17g,\"windpower\":%.17g,\"winddirection\":%d,"
+                      "\"windspeed\":%d,\"next\":%lld,\"lightning\":%s,"
+                      // The fractions are written to **seventeen digits** because a cosine of them is compared: at ten digits the input's own rounding
+                      // shows up in the tenth decimal of the cosine, which is larger than any arithmetic difference worth finding.
+                      "\"year_fraction\":%.17g,\"day_fraction\":%.17g,\"season\":%d,"
+                      "\"common_x\":%.17g,\"common_y\":%.17g,\"common_z\":%.17g,\"mod_seed\":%u,"
+                      "\"celsius_double\":%.17g,\"dayv\":%.17g,\"seasonality\":%.17g,\"noise\":%.17g,"
+                      "\"humidity_noise\":%.17g,\"pressure_noise\":%.17g}",
+                      hour == 0 ? "" : ",\n", hour, static_cast<long long>( to_turn<int>( calendar::turn ) ),
+                      harness_escape( weather.weather_id.str() ).c_str(),
+                      units::to_kelvin( weather.temperature ), point.humidity, point.pressure,
+                      point.windpower, weather.winddirection, weather.windspeed,
+                      static_cast<long long>( to_turn<int>( weather.nextweather ) ),
+                      weather.lightning_active ? "true" : "false",
+                      year_fraction, time_past_midnight( moment.t ) / 1_days,
+                      static_cast<int>( season_of_year( moment.t ) ),
+                      where.x() / 2000.0, where.y() / 2000.0,
+                      to_days<double>( calendar::turn - calendar::turn_zero ),
+                      g->get_seed() % SIMPLEX_NOISE_RANDOM_SEED_LIMIT,
+                      terms[0], terms[1], terms[2], terms[3],
+                      terms[6], terms[7] );
+    }
+    std::fprintf( out, "\n]}\n" );
+    std::fclose( out );
+}
+
+void dump_weather_series( const std::string &path, int hours )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+    weather_manager &weather = get_weather();
+    std::fprintf( out, "{\"harness\":\"weather_series\",\"version\":1,\"hours\":%d,\"steps\":[\n", hours );
+    // The first update decides the opening weather; each step after it is an hour of game time, which is fine-grained enough to see a change and
+    // coarse enough that a day of weather is twenty-four lines.
+    for( int hour = 0; hour < hours; hour++ ) {
+        if( hour > 0 ) {
+            calendar::turn += 1_hours;
+        }
+        // **Label the dice this hour rolls**, so a port can be driven by exactly the dice the reference used. The marks and draws go to the trace the
+        // `CDDA_RNG_TRACE` variable names; they change no draw, which is what makes the trace a record rather than an experiment.
+        const std::string mark = string_format( "weather.hour.%d", hour );
+        rng_mark( mark.c_str() );
+        weather.update_weather();
+        const w_point &point = *weather.weather_precise;
+        // **The inputs as well as the answers.** A recorded temperature is only replayable if the port knows where the player stood, how many turns had
+        // passed and what seed the world carried; and the generator's own intermediate values are written too, so the formula can be gated before the
+        // calendar that feeds it is ported - each piece gets a target of its own instead of one all-or-nothing test.
+        const tripoint_abs_ms where = get_player_character().pos_abs();
+        const season_effective_time moment( calendar::turn );
+        const double year_fraction = time_past_new_year( moment.t ) / calendar::year_length();
+        std::fprintf( out,
+                      "%s{\"hour\":%d,\"turn\":%lld,\"weather\":\"%s\",\"temperature_k\":%.9f,"
+                      "\"humidity\":%.9f,\"pressure\":%.9f,\"windpower\":%.9f,\"winddirection\":%d,"
+                      "\"windspeed\":%d,\"next_weather_turn\":%lld,"
+                      "\"location\":[%d,%d,%d],\"seed\":%u,"
+                      "\"year_fraction\":%.10f,\"day_fraction\":%.10f,\"season\":%d,"
+                      "\"common_x\":%.10f,\"common_y\":%.10f,\"common_z\":%.10f,\"mod_seed\":%u}",
+                      hour == 0 ? "" : ",\n", hour, static_cast<long long>( to_turn<int>( calendar::turn ) ),
+                      harness::harness_escape( weather.weather_id.str() ).c_str(),
+                      units::to_kelvin( point.temperature ), point.humidity, point.pressure,
+                      point.windpower, weather.winddirection, weather.windspeed,
+                      static_cast<long long>( to_turn<int>( weather.nextweather ) ),
+                      where.x(), where.y(), where.z(), g->get_seed(),
+                      year_fraction, time_past_midnight( moment.t ) / 1_days,
+                      static_cast<int>( season_of_year( moment.t ) ),
+                      where.x() / 2000.0, where.y() / 2000.0,
+                      to_days<double>( calendar::turn - calendar::turn_zero ),
+                      g->get_seed() % SIMPLEX_NOISE_RANDOM_SEED_LIMIT );
+    }
+    std::fprintf( out, "\n]}\n" );
+    std::fclose( out );
+}
