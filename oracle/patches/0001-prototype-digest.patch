+void dump_mapgen( const std::string &path, const std::string &oter_id )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+    // The mapgen key itself, which is what the port's registry is keyed by. No overmap-terrain indirection: `get_mapgen_id`
+    // answers with the id a mapgen is registered under, and that is empty for a terrain whose mapgen lives elsewhere.
+    const std::string mapgen_id = oter_id;
+    // A real overmap position and a loaded map, because a mapgen asks the world about its neighbours - connections, ground
+    // cover, the season - and a dummy map answers "nothing", which builds an empty chunk.
+    map &here = get_map();
+    const tripoint_abs_omt omt = project_to<coords::omt>( get_player_character().pos_abs() );
+    mapgendata dat( omt, here, 0.0f, calendar::turn, nullptr );
+    if( !run_mapgen_func( mapgen_id, dat ) ) {
+        std::fprintf( stderr, "harness: mapgen %s did not run\n", mapgen_id.c_str() );
+        std::fclose( out );
+        return;
+    }
+    std::fprintf( out, "{\"harness\":\"mapgen\",\"version\":1,\"oter\":\"%s\",\"mapgen\":\"%s\",\"size\":%d,\"rows\":[\n",
+                  harness::harness_escape( oter_id ).c_str(), harness::harness_escape( mapgen_id ).c_str(),
+                  SEEX * 2 );
+    for( int y = 0; y < SEEY * 2; y++ ) {
+        std::fprintf( out, "%s[", y == 0 ? "" : ",\n" );
+        for( int x = 0; x < SEEX * 2; x++ ) {
+            const tripoint_bub_ms square( x, y, here.get_abs_sub().z() );
+            const std::string ter = here.ter( square ).id().str();
+            const std::string furn = here.furn( square ).id().str();
+            std::fprintf( out, "%s[\"%s\",\"%s\"]", x == 0 ? "" : ",",
+                          harness::harness_escape( ter ).c_str(), harness::harness_escape( furn ).c_str() );
+        }
+        std::fprintf( out, "]" );
+    }
+    std::fprintf( out, "\n]}\n" );
+    std::fclose( out );
+}
