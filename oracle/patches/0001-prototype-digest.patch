+                          harness_escape( vitamin.str() ).c_str(), amount );
+            first_vitamin = false;
+        }
+        std::fprintf( out, "}}" );
+        first = false;
+    }
+    std::fprintf( out, "\n],\"count\":%d}\n", count );
+    std::fclose( out );
+}
