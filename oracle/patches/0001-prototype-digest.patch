+/// What one effect does to a body in one turn: the hunger and thirst branches of `Character::process_one_effect` (`src/character.cpp:10989-11006`).
+///
+/// The branches are three lines each and hide four rules between them: the amount is read with `get_amount` on the turn an effect **arrives** and with `get_mod` after
+/// that, `get_mod` **rolls** between a stated minimum and maximum when a maximum is stated at all, the chance decides whether the turn counts (and is skipped entirely
+/// for a brand-new effect), and the movement is clamped against the type's own ceiling and floor before it is applied.
+///
+/// The effects are synthesised, so the twenty-odd other branches of the real function see zero and do nothing, and the avatar is set to a known hunger and thirst first.
+void dump_per_turn( const std::string &path )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+    avatar &u = get_avatar();
+    // Seven shapes: a stated amount, a stated amount with a ceiling, a floor, a ceiling of two so the clamp bites, a chance, a tick, and one that moves thirst instead.
+    // A shape that **rolls** is deliberately absent: this binary's dice plateau, so a recorded roll would be the plateau's value rather than a die (see `--dump-rng-probe`).
+    static const std::array<const char *, 7> profiles = { {
+            "{\"hunger_amount\":[3]}",
+            "{\"hunger_amount\":[30],\"hunger_max_val\":[20]}",
+            "{\"hunger_amount\":[-40],\"hunger_min_val\":[-10]}",
+            "{\"hunger_amount\":[5],\"hunger_max_val\":[2]}",
+            "{\"hunger_amount\":[5],\"hunger_chance\":[1],\"hunger_chance_bot\":[1]}",
+            "{\"hunger_amount\":[5],\"hunger_chance\":[1],\"hunger_chance_bot\":[1],\"hunger_tick\":[3]}",
+            "{\"thirst_amount\":[7],\"thirst_max_val\":[40]}",
+        }
+    };
+    static const std::array<int, 3> hungers = { { -61, 0, 100 } };
+    static const std::array<int, 2> thirsts = { { 0, 50 } };
+    static const std::array<int, 3> turns = { { 0, 1, 2 } };
+    static const std::array<bool, 2> arrivals = { { false, true } };
+    constexpr unsigned seed = 12345;
+
+    std::fprintf( out, "{\"harness\":\"per-turn\",\"version\":1,\"seed\":%u,\"profiles\":[", seed );
+    for( std::size_t p = 0; p < profiles.size(); ++p ) {
+        std::fprintf( out, "%s%s", p == 0 ? "" : ",", profiles[p] );
+    }
+    std::fprintf( out, "],\"cases\":[\n" );
+
+    bool first_case = true;
+    int cases = 0;
+    int moved = 0;
+    for( std::size_t p = 0; p < profiles.size(); ++p ) {
+        const std::string id = string_format( "harness_turn_%d", static_cast<int>( p ) );
+        const std::string json = string_format( "{\"id\":\"%s\",\"base_mods\":%s}", id.c_str(), profiles[p] );
+        JsonValue parsed = json_loader::from_string( json );
+        JsonObject object = parsed.get_object();
+        load_effect_type( object, "harness" );
+        const efftype_id effect_id( id );
+        if( !effect_id.is_valid() ) {
+            std::fprintf( stderr, "harness: the synthesised effect %s did not load\n", id.c_str() );
+            std::fclose( out );
+            return;
+        }
+        for( const int hunger : hungers ) {
+            for( const int thirst : thirsts ) {
+                for( const bool arrival : arrivals ) {
+                    for( const int turn : turns ) {
+                        u.set_hunger( hunger );
+                        u.set_thirst( thirst );
+                        effect worn( effect_source::empty(), &effect_id.obj(), 1_hours, bodypart_str_id( "torso" ),
+                                     false, 1, calendar::turn_zero );
+                        calendar::turn = calendar::turn_zero + time_duration::from_turns( turn );
+                        rng_set_engine_seed( seed + static_cast<unsigned>( cases ) );
+                        u.process_one_effect( worn, arrival );
+                        ++cases;
+                        if( u.get_hunger() != hunger || u.get_thirst() != thirst ) {
+                            ++moved;
+                        }
+                        std::fprintf( out,
+                                      "%s{\"profile\":%zu,\"hunger\":%d,\"thirst\":%d,\"is_new\":%s,\"turn\":%d,"
+                                      "\"seed\":%u,\"after_hunger\":%d,\"after_thirst\":%d}",
+                                      first_case ? "" : ",\n", p, hunger, thirst, arrival ? "true" : "false", turn,
+                                      seed + static_cast<unsigned>( cases - 1 ), u.get_hunger(), u.get_thirst() );
+                        first_case = false;
+                    }
+                }
+            }
+        }
+    }
+    calendar::turn = calendar::turn_zero;
+    std::fprintf( out, "\n],\"count\":%d,\"moved\":%d}\n", cases, moved );
+    std::fclose( out );
+}
