+{
+    std::vector<std::string> effects;
+    effects.reserve( get_effect_types().size() );
+    for( const std::pair<const efftype_id, effect_type> &entry : get_effect_types() ) {
+        effects.push_back( entry.first.str() );
+    }
+    std::sort( effects.begin(), effects.end() );
+    return { { "effect types", std::move( effects ) } };
+}
