+void dump_vehicle_acceleration( const std::string &path )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+
+    map &here = get_map();
+    const tripoint_bub_ms origin = get_player_character().pos_bub( here );
+    for( int dx = -16; dx <= 16; dx++ ) {
+        for( int dy = -16; dy <= 16; dy++ ) {
+            const tripoint_bub_ms square = origin + tripoint_rel_ms( dx, dy, 0 );
+            here.ter_set( square, ter_id( "t_floor" ) );
+            here.furn_set( square, furn_str_id::NULL_ID() );
+        }
+    }
+
+    std::fprintf( out, "{\"harness\":\"vehicle_acceleration\",\"version\":1,\"origin\":[%d,%d,%d],"
+                  "\"cases\":[", origin.x(), origin.y(), origin.z() );
+    bool first_case = true;
+
+    // `vehicle::ground_acceleration` (`vehicle.cpp:4110-4129`) is what the engine can add this turn:
+    // `100 * 100 * ( power / weight ) / cmps`, where `cmps` is the speed it is asked about in centimetres per second and the answer comes back in hundredths of a
+    // mile per hour. Every division is integer arithmetic except the power-to-weight ratio, which is a double truncated once.
+    const auto dump_vehicle = [&]( const char *name, const vproto_id &type ) {
+        for( const int at : { 0, 50, 500, 1000, 1500, 2000, 10'000 } ) {
+            vehicle *veh = here.add_vehicle( type, origin, 0_degrees, 0, 0, false, true );
+            if( veh == nullptr ) {
+                std::fprintf( stderr, "harness: %s did not place\n", type.str().c_str() );
+                return;
+            }
+            veh->engine_on = true;
+            veh->velocity = at;
+            const int power = units::to_watt( veh->total_power( here, false ) );
+            const double weight = to_kilogram( veh->total_mass( here ) );
+            std::fprintf( out,
+                          "%s{\"name\":\"%s_at_%d\",\"vehicle\":\"%s\",\"at\":%d,\"engine_on\":1,"
+                          "\"power_w\":%d,\"mass_kg\":%.17g,\"max_velocity\":%d,\"acceleration\":%d}",
+                          first_case ? "" : ",", name, at, type.str().c_str(), at, power, weight,
+                          veh->max_velocity( here, false ),
+                          veh->current_acceleration( here, false ) );
+            first_case = false;
+            here.destroy_vehicle( veh );
+        }
+        // And one with nothing turning: the rule answers zero before it reads any coefficient.
+        vehicle *off = here.add_vehicle( type, origin, 0_degrees, 0, 0, false, true );
+        if( off != nullptr ) {
+            off->engine_on = false;
+            off->velocity = 500;
+            std::fprintf( out, "%s{\"name\":\"%s_engine_off\",\"vehicle\":\"%s\",\"at\":500,"
+                          "\"engine_on\":0,\"acceleration\":%d}",
+                          first_case ? "" : ",", name, type.str().c_str(),
+                          off->current_acceleration( here, false ) );
+            first_case = false;
+            here.destroy_vehicle( off );
+        }
+    };
+
+    dump_vehicle( "bicycle", vproto_id( "bicycle" ) );
+    dump_vehicle( "quad_bike", vproto_id( "quad_bike" ) );
+
+    std::fprintf( out, "]}\n" );
+    std::fclose( out );
+}
