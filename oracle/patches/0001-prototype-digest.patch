+void dump_vehicle_crash( const std::string &path )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+
+    map &here = get_map();
+    const tripoint_bub_ms origin = get_player_character().pos_bub( here );
+    for( int dx = -24; dx <= 24; dx++ ) {
+        for( int dy = -24; dy <= 24; dy++ ) {
+            const tripoint_bub_ms square = origin + tripoint_rel_ms( dx, dy, 0 );
+            here.ter_set( square, ter_id( "t_floor" ) );
+            here.furn_set( square, furn_str_id::NULL_ID() );
+        }
+    }
+
+    // `vehicle::part_collision` (`vehicle_move.cpp:836-1170`) turns a hit into damage through an impulse loop: the deformation energy of the collision, split between
+    // the vehicle and the obstacle by `k`, which the material and weight factors set. The dump records both densities the rule divides by and the damage the parts
+    // actually took, so the port can reproduce the number rather than read it back.
+    std::fprintf( out, "{\"harness\":\"vehicle_crash\",\"version\":1,\"origin\":[%d,%d,%d],"
+                  "\"cases\":[", origin.x(), origin.y(), origin.z() );
+    bool first_case = true;
+
+    const char *types[] = { "bicycle", "car" };
+    for( const char *type : types ) {
+        for( const int speed : { 100, 400, 1000, 2000 } ) {
+            const tripoint_bub_ms start = origin + tripoint_rel_ms( 0, 10, 0 );
+            vehicle *veh = here.add_vehicle( vproto_id( type ), start, 0_degrees, 100, 0, false, true );
+            if( veh == nullptr ) {
+                std::fprintf( stderr, "harness: %s did not place\n", type );
+                continue;
+            }
+            // **A vitrified wall, not a wooden one**: `t_vitrified_wall` is impassable and has no bash block, so the reference's own constants decide the
+            // collision - mass 1000 kg, restitution 0.10, density 80 (`vehicle_move.cpp:961-967`) - instead of `terrain_collision_data`'s bash figures,
+            // which are not in the dump.
+            // Far enough that the vehicle's own body does not overlap it when it is placed.
+            for( int dy = -3; dy <= 3; dy++ ) {
+                here.ter_set( start + tripoint_rel_ms( 4, dy, 0 ), ter_id( "t_vitrified_wall" ) );
+            }
+            veh->velocity = speed;
+            veh->cruise_velocity = speed;
+            // Enough movement to reach the wall: at 400 vmiph a square costs a whole turn, and the wall is four squares away.
+            veh->of_turn = 20.0f;
+            std::vector<int> hp_before;
+            for( int index = 0; index < veh->part_count(); index++ ) {
+                hp_before.push_back( veh->part( index ).hp() );
+            }
+
+            // **Exactly one movement call**: the hit points lost are then one collision's blow, which is what the impulse loop computes. Recording eight calls
+            // mixed repeated hits into one number and made the row impossible to check.
+            // Move until the collision happens, then stop: the hit points recorded are **one blow**, which is what the impulse loop computes.
+            for( int step = 0; step < 8; step++ ) {
+                if( veh == nullptr ) {
+                    break;
+                }
+                veh = veh->act_on_map( here );
+                if( veh == nullptr || veh->velocity != speed ) {
+                    break;
+                }
+            }
+            if( veh == nullptr ) {
+                std::fprintf( out, "%s{\"vehicle\":\"%s\",\"speed\":%d,\"destroyed\":true}",
+                              first_case ? "" : ",", type, speed );
+                first_case = false;
+                continue;
+            }
+
+            // The part the dump names is the one that lost the most hit points: that is the part the wall hit.
+            int worst = -1;
+            int lost = 0;
+            for( size_t index = 0; index < hp_before.size() &&
+                    index < static_cast<size_t>( veh->part_count() ); index++ ) {
+                const int damage = hp_before[index] - veh->part( static_cast<int>( index ) ).hp();
+                if( damage > lost ) {
+                    lost = damage;
+                    worst = static_cast<int>( index );
+                }
+            }
+            std::fprintf( out, "%s{\"vehicle\":\"%s\",\"speed\":%d,\"mass_g\":%lld,"
+                          "\"velocity_after\":%d,\"part\":%d,\"part_lost\":%d,",
+                          first_case ? "" : ",", type, speed,
+                          static_cast<long long>( units::to_gram( veh->total_mass( here ) ) ),
+                          veh->velocity, worst, lost );
+            if( worst >= 0 ) {
+                const vehicle_part &vp = veh->part( worst );
+                const itype *base = item::find_type( vp.info().base_item );
+                const auto &mats = base->materials;
+                const float mat_total = base->mat_portion_total == 0 ? 1 : base->mat_portion_total;
+                float vpart_dens = 0.0f;
+                if( !mats.empty() ) {
+                    for( const std::pair<const material_id, int> &mat_id : mats ) {
+                        vpart_dens += mat_id.first->density() *
+                                      ( static_cast<float>( mat_id.second ) / mat_total );
+                    }
+                    vpart_dens /= mats.size();
+                }
+                // A named local: `id.str()` does not decay to a C string, and passing a `std::string` to `%s` read the pointer's bytes as text.
+                const std::string part_name = vp.info().id.str();
+                std::fprintf( out, "\"part_name\":\"%s\",\"vpart_dens\":%.9g,"
+                              "\"hp_before\":%d,\"hp_after\":%d}",
+                              part_name.c_str(), static_cast<double>( vpart_dens ),
+                              hp_before[static_cast<size_t>( worst )], vp.hp() );
+            } else {
+                std::fprintf( out, "\"part_name\":\"\",\"vpart_dens\":0,\"hp_before\":0,\"hp_after\":0}" );
+            }
+            first_case = false;
+            here.destroy_vehicle( veh );
+        }
+    }
+
+    std::fprintf( out, "]}\n" );
+    std::fclose( out );
+}
+
+/// **Two vehicles hitting each other**, which is the one collision the port has never had ground truth for.
+///
+/// `map::move_vehicle`'s vehicle branch (`map.cpp:1075-1200`) splits the closing speed into the component along the line between the hulls, exchanges that, and turns the rest
+/// into damage on both sides. **A null return from `act_on_map` is not a death**: `map.cpp:898-901` returns null on purpose after a vehicle-vehicle hit, "to let the hit vehicle
+/// move away" - so the recording keeps its pointer and stops its loop when that happens. Reading that null as destruction is what made round 171's draft record `mover_gone`
+/// in every case.
+/// **A boarding session**: who sits where, and what that does to the hull's mass.
+///
+/// `map::board_vehicle` (`map.cpp:1385-1418`) takes the BOARDABLE part under the character, marks it with the passenger flag and invalidates the mass cache; the weight itself is
+/// added back in `calc_mass_center` (`vehicle.cpp:8514-8520`), which counts a boarded character's `get_weight()` against its part. The dump records the part that was chosen, the
+/// square it stands on, the character's weight, and the vehicle's mass either side of the boarding - **the difference** is the rule, and it is the one number a port can compare
+/// without also having to reproduce the loot a hull spawns with.
+/// **What a loaded survivor's step costs, and where the number comes from.** The walk charge is not the terrain: `avatar_action::move` charges `Character::run_cost`, whose
+/// "Encum./Wounds" term is `limb_run_cost_modifier` - `(footing_mod + move_speed_mod * 2) / 3` (`character_modifier.cpp:302-306`) - and each of those is a limb score turned into a
+/// multiplier by its data entry (`character_modifiers.json`: `{"limb_score": ..., "max": "max_move_cost", "nominator": 1.0}`). The dump records **each layer separately**, unloaded and
+/// loaded past capacity, so a port can be checked link by link instead of against one unexplained number.
+void dump_run_cost( const std::string &path )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+    map &here = get_map();
+    Character &you = get_player_character();
+    const tripoint_bub_ms origin = you.pos_bub( here );
+    for( int dx = -3; dx <= 3; dx++ ) {
+        for( int dy = -3; dy <= 3; dy++ ) {
+            const tripoint_bub_ms square = origin + tripoint_rel_ms( dx, dy, 0 );
+            here.ter_set( square, ter_id( "t_floor" ) );
+            here.furn_set( square, furn_str_id::NULL_ID() );
+        }
+    }
+
+    std::fprintf( out, "{\"harness\":\"run_cost\",\"version\":1,\"cases\":[" );
+    bool first_case = true;
+    auto report = [&]( const char *name ) {
+        const float move_speed = you.get_limb_score( limb_score_id( "move_speed" ) );
+        const float footing = you.get_limb_score( limb_score_id( "footing" ) );
+        // **Through the character's own accessor**, because `character_modifier` is only forward-declared here: `Character::get_modifier` (`character.h:806`) is the answer the
+        // rules themselves call, so the dump asks the same question they do.
+        const float speed_mod = you.get_modifier( character_modifier_id( "limb_speed_movecost_mod" ) );
+        const float footing_mod =
+            you.get_modifier( character_modifier_id( "limb_footing_movecost_mod" ) );
+        const float run_mod = you.get_modifier( character_modifier_id( "limb_run_cost_mod" ) );
+        // **The reference's own list of what it did to the base cost.** `run_cost_effects` (`character.cpp:10376`) returns one entry per modifier it applied and the caller's
+        // `movecost` comes back changed, so the dump can print the chain instead of guessing at it from the total.
+        float probe = 100.0f;
+        const std::vector<run_cost_effect> chain = you.run_cost_effects( probe );
+        std::fprintf( out, "%s{\"case\":\"%s\",\"effects\":[", first_case ? "" : ",", name );
+        bool first_effect = true;
+        for( const run_cost_effect &effect : chain ) {
+            std::fprintf( out, "%s{\"what\":\"%s\",\"times\":%f,\"plus\":%f}",
+                          first_effect ? "" : ",", effect.description.c_str(), effect.times, effect.plus );
+            first_effect = false;
+        }
+        std::fprintf( out, "],\"probe\":%f,", probe );
+        std::fprintf( out,
+                      "\"weight_g\":%d,\"capacity_g\":%d,"
+                      "\"other_weight_g\":%d,\"move_speed\":%f,\"footing\":%f,"
+                      "\"move_speed_mod\":%f,\"footing_mod\":%f,\"run_cost_mod\":%f,"
+                      "\"run_cost_100\":%d,\"run_cost_100_diagonal\":%d,"
+                      "\"floor_cost\":%d}",
+                      static_cast<int>( units::to_gram( you.get_weight() ) ),
+                      static_cast<int>( units::to_gram( you.weight_capacity() ) ),
+                      static_cast<int>( units::to_gram( you.weight_carried() ) ), move_speed, footing,
+                      speed_mod, footing_mod, run_mod, you.run_cost( 100, false ),
+                      you.run_cost( 100, true ), here.move_cost( origin ) );
+        first_case = false;
+    };
+    report( "unloaded" );
+    for( int i = 0; i < 200; i++ ) {
+        you.i_add( item( itype_id( "rock" ) ) );
+    }
+    report( "loaded" );
+
+    std::fprintf( out, "]}\n" );
+    std::fclose( out );
+}
+
+void dump_vehicle_boarding( const std::string &path )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+
+    map &here = get_map();
+    const tripoint_bub_ms origin = get_player_character().pos_bub( here );
+    for( int dx = -20; dx <= 20; dx++ ) {
+        for( int dy = -20; dy <= 20; dy++ ) {
+            const tripoint_bub_ms square = origin + tripoint_rel_ms( dx, dy, 0 );
+            here.ter_set( square, ter_id( "t_floor" ) );
+            here.furn_set( square, furn_str_id::NULL_ID() );
+        }
+    }
+
+    std::fprintf( out, "{\"harness\":\"vehicle_boarding\",\"version\":1,\"origin\":[%d,%d,%d],"
+                  "\"cases\":[", origin.x(), origin.y(), origin.z() );
+    bool first_case = true;
+    for( const char *type : { "car", "bicycle", "2seater2" } ) {
+        const tripoint_bub_ms start = origin + tripoint_rel_ms( 0, 8, 0 );
+        vehicle *veh = here.add_vehicle( vproto_id( type ), start, 0_degrees, 0, 0, false, true );
+        if( veh == nullptr ) {
+            std::fprintf( stderr, "harness: %s did not place\n", type );
+            continue;
+        }
+        int part = -1;
+        tripoint_bub_ms seat = start;
+        point_rel_ms mount( 0, 0 );
+        for( const vpart_reference &vpr : veh->get_all_parts() ) {
+            if( !vpr.has_feature( VPFLAG_BOARDABLE ) ) {
+                continue;
+            }
+            part = vpr.part_index();
+            mount = vpr.mount_pos();
+            seat = vpr.pos_bub( here );
+            break;
+        }
+        if( part < 0 ) {
+            std::fprintf( stderr, "harness: %s has no boardable part\n", type );
+            here.destroy_vehicle( veh );
+            continue;
+        }
+        Character &you = get_player_character();
+        you.setpos( here, seat );
+        const int weight = static_cast<int>( units::to_gram( you.get_weight() ) );
+        const int mass_before = static_cast<int>( units::to_gram( veh->total_mass( here ) ) );
+        here.board_vehicle( seat, &you );
+        const int mass_after = static_cast<int>( units::to_gram( veh->total_mass( here ) ) );
+        const bool boarded = you.in_vehicle;
+
+        std::fprintf( out,
+                      "%s{\"vehicle\":\"%s\",\"part\":%d,\"mount\":[%d,%d],\"square\":[%d,%d,0],"
+                      "\"weight_g\":%d,\"mass_before_g\":%d,\"mass_after_g\":%d,\"in_vehicle\":%s}",
+                      first_case ? "" : ",", type, part, mount.x(), mount.y(), seat.x(), seat.y(), weight,
+                      mass_before, mass_after, boarded ? "true" : "false" );
+        first_case = false;
+        // **Unboarding through the part is a rule of its own and is not recorded here yet.** Two attempts to record it in this dump both left the hull unchanged - the
+        // `veh_at` lookup behind it did not find the part the boarding had just used - so the dump keeps only what it can state exactly, and the unboarding rule is ported from
+        // the source with a transcribed case instead (`map.cpp:1420-1440`).
+        you.setpos( here, origin );
+        here.destroy_vehicle( veh );
+    }
+    std::fprintf( out, "]}\n" );
+    std::fclose( out );
+}
+
+void dump_vehicle_impact( const std::string &path )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+
+    map &here = get_map();
+    const tripoint_bub_ms origin = get_player_character().pos_bub( here );
+    for( int dy = -20; dy <= 20; dy++ ) {
+        for( int dx = -20; dx <= 20; dx++ ) {
+            const tripoint_bub_ms square = origin + tripoint_rel_ms( dx, dy, 0 );
+            here.ter_set( square, ter_id( "t_floor" ) );
+            here.furn_set( square, furn_str_id::NULL_ID() );
+        }
+    }
+
+    std::fprintf( out, "{\"harness\":\"vehicle_impact\",\"version\":1,\"origin\":[%d,%d,%d],"
+                  "\"cases\":[", origin.x(), origin.y(), origin.z() );
+    bool first_case = true;
+
+    struct impact_case {
+        const char *name;
+        const char *mover;
+        const char *target;
+        int speed;
+        int target_facing;
+    };
+    // Speeds in vehicle miles per hour hundredths: 400 is four miles an hour, 4000 is forty.
+    const impact_case cases[] = {
+        { "car_into_car_head_on", "car", "car", 400, 180 },
+        { "car_into_car_side", "car", "car", 400, 90 },
+        { "car_into_car_fast", "car", "car", 4000, 180 },
+        // **An offset hit, which is the only case that tells the two rules apart**: with both hulls on the mover's line, the perpendicular component is zero and a one-dimensional
+        // exchange answers the same numbers. Two squares across, and only the rule that keeps the sideways part can land the struck car's speed.
+        { "car_into_car_offset", "car", "car", 1000, 180 },
+        { "car_into_bicycle", "car", "bicycle", 1000, 180 },
+        { "bicycle_into_car", "bicycle", "car", 1000, 180 },
+    };
+
+    for( const impact_case &one : cases ) {
+        const tripoint_bub_ms start = origin + tripoint_rel_ms( 0, 10, 0 );
+        vehicle *mover = here.add_vehicle( vproto_id( one.mover ), start, 0_degrees, 100, 0, false, true );
+        // Six squares east: far enough that neither hull overlaps the other when placed, and reached in one step at speed four hundred.
+        // The offset case places the second hull two squares across; every other case lines them up, so only this one answers differently under a one-dimensional rule.
+        const bool offset = std::string( one.name ).find( "offset" ) != std::string::npos;
+        const tripoint_bub_ms target_at = start + tripoint_rel_ms( 6, offset ? -2 : 0, 0 );
+        vehicle *target = here.add_vehicle( vproto_id( one.target ), target_at,
+                                            units::from_degrees( one.target_facing ), 100, 0, false, true );
+        if( mover == nullptr || target == nullptr ) {
+            std::fprintf( stderr, "harness: %s hit %s did not place\n", one.mover, one.target );
+            for( const wrapped_vehicle &left : here.get_vehicles() ) {
+                here.destroy_vehicle( left.v );
+            }
+            continue;
+        }
+        mover->velocity = one.speed;
+        mover->cruise_velocity = one.speed;
+        mover->of_turn = 20.0f;
+        target->velocity = 0;
+
+        const int mover_before = mover->velocity;
+        const int target_before = target->velocity;
+        std::vector<std::pair<int, int>> mover_hp;
+        std::vector<std::pair<int, int>> target_hp;
+        for( int index = 0; index < mover->part_count(); index++ ) {
+            mover_hp.emplace_back( index, mover->part( index ).hp() );
+        }
+        for( int index = 0; index < target->part_count(); index++ ) {
+            target_hp.emplace_back( index, target->part( index ).hp() );
+        }
+
+        bool hit_a_vehicle = false;
+        int steps_taken = 0;
+        for( int step = 0; step < 12; step++ ) {
+            const int before = mover->velocity;
+            vehicle *after = mover->act_on_map( here );
+            steps_taken++;
+            if( after == nullptr ) {
+                // **The vehicle is still there**; the null says the step met another hull and the next turn lets it move away.
+                hit_a_vehicle = true;
+                break;
+            }
+            mover = after;
+            if( mover->velocity != before ) {
+                break;
+            }
+        }
+
+        // **The inputs the exchange divides by are recorded with the answer**, because a port whose car weighs something else would be red for a data reason and
+        // look like a rule that does not match: the two masses in kilogram, both rotated centres of mass, and both hull facings.
+        const point_rel_ms mover_cof = mover->rotated_center_of_mass( here );
+        const point_rel_ms target_cof = target->rotated_center_of_mass( here );
+        std::fprintf( out,
+                      "%s{\"name\":\"%s\",\"mover\":\"%s\",\"target\":\"%s\",\"speed\":%d,"
+                      "\"steps\":%d,\"hit_a_vehicle\":%s,\"mover_before\":%d,\"mover_after\":%d,"
+                      "\"target_before\":%d,\"target_after\":%d,"
+                      "\"mover_mass\":%.1f,\"target_mass\":%.1f,"
+                      "\"mover_cof\":[%d,%d],\"target_cof\":[%d,%d],"
+                      "\"mover_face\":%.1f,\"target_face\":%.1f,",
+                      first_case ? "" : ",", one.name, one.mover, one.target, one.speed, steps_taken,
+                      hit_a_vehicle ? "true" : "false", mover_before, mover->velocity, target_before,
+                      target->velocity,
+                      to_kilogram( mover->total_mass( here ) ), to_kilogram( target->total_mass( here ) ),
+                      mover_cof.x(), mover_cof.y(), target_cof.x(), target_cof.y(),
+                      units::to_degrees( mover->face.dir() ), units::to_degrees( target->face.dir() ) );
+        first_case = false;
+
+        std::fprintf( out, "\"mover_damage\":[");
+        bool first = true;
+        for( const std::pair<int, int> &entry : mover_hp ) {
+            const int after = mover->part( entry.first ).hp();
+            if( after != entry.second ) {
+                std::fprintf( out, "%s{\"part\":%d,\"before\":%d,\"after\":%d}", first ? "" : ",",
+                              entry.first, entry.second, after );
+                first = false;
+            }
+        }
+        std::fprintf( out, "],\"target_damage\":[");
+        first = true;
+        for( const std::pair<int, int> &entry : target_hp ) {
+            const int after = target->part( entry.first ).hp();
+            if( after != entry.second ) {
+                std::fprintf( out, "%s{\"part\":%d,\"before\":%d,\"after\":%d}", first ? "" : ",",
+                              entry.first, entry.second, after );
+                first = false;
+            }
+        }
+        std::fprintf( out, "]}" );
+
+        for( const wrapped_vehicle &left : here.get_vehicles() ) {
+            here.destroy_vehicle( left.v );
+        }
+    }
+
+    std::fprintf( out, "]}\n" );
+    std::fclose( out );
+}
