+void dump_fields( const std::string &path )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+    // **Version three carries the two processors' data.** `field_processor_extra_radiation` reads `extra_radiation_min/max` per intensity level and
+    // `field_processor_wandering_field` reads the type's `wandering_field` (`src/map_field.cpp:664-690`); without them in the dump a port cannot be told what the
+    // reference would have done, only what the fields look like.
+    // **Version four carries what falls.** `map::drop_fields` (`src/map.cpp:2977-2994`) moves a field to the level below only when the type's `accelerated_decay` is
+    // set, and `map::add_field` refuses to put a non-gaseous field on a square with no floor (`src/map.cpp:6531-6534`) - two flags, and without them a port cannot
+    // tell which fields fall and which may land.
+    // Version five carries `convection_temperature_mod`, the per-intensity number `get_convection_temperature` adds to a square's temperature
+    // (`src/game.cpp:1845-1853`).
+    std::fprintf( out, "{\"harness\":\"fields\",\"version\":5,\n\"prototypes\":[\n" );
+    bool first = true;
+    for( const field_type &field : get_all_field_types().get_all() ) {
+        std::fprintf( out, "%s\n{\"id\":\"%s\",\"num\":%d,\"priority\":%d,"
+                      "\"underwater_age_speedup\":%d,\"outdoor_age_speedup\":%d,"
+                      "\"percent_spread\":%d,\"half_life\":%d,\"linear_half_life\":%s,"
+                      "\"wandering_field\":\"%s\",\"accelerated_decay\":%s,\"phase\":\"%s\",\"levels\":[",
+                      first ? "" : ",", harness_escape( field.id.str() ).c_str(),
+                      static_cast<int>( field.id.id().to_i() ), field.priority,
+                      to_turns<int>( field.underwater_age_speedup ),
+                      to_turns<int>( field.outdoor_age_speedup ),
+                      field.percent_spread, to_turns<int>( field.half_life ),
+                      field.linear_half_life ? "true" : "false",
+                      harness_escape( field.wandering_field.str() ).c_str(),
+                      field.accelerated_decay ? "true" : "false",
+                      harness_escape( io::enum_to_string( field.phase ) ).c_str() );
+        bool first_level = true;
+        for( const field_intensity_level &level : field.intensity_levels ) {
+            std::fprintf( out, "%s\n{\"name\":\"%s\",\"sym\":%u,\"color\":\"%s\","
+                          "\"dangerous\":%s,\"transparent\":%s,\"translucency\":%.6g,\"move_cost\":%d,"
+                          "\"concentration\":%d,\"light\":%.6g,"
+                          "\"upgrade_chance\":%d,\"upgrade_duration\":%d,"
+                          "\"spawn_chance\":%d,\"spawn_count\":%d,\"spawn_radius\":%d,"
+                          "\"spawn_group\":\"%s\","
+                          "\"convection\":%d,"
+                          "\"extra_radiation_min\":%d,\"extra_radiation_max\":%d}",
+                          first_level ? "" : ",", harness_escape( level.name.translated() ).c_str(),
+                          level.symbol, string_from_color( level.color ).c_str(),
+                          level.dangerous ? "true" : "false",
+                          level.transparent ? "true" : "false",
+                          static_cast<double>( level.translucency ), level.move_cost,
+                          level.concentration, static_cast<double>( level.light_emitted ),
+                          level.intensity_upgrade_chance,
+                          // The decay's own clock. A field loses a level when the calendar passes the deadline this half-life sets, so a dump without it leaves a port
+                          // to guess - and the port guessed a million turns, which keeps a mist alive that the reference clears in two.
+                          to_turns<int>( level.intensity_upgrade_duration ),
+                          level.monster_spawn_chance, level.monster_spawn_count,
+                          level.monster_spawn_radius,
+                          harness_escape( level.monster_spawn_group.str() ).c_str(),
+                          level.convection_temperature_mod,
+                          level.extra_radiation_min, level.extra_radiation_max );
+            first_level = false;
+        }
+        std::fprintf( out, "]}" );
+        first = false;
+    }
+    std::fprintf( out, "]}\n" );
+    std::fclose( out );
+}
