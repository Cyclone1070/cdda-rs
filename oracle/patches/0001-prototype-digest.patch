+void dump_vehicle_collision( const std::string &path )
+{
+    static const std::string structure_location( "structure" );
+    static const std::array<const char *, 5> type_names = {
+        "nothing", "body", "veh", "bashable", "other"
+    };
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+
+    map &here = get_map();
+    const vproto_id type( "bicycle" );
+    if( !type.is_valid() ) {
+        std::fprintf( stderr, "harness: bicycle is not a valid prototype\n" );
+        std::fclose( out );
+        return;
+    }
+
+    const tripoint_bub_ms origin = get_player_character().pos_bub( here );
+    for( int dx = -12; dx <= 12; dx++ ) {
+        for( int dy = -12; dy <= 12; dy++ ) {
+            const tripoint_bub_ms square = origin + tripoint_rel_ms( dx, dy, 0 );
+            here.ter_set( square, ter_id( "t_floor" ) );
+            here.furn_set( square, furn_str_id::NULL_ID() );
+        }
+    }
+
+    vehicle *first = here.add_vehicle( type, origin, 0_degrees, 0, 0, false, true );
+    if( first == nullptr ) {
+        std::fprintf( stderr, "harness: collision placement failed at %d,%d\n", origin.x(), origin.y() );
+        std::fclose( out );
+        return;
+    }
+    // `map::move_vehicle` fills the turned precalc before it asks about collisions (`map.cpp:803-805`), and the projection reads it (`vehicle.cpp:8222`). Without this
+    // call every part projects to the vehicle's own square and the answer is about the wrong squares.
+    first->precalc_mounts( 1, 0_degrees, first->pivot_point( here ) );
+
+    std::fprintf( out, "{\"harness\":\"vehicle_collision\",\"version\":2,\"vehicle\":\"%s\",",
+                  type.str().c_str() );
+    std::fprintf( out, "\"origin\":[%d,%d,%d],\"cases\":[", origin.x(), origin.y(), origin.z() );
+    bool first_case = true;
+
+    // One case: the world as it stands, the displacement, and what detect-only collision answers. `obstacle_at` names a second vehicle's origin when one is present, and
+    // `creature_at` names the creature that was hit, so the port can rebuild the same situation instead of guessing it.
+    const auto dump_case = [&]( const char *name, int dx, int dy, const tripoint_bub_ms &obstacle,
+                                bool has_obstacle, const char *terrain = nullptr ) {
+        std::vector<veh_collision> colls;
+        // `map::move_vehicle` cancels the displacement the pivot's move would add before it asks about collisions (`map.cpp:803-810`), and the
+        // projection reads the turned precalc. Passing the raw displacement here measures a projection nobody in the game ever asks for.
+        first->precalc_mounts( 1, 0_degrees, first->pivot_point( here ) );
+        const tripoint_rel_ms dp1 = tripoint_rel_ms( dx, dy, 0 ) - first->pivot_displacement();
+        const bool hit = first->collision( here, colls, dp1, true, false );
+        std::fprintf( out, "%s{\"name\":\"%s\",\"dp\":[%d,%d],\"hit\":%d", first_case ? "" : ",",
+                      name, dx, dy, hit ? 1 : 0 );
+        first_case = false;
+        if( has_obstacle ) {
+            std::fprintf( out, ",\"obstacle_at\":[%d,%d,%d]", obstacle.x(), obstacle.y(), obstacle.z() );
+        }
+        if( terrain != nullptr ) {
+            std::fprintf( out, ",\"terrain\":\"%s\",\"terrain_at\":[%d,%d,%d]", terrain, obstacle.x(),
+                          obstacle.y(), obstacle.z() );
+        }
+        if( hit && !colls.empty() ) {
+            const veh_collision &coll = colls.front();
+            std::fprintf( out,
+                          ",\"type\":\"%s\",\"part\":\"%s\",\"part_index\":%d,\"target\":\"%s\","
+                          "\"target_part\":%d",
+                          type_names.at( static_cast<size_t>( coll.type ) ),
+                          first->part( coll.part ).info().id.str().c_str(), coll.part,
+                          escaped( coll.target_name ).c_str(), coll.target_part );
+            if( coll.type == veh_coll_body ) {
+                Creature *critter = static_cast<Creature *>( coll.target );
+                const tripoint_bub_ms at = critter->pos_bub( here );
+                std::fprintf( out, ",\"creature_at\":[%d,%d,%d]", at.x(), at.y(), at.z() );
+            }
+        }
+        std::fprintf( out, "}" );
+    };
+
+    // A second bicycle three squares east: its trailing parts stand two squares ahead of the first one's leading frame, and `add_vehicle` refuses an overlap.
+    const tripoint_bub_ms obstacle = origin + tripoint_rel_ms( 3, 0, 0 );
+    vehicle *second = here.add_vehicle( type, obstacle, 0_degrees, 0, 0, false, true );
+    const tripoint_bub_ms obstacle_actual = second == nullptr ? obstacle : second->pos_bub( here );
+    if( second == nullptr ) {
+        std::fprintf( stderr, "harness: the second bicycle did not place at %d,%d\n", obstacle.x(),
+                      obstacle.y() );
+        std::fclose( out );
+        return;
+    }
+    dump_case( "east_into_vehicle", 1, 0, obstacle_actual, true );
+
+    here.destroy_vehicle( second );
+
+    // Terrain in front: the leading frame's destination is two squares east, so whatever is under that square is what it would hit
+    // (`vehicle_move.cpp:950-970`). A plain floor has a bash block too - for a fall through it - and the rule excludes it by its move cost.
+    const tripoint_bub_ms ahead = origin + tripoint_rel_ms( 2, 0, 0 );
+    for( const char *terrain : { "t_wall", "t_floor", "t_open_air", "t_underbrush" } ) {
+        here.ter_set( ahead, ter_id( terrain ) );
+        dump_case( terrain, 1, 0, ahead, false, terrain );
+    }
+    here.ter_set( ahead, ter_id( "t_floor" ) );
+
+    // A zombie two squares east, where the leading frame would go.
+    g->place_critter_at( mtype_id( "mon_zombie" ), origin + tripoint_rel_ms( 2, 0, 0 ) );
+    dump_case( "east_into_creature", 1, 0, tripoint_bub_ms(), false );
+    // North and south, with the zombie out of the way.
+    dump_case( "north", 0, 1, tripoint_bub_ms(), false );
+    dump_case( "south", 0, -1, tripoint_bub_ms(), false );
+
+    // What the projection saw, so the port can be checked against the same squares rather than against a guess about the pivot.
+    const point_rel_ms pivot = first->pivot_point( here );
+    std::fprintf( out, "],\"pivot\":[%d,%d],\"parts\":[", pivot.x(), pivot.y() );
+    first->precalc_mounts( 1, 0_degrees, first->pivot_point( here ) );
+    first->part_project_points( tripoint_rel_ms( 1, 0, 0 ) - first->pivot_displacement() );
+    bool first_part = true;
+    for( int p = 0; p < first->part_count(); p++ ) {
+        const vehicle_part &vp = first->part( p );
+        if( vp.removed || !vp.is_real_or_active_fake() ) {
+            continue;
+        }
+        const vpart_info &info = vp.info();
+        if( !vp.is_fake && info.location != structure_location && !info.has_flag( VPFLAG_ROTOR ) ) {
+            continue;
+        }
+        const tripoint_bub_ms standing = first->bub_part_pos( here, p );
+        const tripoint_bub_ms projected = here.get_bub( vp.next_pos );
+        std::fprintf( out,
+                      "%s{\"index\":%d,\"part\":\"%s\",\"at\":[%d,%d,%d],\"next\":[%d,%d,%d]}",
+                      first_part ? "" : ",", p, info.id.str().c_str(), standing.x(), standing.y(),
+                      standing.z(), projected.x(), projected.y(), projected.z() );
+        first_part = false;
+    }
+    std::fprintf( out, "]}\n" );
+    std::fclose( out );
+}
