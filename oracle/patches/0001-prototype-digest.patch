+void dump_sun_internals( const std::string &path )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+    // **The calendar is set from the option before sampling**, because it is not set yet when this
+    // dump runs: `calendar::year_length()` is still the unconfigured four days, while the options
+    // table already answers ninety-one. Without this line the samples are computed on a four-day
+    // year and agree with nothing that runs later.
+    calendar::set_season_length( ::get_option<int>( "SEASON_LENGTH" ) );
+
+    // The options the run used, because the numbers below depend on them: the year length enters
+    // `angle_per_day` directly, so a sample taken with one-day seasons and a sample taken with
+    // ninety-one-day seasons are not comparable at all.
+    std::fprintf( out,
+                  "{\"harness\":\"sun-internals\",\"version\":2,\n"
+                  "\"options\":{\"SEASON_LENGTH\":%d,\"ETERNAL_SEASON\":%s},\n\"samples\":[",
+                  ::get_option<int>( "SEASON_LENGTH" ),
+                  calendar::eternal_season() ? "true" : "false" );
+    bool first = true;
+    // The turns around the sunrise the environment dump disagreed about: one every hundred turns
+    // across the first hour after midnight, plus the reference's own sunrise for that day.
+    std::vector<int> turns;
+    for( int turn = 0; turn <= 4 * 3600; turn += 100 ) {
+        turns.push_back( turn );
+    }
+    turns.push_back( to_turn<int>( sunrise( calendar::turn_zero ) ) );
+    turns.push_back( to_turn<int>( sunset( calendar::turn_zero ) ) );
+    for( int turn : turns ) {
+        const time_point t = calendar::turn_zero + time_duration::from_turns( turn );
+        const std::array<double, 6> internals = harness_sun_internals( t );
+        std::fprintf( out,
+                      "%s\n{\"turn\":%d,\"ra\":%.9f,\"dec\":%.9f,\"sidereal\":%.9f,"
+                      "\"hour_angle\":%.9f,\"days\":%.12f,\"latitude\":%.9f}",
+                      first ? "" : ",", turn, internals[0], internals[1], internals[2],
+                      internals[3], internals[4], internals[5] );
+        first = false;
+    }
+    std::fprintf( out, "]}\n" );
+    std::fclose( out );
+}
