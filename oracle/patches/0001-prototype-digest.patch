+        if( !type->comestible ) {
+            continue;
+        }
+        const islot_comestible &slot = *type->comestible;
+        ++count;
+        std::fprintf( out,
+                      "%s{\"id\":\"%s\",\"comestible_type\":\"%s\",\"tool\":\"%s\",\"charges\":%d,"
+                      "\"stack_size\":%d,\"quench\":%d,\"fun\":%d,\"stim\":%d,\"sleepiness_mod\":%d,"
+                      "\"healthy\":%d,\"parasites\":%d,\"spoils_in\":%d,\"monotony_penalty\":%d,"
+                      "\"calories\":%lld,\"cooks_like\":\"%s\",\"smoking_result\":\"%s\","
+                      "\"addiction_potential\":%d,\"nutr\":%d,\"petfood\":[",
+                      first ? "" : ",\n", harness_escape( type->get_id().str() ).c_str(),
+                      harness_escape( slot.comesttype ).c_str(), harness_escape( slot.tool.str() ).c_str(),
+                      slot.def_charges, slot.stack_size, slot.quench, slot.harness_fun(), slot.stim,
+                      slot.sleepiness_mod, slot.healthy, slot.parasites,
+                      to_turns<int>( slot.spoils ), slot.harness_monotony_penalty(),
+                      static_cast<long long>( slot.harness_calories() ), harness_escape( slot.cooks_like.str() ).c_str(),
+                      harness_escape( slot.smoking_result.str() ).c_str(),
+                      slot.harness_addict_potential(), slot.get_default_nutr() );
+        bool first_pet = true;
+        for( const std::string &kind : slot.petfood ) {
+            std::fprintf( out, "%s\"%s\"", first_pet ? "" : ",", harness_escape( kind ).c_str() );
+            first_pet = false;
+        }
+        std::fprintf( out, "],\"addictions\":{" );
+        bool first_addiction = true;
+        for( const std::pair<const addiction_id, int> &entry : slot.addictions ) {
+            std::fprintf( out, "%s\"%s\":%d", first_addiction ? "" : ",",
+                          harness_escape( entry.first.str() ).c_str(), entry.second );
+            first_addiction = false;
+        }
+        std::fprintf( out, "},\"vitamins\":{" );
+        bool first_vitamin = true;
+        for( const std::pair<const vitamin_id, int> &entry : slot.harness_vitamins() ) {
+            std::fprintf( out, "%s\"%s\":%d", first_vitamin ? "" : ",",
+                          harness_escape( entry.first.str() ).c_str(), entry.second );
+            first_vitamin = false;
+        }
+        std::fprintf( out, "},\"contamination\":{" );
+        bool first_disease = true;
+        for( const std::pair<const diseasetype_id, float> &entry : slot.contamination ) {
+            std::fprintf( out, "%s\"%s\":%.6g", first_disease ? "" : ",",
+                          harness_escape( entry.first.str() ).c_str(), entry.second );
+            first_disease = false;
+        }
+        std::fprintf( out, "},\"freezing_point\":%.6g,\"primary_material\":\"%s\",\"rot_spawn\":{\"monster\":\"%s\","
+                      "\"group\":\"%s\"},\"consumption_eocs\":[",
+                      slot.freeze_point, harness_escape( slot.primary_material.str() ).c_str(),
+                      harness_escape( slot.rot_spawn.rot_spawn_monster.str() ).c_str(),
+                      harness_escape( slot.rot_spawn.rot_spawn_group.str() ).c_str() );
+        bool first_eoc = true;
+        for( const effect_on_condition_id &eoc : slot.consumption_eocs ) {
+            std::fprintf( out, "%s\"%s\"", first_eoc ? "" : ",", harness_escape( eoc.str() ).c_str() );
+            first_eoc = false;
