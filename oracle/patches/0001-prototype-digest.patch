+/// How far a per-turn modifier is allowed to move a value: `bound_mod_to_vals` (`src/cata_utility.cpp:199-208`).
+///
+/// Every "the effect moves your hunger by three, but not past its stated ceiling" in `process_one_effect` goes through this, and it has two rules that a clamp written
+/// from instinct gets wrong: a ceiling or a floor of **zero means no limit at all** rather than "clamped to zero", and the answer is the **movement** rather than the
+/// new value, so the caller adds it back. The grid crosses both signs, both limits and the zero cases.
+void dump_bound_mod( const std::string &path )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+    static const std::array<int, 5> values = { { -100, -5, 0, 5, 100 } };
+    static const std::array<int, 7> mods = { { -60, -10, -1, 0, 1, 10, 60 } };
+    static const std::array<int, 5> limits = { { 0, -20, 5, 20, 100 } };
+    std::fprintf( out, "{\"harness\":\"bound-mod\",\"version\":1,\"cases\":[\n" );
+    bool first = true;
+    int cases = 0;
+    for( const int value : values ) {
+        for( const int mod : mods ) {
+            for( const int maximum : limits ) {
+                for( const int minimum : limits ) {
+                    ++cases;
+                    std::fprintf( out, "%s{\"val\":%d,\"mod\":%d,\"max\":%d,\"min\":%d,\"bounded\":%d}",
+                                  first ? "" : ",\n", value, mod, maximum, minimum,
+                                  bound_mod_to_vals( value, mod, maximum, minimum ) );
+                    first = false;
+                }
+            }
+        }
+    }
+    std::fprintf( out, "\n],\"count\":%d}\n", cases );
+    std::fclose( out );
+}
+
+/// Whether an effect's per-turn something fires this turn: `effect::activated` (`src/effect.cpp:1360-1394`).
+///
+/// This is the chance arithmetic plus two things the percentage does not have: the **tick clock**, which decides whether this is a turn the thing can happen at all
+/// (`( when - turn_zero ) % tick == 0`), and the **dice**, one uniform float per roll compared against the chance.
+///
+/// Each case records the die the reference rolled and the answer it gave, so the port replays the same uniform float rather than rolling its own — a rule and its dice
+/// on one recording.
+void dump_effect_activated( const std::string &path )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+    static const std::array<int, 3> values = { { 0, 1, 3 } };
+    static const std::array<double, 2> mods = { { 1.0, 2.0 } };
+    static const std::array<int, 3> turns = { { 0, 1, 2 } };
+    constexpr unsigned seed = 12345;
+    std::fprintf( out, "{\"harness\":\"effect-activated\",\"version\":1,\"seed\":%u,\"cases\":[\n", seed );
+    int rolled = 0;
+    bool first_case = true;
+    int cases = 0;
+    int fired = 0;
+    for( const std::pair<const efftype_id, effect_type> &entry : get_effect_types() ) {
+        const effect_type &type = entry.second;
+        const auto &table = ::oracle_effect_reader::mod_data( type );
+        if( table.empty() ) {
+            continue;
+        }
+        std::vector<std::string> names;
+        for( const auto &group : table ) {
+            for( const auto &cell : group.second ) {
+                const uint8_t action = static_cast<uint8_t>( cell.first & 0xFFU );
+                if( action == static_cast<uint8_t>( mod_action::CHANCE_TOP ) ||
+                    action == static_cast<uint8_t>( mod_action::TICK ) ) {
+                    names.push_back( group.first );
+                    break;
+                }
+            }
+        }
+        if( names.empty() ) {
+            continue;
+        }
+        std::sort( names.begin(), names.end() );
+        names.erase( std::unique( names.begin(), names.end() ), names.end() );
+        for( const std::string &name : names ) {
+            for( int intensity = 1; intensity <= 4; ++intensity ) {
+                effect probe( effect_source::empty(), &type, 1_hours, bodypart_str_id( "torso" ), false,
+                              intensity, calendar::turn_zero );
+                for( const int val : values ) {
+                    for( const double mod : mods ) {
+                        for( const int turn : turns ) {
+                            const time_point when = calendar::turn_zero + time_duration::from_turns( turn );
+                            // One die per case, and a different seed each time so the roll is not the same float fifteen thousand times: seed, take the die, put the
+                            // engine back, and let the rule roll it. What the rule consumed is measured too — the second draw from the seed tells us whether the first
+                            // was taken, which is how the gate can hold the port to drawing on the same cases and not on the others.
+                            const unsigned case_seed = seed + static_cast<unsigned>( cases );
+                            rng_set_engine_seed( case_seed );
+                            const double roll = rng_float( 0.0, 1.0 );
+                            const double second = rng_float( 0.0, 1.0 );
+                            rng_set_engine_seed( case_seed );
+                            const bool answer = probe.activated( when, name, val, false, mod );
+                            // `rng_float` pulls more than one engine value, so the tell is not "a different number" but "the *second* call's number": if the rule
+                            // took a draw the stream has moved on by exactly one call and the next call answers what `second` did; if it took none, the next call
+                            // repeats `roll`.
+                            const double after = rng_float( 0.0, 1.0 );
+                            const bool consumed = after == second;
+                            ++cases;
+                            if( answer ) {
+                                ++fired;
+                            }
+                            if( consumed ) {
+                                ++rolled;
+                            }
+                            std::fprintf( out,
+                                          "%s{\"id\":\"%s\",\"arg\":\"%s\",\"intensity\":%d,\"val\":%d,\"mod\":%g,"
+                                          "\"turn\":%d,\"roll\":%.17g,\"dice\":%d,\"answer\":%s}",
+                                          first_case ? "" : ",\n", harness_escape( entry.first.str() ).c_str(),
+                                          harness_escape( name ).c_str(), intensity, val, mod, turn, roll,
+                                          consumed ? 1 : 0, answer ? "true" : "false" );
+                            first_case = false;
+                        }
+                    }
+                }
+            }
+        }
+    }
+    std::fprintf( out, "\n],\"count\":%d,\"fired\":%d,\"rolled\":%d}\n", cases, fired, rolled );
+    std::fclose( out );
+}
+
+/// How likely an effect's per-turn something is to happen: `effect::get_percentage` (`src/effect.cpp:1324-1356`).
+///
+/// This is the arithmetic behind every "you vomit", "you cough", "the pain rises" in the game, and it is four rules stacked in a way no reading guesses right. The
+/// chance is a hundred percent divided by the top of the range, or multiplied by top over bottom when a bottom is given; the tick divides it further, except that a
+/// tick of **zero means one** and a tick below zero means the thing cannot happen at all; and a `val` of zero with no stated chance answers zero rather than a default.
+///
+/// The percentages are recorded for every argument that has a chance or a tick, at four intensities, two reduction levels and three values — the whole cross product,
+/// because the rules interact.
+void dump_effect_chances( const std::string &path )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+    static const std::array<int, 3> values = { { 0, 1, 3 } };
+    std::fprintf( out, "{\"harness\":\"effect-chances\",\"version\":1,\"values\":[0,1,3],\"types\":[\n" );
+    bool first_type = true;
+    int entries = 0;
+    for( const std::pair<const efftype_id, effect_type> &entry : get_effect_types() ) {
+        const effect_type &type = entry.second;
+        const auto &table = ::oracle_effect_reader::mod_data( type );
+        if( table.empty() ) {
+            continue;
+        }
+        std::vector<std::string> names;
+        for( const auto &group : table ) {
+            bool interesting = false;
+            for( const auto &cell : group.second ) {
+                const uint8_t action = static_cast<uint8_t>( cell.first & 0xFFU );
+                if( action == static_cast<uint8_t>( mod_action::CHANCE_TOP ) ||
+                    action == static_cast<uint8_t>( mod_action::TICK ) ) {
+                    interesting = true;
+                }
+            }
+            if( interesting ) {
+                names.push_back( group.first );
+            }
+        }
+        if( names.empty() ) {
+            continue;
+        }
+        std::sort( names.begin(), names.end() );
+        std::fprintf( out, "%s{\"id\":\"%s\",\"chances\":[", first_type ? "" : ",\n",
+                      harness_escape( entry.first.str() ).c_str() );
+        first_type = false;
+        bool first_entry = true;
+        for( const std::string &name : names ) {
+            for( int intensity = 1; intensity <= 4; ++intensity ) {
+                effect probe( effect_source::empty(), &type, 1_hours, bodypart_str_id( "torso" ), false,
+                              intensity, calendar::turn_zero );
+                // Only the effect's own path is recorded. The reduced path is the same formula over the level-one cells, which `--dump-effect-mods` already pins; running
+                // it here through `resists_effect` is not possible on a synthetic effect, and hand-writing the formula into the oracle would only record itself.
+                for( const int val : values ) {
+                    const double percentage = probe.get_percentage( name, val, false );
+                    if( !std::isfinite( percentage ) ) {
+                        // A zero top with a nonzero value is a division by zero; the reference answers an infinity and does nothing with it.
+                        continue;
+                    }
+                    ++entries;
+                    std::fprintf( out, "%s{\"arg\":\"%s\",\"intensity\":%d,\"val\":%d,\"percentage\":%.17g}",
+                                  first_entry ? "" : ",", harness_escape( name ).c_str(), intensity, val,
+                                  percentage );
+                    first_entry = false;
+                }
+            }
+        }
+        std::fprintf( out, "]}" );
+    }
+    std::fprintf( out, "\n],\"count\":%d}\n", entries );
+    std::fclose( out );
+}
+
+/// Every effect type's per-intensity modifier table, and the value each entry answers.
+///
+/// `load_mod_data` (`src/effect.cpp:333-560`) turns `base_mods` and `scaling_mods` into one table per effect: an **effect name** (`"PAIN"`, `"HUNGER"`, `"SPEED"`, …), an
+/// **action** (`pain_min`, `pain_max`, `pain_chance`, `pain_tick`, …) and a **reduction level**, which is the index in the JSON array — `pain_min: [ 1, 0 ]` is one at
+/// the base level and zero when the effect is reduced. Each cell holds two numbers, a base and a scaling, and `get_mod_value` (`src/effect.cpp:563-582`) reads them as
+/// `base + scaling * (intensity - 1)`.
+///
+/// That makes the table data and the value arithmetic a single thing worth recording: the recording holds both, so the port's loader and its arithmetic are held to the
+/// same artifact.
+void dump_effect_mods( const std::string &path )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+    std::fprintf( out, "{\"harness\":\"effect-mods\",\"version\":1,\"types\":[\n" );
+    bool first_type = true;
+    int with_mods = 0;
+    int entries = 0;
+    for( const std::pair<const efftype_id, effect_type> &entry : get_effect_types() ) {
+        const effect_type &effect = entry.second;
+        const auto &table = ::oracle_effect_reader::mod_data( effect );
+        if( table.empty() ) {
+            continue;
+        }
+        ++with_mods;
+        std::fprintf( out, "%s{\"id\":\"%s\",\"mods\":[", first_type ? "" : ",\n",
+                      harness_escape( entry.first.str() ).c_str() );
+        first_type = false;
+        std::vector<std::string> names;
+        names.reserve( table.size() );
+        for( const auto &group : table ) {
+            names.push_back( group.first );
+        }
+        std::sort( names.begin(), names.end() );
+        bool first_mod = true;
+        for( const std::string &name : names ) {
+            const auto &cells = table.at( name );
+            std::vector<uint32_t> keys;
+            keys.reserve( cells.size() );
+            for( const auto &cell : cells ) {
+                keys.push_back( cell.first );
+            }
+            std::sort( keys.begin(), keys.end() );
+            for( const uint32_t key : keys ) {
+                const modifier_value_arr &values = cells.at( key );
+                ++entries;
+                std::fprintf( out,
+                              "%s{\"arg\":\"%s\",\"action\":%u,\"level\":%u,\"base\":%.17g,\"scaling\":%.17g,"
+                              "\"values\":[",
+                              first_mod ? "" : ",", harness_escape( name ).c_str(),
+                              key & 0xFFU, ( key >> 8 ) & 0xFFU,
+                              values[static_cast<size_t>( mod_type::BASE_MOD )],
+                              values[static_cast<size_t>( mod_type::SCALING_MOD )] );
+                for( int intensity = 1; intensity <= 4; ++intensity ) {
+                    std::fprintf( out, "%s%.17g", intensity == 1 ? "" : ",",
+                                  effect.get_mod_value( name, static_cast<mod_action>( key & 0xFFU ),
+                                                        static_cast<uint8_t>( ( key >> 8 ) & 0xFFU ), intensity ) );
+                }
+                std::fprintf( out, "]}" );
+                first_mod = false;
+            }
+        }
+        std::fprintf( out, "]}" );
+    }
+    std::fprintf( out, "\n],\"count\":%d,\"types_with_mods\":%d}\n", entries, with_mods );
+    std::fclose( out );
+}
