+/// The reference's own answer to "how likely is a critical", swept over the inputs the rule reads.
+///
+/// Reference: `Character::crit_chance` (`src/melee.cpp:1116-1193`). **The three chances multiply**, and a roll past one and a half times the target's dodge adds the chance of a **pair** -
+/// which is arithmetic a port can transcribe wrongly in several ways that all look plausible. This sweep is the recording: six weapon accuracies, the unarmed skill's own branch, dexterity,
+/// perception, the weapon's skill and the melee skill, each at four levels, against a roll at and either side of the doubling threshold.
+void dump_crit_chance( const std::string &path )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+    avatar &u = get_avatar();
+    u.set_body();
+    const std::array<int, 4> levels = { { 0, 3, 7, 10 } };
+    const std::array<std::pair<const char *, int>, 4> weapons = { {
+            { "null", 0 },
+            { "crowbar", 0 },
+            { "knife_combat", 0 },
+            { "sword_wood", 0 },
+        } };
+    std::fprintf( out, "{\"rows\":[" );
+    bool first_row = true;
+    for( const auto &weapon : weapons ) {
+        item weap( itype_id( weapon.first ), calendar::turn, 1 );
+        for( int dexterity : levels ) {
+            for( int perception : levels ) {
+                for( int weapon_skill : levels ) {
+                    for( int melee_skill : levels ) {
+                        // **`_cur` is what the rule reads**: `crit_chance` asks `dex_cur` and `per_cur` (`melee.cpp:1141`), and the first version of this dump set only the maxima,
+                        // so every row was labelled with a dexterity the reference never used.
+                        u.str_cur = 10;
+                        u.str_max = 10;
+                        u.dex_cur = dexterity;
+                        u.dex_max = dexterity;
+                        u.per_cur = perception;
+                        u.per_max = perception;
+                        // The reference's skill ids are file-local (`skill.cpp:31`), so the harness spells them the way the data does.
+                        const skill_id weapon_used = weap.melee_skill();
+                        u.set_skill_level( weapon_used.is_null() ? skill_id( "unarmed" ) : weapon_used, weapon_skill );
+                        u.set_skill_level( skill_id( "unarmed" ), weapon_skill );
+                        u.set_skill_level( skill_id( "melee" ), melee_skill );
+                        // The dodge is held at nothing so the doubling branch is decided by the roll alone, and the roll is swept at the three places that matter.
+                        const std::array<float, 3> rolls = { { 0.0f, 1.0f, 3.0f } };
+                        for( float roll : rolls ) {
+                            if( !first_row ) {
+                                std::fprintf( out, "," );
+                            }
+                            first_row = false;
+                            // **Two skill figures, because the rule reads two**: `weapon_skill` is the level set on the weapon's own skill (and on `unarmed`), while
+                            // `weapon_skill_level` is what `get_skill_level( weap.melee_skill() )` actually answers - **zero for a null weapon**, whose skill id is null. A dump with only the
+                            // first column says the reference used three where it used nothing.
+                            std::fprintf( out,
+                                          "{\"weapon\":\"%s\",\"dex\":%d,\"per\":%d,\"weapon_skill\":%d,\"weapon_skill_level\":%d,\"melee_skill\":%d,\"roll\":%.3f,\"chance\":%.6f}",
+                                          weapon.first, dexterity, perception, weapon_skill,
+                                          static_cast<int>( u.get_skill_level( weap.melee_skill() ) ), melee_skill,
+                                          static_cast<double>( roll ), u.crit_chance( roll, 0.0f, weap ) );
+                        }
+                    }
+                }
+            }
+        }
+    }
+    std::fprintf( out, "]}\n" );
+    std::fflush( out );
+    std::fclose( out );
+}
+
+/// What a swing costs in moves and stamina, swept over the inputs the two rules read.
+///
+/// Reference: `Character::attack_speed` (`src/melee.cpp:2668-2712`) and `Character::get_total_melee_stamina_cost` (`src/melee.cpp:970-996`). Both were transcribed into the port from the
+/// source and neither had ever been compared against the reference's own answer - the class of defect the crit-chance dump found twice. **The two are swept together** because they read the
+/// same character: the melee skill, dexterity, the stamina ratio, the stance and the weapon.
+void dump_swing_cost( const std::string &path )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+    avatar &u = get_avatar();
+    u.set_body();
+    u.str_cur = 10;
+    u.str_max = 10;
+    u.dex_max = 20;
+    const std::array<std::pair<const char *, int>, 6> weapons = { {
+            { "null", 0 },
+            { "crowbar", 0 },
+            { "knife_combat", 0 },
+            { "sword_wood", 0 },
+            { "mace", 0 },
+            { "hammer", 0 },
+        } };
+    const std::array<int, 4> skills = { { 0, 3, 7, 10 } };
+    const std::array<int, 3> dexterities = { { 0, 8, 20 } };
+    const std::array<float, 3> stamina_ratios = { { 0.0f, 0.25f, 1.0f } };
+    // **The stances, because both rules read them and both have a branch for each**: `attack_speed` multiplies by four on the ground (`melee.cpp:2696-2704`) and the stamina rule's
+    // `stance_malus` is fifty there and twenty in a crouch (`melee.cpp:975-977`).
+    const std::array<const char *, 3> stances = { { "standing", "downed", "crouching" } };
+    std::fprintf( out, "{\"rows\":[" );
+    bool first_row = true;
+    for( const std::string &stance : stances ) {
+    if( stance == "downed" ) {
+        u.add_effect( efftype_id( "downed" ), 1_hours );
+    } else if( stance == "crouching" ) {
+        // **The downed effect is taken off again**, or the crouching rows inherit it and the dump says "crouching" about a body on the floor - which is what the first version of this
+        // sweep did, and what the port's own comparison caught: a crouched row answered -100 where the crouch's malus is twenty.
+        u.remove_effect( efftype_id( "downed" ) );
+        u.set_movement_mode( move_mode_id( "crouch" ) );
+    } else {
+        u.set_movement_mode( move_mode_id( "walk" ) );
+    }
+    for( const auto &weapon : weapons ) {
+        item weap( itype_id( weapon.first ), calendar::turn, 1 );
+        // **The crouch branch asks `unarmed_attack()`, which reads the item actually in hand** - so the weapon is wielded for that stance and put away for the others. Without this the
+        // crouching rows were the empty-handed case wearing a weapon's numbers, which is what the port's comparison found.
+        if( stance == "crouching" ) {
+            item held( itype_id( weapon.first ), calendar::turn, 1 );
+            u.wield( held );
+        } else {
+            u.remove_weapon();
+        }
+        for( int skill : skills ) {
+            u.set_skill_level( skill_id( "melee" ), skill );
+            for( int dexterity : dexterities ) {
+                u.dex_cur = dexterity;
+                // Both are plain ints (`character.h:3164-3165`): the reference keeps stamina as whole units, so the ratio is set with whole numbers too.
+                const int stamina_max = u.get_stamina_max();
+                for( float ratio : stamina_ratios ) {
+                    u.set_stamina( static_cast<int>( ratio * static_cast<float>( stamina_max ) ) );
+                    const double ratio_used = static_cast<double>( u.get_stamina() ) / static_cast<double>( stamina_max );
+                    if( !first_row ) {
+                        std::fprintf( out, "," );
+                    }
+                    first_row = false;
+                    std::fprintf( out,
+                                  "{\"weapon\":\"%s\",\"stance\":\"%s\",\"melee_skill\":%d,\"dexterity\":%d,\"stamina_ratio\":%.6f,"
+                                  "\"attack_speed\":%d,\"stamina_cost\":%d,\"weapon_time\":%d,"
+                                  "\"lift_mod\":%.6f,\"balance_mod\":%.6f}",
+                                  weapon.first, stance.c_str(), skill, dexterity, ratio_used, u.attack_speed( weap ),
+                                  u.get_total_melee_stamina_cost( &weap ), weap.attack_time( u ),
+                                  static_cast<double>( u.get_modifier( character_modifier_id( "melee_thrown_move_lift_mod" ) ) ),
+                                  static_cast<double>( u.get_modifier( character_modifier_id( "melee_thrown_move_balance_mod" ) ) ) );
+                }
+            }
+        }
+    }
+    }
+    std::fprintf( out, "]}\n" );
+    std::fflush( out );
+    std::fclose( out );
+    if( u.has_effect( efftype_id( "downed" ) ) ) {
+        u.remove_effect( efftype_id( "downed" ) );
+    }
+}
