+void dump_map( const std::string &path )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+    // One map chunk, exactly as the generator left it: the overmap terrain it belongs to, where it sits, and the
+    // terrain id of every square. A port that generates the same chunk has to produce these ids.
+    map &here = get_map();
+    // **The chunk the player stands in, not the buffer's corner.** `get_abs_sub` is the map object's own origin, which sits several
+    // submaps from the avatar; asking for its overmap square named a different chunk and then read squares outside the loaded buffer.
+    const tripoint_abs_omt omt = project_to<coords::omt>( get_avatar().pos_abs() );
+    const oter_id &oter = overmap_buffer.ter( omt );
+    std::fprintf( out, "{\"harness\":\"map\",\"version\":1,\"oter\":\"%s\",\"omt\":[%d,%d,%d],\"size\":%d,\"rows\":[\n",
+                  harness::harness_escape( oter.id().str() ).c_str(), omt.x(), omt.y(), omt.z(),
+                  SEEX * 2 );
+    const tripoint_abs_ms chunk_abs = project_to<coords::ms>( omt );
+    for( int y = 0; y < SEEY * 2; y++ ) {
+        std::fprintf( out, "%s[", y == 0 ? "" : ",\n" );
+        for( int x = 0; x < SEEX * 2; x++ ) {
+            // **Only squares the map holds are asked for.** A read outside the loaded bubble pulls in a submap, and then the
+            // overmap generates an OMT - which waits for input that a headless run never provides, so the dump hung thirteen
+            // rows in. An empty string says "this square was not loaded" rather than inventing terrain for it.
+            // **Ask for the square by its absolute position**, and let the map convert. Reading the buffer's corner instead asks for a
+            // square that may not be loaded, and an unloaded read triggers generation, which waits forever in a headless run. The
+            // conversion also means the answer is the chunk the overmap names rather than whichever chunk happens to sit at the origin.
+            const tripoint_bub_ms square = here.get_bub( chunk_abs + point( x, y ) );
+            if( here.inbounds( square ) ) {
+                const ter_id &ter = here.ter( square );
+                std::fprintf( out, "%s\"%s\"", x == 0 ? "" : ",", harness::harness_escape( ter.id().str() ).c_str() );
+            } else {
+                std::fprintf( out, "%s\"\"", x == 0 ? "" : "," );
+            }
+        }
+        std::fprintf( out, "]" );
+    }
+    std::fprintf( out, "\n]}\n" );
+    std::fclose( out );
+}
