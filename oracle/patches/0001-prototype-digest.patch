+/// Writes what every recipe **makes**, rather than what it asks for: the result rule and the byproduct rule are rules about produced things, and reading them out of the
+/// data is exactly the mistake `create_results` exists to prevent. For a batch of one and of two, the produced items are folded to `(item id, count)` - `item::count()`
+/// is the charge count for a stack and one for a single thing, which is the number the port keeps as a stack's charges.
+/** The name of a limb's kind, which the reference keeps as an enum with no printer of its own (`body_part_type::type`, `bodypart.h:174-197`). */
+static const char *harness_limb_kind( body_part_type::type kind )
+{
+    switch( kind ) {
+        case body_part_type::type::head:
+            return "head";
+        case body_part_type::type::torso:
+            return "torso";
+        case body_part_type::type::sensor:
+            return "sensor";
+        case body_part_type::type::mouth:
+            return "mouth";
+        case body_part_type::type::arm:
+            return "arm";
+        case body_part_type::type::hand:
+            return "hand";
+        case body_part_type::type::leg:
+            return "leg";
+        case body_part_type::type::foot:
+            return "foot";
+        case body_part_type::type::wing:
+            return "wing";
+        case body_part_type::type::tail:
+            return "tail";
+        case body_part_type::type::other:
+            return "other";
+        case body_part_type::type::num_types:
+            break;
+    }
+    return "other";
+}
