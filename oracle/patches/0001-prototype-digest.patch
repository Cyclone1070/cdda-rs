+void dump_vehicle_placement( const std::string &path )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+
+    map &here = get_map();
+    const vproto_id type( "2seater2" );
+    if( !type.is_valid() ) {
+        std::fprintf( stderr, "harness: 2seater2 is not a valid prototype\n" );
+        std::fclose( out );
+        return;
+    }
+
+    const tripoint_bub_ms origin = get_player_character().pos_bub( here );
+    // Floor a generous box first: `add_vehicle_to_map` refuses a vehicle that lands in deep water, and a fresh world can be anything.
+    for( int dx = -12; dx <= 12; dx++ ) {
+        for( int dy = -12; dy <= 12; dy++ ) {
+            const tripoint_bub_ms square = origin + tripoint_rel_ms( dx, dy, 0 );
+            here.ter_set( square, ter_id( "t_floor" ) );
+            here.furn_set( square, furn_str_id::NULL_ID() );
+        }
+    }
+
+    vehicle *veh = here.add_vehicle( type, origin, 0_degrees, 0, 0, false, true );
+    if( veh == nullptr ) {
+        std::fprintf( stderr,
+                      "harness: placement failed at %d,%d,%d: valid=%d inbounds=%d ter=%s furn=%s impassable=%d veh=%d\n",
+                      origin.x(), origin.y(), origin.z(), type.is_valid(), here.inbounds( origin ),
+                      here.ter( origin ).id().str().c_str(), here.furn( origin ).id().str().c_str(),
+                      here.impassable( origin ), here.veh_at( origin ) ? 1 : 0 );
+        std::fclose( out );
+        return;
+    }
+
+    (void)veh->get_points( true );
+
+    // Fill every tank and battery with a known amount, so `fuel_left` has numbers to answer about instead of an empty hull. `ammo_set` caps the amount at the
+    // part's own capacity and answers what it actually stored (`vehicle_part.cpp:324-345`); the dump records both.
+    for( const vpart_reference &vpr : veh->get_all_parts() ) {
+        if( vpr.part().is_tank() ) {
+            vpr.part().ammo_set( itype_id( "gasoline" ), 100 );
+        } else if( vpr.part().is_battery() ) {
+            vpr.part().ammo_set( itype_id( "battery" ), 100 );
+        }
+    }
+
+    std::fprintf( out, "{\"harness\":\"vehicle_placement\",\"version\":1,\"vehicle\":\"%s\",\"name\":\"%s\",",
+                  type.str().c_str(), veh->name.c_str() );
+    std::fprintf( out, "\"origin\":[%d,%d,%d],\"parts\":[", origin.x(), origin.y(), origin.z() );
+    bool first = true;
+    for( const vpart_reference &vpr : veh->get_all_parts() ) {
+        const tripoint_bub_ms at = vpr.pos_bub( here );
+        std::fprintf( out,
+                      "%s{\"mount\":[%d,%d],\"at\":[%d,%d],\"fuel_type\":\"%s\",\"fuel_store\":%d,\"tank\":%d,"
+                      "\"battery\":%d,\"ammo\":\"%s\",\"charges\":%d",
+                      first ? "" : ",", vpr.mount_pos().x(), vpr.mount_pos().y(), at.x(), at.y(),
+                      vpr.part().info().fuel_type.str().c_str(), vpr.part().is_fuel_store( false ) ? 1 : 0,
+                      vpr.part().is_tank() ? 1 : 0, vpr.part().is_battery() ? 1 : 0,
+                      vpr.part().ammo_current().str().c_str(),
+                      static_cast<int>( vpr.part().ammo_remaining() ) );
+        std::fprintf( out, ",\"fuel_opts\":[" );
+        bool first_fuel = true;
+        if( vpr.info().engine_info ) {
+            for( const itype_id &option : vpr.info().engine_info->fuel_opts ) {
+                std::fprintf( out, "%s\"%s\"", first_fuel ? "" : ",", escaped( option.str() ).c_str() );
+                first_fuel = false;
+            }
+        }
+        std::fprintf( out, "]}" );
+        first = false;
+    }
+    std::fprintf( out, "]}\n" );
+    std::fclose( out );
+
+    here.destroy_vehicle( veh );
+}
