+/// What the character remembers about a handful of squares.
+///
+/// `map_memory` (`src/map_memory.cpp`) is the map the character keeps in their head: a `memorized_tile` per square, holding the terrain and its subtile and rotation, a
+/// **decoration** with its own, and a symbol. Three writes fill it and one clears it, and the interesting one is the clear: `clear_tile_decoration` takes a **prefix** and
+/// only clears a decoration whose id starts with it - and when it does clear, it clears the symbol too, because the symbol was the decoration's.
+///
+/// The scripted sequence below is chosen so every branch is exercised: a decoration that matches its prefix, one that does not, one cleared with the empty prefix (which
+/// every id starts with), and a square written twice.
+void dump_memory( const std::string &path )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+    avatar &u = get_avatar();
+    const tripoint_abs_ms here = u.pos_abs();
+    // Region first: a memory submap that was never allocated refuses writes (`if( !sm.is_valid() ) return`), so a dump that wrote before preparing would record nothing
+    // and look like a rule about writing.
+    u.prepare_map_memory_region( here - tripoint_rel_ms( 30, 30, 0 ), here + tripoint_rel_ms( 30, 30, 0 ) );
+    const auto at = [&]( int dx, int dy ) {
+        return here + tripoint_rel_ms( dx, dy, 0 );
+    };
+    // A plain terrain write, with a rotation and a subtile.
+    u.memorize_terrain( at( 0, 0 ), "t_floor", 2, 1 );
+    // A terrain and a decoration, then the decoration cleared by its own prefix.
+    u.memorize_terrain( at( 1, 0 ), "t_pavement", 0, 0 );
+    u.memorize_decoration( at( 1, 0 ), "vp_frame", 3, 2 );
+    u.memorize_symbol( at( 1, 0 ), U'X' );
+    u.memorize_clear_decoration( at( 1, 0 ), "vp_" );
+    // A terrain, a decoration and a symbol, cleared with a prefix that does **not** match: nothing changes.
+    u.memorize_terrain( at( 2, 0 ), "t_dirt", 1, 3 );
+    u.memorize_decoration( at( 2, 0 ), "graffiti_hello", 0, 0 );
+    u.memorize_symbol( at( 2, 0 ), U'Y' );
+    u.memorize_clear_decoration( at( 2, 0 ), "vp_" );
+    // A decoration cleared with the empty prefix, which every id starts with.
+    u.memorize_decoration( at( 3, 0 ), "f_bench", 1, 1 );
+    u.memorize_symbol( at( 3, 0 ), U'Z' );
+    u.memorize_clear_decoration( at( 3, 0 ), "" );
+    // A square written twice: the second write keeps the rest of the tile.
+    u.memorize_terrain( at( 4, 0 ), "t_floor", 0, 0 );
+    u.memorize_decoration( at( 4, 0 ), "f_chair", 0, 0 );
+    u.memorize_terrain( at( 4, 0 ), "t_grass", 2, 1 );
+    // A square that is never written at all, which must answer the default tile.
+    std::fprintf( out, "{\"harness\":\"memory\",\"version\":1,\"squares\":[" );
+    bool first = true;
+    for( int dy = -1; dy <= 1; dy++ ) {
+        for( int dx = -1; dx <= 5; dx++ ) {
+            const memorized_tile &tile = u.get_memorized_tile( at( dx, dy ) );
+            std::fprintf( out,
+                          "%s{\"dx\":%d,\"dy\":%d,\"ter\":\"%s\",\"ter_subtile\":%d,\"ter_rotation\":%d,"
+                          "\"dec\":\"%s\",\"dec_subtile\":%d,\"dec_rotation\":%d,\"symbol\":%u}",
+                          first ? "" : ",", dx, dy, harness_escape( tile.get_ter_id() ).c_str(),
+                          tile.get_ter_subtile(), tile.get_ter_rotation(),
+                          harness_escape( tile.get_dec_id() ).c_str(), tile.get_dec_subtile(),
+                          tile.get_dec_rotation(), static_cast<unsigned>( tile.symbol ) );
+            first = false;
+        }
+    }
+    std::fprintf( out, "]}\n" );
+    std::fclose( out );
+}
+
+/// The temperature of a handful of squares, and the three terms each is made of.
+///
+/// `weather_manager::get_temperature` (`src/weather.cpp:956-982`) is four lines and a cache: a square below street level answers the weather generator's
+/// `base_temperature` and nothing else, and a square above it answers the weather's current temperature plus `get_heat_radiation` (`src/game.cpp:1755-1795`),
+/// `get_convection_temperature` (`src/game.cpp:1835-1855`) and the submap's own `temperature_mod` (`src/map.cpp:4936-4949`). The three are recorded apart because
+/// they are three different sets of data - a fire's strength and distance, a field's `convection_temperature_mod`, and a number that is usually zero - and a port that
+/// only recorded the total could be wrong in one of them and right by accident in the others.
+///
+/// Each square is recorded twice: once as the reference computes it, and once with the fire removed, so that "the fire is what warmed this square" is a number rather
+/// than an assumption.
+void dump_temperature( const std::string &path )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+    map &here = get_map();
+    weather_manager &weather = get_weather();
+    // **The game has to be past its first turn, or the three modifiers are skipped.** `get_temperature` only adds them `if( !g->new_game )`
+    // (`src/weather.cpp:968`), and `new_game` is cleared in `do_turn` (`src/do_turn.cpp:464`) - which the harness never reaches. Without this line the
+    // recording is the weather's temperature on every square and the three terms are recorded against a total that ignores them.
+    g->new_game = false;
+    const tripoint_bub_ms origin = get_avatar().pos_bub();
+    // **The room is uniform, and that is the point.** `get_heat_radiation` skips a heat source the location cannot see (`src/game.cpp:1787`), so a recording taken in
+    // mapgen - with walls between the query square and the fire - measures `sees` as much as it measures heat. Every square of a thirty-three square box is floor here, so
+    // the two sources are visible from every query square and the number recorded is the arithmetic.
+    for( int dy = -16; dy <= 16; dy++ ) {
+        for( int dx = -16; dx <= 16; dx++ ) {
+            const tripoint_bub_ms at = origin + tripoint_rel_ms( dx, dy, 0 );
+            here.ter_set( at, ter_str_id( "t_floor" ) );
+            here.field_at( at ).clear();
+        }
+    }
+    // **Two *terrain* sources and one cold field, and no fire anywhere.** A fire field of intensity three is **opaque**, so a fire used as a heat source also hides what is
+    // behind it: the first version of this fixture had a fire at one end of the corridor and recorded heat that rose and fell for reasons that had nothing to do with
+    // distance - the fire was visible from one square and not from the next. `fd_cold_air3` is a gas, so it is transparent, has no heat radiation, and still carries a
+    // negative `convection_temperature_mod`, which is the term this fixture is for.
+    const tripoint_bub_ms lava_at = origin + tripoint_rel_ms( 4, 1, 0 );
+    const tripoint_bub_ms water_at = origin + tripoint_rel_ms( 0, -2, 0 );
+    const tripoint_bub_ms fire_at = origin + tripoint_rel_ms( 8, 0, 0 );
+    here.ter_set( lava_at, ter_str_id( "t_lava" ) );
+    here.ter_set( water_at, ter_str_id( "t_water_hot" ) );
+    here.add_field( fire_at, fd_cold_air3, 1, 0_turns, false );
+    std::fprintf( out,
+                  "{\"harness\":\"temperature\",\"version\":1,\"weather\":%.9g,\"base\":%.9g,"
+                  "\"lava\":[%d,%d],\"water\":[%d,%d],\"fire\":[%d,%d],\"squares\":[",
+                  static_cast<double>( units::to_kelvin( weather.temperature ) ),
+                  static_cast<double>( units::to_kelvin( units::from_celsius(
+                          weather.get_cur_weather_gen().base_temperature ) ) ),
+                  lava_at.x() - origin.x(), lava_at.y() - origin.y(),
+                  water_at.x() - origin.x(), water_at.y() - origin.y(),
+                  fire_at.x() - origin.x(), fire_at.y() - origin.y() );
+    bool first = true;
+    for( int dx = 0; dx <= 8; dx++ ) {
+        const tripoint_bub_ms at = origin + tripoint_rel_ms( dx, 0, 0 );
+        const double heat = static_cast<double>( units::to_kelvin_delta( get_heat_radiation( at ) ) );
+        const double convection = static_cast<double>( units::to_kelvin_delta( get_convection_temperature( at ) ) );
+        const double map_mod = static_cast<double>( units::to_kelvin_delta( here.get_temperature_mod( at ) ) );
+        weather.clear_temp_cache();
+        const double total = static_cast<double>( units::to_kelvin( weather.get_temperature( at ) ) );
+        // What a square below street level answers, which ignores all three terms and the weather alike.
+        const tripoint_bub_ms below = at + tripoint_rel_ms( 0, 0, -1 );
+        here.ter_set( below, ter_str_id( "t_rock_floor" ) );
+        weather.clear_temp_cache();
+        const double underground = static_cast<double>( units::to_kelvin( weather.get_temperature( below ) ) );
+        std::fprintf( out,
+                      "%s{\"dx\":%d,\"ter\":\"%s\",\"field\":%d,\"heat\":%.9g,\"convection\":%.9g,"
+                      "\"map\":%.9g,\"total\":%.9g,\"underground\":%.9g}",
+                      first ? "" : ",", dx, harness_escape( here.ter( at ).id().str() ).c_str(),
+                      static_cast<int>( here.field_at( at ).field_count() ), heat, convection, map_mod,
+                      total, underground );
+        first = false;
+    }
+    std::fprintf( out, "]}\n" );
+    std::fclose( out );
+}
+
+/// What falls when a square loses its support.
+///
+/// `map::process_falling` (`src/map.cpp:3018-3035`) is a queue and a call to `drop_everything`, which is four rules in a row: creature, furniture, items, vehicle, fields
+/// (`src/map.cpp:2693-2705`) - and it only runs any of them when the square has no floor. What is recorded here is where each thing **ends up**, which is the part of the rule
+/// a modeller can be held to: a port can keep the arithmetic of the impact damage wrong and still move everything to the same square, but it cannot move things to a
+/// different square and be right.
+///
+/// Four columns: one level down, three levels down, a column with fields, and a column with furniture. Every column is open air the whole way, so every fixture is a
+/// square that genuinely has no floor; the run is `support_dirty` then `process_falling`, which is the same pair the game calls when a support is destroyed.
+void dump_falling( const std::string &path )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+    map &here = get_map();
+    const tripoint_bub_ms origin = get_avatar().pos_bub();
+    // The columns are a few squares apart, all over mapgen the fixture overwrites: open air all the way down, with a floor where the case says.
+    struct column {
+        int dx;
+        int levels;
+        bool fields;
+        bool furniture;
+        int items;
+        bool floor_here;
+    };
+    const std::array<column, 5> columns = { {
+            { -6, 1, false, false, 2, false }, // one level, two rocks
+            { -2, 3, false, false, 1, false }, // three levels, one rock
+            { 2, 1, true, false, 0, false },   // fields
+            { 6, 2, false, true, 0, false },   // furniture
+            { 10, 1, false, false, 1, true },  // a square that still has a floor: nothing falls
+        }
+    };
+    for( const column &c : columns ) {
+        const tripoint_bub_ms at = origin + tripoint_rel_ms( c.dx, 0, 0 );
+        // **The whole column is cleared, not just its terrain.** The first version of this fixture only set the terrain, and mapgen's furniture, items and fields were still
+        // there underneath it - a locker in a column that was supposed to hold one rock, junk items in another - so the recording was of the map with a hole punched in it
+        // rather than of the rule.
+        for( int level = 0; level >= -6; level-- ) {
+            const tripoint_bub_ms p = at + tripoint_rel_ms( 0, 0, level );
+            here.ter_set( p, ter_str_id( "t_open_air" ) );
+            here.furn_set( p, furn_str_id::NULL_ID() );
+            here.i_clear( p );
+            here.field_at( p ).clear();
+        }
+        // The floor the things land on, unless the case is a square that has its own.
+        here.ter_set( at + tripoint_rel_ms( 0, 0, c.floor_here ? 0 : -c.levels ),
+                      ter_str_id( "t_rock_floor" ) );
+        // Two different heavy things, so that a merged stack cannot hide one of them: rocks are counted by charge and would answer as one entry.
+        static const std::array<itype_id, 2> payload = { { itype_id( "rock" ), itype_id( "log" ) } };
+        for( int n = 0; n < c.items; n++ ) {
+            here.add_item( at, item( payload[static_cast<size_t>( n ) % payload.size()], calendar::turn ) );
+        }
+        if( c.fields ) {
+            // Three intensities, so that what is left behind and what arrives can be told apart: at two, "moved" and "one left" look the same as "moved half".
+            here.add_field( at, fd_smoke, 3, 0_turns, false );
+            here.add_field( at, fd_blood, 1, 0_turns, false );
+        }
+        if( c.furniture ) {
+            here.furn_set( at, furn_str_id( "f_bench" ) );
+        }
+    }
+    // What the columns hold **before** anything falls, so the recording describes its own fixture rather than leaving the port to rebuild it from a list of constants.
+    std::vector<std::string> before;
+    for( const column &c : columns ) {
+        const tripoint_bub_ms p = origin + tripoint_rel_ms( c.dx, 0, 0 );
+        std::string line;
+        for( const item &thing : here.i_at( p ) ) {
+            line += "i:" + thing.typeId().str() + ";";
+        }
+        for( const auto &iter : here.field_at( p ) ) {
+            line += "f:" + iter.second.get_field_type()->id.str() + ":" +
+                    std::to_string( iter.second.get_field_intensity() ) + ";";
+        }
+        if( here.furn( p ) != furn_str_id::NULL_ID() ) {
+            line += "u:" + here.furn( p ).id().str() + ";";
+        }
+        before.push_back( line );
+    }
+    // Every column loses its support at once, which is what a floor being bashed out from under several squares looks like.
+    for( const column &c : columns ) {
+        here.harness_support_dirty( origin + tripoint_rel_ms( c.dx, 0, 0 ) );
+    }
+    here.process_falling();
+    // Where everything ended up: every level of every column, so a thing that fell past its floor is visible as such.
+    std::fprintf( out, "{\"harness\":\"falling\",\"version\":1,\"before\":[" );
+    {
+        bool first_before = true;
+        for( const std::string &line : before ) {
+            std::fprintf( out, "%s\"%s\"", first_before ? "" : ",", harness_escape( line ).c_str() );
+            first_before = false;
+        }
+    }
+    std::fprintf( out, "],\"columns\":[" );
+    bool first_column = true;
+    for( const column &c : columns ) {
+        const tripoint_bub_ms at = origin + tripoint_rel_ms( c.dx, 0, 0 );
+        std::fprintf( out, "%s{\"dx\":%d,\"levels\":[", first_column ? "" : ",", c.dx );
+        bool first_level = true;
+        for( int level = 0; level >= -8; level-- ) {
+            const tripoint_bub_ms p = at + tripoint_rel_ms( 0, 0, level );
+            std::fprintf( out, "%s{\"z\":%d,\"ter\":\"%s\",\"furn\":\"%s\",\"items\":[",
+                          first_level ? "" : ",", level, harness_escape( here.ter( p ).id().str() ).c_str(),
+                          harness_escape( here.furn( p ).id().str() ).c_str() );
+            bool first_item = true;
+            for( const item &thing : here.i_at( p ) ) {
+                std::fprintf( out, "%s\"%s\"", first_item ? "" : ",", harness_escape( thing.typeId().str() ).c_str() );
+                first_item = false;
+            }
+            std::fprintf( out, "],\"fields\":[" );
+            bool first_field = true;
+            for( const auto &iter : here.field_at( p ) ) {
+                // **A dead entry is not a field.** `remove_field` zeroes an entry's intensity, and the map keeps the slot until it is swept, so an unfiltered reading
+                // shows a field that is gone - which is how a removed smoke came to be recorded as "one intensity left behind".
+                if( !iter.second.is_field_alive() ) {
+                    continue;
+                }
+                std::fprintf( out, "%s[\"%s\",%d,%d]", first_field ? "" : ",",
+                              harness_escape( iter.second.get_field_type()->id.str() ).c_str(),
+                              iter.second.get_field_intensity(), to_turns<int>( iter.second.get_field_age() ) );
+                first_field = false;
+            }
+            std::fprintf( out, "]}" );
+            first_level = false;
+        }
+        std::fprintf( out, "]}" );
+        first_column = false;
+    }
+    std::fprintf( out, "]}\n" );
+    std::fclose( out );
+}
+
+/// The `seen_cache` around the character, **across levels**.
+///
+/// Vision is the one environment layer with nothing recorded for it: `dump_frame` reads the light a square stands in, and light is not sight. The reference fills
+/// one cache per level and casts over all of them at once (`cast_zlight`, `lightmap.cpp:1079-1081`), so a character looking down a hole sees the floor below and
+/// a character under a solid roof does not see the sky - and a port can only be held to that if the dump says which squares each level's cache reaches.
+void dump_visibility( const std::string &path, int radius, int avatar_x, int avatar_y )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+    avatar &u = get_avatar();
+    // **A recording has to happen from a fixed square.** The world's start location is chosen per process, so a dump taken "wherever the character started" is a
+    // different fixture every run - which makes a gate that compares against it a gate on the seed rather than on the cast.
+    if( avatar_x >= 0 && avatar_y >= 0 ) {
+        u.setpos( get_map().get_abs( tripoint_bub_ms( avatar_x, avatar_y, u.posz() ) ) );
+        get_map().invalidate_map_cache( u.posz() );
+    }
+    const tripoint_bub_ms centre = u.pos_bub();
+    map &here = get_map();
+    // **Every level is built, not just the character's.** `build_map_cache` rebuilds one level's caches, and a dump that built only the character's would report
+    // whatever the level below happened to hold from an earlier build - which is how a stale `seen_cache` read as "the character sees the floor below" before this
+    // loop existed. The values below are only worth comparing if the dump produced them itself.
+    // **`skip_lightmap` must be false.** The second parameter is not "cumulative": passing true skips the lightmap build, and the sight cast lives in it - so the
+    // dump would read a `seen_cache` left by whatever build the game ran earlier, which is how a character's own brighter cast came to look dimmer in the record.
+    // **The character's own level is built last.** Each build wipes every level's `seen_cache` and re-casts, and only the build whose target *is* the character's level
+    // writes `VISIBILITY_FULL` into the square the character stands on - so ending on any other level leaves that square reading zero.
+    for( const int dz : { -1, 1, 0 } ) {
+        // The caches have to be **made dirty** first: `build_map_cache` skips a level whose `seen_cache_dirty` is false, and a skipped build leaves whatever the
+        // previous one wrote - including the character's own square, which reads zero if no build ever wrote `VISIBILITY_FULL` for it.
+        here.invalidate_map_cache( centre.z() + dz );
+        here.build_map_cache( centre.z() + dz );
+    }
+    // **The sight range penalty is a cast input too.** `build_seen_cache` passes it as `offset_distance` (`lightmap.cpp:1079`), where it both shortens the cast and
+    // adds to every distance - so a port that ignored it would see further and brighter than the reference in dim light or bad weather.
+    const int sight_range = u.sight_max;
+    const int penalty = sight_range >= MAX_VIEW_DISTANCE ? 0 : sight_range;
+    std::fprintf( out,
+                  "{\"harness\":\"visibility\",\"version\":1,\"radius\":%d,\"centre\":[%d,%d,%d],\"penalty\":%d,\n"
+                  "\"squares\":[\n",
+                  radius, centre.x(), centre.y(), centre.z(), penalty );
+    bool first = true;
+    for( int dz = -1; dz <= 1; dz++ ) {
+        const int z = centre.z() + dz;
+        const level_cache &cache = here.get_cache_ref( z );
+        for( int dy = -radius; dy <= radius; dy++ ) {
+            for( int dx = -radius; dx <= radius; dx++ ) {
+                const point_bub_ms p( centre.x() + dx, centre.y() + dy );
+                // **The cast's own inputs are recorded beside its output.** A port cannot be held to a seen cache unless it is given the same transparency and
+                // floor bits the reference read: reconstructing them from terrain ids would need the port's loader to agree about every flag first, and a disagreement
+                // there would look like a cast that was wrong.
+                std::fprintf( out,
+                              "%s{\"x\":%d,\"y\":%d,\"z\":%d,\"seen\":%.6f,\"transparency\":%.6f,\"floor\":%s,\"sealed\":%s}",
+                              first ? "" : ",\n", p.x(), p.y(), z,
+                              static_cast<double>( cache.seen_cache[p.x()][p.y()] ),
+                              static_cast<double>( cache.vision_transparency_cache[p.x()][p.y()] ),
+                              cache.floor_cache[p.x()][p.y()] ? "true" : "false",
+                              cache.no_floor_gaps ? "true" : "false" );
+                first = false;
+            }
+        }
+    }
+    std::fprintf( out, "\n]}\n" );
+    std::fclose( out );
+}
+
+void dump_state( const std::string &path )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+    const avatar &u = get_avatar();
+    const time_point now = calendar::turn;
+
+    cata_default_random_engine probe = rng_get_engine();
+    std::fprintf( out, "{\"harness\":\"state\",\"version\":1,\n" );
+    std::fprintf( out, "\"rng_next\":[" );
+    for( int i = 0; i < 4; i++ ) {
+        std::fprintf( out, "%s%llu", i == 0 ? "" : ",",
+                      static_cast<unsigned long long>( probe() ) );
+    }
+    std::fprintf( out, "],\n" );
+
+    std::fprintf( out,
+                  "\"turn\":%d,\"season\":%d,\"day_of_season\":%d,\"hour\":%d,\n",
+                  to_turn<int>( now ), static_cast<int>( season_of_year( now ) ),
+                  day_of_season<int>( now ), hour_of_day<int>( now ) );
+
+    const tripoint_abs_ms pos = u.pos_abs();
+    std::fprintf( out,
+                  "\"avatar\":{\"pos_abs\":[%d,%d,%d],\"str\":%d,\"dex\":%d,\"int\":%d,"
+                  "\"per\":%d,\"hp\":%d,\"moves\":%d},\n",
+                  pos.x(), pos.y(), pos.z(), u.str_max, u.dex_max, u.int_max, u.per_max,
+                  static_cast<int>( u.get_hp() ), static_cast<int>( u.get_moves() ) );
+
+    // The reality bubble, hashed tile by tile: terrain, furniture, and how many
+    // items lie on the square. This is the first digest that compares worlds
+    // rather than environments.
+    std::vector<std::string> rows;
+    const tripoint_bub_ms center = u.pos_bub();
+    for( const tripoint_bub_ms &p : g->harness_map().points_in_radius( center, 60 ) ) {
+        std::string row = string_format( "%d,%d,%d|%s|%s|%zu", p.x(), p.y(), p.z(),
+                                         g->harness_map().ter( p ).id().str(), g->harness_map().furn( p ).id().str(),
+                                         g->harness_map().i_at( p ).size() );
+        rows.push_back( std::move( row ) );
+    }
+    std::fprintf( out,
+                  "\"bubble\":{\"radius\":60,\"tiles\":%zu,\"digest\":\"%016llx\"},\n",
+                  rows.size(),
+                  static_cast<unsigned long long>( digest_strings( rows ) ) );
+
+    std::size_t creatures = 0;
+    for( Creature &critter : g->all_creatures() ) {
+        static_cast<void>( critter );
+        creatures++;
+    }
+    std::fprintf( out, "\"creatures\":%zu}\n", creatures );
+    std::fclose( out );
+}
+
+// The field sweep, run one turn at a time, with every field written out.
+//
+// This is the environment-only session the P2 exit gate asks for: a fire is placed on a square, the map's own
+// `process_fields` runs a turn at a time, and after each turn every field entry within the radius is written down
+// with its type, intensity and age. There are no creatures and no items in the session, so what the port has to
+// reproduce is exactly what the field processor does - nothing else can move.
+// The squares a field fixture watches: the level it starts on and the two beside it. A gas that falls or rises leaves its own level, and a dump that only read that level
+// would report the field gone and the two runs would agree about nothing.
+static std::vector<tripoint_bub_ms> harness_three_levels( const tripoint_bub_ms &center, int radius )
+{
+    std::vector<tripoint_bub_ms> squares;
+    // **One level above the old window, because gas rises.** A field at intensity above one that finds no neighbour to spread into goes **up** instead
+    // (`map_field.cpp:380-386`), and a dump that stopped one level short would show the source thinning with no destination - which a port can read as a decay and
+    // get right by accident, or as a rise it has no terrain for and get wrong. The extra level is the drop's own top floor, where the risen gas lands.
+    for( int dz = -1; dz <= 2; dz++ ) {
+        for( const tripoint_bub_ms &p : g->harness_map().points_in_radius( center + tripoint_rel_ms( 0, 0, dz ), radius ) ) {
+            squares.push_back( p );
+        }
+    }
+    return squares;
+}
+
+void dump_field_series( const std::string &path, const point &offset, int intensity, int turns,
+                        int radius, const point &items_at,
+                        const std::vector<std::pair<point, std::string>> &terrain,
+                        const std::vector<std::pair<point, std::string>> &furniture,
+                        const std::string &gas_type, int gas_intensity,
+                        const std::vector<std::tuple<tripoint, std::string>> &terrain_at,
+                        const std::optional<tripoint> &gas_at, int turn_minutes, int place_scent )
+{
+    const tripoint_bub_ms fire = get_avatar().pos_bub() + tripoint( offset, 0 );
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+    for( const std::pair<point, std::string> &change : terrain ) {
+        g->harness_map().ter_set( get_avatar().pos_bub() + tripoint( change.first, 0 ),
+                                  ter_id( change.second ) );
+    }
+    // Terrain on **any level**, which is what a fixture about falling gas needs: whether a gas may drop depends on the square below it, and a room's basement is a wall
+    // unless the fixture says otherwise.
+    for( const std::tuple<tripoint, std::string> &change : terrain_at ) {
+        g->harness_map().ter_set( get_avatar().pos_bub() + tripoint_rel_ms( std::get<0>( change ) ),
+                                  ter_id( std::get<1>( change ) ) );
+    }
+    for( const std::pair<point, std::string> &change : furniture ) {
+        g->harness_map().furn_set( get_avatar().pos_bub() + tripoint( change.first, 0 ),
+                                   furn_id( change.second ) );
+    }
+    // Intensity zero means the fixture is about the gas alone: a fire would add smoke of its own and there would be no telling the two apart.
+    if( intensity > 0 ) {
+        g->harness_map().add_field( fire, fd_fire, intensity, 0_turns, false );
+    }
+    // A gas on the same square, when the fixture is about where a gas goes rather than what a fire leaves: the gas processors fall before they drift and rise after they
+    // fail to, and neither branch is visible from a dump that only reads the level the field started on.
+    if( !gas_type.empty() ) {
+        // **Where the gas goes matters as much as what it is.** A fixture about wind needs a gas the weather can reach: a square indoors is sheltered, and
+        // `get_local_windpower` answers zero there however hard the sky is blowing - which is why one on a roof is the only way to exercise the wind branch.
+        const tripoint_bub_ms where = gas_at ? get_avatar().pos_bub() + tripoint_rel_ms( *gas_at ) : fire;
+        g->harness_map().add_field( where, field_type_id( gas_type ), gas_intensity, 0_turns, false );
+    }
+    // **Scent, so a session can cover diffusion.** The map's scent layer is only ever filled by a character walking, so every session recorded without this
+    // carries an empty layer - and the M2 exit gate asks for one that diffuses. One square's worth is enough: the window spreads it from there.
+    if( place_scent != 0 ) {
+        // The player's own square: `fire` carries the fixture's *offset*, which is a sentinel when no fire was asked for.
+        get_scent().set( get_avatar().pos_bub(), place_scent );
+        const tripoint_bub_ms at = get_avatar().pos_bub();
+        if( getenv( "CDDA_GAS_TRACE" ) != nullptr ) {
+            std::fprintf( stderr, "scent placed %d at %d,%d,%d reads back %d\n", place_scent, at.x(), at.y(),
+                          at.z(), get_scent().get( at ) );
+        }
+    }
+    // One flammable item, placed where a fixture wants a square to catch that the ground itself would refuse. A plank is the smallest thing certain to burn and
+    // needs nothing else to be true about the world.
+    if( items_at != point( INT_MIN, INT_MIN ) ) {
+        static const itype_id itype_2x4( "2x4" );
+        g->harness_map().add_item_or_charges( get_avatar().pos_bub() + tripoint( items_at, 0 ),
+                                              item( itype_2x4 ) );
+    }
+    // Where in the reference's dice stream the session begins. `CDDA_RNG_TRACE` records every draw the whole run makes,
+    // world generation included, so a replay needs the offset to slice its own dice out of that file.
+    std::fprintf( out,
+                  "{\"harness\":\"field-series\",\"version\":1,\"radius\":%d,\"draw_start\":%llu,",
+                  radius, rng_draws_so_far() );
+    const tripoint_bub_ms center = get_avatar().pos_bub();
+    // The terrain of the **whole** radius, not just of the squares that carry a field. A replay needs the ground under every square the fire might care
+    // about - the fuel branch, the spread rule, whether smoke may rise - and a dump that lists terrain only where fields are leaves the rest of the map
+    // a guess, which is exactly the part a port would get wrong without noticing.
+    std::fprintf( out, "\"grid\":[" );
+    bool first_square = true;
+    for( const tripoint_bub_ms &p : harness_three_levels( center, radius ) ) {
+        const ter_id &ter = g->harness_map().ter( p );
+        const furn_id &frn = g->harness_map().furn( p );
+        // The items on a square are part of the answer too: the spread rule's last disjunct is
+        // `one_in( 5 ) && get_item_count() > 0 && flammable_items_at( ... )`, so a replay has to know whether anything burnable is lying there.
+        std::fprintf( out,
+                      "%s{\"x\":%d,\"y\":%d,\"z\":%d,\"ter\":\"%s\",\"furn\":\"%s\","
+                      "\"items\":%zu,\"items_burn\":%d",
+                      first_square ? "" : ",", p.x(), p.y(), p.z(),
+                      harness::harness_escape( ter.id().str() ).c_str(),
+                      harness::harness_escape( frn.id().str() ).c_str(),
+                      g->harness_map().i_at( p ).size(),
+                      g->harness_map().flammable_items_at( p ) ? 1 : 0 );
+        // ...and *what* is lying there, because the fire eats the items themselves: `item::simulate_burn` divides a material's volume per turn by the
+        // item's own volume, so two squares that both say `items_burn: 1` can feed a fire by very different amounts.
+        std::fprintf( out, ",\"items_at\":[" );
+        bool first_item = true;
+        for( const item &thing : g->harness_map().i_at( p ) ) {
+            std::fprintf( out, "%s\"%s\"", first_item ? "" : ",",
+                          harness::harness_escape( thing.typeId().str() ).c_str() );
+            first_item = false;
+        }
+        std::fprintf( out, "]}" );
+        first_square = false;
+    }
+    std::fprintf( out, "],\n\"turns\":[" );
+    for( int turn = 0; turn <= turns; turn++ ) {
+        // **The wind this turn**, because a gas's spread chance is `rng( 1, 100 - windpower )` and its destination is resisted when it blows into that wind: two runs
+        // with the same seed and different wind spread differently, and the dump's dice say the ceiling moved, so the fixture has to say why.
+        const weather_manager &weather_now = get_weather();
+        {
+            const bool sheltered_now = g->is_sheltered( center );
+            const tripoint_abs_ms where_now = g->harness_map().get_abs( center );
+            const int local_wind = get_local_windpower(
+                                        weather_now.windspeed,
+                                        overmap_buffer.ter( coords::project_to<coords::omt>( where_now ) ),
+                                        where_now, weather_now.winddirection, sheltered_now );
+            // **The sky as well as the wind.** A session that covers a weather transition needs the weather itself: the manager's id decides the light
+            // multiplier, the sight penalty and the sound attenuation, so a dump that recorded only the wind could not tell a storm from a calm night with
+            // the same air speed, and a replay would agree on every square while the sky above it was wrong.
+            // **The inputs as well as the answers.** A recorded sky is only replayable if the port knows where the player stood, which season it was, what the
+            // noise field's seed was and how far into the day the turn fell - the same four things the manager's own dump carries for the same reason. The point
+            // the generator produced goes with them, so a replay can be held to the arithmetic and not just to the rounding of the air temperature.
+            const season_effective_time moment_now( calendar::turn );
+            const tripoint_abs_ms where_now_abs = get_player_character().pos_abs();
+            std::fprintf( out,
+                          "%s{\"turn\":%d,\"now\":%d,\"windspeed\":%d,\"winddirection\":%d,\"windpower\":%d,"
+                          "\"weather\":\"%s\",\"temperature\":%.17g,\"nextweather\":%d,"
+                          "\"year_fraction\":%.17g,\"day_fraction\":%.17g,\"season\":%d,"
+                          "\"common_x\":%.17g,\"common_y\":%.17g,\"common_z\":%.17g,\"mod_seed\":%u,"
+                          "\"point_temperature\":%.17g,\"humidity\":%.17g,\"pressure\":%.17g,"
+                          "\"fields\":[",
+                          turn == 0 ? "" : ",\n", turn, to_turn<int>( calendar::turn ), weather_now.windspeed,
+                          weather_now.winddirection, local_wind,
+                          harness::harness_escape( weather_now.weather_id.str() ).c_str(),
+                          static_cast<double>( units::to_kelvin( weather_now.temperature ) ),
+                          to_turn<int>( weather_now.nextweather ),
+                          time_past_new_year( moment_now.t ) / calendar::year_length(),
+                          time_past_midnight( moment_now.t ) / 1_days,
+                          static_cast<int>( season_of_year( moment_now.t ) ),
+                          where_now_abs.x() / 2000.0, where_now_abs.y() / 2000.0,
+                          to_days<double>( calendar::turn - calendar::turn_zero ),
+                          g->get_seed() % SIMPLEX_NOISE_RANDOM_SEED_LIMIT,
+                          static_cast<double>( units::to_kelvin( weather_now.weather_precise->temperature ) ),
+                          weather_now.weather_precise->humidity, weather_now.weather_precise->pressure );
+        }
+        bool first = true;
+        for( const tripoint_bub_ms &p : harness_three_levels( center, radius ) ) {
+            const field &fld = g->harness_map().field_at( p );
+            // The terrain under the field is part of the answer, not decoration: the fire processor's fuel accounting
+            // branches on the terrain's flags, and two runs that differ only in the ground under a fire will disagree
+            // about its age. Without this in the dump there is no way to tell which branch ran.
+            const ter_id &ter = g->harness_map().ter( p );
+            const furn_id &frn = g->harness_map().furn( p );
+            for( const auto &entry : fld ) {
+                // **The wind at this square**, not at the player's. `spread_gas` asks `get_local_windpower` about the square the gas stands on
+                // (`map_field.cpp:279-284`), and a gas on a roof feels a wind that one in the cellar beside it does not; a fixture that recorded the player's
+                // wind would replay a still room and a windy one with the same number.
+                const int wind_here = get_local_windpower(
+                                          weather_now.windspeed,
+                                          overmap_buffer.ter( coords::project_to<coords::omt>( g->harness_map().get_abs( p ) ) ),
+                                          g->harness_map().get_abs( p ), weather_now.winddirection, g->is_sheltered( p ) );
+                std::fprintf( out,
+                              "%s{\"x\":%d,\"y\":%d,\"z\":%d,\"type\":\"%s\",\"intensity\":%d,\"age\":%d,"
+                              "\"ter\":\"%s\",\"furn\":\"%s\",\"windpower\":%d,\"sheltered\":%s,\"alive\":%s,\"decay_at\":%d}",
+                              first ? "" : ",", p.x(), p.y(), p.z(),
+                              harness::harness_escape( entry.second.get_field_type().id().str() ).c_str(),
+                              entry.second.get_field_intensity(),
+                              to_turns<int>( entry.second.get_field_age() ),
+                              harness::harness_escape( ter.id().str() ).c_str(),
+                              harness::harness_escape( frn.id().str() ).c_str(), wind_here,
+                              g->is_sheltered( p ) ? "true" : "false",
+                              // **A dead entry is still in the dump.** `field::find_field` hides it from every rule, but it sits in the square's list until the sweep
+                              // next removes it, so a reader who cannot see the flag reads a corpse as a field - which is exactly how a risen field that had died looked
+                              // like one that had silently changed age.
+                              entry.second.is_field_alive() ? "true" : "false",
+                              to_turn<int>( entry.second.harness_decay_time() ) );
+                first = false;
+            }
+        }
+        // Scent has nothing to do with fields, but an environment session that ignores it cannot compare one.
+        //
+        // **Its window is wider than the fields'.** A fire stays where it is put; scent walks a square a turn, so a three-square window records a layer that
+        // has spread out of sight by the fifth turn - which is exactly the point where a replay starts disagreeing with a record it cannot see all of.
+        std::fprintf( out, "],\"scent\":[" );
+        first = true;
+        for( const tripoint_bub_ms &p : harness_three_levels( center, radius * 6 ) ) {
+            const int value = get_scent().get( p );
+            if( value != 0 ) {
+                std::fprintf( out, "%s[%d,%d,%d]", first ? "" : ",", p.x(), p.y(), value );
+                first = false;
+            }
+        }
+        // **The light, per square, one level at a time.** The M2 exit gate asks for light changing across z-levels and until now no session carried any. Each level is
+        // built and **read immediately**, because a build for one level is free to touch its neighbours' caches (`map.cpp:9562-9566`) and a dump that built all of them
+        // first would read whichever one was built last.
+        std::fprintf( out, "],\"light\":[" );
+        {
+            bool first_light = true;
+            for( int z = center.z() - 1; z <= center.z() + 1; z++ ) {
+                for( int pass = 0; pass < 2; pass++ ) {
+                    g->harness_map().invalidate_map_cache( z );
+                    g->harness_map().build_map_cache( z );
+                }
+                for( const tripoint_bub_ms &p : harness_three_levels( center, 2 ) ) {
+                    if( p.z() != z ) {
+                        continue;
+                    }
+                    const auto &cache = g->harness_map().get_cache_ref( p.z() );
+                    // **The answer the game uses, not the cache's internals.** `light_at` (`lightmap.cpp:674-697`) is what decides whether a square is drawn lit, so a
+                    // replay is held to it rather than to a number that only the cast sees. The draw path's own answer and the square's light source go beside it: the
+                    // first says what a player would make of the square, the second keeps a fire's light apart from the sky's.
+                    const lit_level seen = g->harness_map().light_at( p );
+                    const lit_level apparent =
+                        g->harness_map().apparent_light_at( p, g->harness_map().get_visibility_variables_cache() );
+                    const int source = static_cast<int>( cache.sm[p.x()][p.y()] );
+                    // **The names say what the numbers are**, after a round of calling `lm`'s maximum "ambient" and finding that it was the lightmap itself: `brightest`
+                    // is the square's own brightest quadrant, `sky` is `natural_light_level` for the level (what the sun offers before anything reflects it) and
+                    // `source` is the square's own emitter.
+                    std::fprintf( out,
+                                  "%s{\"x\":%d,\"y\":%d,\"z\":%d,\"lit\":%d,\"apparent\":%d,\"source\":%d,"
+                                  "\"brightest\":%.6f,\"sky\":%.6f}",
+                                  first_light ? "" : ",", p.x(), p.y(), p.z(), static_cast<int>( seen ),
+                                  static_cast<int>( apparent ), source,
+                                  static_cast<double>( cache.lm[p.x()][p.y()].max() ),
+                                  static_cast<double>( g->natural_light_level( p.z() ) ) );
+                    first_light = false;
+                }
+            }
+        }
+        std::fprintf( out, "]}" );
+        if( turn < turns ) {
+            // **Time moves when asked.** A session with a frozen clock cannot contain a weather transition, and the M2 exit gate needs one: `--turn-minutes`
+            // advances the calendar before each sweep and lets the manager see the new hour, which is the only way a session can cover a change of sky.
+            // **Scent moves because time moves in it.** `scent_map::update` is the game loop's own call (`game.cpp`), and a session that never makes it
+            // records a layer that stands still however many turns pass - which is what every fixture carried before this flag existed.
+            if( place_scent != 0 ) {
+                get_scent().update( get_avatar().pos_bub(), g->harness_map() );
+            }
+            if( turn_minutes > 0 ) {
+                calendar::turn += time_duration::from_minutes( turn_minutes );
+                // **The next hour's sky, labelled.** The manager is asked about the hour it has just moved into, so these dice belong to the turn **after** this
+                // one; a replay that guessed from position alone would have to count the gas processor's draws to find them.
+                rng_mark( string_format( "weather.session.hour.%d", turn + 1 ).c_str() );
+                get_weather().update_weather();
+                rng_mark( "weather.session.done" );
+            }
+            // **One label per turn**, because a processor's own label says what it rolled but not which turn rolled it: a trace with fifty-nine blocks and sixty
+            // turns cannot say whether a turn's gas could not spread or its processor never ran, and the dice after that turn no longer line up.
+            const std::string turn_mark = string_format( "gas.turn.%d", turn );
+            rng_mark( turn_mark.c_str() );
+#ifdef CATA_HARNESS
+            // The same label on stderr, so the per-square trace lines that follow can be attributed to a turn instead of guessed at.
+            if( getenv( "CDDA_GAS_TRACE" ) != nullptr ) {
+                std::fprintf( stderr, "== %s at %d\n", turn_mark.c_str(), to_turn<int>( calendar::turn ) );
+            }
+#endif
+            g->harness_map().process_fields();
+        }
+    }
+    std::fprintf( out, "\n]}\n" );
+    std::fclose( out );
+}
