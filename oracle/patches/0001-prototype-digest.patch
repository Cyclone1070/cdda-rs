+void dump_qualities( const std::string &path )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+    // **The qualities themselves**, which are their own registry: an id, the name the UI shows, and the usages they unlock.
+    std::fprintf( out, "{\"harness\":\"qualities\",\"version\":1,\n\"qualities\":[\n" );
+    bool first = true;
+    for( const quality_id &quality_id : quality::get_all() ) {
+        const quality &defined = quality_id.obj();
+        std::fprintf( out, "%s{\"id\":\"%s\",\"name\":\"%s\"}", first ? "" : ",\n",
+                      harness_escape( defined.id.str() ).c_str(),
+                      harness_escape( defined.name.translated() ).c_str() );
+        first = false;
+    }
+    std::fprintf( out, "\n],\n\"items\":[\n" );
+    // **What each item type is worth as a tool.** The reference keeps this as a map from quality to level, and a negative level is meaningful: a butchering tool that
+    // makes the job *worse* than bare hands is written with a negative one.
+    first = true;
+    int with_qualities = 0;
+    for( const itype *type : item_controller->all() ) {
+        if( type->qualities.empty() ) {
+            continue;
+        }
+        std::fprintf( out, "%s{\"id\":\"%s\",\"qualities\":[", first ? "" : ",\n",
+                      harness_escape( type->get_id().str() ).c_str() );
+        bool first_quality = true;
+        for( const auto &entry : type->qualities ) {
+            std::fprintf( out, "%s[\"%s\",%d]", first_quality ? "" : ",",
+                          harness_escape( entry.first.str() ).c_str(), entry.second );
+            first_quality = false;
+        }
+        std::fprintf( out, "]}" );
+        first = false;
+        with_qualities++;
+    }
+    std::fprintf( out, "\n],\n\"count\":%d}\n", with_qualities );
+    std::fclose( out );
+}
