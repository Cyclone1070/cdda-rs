+/// Every item type's pockets: what each one holds, how much, and what it refuses.
+///
+/// Reference: `pocket_data` (`src/item_pocket.h:500-570`) as `item::get_pockets` hands it out. The port needs four facts to make the same refusals `can_contain` makes: the
+/// volume a pocket holds, whether it is **watertight** (a liquid needs that, `src/item_pocket.cpp:1396-1401`) and **airtight** (a gas needs that), and whether it is rigid.
+void dump_pockets( const std::string &path )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+    std::fprintf( out, "{\"harness\":\"pockets\",\"version\":1,\n\"types\":[\n" );
+    bool first = true;
+    for( const itype *proto : item_controller->all() ) {
+        item made( proto->get_id() );
+        if( made.is_null() ) {
+            continue;
+        }
+        std::fprintf( out, "%s{\"id\":\"%s\",\"pockets\":[", first ? "" : ",\n",
+                      harness_escape( proto->id.str() ).c_str() );
+        bool first_pocket = true;
+        for( const item_pocket *pocket : made.get_all_contained_pockets() ) {
+            if( pocket == nullptr ) {
+                continue;
+            }
+            std::string accepts;
+            for( const itype_id &allowed : pocket->get_pocket_data()->item_id_restriction ) {
+                accepts += std::string( accepts.empty() ? "" : "," ) + "\"" + harness_escape( allowed.str() ) + "\"";
+            }
+            std::string flags_allowed;
+            for( const flag_id &allowed : pocket->get_pocket_data()->get_flag_restrictions() ) {
+                flags_allowed += std::string( flags_allowed.empty() ? "" : "," ) + "\"" + harness_escape( allowed.str() ) + "\"";
+            }
+            std::string materials_allowed;
+            for( const material_id &allowed : pocket->get_pocket_data()->material_restriction ) {
+                materials_allowed += std::string( materials_allowed.empty() ? "" : "," ) + "\"" + harness_escape( allowed.str() ) + "\"";
+            }
+            std::fprintf( out,
+                          "%s{\"kind\":\"%s\",\"watertight\":%s,\"airtight\":%s,\"rigid\":%s,"
+                          "\"max_volume\":%lld,\"max_weight\":%lld,"
+                          "\"max_length\":%lld,\"min_length\":%lld,\"min_volume\":%lld,"
+                          "\"holster\":%s,\"ablative\":%s,"
+                          "\"max_item_volume\":%lld,\"sealed\":%s,"
+                          "\"items\":[%s],\"flags\":[%s],\"materials\":[%s]}",
+                          first_pocket ? "" : ",", io::enum_to_string( pocket->get_pocket_data()->type ).c_str(),
+                          pocket->get_pocket_data()->watertight ? "true" : "false",
+                          pocket->get_pocket_data()->airtight ? "true" : "false",
+                          pocket->get_pocket_data()->rigid ? "true" : "false",
+                          static_cast<long long>( units::to_milliliter( pocket->volume_capacity() ) ),
+                          static_cast<long long>( units::to_gram( pocket->weight_capacity() ) ),
+                          static_cast<long long>( units::to_millimeter( pocket->get_pocket_data()->max_item_length ) ),
+                          static_cast<long long>( units::to_millimeter( pocket->get_pocket_data()->min_item_length ) ),
+                          static_cast<long long>( units::to_milliliter( pocket->get_pocket_data()->min_item_volume ) ),
+                          pocket->get_pocket_data()->holster ? "true" : "false",
+                          pocket->get_pocket_data()->ablative ? "true" : "false",
+                          pocket->get_pocket_data()->max_item_volume ?
+                          static_cast<long long>( units::to_milliliter( *pocket->get_pocket_data()->max_item_volume ) ) : -1,
+                          pocket->get_pocket_data()->sealed_data ? "true" : "false",
+                          accepts.c_str(), flags_allowed.c_str(), materials_allowed.c_str() );
+            first_pocket = false;
+        }
+        std::fprintf( out, "]}" );
+        first = false;
+    }
+    std::fprintf( out, "\n]}\n" );
+    std::fclose( out );
+}
