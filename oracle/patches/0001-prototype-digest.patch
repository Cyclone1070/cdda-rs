+/// Where a projectile that keeps its heading ends up.
+///
+/// `move_along_line` (`src/line.cpp:380-406`) walks `distance` steps along the straight line between two points: the slope is normalised by the **float** Euclidean
+/// distance (`trig_dist`, `src/line.h:168-172`) and the result is truncated back to integers, so the arithmetic is not the obvious one and the truncation decides a
+/// tile at some distances. `continue_line` then starts a fresh line from there (`src/line.cpp:408-414`).
+///
+/// The cases mix axis-aligned headings, which must land exactly, with diagonals and climbs, whose slopes are irrational and where the truncation shows.
+void dump_move_along( const std::string &path )
+{
+    struct case_t {
+        tripoint from;
+        tripoint to;
+        int distance;
+        const char *shape;
+    };
+    const std::vector<case_t> cases = {
+        { tripoint( 5, 5, 0 ), tripoint( 15, 5, 0 ), 3, "straight-x" },
+        { tripoint( 5, 5, 0 ), tripoint( 5, 15, 0 ), 4, "straight-y" },
+        { tripoint( 5, 5, 0 ), tripoint( 5, 5, 9 ), 2, "straight-up" },
+        { tripoint( 5, 5, 0 ), tripoint( 15, 15, 0 ), 3, "diagonal" },
+        { tripoint( 5, 5, 0 ), tripoint( 15, 15, 0 ), 1, "diagonal" },
+        { tripoint( 5, 5, 0 ), tripoint( 15, 15, 10 ), 5, "diagonal-climbing" },
+        { tripoint( 5, 5, 0 ), tripoint( 9, 5, 0 ), 2, "short-x" },
+        { tripoint( 5, 5, 0 ), tripoint( 9, 5, 0 ), 2, "short-x" },
+        { tripoint( 0, 0, 0 ), tripoint( 3, 4, 0 ), 10, "three-four-five" },
+        { tripoint( -5, -5, 0 ), tripoint( -15, -15, 0 ), 3, "negative-diagonal" },
+        { tripoint( 5, 5, 0 ), tripoint( 15, 5, 0 ), 0, "no-distance" },
+        { tripoint( 5, 5, 0 ), tripoint( 15, 6, 2 ), 7, "shallow-climb" },
+        { tripoint( 5, 5, 0 ), tripoint( 6, 15, -2 ), 7, "steep-y" },
+    };
+
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+    std::fprintf( out, "{\"harness\":\"move-along\",\"version\":1,\"cases\":[" );
+    bool first_case = true;
+    for( const case_t &c : cases ) {
+        const std::vector<tripoint> line = line_to( c.from, c.to, 0, 0 );
+        std::vector<tripoint> heading = line;
+        heading.insert( heading.begin(), c.from );
+        const tripoint moved = move_along_line( c.from, heading, c.distance );
+        const std::vector<tripoint> continued = continue_line( heading, c.distance );
+        std::fprintf( out,
+                      "%s{\"shape\":\"%s\",\"from\":[%d,%d,%d],\"to\":[%d,%d,%d],\"distance\":%d,"
+                      "\"moved\":[%d,%d,%d],\"continued\":[",
+                      first_case ? "" : ",", c.shape, c.from.x, c.from.y, c.from.z, c.to.x, c.to.y, c.to.z,
+                      c.distance, moved.x, moved.y, moved.z );
+        for( std::size_t i = 0; i < continued.size(); i++ ) {
+            std::fprintf( out, "%s[%d,%d,%d]", i == 0 ? "" : ",", continued[i].x, continued[i].y,
+                          continued[i].z );
+        }
+        std::fprintf( out, "]}" );
+        first_case = false;
+    }
+    std::fprintf( out, "]}\n" );
+    std::fclose( out );
+}
