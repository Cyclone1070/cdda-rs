+/// What the accepting rules say, over real data.
+///
+/// Reference: `item_pocket::can_contain` (`src/item_pocket.cpp:1448-1610`), asked of a pocket and a real item. A pocket's refusals are not interchangeable - the order
+/// they are asked in decides which one a payload hears - so this records **every pocket of a container, in order**, with the reference's own message for each
+/// refusal. That is what makes the accept-lists testable: a wallet that carries a credit card hears "holster does not accept this item type or form factor", and a
+/// rock in a scabbard hears the same, while a rock in a backpack hears nothing at all.
+void dump_accepts( const std::string &path )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+    // Containers chosen for what their pockets ask: accept-lists by id, by flag and by material, a holster, a one-item biggest volume, and a plain pocket to say
+    // what "no restriction" looks like.
+    const std::vector<std::string> containers = {
+        "backpack", "wallet_travel", "autoclave", "candlestick", "mask_gas", "scabbard", "sheath", "bottle_plastic",
+        "art_klein", "tool_belt", "quiver", "holster"
+    };
+    std::fprintf( out, "{\"harness\":\"pocket-accepts\",\"version\":1,\n\"cases\":[\n" );
+    bool first_case = true;
+    for( const std::string &container_id : containers ) {
+        const itype *container_proto = item::find_type( itype_id( container_id ) );
+        if( container_proto == nullptr ) {
+            continue;
+        }
+        item container( container_proto->get_id() );
+        std::vector<item_pocket *> pockets = container.get_all_contained_pockets();
+        if( pockets.empty() ) {
+            continue;
+        }
+        // Every twenty-fifth type, so that the sample is deterministic and wide without being a file of its own.
+        int index = 0;
+        for( const itype *payload : item_controller->all() ) {
+            index++;
+            if( index % 25 != 0 ) {
+                continue;
+            }
+            item made( payload->get_id() );
+            std::fprintf( out, "%s{\"container\":\"%s\",\"payload\":\"%s\",\"length\":%lld,\"volume\":%lld,\"verdicts\":[",
+                          first_case ? "" : ",\n", harness_escape( container_id ).c_str(), harness_escape( payload->get_id().str() ).c_str(),
+                          static_cast<long long>( units::to_millimeter( made.length() ) ),
+                          static_cast<long long>( units::to_milliliter( made.volume() ) ) );
+            bool first_pocket = true;
+            for( const item_pocket *pocket : pockets ) {
+                const ret_val<item_pocket::contain_code> answer = pocket->can_contain( made );
+                std::fprintf( out, "%s{\"ok\":%s,\"why\":\"%s\"}", first_pocket ? "" : ",",
+                              answer.success() ? "true" : "false",
+                              answer.success() ? "" : harness_escape( answer.str() ).c_str() );
+                first_pocket = false;
+            }
+            std::fprintf( out, "]}" );
+            first_case = false;
+        }
+    }
+    std::fprintf( out, "\n]}\n" );
+    std::fclose( out );
+}
+
+/// A pocket session: the same payloads put into the same containers, one at a time, recorded step by step.
+///
+/// Reference: `item::put_in` (`src/item.cpp:1848`) over `item_pocket::insert_item` (`src/item_pocket.cpp:2194`), which asks `can_contain` first. The dump records the
+/// **answer** to each insertion - success or the reason it failed - and, after every step, what the container weighs, how much room it has left and how much its contents
+/// add to its size. A port can therefore be compared on the decision and on the state it leaves behind, not just on one of them.
+void dump_pocket_session( const std::string &path )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+    // The script: a container, and the payloads tried in it in this order. Chosen to exercise a fit, a near fit and a failure.
+    struct step {
+        const char *container;
+        const char *payload;
+        int charges;
+    };
+    const std::vector<step> script = {
+        { "backpack", "rock", 1 },
+        { "backpack", "rock", 1 },
+        { "backpack", "rock", 1 },
+        { "backpack", "2x4", 1 },
+        // A log will not fit, and a backpack may not hold liquid: the two ways `can_contain` says no.
+        { "backpack", "log", 1 },
+        { "backpack", "water_clean", 1 },
+        { "bottle_plastic", "water_clean", 1 },
+        { "bottle_plastic", "water_clean", 2 },
+        { "bottle_plastic", "water_clean", 1 },
+        { "bottle_plastic", "rock", 1 },
+        // **Bigger than any one of the backpack's pockets, smaller than all four together** (30,000 ml against 25,000 + 510 + 5,000 + 5,000). If the reference
+        // takes this, pockets are pooled and a single capacity is the right model; if it refuses, each pocket is its own limit.
+        { "backpack", "bundle_branch", 1 },
+        // And one that fits a single pocket exactly.
+        { "backpack", "art_crystal", 1 },
+        // **Fits the room and not the weight**: 20,000 ml of a pocket that holds 25,000, and 115 kg of one that holds 30 kg.
+        { "backpack", "manhole_cover", 1 },
+        // And one that is heavy but still within the pocket's weight.
+        { "backpack", "huge_atomic_battery_cell", 1 },
+    };
+    std::fprintf( out, "{\"harness\":\"pocket-session\",\"version\":1,\n\"steps\":[\n" );
+    item container;
+    std::string current;
+    bool first = true;
+    for( const step &one : script ) {
+        if( current != one.container ) {
+            container = item( itype_id( one.container ) );
+            current = one.container;
+        }
+        item payload( itype_id( one.payload ), calendar::turn, std::max( 1, one.charges ) );
+        const ret_val<void> placed = container.put_in( payload, pocket_type::CONTAINER );
+        std::fprintf( out,
+                      "%s{\"container\":\"%s\",\"payload\":\"%s\",\"charges\":%d,\"ok\":%s,\"why\":\"%s\","
+                      "\"container_weight\":%lld,\"container_volume\":%lld,\"room\":%lld,\"contents_size\":%lld}",
+                      first ? "" : ",\n", one.container, one.payload, payload.charges,
+                      placed.success() ? "true" : "false",
+                      harness_escape( placed.success() ? "" : placed.str() ).c_str(),
+                      static_cast<long long>( units::to_gram( container.weight() ) ),
+                      static_cast<long long>( units::to_milliliter( container.volume() ) ),
+                      static_cast<long long>( units::to_milliliter( container.get_remaining_capacity() ) ),
+                      static_cast<long long>( units::to_milliliter( container.get_contents().item_size_modifier() ) ) );
+        first = false;
+    }
+    std::fprintf( out, "\n]}\n" );
+    std::fclose( out );
+}
