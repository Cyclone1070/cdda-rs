+void dump_proficiencies( const std::string &path )
+{
+    std::ofstream out( path );
+    if( !out.is_open() ) {
+        return;
+    }
+    const std::vector<proficiency> &all = proficiency::get_all();
+    out << "{\"count\":" << all.size() << ",\"proficiencies\":[";
+    bool first = true;
+    for( const proficiency &prof : all ) {
+        if( !first ) {
+            out << ",";
+        }
+        first = false;
+        // `time_to_learn` is the proficiency's own number (`proficiency.h:84`), which is what `practice` compares practised time against; `can_learn` is carried
+        // because the data may mark a proficiency unlearnable, and then no amount of practice learns it.
+        out << "{\"id\":\"" << prof.prof_id().str() << "\",\"seconds\":" << to_seconds<int>( prof.time_to_learn() )
+            << ",\"can_learn\":" << ( prof.can_learn() ? "true" : "false" ) << ",\"required\":[";
+        bool first_req = true;
+        for( const proficiency_id &need : prof.required_proficiencies() ) {
+            if( !first_req ) {
+                out << ",";
+            }
+            first_req = false;
+            out << "\"" << need.str() << "\"";
+        }
+        // Version two adds the **bonuses** a proficiency grants (`proficiency::_bonuses`, `proficiency.h:108-114`): a map from the thing the bonus applies to - `melee_attack`,
+        // `crafting_speed` and so on - to a list of `{ type, value }`. `bonus_for( category, type )` takes the **first** entry of the type it finds, so the order matters and the
+        // dump keeps the data's own.
+        out << "],\"bonuses\":[";
+        bool first_cat = true;
+        for( const std::pair<const std::string, std::vector<proficiency_bonus>> &entry : prof.all_bonuses() ) {
+            if( !first_cat ) {
+                out << ",";
+            }
+            first_cat = false;
+            out << "{\"category\":\"" << entry.first << "\",\"values\":[";
+            bool first_bonus = true;
+            for( const proficiency_bonus &bonus : entry.second ) {
+                if( !first_bonus ) {
+                    out << ",";
+                }
+                first_bonus = false;
+                out << "{\"type\":\"" << io::enum_to_string( bonus.type ) << "\",\"value\":" << bonus.value << "}";
+            }
+            out << "]}";
+        }
+        out << "]}";
+    }
+    out << "]}" << std::endl;
+}
