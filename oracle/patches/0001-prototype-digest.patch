+void dump_vehicle_move( const std::string &path )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+
+    map &here = get_map();
+    const tripoint_bub_ms origin = get_player_character().pos_bub( here );
+    for( int dx = -24; dx <= 24; dx++ ) {
+        for( int dy = -24; dy <= 24; dy++ ) {
+            const tripoint_bub_ms square = origin + tripoint_rel_ms( dx, dy, 0 );
+            here.ter_set( square, ter_id( "t_floor" ) );
+            here.furn_set( square, furn_str_id::NULL_ID() );
+        }
+    }
+
+    // `vehicle::act_on_map` (`vehicle_move.cpp:1829-2010`) decides one square of movement and what it costs in `of_turn`. Each case sets a speed and a full turn of
+    // movement, then takes twelve calls: the dump states the square the vehicle stood on, the `of_turn` it had left, and the speed it ended with. A vehicle below
+    // 20 vmiph stops on the spot, which is its own row.
+    std::fprintf( out, "{\"harness\":\"vehicle_move\",\"version\":1,\"origin\":[%d,%d,%d],"
+                  "\"cases\":[", origin.x(), origin.y(), origin.z() );
+    bool first_case = true;
+
+    const char *types[] = { "bicycle", "car" };
+    for( const char *type : types ) {
+        for( const int speed : { 19, 20, 100, 400, 1000 } ) {
+            // Ten squares north of the player: a vehicle placed on the player's square collides with them before it can move, and the dump is about movement.
+            const tripoint_bub_ms start = origin + tripoint_rel_ms( 0, 10, 0 );
+            vehicle *veh = here.add_vehicle( vproto_id( type ), start, 0_degrees, 100, 0, false, true );
+            if( veh == nullptr ) {
+                std::fprintf( stderr, "harness: %s did not place\n", type );
+                continue;
+            }
+            veh->velocity = speed;
+            veh->cruise_velocity = speed;
+            veh->of_turn = 1.0f;
+            std::fprintf( out, "%s{\"vehicle\":\"%s\",\"speed\":%d,\"steps\":[",
+                          first_case ? "" : ",", type, speed );
+            bool first_step = true;
+            for( int step = 0; step < 12; step++ ) {
+                veh = veh->act_on_map( here );
+                if( veh == nullptr ) {
+                    std::fprintf( out, "%s{\"gone\":true}", first_step ? "" : "," );
+                    first_step = false;
+                    break;
+                }
+                std::fprintf( out,
+                              "%s{\"x\":%d,\"y\":%d,\"of_turn\":%.9g,\"velocity\":%d}",
+                              first_step ? "" : ",", veh->pos_bub( here ).x() - start.x(),
+                              veh->pos_bub( here ).y() - start.y(), static_cast<double>( veh->of_turn ),
+                              veh->velocity );
+                first_step = false;
+            }
+            std::fprintf( out, "]}" );
+            first_case = false;
+            here.destroy_vehicle( veh );
+        }
+    }
+
+    std::fprintf( out, "]}\n" );
+    std::fclose( out );
+}
+
+/// A **driving session**: a vehicle driven straight, steered, and forced into a skid, recording after every `act_on_map` what the reference thinks the hull is doing.
+///
+/// The other vehicle dumps answer one question each - what a square costs, what a crash dents, what a plate absorbs. This one answers the *combination*: a steering press sets
+/// the wheel and the turn the hull owes (`vehicle::turn`, `vehicle_move.cpp:676-685`), every accepted move spends a degree of it (`map.cpp:917-928`), and the hull's facing is
+/// the travel direction - or the wheels, while skidding. `face`, `turn_dir`, `last_turn` and `skidding` are the four numbers those rules move, and they are what a port has to
+/// agree about.
+void dump_vehicle_drive( const std::string &path )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+
+    map &here = get_map();
+    const tripoint_bub_ms origin = get_player_character().pos_bub( here );
+    for( int dx = -24; dx <= 24; dx++ ) {
+        for( int dy = -24; dy <= 24; dy++ ) {
+            const tripoint_bub_ms square = origin + tripoint_rel_ms( dx, dy, 0 );
+            here.ter_set( square, ter_id( "t_floor" ) );
+            here.furn_set( square, furn_str_id::NULL_ID() );
+        }
+    }
+
+    std::fprintf( out, "{\"harness\":\"vehicle_drive\",\"version\":1,\"origin\":[%d,%d,%d],"
+                  "\"cases\":[", origin.x(), origin.y(), origin.z() );
+    bool first_case = true;
+
+    struct drive_case {
+        const char *name;
+        const char *type;
+        int speed;
+        // Presses, as (step to press before, degrees).
+        std::vector<std::pair<int, int>> presses;
+        // A forced skid: the step it is set before, and the wheel direction it is set to.
+        int skid_at;
+        int skid_wheel;
+    };
+    // **Speeds a square can be afforded at**: below about a thousand vmiph a square costs the whole turn, so `act_on_map` carries the movement points instead of
+    // moving and nothing about the hull changes. Every case drives, so every case is above that line.
+    const drive_case cases[] = {
+        { "straight", "car", 1000, {}, -1, 0 },
+        { "one_press", "car", 2000, { { 2, 45 } }, -1, 0 },
+        { "presses_both_ways", "car", 2000, { { 2, -30 }, { 7, 15 } }, -1, 0 },
+        { "bicycle_press", "bicycle", 1000, { { 2, 45 } }, -1, 0 },
+        // **Reversing**, with and without a press: the reference negates the press for a reversing vehicle, and `mdir.advance( -1 )` takes the step backwards from the same
+        // heading, so what the hull's facing does here is the question the port answered by reading rather than by measuring.
+        { "reversing", "car", -1000, {}, -1, 0 },
+        { "reversing_press", "car", -1000, { { 2, 45 } }, -1, 0 },
+    };
+
+    for( const drive_case &one : cases ) {
+        const tripoint_bub_ms start = origin + tripoint_rel_ms( 0, 10, 0 );
+        vehicle *veh = here.add_vehicle( vproto_id( one.type ), start, 0_degrees, 100, 0, false, true );
+        if( veh == nullptr ) {
+            std::fprintf( stderr, "harness: %s did not place\n", one.type );
+            continue;
+        }
+        // **A driver at the controls.** A vehicle with nobody aboard is given a one-in-ten chance per step to break into a skid
+        // (`vehicle_move.cpp:1925-1943`), which would make every row of this dump depend on how many dice the previous row drew. Boarding the avatar keeps the session
+        // about steering and movement, which is what the dump is for; the skid rules are recorded elsewhere. The avatar has to stand on the vehicle first, or the
+        // boarding moves the hull to wherever they are and every row records the wrong square.
+        Character &driver = get_player_character();
+        driver.setpos( here, start );
+        here.board_vehicle( start, &driver );
+        veh->velocity = one.speed;
+        veh->cruise_velocity = one.speed;
+        veh->of_turn = 1.0f;
+        std::fprintf( out, "%s{\"name\":\"%s\",\"vehicle\":\"%s\",\"speed\":%d,\"steps\":[",
+                      first_case ? "" : ",", one.name, one.type, one.speed );
+        bool first_step = true;
+        for( int step = 0; step < 12; step++ ) {
+            for( const std::pair<int, int> &press : one.presses ) {
+                if( press.first == step ) {
+                    veh->turn( units::from_degrees( press.second ) );
+                }
+            }
+            if( one.skid_at == step ) {
+                veh->skidding = true;
+                veh->turn_dir = units::from_degrees( one.skid_wheel );
+            }
+            veh = veh->act_on_map( here );
+            if( veh == nullptr ) {
+                std::fprintf( out, "%s{\"gone\":true}", first_step ? "" : "," );
+                break;
+            }
+            std::fprintf( out,
+                          "%s{\"x\":%d,\"y\":%d,\"velocity\":%d,\"of_turn\":%.9g,\"face\":%d,"
+                          "\"turn_dir\":%d,\"last_turn\":%d,\"skidding\":%s}",
+                          first_step ? "" : ",",
+                          veh->pos_bub( here ).x() - start.x(), veh->pos_bub( here ).y() - start.y(),
+                          veh->velocity, static_cast<double>( veh->of_turn ),
+                          static_cast<int>( std::lround( units::to_degrees( veh->face.dir() ) ) ),
+                          static_cast<int>( std::lround( units::to_degrees( veh->turn_dir ) ) ),
+                          static_cast<int>( std::lround( units::to_degrees( veh->last_turn ) ) ),
+                          veh->skidding ? "true" : "false" );
+            first_step = false;
+        }
+        std::fprintf( out, "]}" );
+        first_case = false;
+        here.destroy_vehicle( veh );
+    }
+
+    std::fprintf( out, "]}\n" );
+    std::fclose( out );
+}
