+void dump_crafting( const std::string &path )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+    std::fprintf( out, "{\"harness\":\"crafting\",\"version\":1,\n\"recipes\":[\n" );
+    bool first = true;
+    for( auto it = recipe_dict.begin(); it != recipe_dict.end(); ++it ) {
+        const recipe &r = it->second;
+        std::fprintf( out, "%s{\"id\":\"%s\",\"results\":[", first ? "" : ",\n",
+                      harness_escape( r.ident().str() ).c_str() );
+        first = false;
+        for( int batch = 1; batch <= 2; batch++ ) {
+            std::map<std::string, int> made;
+            for( const item &produced : r.create_results( batch ) ) {
+                made[produced.typeId().str()] += produced.count();
+            }
+            std::fprintf( out, "%s{\"batch\":%d,\"made\":[", batch == 1 ? "" : ",", batch );
+            bool first_item = true;
+            for( const auto &entry : made ) {
+                std::fprintf( out, "%s[\"%s\",%d]", first_item ? "" : ",", harness_escape( entry.first ).c_str(),
+                              entry.second );
+                first_item = false;
+            }
+            std::fprintf( out, "],\"byproducts\":[" );
+            std::map<std::string, int> spare;
+            for( const item &extra : r.create_byproducts( batch ) ) {
+                spare[extra.typeId().str()] += extra.count();
+            }
+            bool first_spare = true;
+            for( const auto &entry : spare ) {
+                std::fprintf( out, "%s[\"%s\",%d]", first_spare ? "" : ",", harness_escape( entry.first ).c_str(),
+                              entry.second );
+                first_spare = false;
+            }
+            std::fprintf( out, "]}" );
+        }
+        std::fprintf( out, "]}" );
+    }
+    std::fprintf( out, "\n],\"count\":%zu}\n", recipe_dict.size() );
+    std::fclose( out );
+}
+
+/// Every item type's thrown damage, which is what `item::base_damage_thrown` answers and what a thrown thing is worth before the arm.
+///
+/// Reference: `item::base_damage_thrown` (`item.cpp:7654-7658`) returns the type's `thrown_damage`, and `item_factory.cpp:324-326` fills it with
+/// `melee.damage_map[bash] * 0.75` when the data names none. A dump is the only way to read that, because the value is computed at load.
+void dump_thrown_damage( const std::string &path )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+    std::fprintf( out, "{\"harness\":\"thrown-damage\",\"version\":2,\n\"types\":[\n" );
+    bool first = true;
+    for( const itype *type : item_controller->all() ) {
+        if( type == nullptr ) {
+            continue;
+        }
+        const damage_instance &thrown = type->thrown_damage;
+        // The melee bash damage is dumped beside the thrown damage because the two are bound together: `item_factory.cpp:324-326` derives the second from the first,
+        // and a port that gets the inheritance of one right and the other wrong cannot tell which from a single number.
+        // The melee of each type is dumped whole - the three damage types the data uses - and `to_hit` beside it, because a character's blow is its weapon's damage aimed by its
+        // weapon's balance: a port that read one and guessed the other would be guessing the half that decides whether the blow lands at all.
+        std::fprintf( out, "%s\n{\"id\":\"%s\",\"total\":%.6g,\"melee_bash\":%.6g,\"melee_cut\":%.6g,\"melee_stab\":%.6g,\"to_hit\":%d,\"damage\":[",
+                      first ? "" : ",", harness_escape( type->get_id().str() ).c_str(),
+                      static_cast<double>( thrown.total_damage() ),
+                      static_cast<double>( type->melee.damage_map.count( damage_type_id( "bash" ) )
+                                           ? type->melee.damage_map.at( damage_type_id( "bash" ) ) : type->melee.default_value ),
+                      static_cast<double>( type->melee.damage_map.count( damage_type_id( "cut" ) )
+                                           ? type->melee.damage_map.at( damage_type_id( "cut" ) ) : type->melee.default_value ),
+                      static_cast<double>( type->melee.damage_map.count( damage_type_id( "stab" ) )
+                                           ? type->melee.damage_map.at( damage_type_id( "stab" ) ) : type->melee.default_value ),
+                      type->m_to_hit );
+        bool first_unit = true;
+        for( const damage_unit &unit : thrown.damage_units ) {
+            std::fprintf( out, "%s{\"type\":\"%s\",\"amount\":%.6g,\"res_pen\":%.6g,\"res_mult\":%.6g}",
+                          first_unit ? "" : ",",
+                          harness_escape( unit.type.str() ).c_str(),
+                          static_cast<double>( unit.amount ),
+                          static_cast<double>( unit.res_pen ),
+                          static_cast<double>( unit.res_mult ) );
+            first_unit = false;
+        }
+        std::fprintf( out, "]}" );
+        first = false;
+    }
+    std::fprintf( out, "]}\n" );
+    std::fclose( out );
+}
