+void dump_vehicle_slowdown( const std::string &path )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+
+    map &here = get_map();
+    const tripoint_bub_ms origin = get_player_character().pos_bub( here );
+    for( int dx = -16; dx <= 16; dx++ ) {
+        for( int dy = -16; dy <= 16; dy++ ) {
+            const tripoint_bub_ms square = origin + tripoint_rel_ms( dx, dy, 0 );
+            here.ter_set( square, ter_id( "t_floor" ) );
+            here.furn_set( square, furn_str_id::NULL_ID() );
+        }
+    }
+
+    // `vehicle::slowdown` (`vehicle_move.cpp:112-153`) is the speed a vehicle loses to drag and rolling resistance each turn, and `gain_moves` applies it
+    // before thrust. The dump states the speed it was asked about, the mass and the two coefficients it divides by, and the answer the reference gives.
+    std::fprintf( out, "{\"harness\":\"vehicle_slowdown\",\"version\":1,\"origin\":[%d,%d,%d],"
+                  "\"cases\":[", origin.x(), origin.y(), origin.z() );
+    bool first_case = true;
+
+    const char *types[] = { "bicycle", "quad_bike", "car", "electric_car" };
+    for( const char *type : types ) {
+        for( const int speed : { 0, 100, 500, 1000, 1871, 3000, 8000 } ) {
+            // Both engine states: `static_drag` subtracts 1500 W of extra drag when the engine is off (`vehicle.cpp:4961`), and that term is part of the answer.
+            for( const bool running : { false, true } ) {
+                vehicle *veh = here.add_vehicle( vproto_id( type ), origin, 0_degrees, 100, 0, false, true );
+                if( veh == nullptr ) {
+                    std::fprintf( stderr, "harness: %s did not place\n", type );
+                    continue;
+                }
+                veh->engine_on = running;
+                const int slowdown = veh->slowdown( here, speed );
+                std::fprintf( out,
+                              "%s{\"vehicle\":\"%s\",\"at\":%d,\"engine_on\":%s,\"mass_g\":%lld,"
+                              "\"c_air\":%.12g,\"c_rolling\":%.12g,\"slowdown\":%d}",
+                              first_case ? "" : ",", type, speed, running ? "true" : "false",
+                              static_cast<long long>( units::to_gram( veh->total_mass( here ) ) ),
+                              veh->coeff_air_drag(), veh->coeff_rolling_drag( here ), slowdown );
+                first_case = false;
+                here.destroy_vehicle( veh );
+            }
+        }
+    }
+
+    std::fprintf( out, "]}\n" );
+    std::fclose( out );
+}
+
+void dump_vehicle_thrust( const std::string &path )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+
+    map &here = get_map();
+    const tripoint_bub_ms origin = get_player_character().pos_bub( here );
+    for( int dx = -16; dx <= 16; dx++ ) {
+        for( int dy = -16; dy <= 16; dy++ ) {
+            const tripoint_bub_ms square = origin + tripoint_rel_ms( dx, dy, 0 );
+            here.ter_set( square, ter_id( "t_floor" ) );
+            here.furn_set( square, furn_str_id::NULL_ID() );
+        }
+    }
+
+    // `vehicle::thrust` (`vehicle_move.cpp:453-620`) is the whole velocity step: engine acceleration times traction, a brake floor, a reverse penalty, the cruise
+    // clamp and the two velocity clamps. The dump states every input the step reads and the velocity it leaves, so a port can be checked number by number rather
+    // than by a distance somewhere later.
+    std::fprintf( out, "{\"harness\":\"vehicle_thrust\",\"version\":1,\"origin\":[%d,%d,%d],"
+                  "\"cases\":[", origin.x(), origin.y(), origin.z() );
+    bool first_case = true;
+
+    struct ThrustCase {
+        const char *name;
+        const char *type;
+        int velocity;
+        int cruise;
+        int thd;
+    };
+    const ThrustCase cases[] = {
+        { "bicycle_at_rest", "bicycle", 0, 0, 1 },
+        { "bicycle_at_rest_with_cruise", "bicycle", 0, 3000, 1 },
+        { "bicycle_rolling", "bicycle", 1000, 3000, 1 },
+        { "bicycle_at_cruise", "bicycle", 3000, 3000, 1 },
+        { "bicycle_braking", "bicycle", 3000, 0, -1 },
+        { "bicycle_reversing", "bicycle", 0, -2000, -1 },
+        { "car_at_rest", "car", 0, 0, 1 },
+        { "car_rolling", "car", 1000, 5000, 1 },
+        { "car_braking", "car", 3000, 0, -1 },
+        { "car_reversing", "car", 0, -2000, -1 },
+        { "electric_car_at_rest", "electric_car", 0, 0, 1 },
+        { "electric_car_reversing", "electric_car", 0, -2000, -1 },
+        { "bicycle_engine_off", "bicycle", 1000, 3000, 1 },
+    };
+
+    for( const ThrustCase &each : cases ) {
+        vehicle *veh = here.add_vehicle( vproto_id( each.type ), origin, 0_degrees, 100, 0, false, true );
+        if( veh == nullptr ) {
+            std::fprintf( stderr, "harness: %s did not place\n", each.type );
+            continue;
+        }
+        const bool engine_off = std::string( each.name ) == "bicycle_engine_off";
+        veh->engine_on = !engine_off;
+        veh->velocity = each.velocity;
+        veh->cruise_velocity = each.cruise;
+        veh->skidding = false;
+
+        const int accel = veh->current_acceleration( here );
+        const float traction = veh->k_traction( here, here.vehicle_wheel_traction( *veh ) );
+        const int max_velocity = veh->max_velocity( here );
+        const int max_reverse = veh->max_reverse_velocity( here );
+        const itype_id battery( "battery" );
+        const bool has_battery = veh->has_engine_type( battery, true );
+        const int before = veh->velocity;
+        veh->thrust( here, each.thd );
+        const int after = veh->velocity;
+
+        std::fprintf( out,
+                      "%s{\"name\":\"%s\",\"vehicle\":\"%s\",\"velocity_before\":%d,\"cruise\":%d,"
+                      "\"thd\":%d,\"engine_on\":%s,\"acceleration\":%d,\"traction\":%.9g,"
+                      "\"max_velocity\":%d,\"max_reverse\":%d,\"has_battery_engine\":%s,"
+                      "\"velocity_after\":%d}",
+                      first_case ? "" : ",", each.name, each.type, before, each.cruise, each.thd,
+                      engine_off ? "false" : "true", accel, static_cast<double>( traction ),
+                      max_velocity, max_reverse, has_battery ? "true" : "false", after );
+        first_case = false;
+        here.destroy_vehicle( veh );
+    }
+
+    std::fprintf( out, "]}\n" );
+    std::fclose( out );
+}
