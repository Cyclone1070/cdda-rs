+void write_one_prototype( std::FILE *out, const T &proto, const char *kind, bool &first )
+{
+    std::fprintf( out, "%s\n{\"kind\":\"%s\",\"id\":\"%s\",\"name\":\"%s\",",
+                  first ? "" : ",", kind, proto.id.str().c_str(), proto.name().c_str() );
