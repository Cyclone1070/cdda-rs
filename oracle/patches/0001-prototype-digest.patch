+        first = false;
+        out << "{\"id\":\"" << entry.first.str() << "\",\"base_removal_chance\":" << entry.second.base_removal_chance
+            << ",\"threshold_min\":" << entry.second.threshold_min << ",\"vitamin\":\"" << entry.second.vitamin.str() << "\"}";
+    }
+    out << "]}" << std::endl;
+}
