+                      "\"volume\":%lld,\"integral_volume\":%lld,\"volume_no_contents\":%lld,"
+                      "\"length\":%lld}",
+                      first ? "" : ",\n", harness_escape( proto->id.str() ).c_str(), made.charges,
+                      static_cast<long long>( units::to_gram( made.weight() ) ),
+                      static_cast<long long>( units::to_gram( made.weight( true, true ) ) ),
+                      static_cast<long long>( units::to_milligram( made.weight() ) ),
+                      static_cast<long long>( units::to_milligram( made.weight( true, true ) ) ),
+                      static_cast<long long>( units::to_milliliter( made.volume() ) ),
+                      static_cast<long long>( units::to_milliliter( made.volume( true ) ) ),
+                      static_cast<long long>( units::to_milliliter( made.volume( false, true ) ) ),
+                      static_cast<long long>( units::to_millimeter( made.length() ) ) );
