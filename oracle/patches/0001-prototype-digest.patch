+/// What every item type actually weighs and takes up, as the reference's own functions answer.
+///
+/// Reference: `item::weight` (`src/item.cpp:7229-7300`) and `item::volume` (`src/item.cpp:7511-7590`). The prototype dump says what the *data* is; this says what the
+/// rules make of it - four numbers per type, at the charges the type's own default gives, which is where the charge and stack-size rules start to matter. A port that
+/// reproduced the data but not the rules would pass a prototype digest and fail this.
+void dump_item_measures( const std::string &path )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+    std::fprintf( out, "{\"harness\":\"item-measures\",\"version\":1,\n\"types\":[\n" );
+    bool first = true;
+    for( const itype *proto : item_controller->all() ) {
+        // A real item, so every rule that reads a live object applies - contents, charges, damage, flags.
+        item made( proto->get_id() );
+        std::fprintf( out,
+                      "%s{\"id\":\"%s\",\"charges\":%d,\"weight\":%lld,\"integral_weight\":%lld,"
