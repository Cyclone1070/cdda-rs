+/// Every `transform` use action, resolved: what an item turns into and what that costs.
+///
+/// Reference: `class iuse_transform` (`src/iuse_actor.h:44-110`) and its `load` (`src/iuse_actor.cpp:216-250`). It is the most common use action in the content (423
+/// declarations), and its fields are all about the **result**: the target id or the item group to draw one from, an optional container to put it in, the charges to
+/// set, a timer to start, and the conditions that must hold before the transformation may happen at all.
+/// What a bite actually puts in the stomach, per comestible.
+///
+/// Reference: `Character::consume_effects` (`src/consumption.cpp:1689-1714`) up to the point it calls `stomach.ingest`. Four calculations happen before that call and
+/// none of them is visible in the item's data:
+///
+/// * `compute_effective_nutrients` (`:306-317`) - the calories a character actually gets, after `RAW` loses a quarter, a carnivore loses half of `CARNIVORE_OK`
+///   food, and rot scales the rest down linearly to nothing at halfway-rotten;
+/// * `compute_default_effective_vitamins` (`:262-302`), which turns each **vitamin's** RDA percentage into internal units with `RDA_to_default` (`src/vitamin.cpp:122-129`):
+///   `24h * percent / 100 / rate`, and every vitamin in the content has a 15-minute rate, so one unit is 96 a day and a percent is 0.96 units;
+/// * `masticated_volume` (`:1524-1543`) - the water in the food is `quench * 5 mL`, and the dry volume is crunched down to its dry weight when it is less dense than
+///   water;
+/// * `compute_effective_food_volume_ratio` (`:1506-1519`) - calories per gram, floored at 1 and square-rooted above 3, which is how a dense food takes up more room
+///   than its volume says.
+void dump_food_summary( const std::string &path )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+    std::fprintf( out, "{\"harness\":\"food-summary\",\"version\":1,\n\"types\":[\n" );
+    bool first = true;
+    int count = 0;
+    avatar &u = get_avatar();
+    for( const itype *type : item_controller->all() ) {
+        if( type == nullptr || !type->comestible ) {
+            continue;
+        }
+        item food( type->get_id(), calendar::turn, 1 );
+        const nutrients effective = u.compute_effective_nutrients( food );
+        const std::pair<units::volume, units::volume> masticated = u.masticated_volume( food );
+        const double ratio = u.compute_effective_food_volume_ratio( food );
+        ++count;
+        std::fprintf( out,
+                      "%s{\"id\":\"%s\",\"comestible_type\":\"%s\",\"quench\":%d,\"weight_g\":%lld,"
+                      "\"type_weight_g\":%lld,\"charges\":%d,\"volume_ml\":%lld,\"count\":%d,\"relative_rot\":%.6g,"
+                      "\"kcal\":%d,\"water_ml\":%lld,"
+                      "\"solid_ml\":%lld,\"ratio\":%.17g,\"solids_ml\":%lld,\"vitamins\":{",
+                      first ? "" : ",\n", harness_escape( type->get_id().str() ).c_str(),
+                      harness_escape( type->comestible->comesttype ).c_str(),
+                      type->comestible->quench,
+                      static_cast<long long>( units::to_gram( food.weight() ) ),
+                      // The prototype's own weight, so a disagreement can be placed: on the type's data or on the item's arithmetic.
+                      static_cast<long long>( units::to_gram( type->weight ) ),
+                      food.charges,
+                      static_cast<long long>( units::to_milliliter( food.volume() ) ),
+                      food.count(), food.get_relative_rot(), effective.kcal(),
+                      static_cast<long long>( units::to_milliliter( masticated.first ) ),
+                      static_cast<long long>( units::to_milliliter( masticated.second ) ), ratio,
+                      static_cast<long long>( units::to_milliliter( masticated.second * ratio ) ) );
+        bool first_vitamin = true;
+        for( const std::pair<const vitamin_id, int> &vitamin : effective.vitamins() ) {
+            if( vitamin.second == 0 ) {
+                continue;
+            }
+            std::fprintf( out, "%s\"%s\":%d", first_vitamin ? "" : ",",
+                          harness_escape( vitamin.first.str() ).c_str(), vitamin.second );
+            first_vitamin = false;
+        }
+        std::fprintf( out, "}}" );
+        first = false;
+    }
+    std::fprintf( out, "\n],\"count\":%d}\n", count );
+    std::fclose( out );
+}
+
+/// The trace of a full stomach emptying itself, per comestible, in both compartments.
+///
+/// Reference: `stomach_contents::digest` (`src/stomach.cpp:400-437`) and the rates it works at (`:440-476`). The stomach passes material on to the guts in half-hour
+/// steps, and the guts absorb it into the body; both are fed here with a fixed `needs_rates` so the recording measures the rule and not a particular avatar's day.
+///
+/// What the rule is, in words:
+///
+/// * **water** leaves at 250 mL per five minutes and never more than is there — and a drying food's *negative* water is handed back whole, which is how eating
+///   something salty makes you thirstier;
+/// * **solids** leave at a sixth of the stomach's capacity per half hour (a bowl of guts moves a flat 250 mL), never more than is there;
+/// * **calories** leave at whatever is larger: a flat minimum, or a sixth of what is left — but never more than is left, and never less than a sixth of the
+///   thousandths-of-a-kilocalorie figure;
+/// * **vitamins** leave the same way, one at a time, with the same shape and a minimum of one unit — except a **drug** vitamin, which the stomach dumps into the
+///   blood in one step and the guts treat like any other.
+void dump_digest( const std::string &path )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+    // The rates the trace runs at: a maintenance intake of 2,500 kcal a day and no other pressure on the body.
+    needs_rates rates;
+    rates.kcal = 2500.0f;
+    rates.hunger = 1.0f;
+    rates.thirst = 1.0f;
+    rates.sleepiness = 0.0f;
+    const units::volume capacity = 1500_ml;
+    const int steps = 6;
+
+    std::fprintf( out,
+                  "{\"harness\":\"digest\",\"version\":1,\"rates\":{\"kcal\":%.6g,\"hunger\":%.6g,"
+                  "\"thirst\":%.6g,\"sleepiness\":%.6g},\"capacity_ml\":%lld,\"steps\":%d,\n\"foods\":[\n",
+                  static_cast<double>( rates.kcal ), static_cast<double>( rates.hunger ),
+                  static_cast<double>( rates.thirst ), static_cast<double>( rates.sleepiness ),
+                  static_cast<long long>( units::to_milliliter( capacity ) ), steps );
+
+    // One compartment's whole trace: what the food puts in, then `steps` half-hour digests.
+    const auto trace = [&]( const food_summary &ingested, bool is_stomach ) {
+        stomach_contents contents( capacity, is_stomach );
+        contents.ingest( ingested );
+        std::fprintf( out, "{\"capacity_ml\":%lld,\"steps\":[",
+                      static_cast<long long>( units::to_milliliter( contents.capacity( get_avatar() ) ) ) );
+        std::map<vitamin_id, int> first_vitamins;
+        std::map<vitamin_id, int> total_vitamins;
+        for( int step = 0; step < steps; ++step ) {
+            const food_summary digested = contents.digest( get_avatar(), rates, 1, 1 );
+            if( step == 0 ) {
+                first_vitamins = digested.nutr.vitamins();
+            }
+            for( const std::pair<const vitamin_id, int> &vitamin : digested.nutr.vitamins() ) {
+                total_vitamins[vitamin.first] += vitamin.second;
+            }
+            std::fprintf( out,
+                          "%s[%lld,%lld,%lld,%lld,%lld,%d]", step == 0 ? "" : ",",
+                          static_cast<long long>( units::to_milliliter( digested.water ) ),
+                          static_cast<long long>( units::to_milliliter( digested.solids ) ),
+                          static_cast<long long>( digested.nutr.calories ),
+                          static_cast<long long>( units::to_milliliter( contents.contains() ) ),
+                          static_cast<long long>( units::to_milliliter( contents.get_water() ) ),
+                          contents.get_calories() );
+        }
+        const auto vitamin_map = []( const std::map<vitamin_id, int> &map ) {
+            std::string text = "{";
+            bool first = true;
+            for( const std::pair<const vitamin_id, int> &vitamin : map ) {
+                if( vitamin.second == 0 ) {
+                    continue;
+                }
+                text += string_format( "%s\"%s\":%d", first ? "" : ",",
+                                       harness_escape( vitamin.first.str() ).c_str(), vitamin.second );
+                first = false;
+            }
+            return text + "}";
+        };
+        std::fprintf( out, "],\"vitamins_first\":%s,\"vitamins_total\":%s}",
+                      vitamin_map( first_vitamins ).c_str(), vitamin_map( total_vitamins ).c_str() );
+    };
+
+    avatar &u = get_avatar();
+    bool first = true;
+    int count = 0;
+    for( const itype *type : item_controller->all() ) {
+        if( type == nullptr || !type->comestible ) {
+            continue;
+        }
+        item food( type->get_id(), calendar::turn, 1 );
+        const nutrients effective = u.compute_effective_nutrients( food );
+        const std::pair<units::volume, units::volume> masticated = u.masticated_volume( food );
+        const double ratio = u.compute_effective_food_volume_ratio( food );
+        const food_summary ingested{ masticated.first, masticated.second * ratio, effective };
+        ++count;
+        std::fprintf( out,
+                      "%s{\"id\":\"%s\",\"ingested\":{\"water_ml\":%lld,\"solids_ml\":%lld,\"calories\":%lld,"
+                      "\"vitamins\":{",
+                      first ? "" : ",\n", harness_escape( type->get_id().str() ).c_str(),
+                      static_cast<long long>( units::to_milliliter( ingested.water ) ),
+                      static_cast<long long>( units::to_milliliter( ingested.solids ) ),
+                      static_cast<long long>( ingested.nutr.calories ) );
+        bool first_vitamin = true;
+        for( const std::pair<const vitamin_id, int> &vitamin : ingested.nutr.vitamins() ) {
+            if( vitamin.second == 0 ) {
+                continue;
+            }
+            std::fprintf( out, "%s\"%s\":%d", first_vitamin ? "" : ",",
+                          harness_escape( vitamin.first.str() ).c_str(), vitamin.second );
+            first_vitamin = false;
+        }
+        std::fprintf( out, "}},\"stomach\":" );
+        trace( ingested, true );
+        std::fprintf( out, ",\"guts\":" );
+        trace( ingested, false );
+        std::fprintf( out, "}" );
+        first = false;
+    }
+    std::fprintf( out, "\n],\"count\":%d}\n", count );
+    std::fclose( out );
+}
+
+/// What the body does with what the guts release: `Character::update_stomach` (`src/character_body.cpp:935-1019`), up to the point it picks a hunger *effect*.
+///
+/// This dump calls the **real** rule and records what it did, with every input it read written down beside it: the metabolic `rates` (which the rule recomputes from
+/// the character, so they are recorded per profile), the calorie burn per turn (`get_bmr() / (12 * 24)`), the healthy weight's calorie figure, and the two dice.
+///
+/// The dice are the only randomness in the rule — `roll_remainder( rates.hunger * five_mins )` and the same for thirst — and they are made reproducible rather than
+/// avoided: the engine is seeded, the two rolls are taken and written down, the engine is seeded **again** to the same place, and the rule then rolls the same two
+/// numbers in the same order. The port takes the recorded numbers as inputs, because dice belong to the caller.
+///
+/// Three profiles are traced for each food, because the rule is a ladder of `if`s on the character's state and one happy path would only ever climb one rung: fed and
+/// just bitten; fed and bitten forty minutes ago (past the ten-minute line); and already engorged, thirsty, and running on half the calories it wants.
+void dump_update_stomach( const std::string &path )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+    struct profile {
+        /// The compartment's base capacity. **250 mL is what a real character has**: `stomach_contents`'s `max_volume` defaults to zero and `capacity()` floors it at a
+        /// quarter of a litre, so a stomach capacity of 1,500 is a hypothetical and 250 is the game. Both are here because the ladder of fullness is written in
+        /// fractions of the capacity and a 1,500 mL stomach never gets past the first rung with one bite.
+        int capacity_ml;
+        int hunger;
+        int thirst;
+        int stored_kcal;
+        int minutes_since_ate;
+    };
+    static const std::array<profile, 6> profiles = {{
+            { 1500, 0, 0, 3000, 0 },
+            { 1500, 0, 0, 3000, 40 },
+            { 1500, -61, 20, 1500, 0 },
+            { 250, 0, 0, 3000, 0 },
+            { 250, 0, 0, 3000, 40 },
+            { 250, 300, 0, 1000, 40 },
+        }};
+    const unsigned seed = 20'250'101;
+
+    avatar &u = get_avatar();
+    const auto vitamin_map = []( const std::map<vitamin_id, int> &map ) {
+        std::string text = "{";
+        bool first = true;
+        for( const std::pair<const vitamin_id, int> &vitamin : map ) {
+            if( vitamin.second == 0 ) {
+                continue;
+            }
+            text += string_format( "%s\"%s\":%d", first ? "" : ",",
+                                   harness_escape( vitamin.first.str() ).c_str(), vitamin.second );
+            first = false;
+        }
+        return text + "}";
+    };
+    const auto levels = [&u]() {
+        std::map<vitamin_id, int> out_levels;
+        for( const std::pair<const vitamin_id, vitamin> &entry : vitamin::all() ) {
+            const int level = u.vitamin_get( entry.first );
+            if( level != 0 ) {
+                out_levels.emplace( entry.first, level );
+            }
+        }
+        return out_levels;
+    };
+
+    std::fprintf( out, "{\"harness\":\"update-stomach\",\"version\":1,\"five_mins\":6,"
+                  "\"half_hours\":1,\"seed\":%u,\n\"foods\":[\n", seed );
+
+    bool first_food = true;
+    int count = 0;
+    for( const itype *type : item_controller->all() ) {
+        if( type == nullptr || !type->comestible ) {
+            continue;
+        }
+        item food( type->get_id(), calendar::turn, 1 );
+        const nutrients effective = u.compute_effective_nutrients( food );
+        const std::pair<units::volume, units::volume> masticated = u.masticated_volume( food );
+        const double ratio = u.compute_effective_food_volume_ratio( food );
+        const food_summary ingested{ masticated.first, masticated.second * ratio, effective };
+        ++count;
+        std::fprintf( out, "%s{\"id\":\"%s\",\"ingested\":{\"water_ml\":%lld,\"solids_ml\":%lld,"
+                      "\"calories\":%lld,\"vitamins\":%s},\"profiles\":[",
+                      first_food ? "" : ",\n", harness_escape( type->get_id().str() ).c_str(),
+                      static_cast<long long>( units::to_milliliter( ingested.water ) ),
+                      static_cast<long long>( units::to_milliliter( ingested.solids ) ),
+                      static_cast<long long>( ingested.nutr.calories ),
+                      vitamin_map( ingested.nutr.vitamins() ).c_str() );
+        bool first_profile = true;
+        for( const profile &p : profiles ) {
+            // The bite happens at a clock position chosen so that `time_since_ate()` comes out as the profile's: `ingest` stamps `last_ate` with the clock, so the
+            // clock is moved back before the food goes in and forward again before the update.
+            const time_point now = calendar::turn_zero + 1_hours;
+            calendar::turn = now - time_duration::from_minutes( p.minutes_since_ate );
+            const units::volume capacity = units::from_milliliter( p.capacity_ml );
+            u.stomach = stomach_contents( capacity, true );
+            u.guts = stomach_contents( capacity, false );
+            u.set_hunger( p.hunger );
+            u.set_thirst( p.thirst );
+            u.set_stored_kcal( p.stored_kcal );
+            for( const std::pair<const vitamin_id, vitamin> &entry : vitamin::all() ) {
+                u.vitamin_set( entry.first, 0 );
+            }
+            u.stomach.ingest( ingested );
+            calendar::turn = now;
+
+            // The inputs the rule will read, recorded before it runs.
+            const needs_rates rates = u.calc_needs_rates();
+            const float kcal_per_time = u.get_bmr() / ( 12.0f * 24.0f );
+            const int healthy_kcal = u.get_healthy_kcal();
+            const int stored_before = u.get_stored_kcal();
+            const int stored_calories_before = u.get_stored_calories();
+            const int hunger_before = u.get_hunger();
+            const int thirst_before = u.get_thirst();
+            std::fprintf( out,
+                          "%s{\"profile\":{\"capacity_ml\":%d,\"hunger\":%d,\"thirst\":%d,\"stored_kcal\":%d,"
+                          "\"minutes_since_ate\":%d},"
+                          "\"rates\":{\"kcal\":%.6g,\"hunger\":%.6g,\"thirst\":%.6g,\"sleepiness\":%.6g},"
+                          "\"kcal_per_time\":%.17g,\"healthy_kcal\":%d,",
+                          first_profile ? "" : ",", p.capacity_ml, p.hunger, p.thirst, p.stored_kcal,
+                          p.minutes_since_ate,
+                          static_cast<double>( rates.kcal ), static_cast<double>( rates.hunger ),
+                          static_cast<double>( rates.thirst ), static_cast<double>( rates.sleepiness ),
+                          static_cast<double>( kcal_per_time ), healthy_kcal );
+            first_profile = false;
+
+            // Roll the two dice, then put the engine back so the rule rolls them again itself.
+            rng_set_engine_seed( seed );
+            const int hunger_roll = roll_remainder( rates.hunger * 6 );
+            const int thirst_roll = roll_remainder( rates.thirst * 6 );
+            rng_set_engine_seed( seed );
+            u.update_stomach( now, now + 30_minutes );
+
+            std::fprintf( out,
+                          "\"rolls\":{\"hunger\":%d,\"thirst\":%d},"
+                          "\"before\":{\"hunger\":%d,\"thirst\":%d,\"stored_kcal\":%d,\"stored_calories\":%d},"
+                          "\"after\":{\"hunger\":%d,\"thirst\":%d,\"stored_kcal\":%d,\"stored_calories\":%d,"
+                          "\"vitamins\":%s,"
+                          "\"stomach\":{\"contains_ml\":%lld,\"water_ml\":%lld,\"kcal\":%d},"
+                          "\"guts\":{\"contains_ml\":%lld,\"water_ml\":%lld,\"kcal\":%d}}}",
+                          hunger_roll, thirst_roll, hunger_before, thirst_before, stored_before,
+                          stored_calories_before,
+                          u.get_hunger(), u.get_thirst(), u.get_stored_kcal(), u.get_stored_calories(),
+                          vitamin_map( levels() ).c_str(),
+                          static_cast<long long>( units::to_milliliter( u.stomach.contains() ) ),
+                          static_cast<long long>( units::to_milliliter( u.stomach.get_water() ) ),
+                          u.stomach.get_calories(),
+                          static_cast<long long>( units::to_milliliter( u.guts.contains() ) ),
+                          static_cast<long long>( units::to_milliliter( u.guts.get_water() ) ),
+                          u.guts.get_calories() );
+        }
+        std::fprintf( out, "]}" );
+        first_food = false;
+    }
+    std::fprintf( out, "\n],\"count\":%d}\n", count );
+    std::fclose( out );
+}
+
+/// The arithmetic behind the metabolic rates: `get_starvation` (`src/character.cpp:4657-4670`), `metabolic_rate` (`:770-790`), `base_bmr` (`:6514-6527`),
+/// `get_bmr` (`:6538-6542`) and the `calc_needs_rates` that assembles them (`:5273-5316`).
+///
+/// These four numbers are the ones every meal, every burn and every sleep in the game are measured against, and until now the port took them from a recording rather
+/// than computing them. The dump therefore calls each function separately as well as recording the state it read, so a disagreement says **which** of the four is
+/// wrong instead of only that the rates came out different.
+///
+/// The grid is deliberately lopsided: hunger runs from engorged to famished and past the last threshold, the calorie store runs from full to half, and the activity
+/// level runs over the whole exertional range. The avatar is kept **awake**, because the sleeping path multiplies the rates by a half and reads the temperature of
+/// every body part (`calc_sleep_recovery_rate`, `:5321-5360`), which is a slice of its own.
+void dump_needs( const std::string &path )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+    static const std::array<int, 6> hungers = {{ -61, -21, 0, 100, 300, 600 }};
+    static const std::array<double, 3> kcal_percents = {{ 1.0, 0.9, 0.5 }};
+    static const std::array<float, 4> activities = {{ 1.0f, 1.15f, 1.5f, 2.0f }};
+
+    avatar &u = get_avatar();
+    u.remove_effect( efftype_id( "sleep" ) );
+    const int healthy_kcal = u.get_healthy_kcal();
+    const int weight_grams = units::to_gram<int>( u.bodyweight() );
+    const int height_cm = u.height();
+    const int age = u.age();
+    const double metabolism_base = static_cast<double>( u.metabolic_rate_base() );
+
+    std::fprintf( out,
+                  "{\"harness\":\"needs\",\"version\":1,\"bodyweight_grams\":%d,\"height_cm\":%d,\"age\":%d,"
+                  "\"metabolism_base\":%.17g,\"healthy_kcal\":%d,\n\"cases\":[\n",
+                  weight_grams, height_cm, age, metabolism_base, healthy_kcal );
+    bool first = true;
+    int count = 0;
+    for( const int hunger : hungers ) {
+        for( const double percent : kcal_percents ) {
+            for( const float activity : activities ) {
+                u.set_hunger( hunger );
+                u.set_stored_kcal( static_cast<int>( std::round( healthy_kcal * percent ) ) );
+                // The tracker averages a window, so the level is logged several times to move the average rather than nudge it.
+                for( int i = 0; i < 20; ++i ) {
+                    u.set_activity_level( activity );
+                }
+                const needs_rates rates = u.calc_needs_rates();
+                ++count;
+                std::fprintf( out,
+                              "%s{\"hunger\":%d,\"stored_kcal\":%d,\"kcal_percent\":%.17g,\"activity\":%.17g,"
+                              "\"bodyweight_grams\":%d,\"metabolism_base\":%.17g,"
+                              "\"starvation\":%d,\"speed\":%d,\"metabolic_rate\":%.17g,\"base_bmr\":%d,"
+                              "\"average_activity\":%.17g,\"max_exertion\":%.17g,\"bmr\":%d,"
+                              "\"rates\":{\"kcal\":%.17g,\"hunger\":%.17g,\"thirst\":%.17g,\"sleepiness\":%.17g,"
+                              "\"recovery\":%.17g}}",
+                              first ? "" : ",\n", hunger, u.get_stored_kcal(), u.get_kcal_percent(),
+                              static_cast<double>( activity ), units::to_gram<int>( u.bodyweight() ),
+                              static_cast<double>( u.metabolic_rate_base() ),
+                              u.get_starvation(), u.get_speed(),
+                              static_cast<double>( u.metabolic_rate() ), u.base_bmr(),
+                              static_cast<double>( u.activity_history.average_activity() ),
+                              static_cast<double>( u.maximum_exertion_level() ), u.get_bmr(),
+                              static_cast<double>( rates.kcal ), static_cast<double>( rates.hunger ),
+                              static_cast<double>( rates.thirst ), static_cast<double>( rates.sleepiness ),
+                              static_cast<double>( rates.recovery ) );
+                first = false;
+            }
+        }
+    }
+    std::fprintf( out, "\n],\"count\":%d}\n", count );
+    std::fclose( out );
+}
+
+/// Does reseeding the reference's engine change the next die? Three seeds, three draws each, and the same with an avatar in hand.
+///
+/// This exists because a dump recorded constant dice and the suspicion fell on the seeding. It answers that question directly rather than by argument.
+void dump_rng_probe( const std::string &path )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+    std::fprintf( out, "{\"harness\":\"rng-probe\",\"version\":1,\"before_avatar\":[" );
+    bool first = true;
+    for( unsigned seed : { 12345u, 12346u, 12347u } ) {
+        rng_set_engine_seed( seed );
+        std::fprintf( out, "%s{\"seed\":%u,\"draws\":[%d,%d,%d]}", first ? "" : ",", seed, rng( 1, 100 ),
+                      rng( 1, 100 ), rng( 1, 100 ) );
+        first = false;
+    }
+    std::fprintf( out, "],\"after_avatar\":[" );
+    first = true;
+    for( unsigned seed : { 12345u, 12346u, 12347u } ) {
+        avatar &u = get_avatar();
+        rng_set_engine_seed( seed );
+        std::fprintf( out, "%s{\"seed\":%u,\"draws\":[%d,%d,%d]}", first ? "" : ",", seed, rng( 1, 100 ),
+                      rng( 1, 100 ), rng( 1, 100 ) );
+        ( void )u;
+        first = false;
+    }
+    std::fprintf( out, "]}\n" );
+    std::fclose( out );
+}
+
+/// One skill level after one experience change, twice: once spending the excess and once crossing levels with it.
+///
+/// The arithmetic is entirely in `SkillLevel` (`src/skill.cpp:444-480`), and its thresholds are squares: ten thousand points for the first level, forty for the second,
+/// ninety for the third. The dump walks both settings over the same list of raw values - including values one below and one above each threshold, the cap, and the
+/// negatives that take a level away - so the port can be compared step for step rather than by the story the code tells.
+void dump_skill_level( const std::string &path )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+    // No negative values: at level zero, `on_exercise_change` sets the experience to `-1` and the level to `-1`, after which `exercise()` divides by
+    // `100 * ( level + 1 )^2` = zero and the reference dies of SIGFPE. That is a defect in the reference, not a rule to copy - see docs/parity.md.
+    const std::vector<int> raws = { 0, 1, 99, 100, 9999, 10000, 10001, 39999, 40000, 40001, 89999,
+                                    90000, 140000, 159999, 160000, 1000000, 100000000
+                                  };
+    std::fprintf( out, "{\"harness\":\"skill-level\",\"version\":1,\"max_skill\":%d,\"cases\":[\n", MAX_SKILL );
+    bool first = true;
+    for( const int raw : raws ) {
+        // `set_exercise` goes through `on_exercise_change( true )` - multi-level allowed - which is the path recorded here. The single-level path is `train`'s, and it
+        // needs the `SKILL_TRAINING_SPEED` option, so it stays a declared gap rather than being recorded with an option value the dump happens to have.
+        SkillLevel level;
+        level.set_exercise( raw, true );
+        std::fprintf( out,
+                      "%s{\"raw\":%d,\"level\":%d,\"exercise_raw\":%d,\"exercise\":%d,"
+                      "\"knowledge_level\":%d,\"knowledge_raw\":%d,\"exercised_level\":%d}",
+                      first ? "" : ",\n", raw, level.level(), level.exercise( true ),
+                      level.exercise( false ), level.knowledgeLevel(), level.knowledgeExperience( true ),
+                      level.exercised_level() );
+        first = false;
+    }
+    // And the training path, which is where the excess is **spent**: `train` reads `SKILL_TRAINING_SPEED`, and the default of one is what the cases below run with.
+    struct TrainCase {
+        int amount;
+        float catchup;
+        float knowledge;
+        int multilevel;
+        int repeats;
+        // Knowledge experience laid down first, through `knowledge_train`: without it the cap on the knowledge addition cannot be seen, because levelling a skill
+        // **resets** its knowledge experience (`src/skill.cpp:462-465`).
+        int knowledge_first;
+    };
+    const std::vector<TrainCase> trains = {
+        { 0, 1.0f, 1.0f, 0, 1, 0 },     { 1, 1.0f, 1.0f, 0, 1, 0 },     { 100, 1.0f, 1.0f, 0, 1, 0 },
+        { 9999, 1.0f, 1.0f, 0, 1, 0 },  { 10000, 1.0f, 1.0f, 0, 1, 0 }, { 10001, 1.0f, 1.0f, 0, 1, 0 },
+        { 40000, 1.0f, 1.0f, 0, 1, 0 }, { 40000, 1.0f, 1.0f, 1, 1, 0 }, { 40000, 0.5f, 1.5f, 0, 1, 0 },
+        { 40000, 0.5f, 1.5f, 1, 1, 0 }, { 10000, 1.0f, 1.0f, 0, 2, 0 }, { 10000, 1.0f, 1.0f, 1, 3, 0 },
+        { 100, 1.0f, 1.0f, 1, 5, 0 },   { 25000, 2.0f, 0.25f, 0, 2, 0 },
+        // Knowledge experience ahead of practice, which is the branch where the ninety-percent cap can actually be seen: the knowledge addition is larger than the
+        // catch-up, so only the cap keeps it from pulling ahead.
+        { 10000, 0.1f, 1.0f, 1, 1, 0 }, { 10000, 0.5f, 1.5f, 1, 1, 0 },
+        // Knowledge laid down first, so the ninety-percent cap has something to hold back.
+        { 100, 0.05f, 1.5f, 1, 1, 5000 }, { 100, 0.05f, 1.5f, 0, 1, 5000 },
+        { 1000, 0.05f, 1.5f, 1, 3, 5000 },
+    };
+    std::fprintf( out, "\n],\"trains\":[" );
+    bool first_train = true;
+    for( const TrainCase &item : trains ) {
+        SkillLevel level;
+        if( item.knowledge_first > 0 ) {
+            level.knowledge_train( item.knowledge_first );
+        }
+        for( int repeat = 0; repeat < item.repeats; ++repeat ) {
+            level.train( item.amount, item.catchup, item.knowledge, item.multilevel != 0 );
+        }
+        std::fprintf( out,
+                      "%s{\"amount\":%d,\"catchup\":%.9g,\"knowledge\":%.9g,\"multilevel\":%d,\"repeats\":%d,\"knowledge_first\":%d,"
+                      "\"level\":%d,\"exercise_raw\":%d,\"knowledge_level\":%d,\"knowledge_raw\":%d,"
+                      "\"rust\":%d,\"exercised_level\":%d}",
+                      first_train ? "" : ",\n", item.amount, static_cast<double>( item.catchup ),
+                      static_cast<double>( item.knowledge ), item.multilevel, item.repeats, item.knowledge_first,
+                      level.level(),
+                      level.exercise( true ), level.knowledgeLevel(), level.knowledgeExperience( true ),
+                      level.rustAccumulator(), level.exercised_level() );
+        first_train = false;
+    }
+    std::fprintf( out, "]}\n" );
+    std::fclose( out );
+}
