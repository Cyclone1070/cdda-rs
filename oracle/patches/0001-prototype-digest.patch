+/// Every effect type, with the fields the rules that read them consult.
+///
+/// The effect registry is the one content family the prototype digest could not see: `effect_types` is a plain `std::map` in `src/effect.cpp:58`, not a
+/// `generic_factory`, so nothing registers it automatically. It is the biggest family in the game's behaviour — 453 types, and every one of the hunger, sleep,
+/// allergy and vitamin rules lands on one — so it is recorded here in full for the fields a rule can read, plus its ids for the digest.
+void dump_effects( const std::string &path )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+    const auto list = []( const auto &values ) {
+        std::string text = "[";
+        bool first = true;
+        for( const auto &value : values ) {
+            text += string_format( "%s\"%s\"", first ? "" : ",", harness_escape( value.str() ).c_str() );
+            first = false;
+        }
+        return text + "]";
+    };
+    std::fprintf( out, "{\"harness\":\"effects\",\"version\":1,\n\"types\":[\n" );
+    bool first_type = true;
+    int count = 0;
+    for( const std::pair<const efftype_id, effect_type> &entry : get_effect_types() ) {
+        const effect_type &effect = entry.second;
+        ++count;
+        std::fprintf( out,
+                      "%s{\"id\":\"%s\",\"max_intensity\":%d,\"max_duration\":%lld,\"dur_add_perc\":%d,"
+                      "\"int_add_val\":%d,\"int_decay_step\":%d,\"int_decay_tick\":%d,\"int_dur_factor\":%lld,"
+                      "\"int_decay_remove\":%s,\"main_parts_only\":%s,\"show_in_info\":%s,"
+                      "\"show_intensity\":%s,\"pain_sizing\":%s,\"hurt_sizing\":%s,\"harmful_cough\":%s,"
+                      "\"impairs_movement\":%s,\"pkill_addict_reduces\":%s,\"rating\":%d,"
+                      "\"flags\":%s,\"resist_traits\":%s,\"resist_effects\":%s,\"removes_effects\":%s,"
+                      "\"blocks_effects\":%s}",
+                      first_type ? "" : ",\n", harness_escape( entry.first.str() ).c_str(),
+                      ::oracle_effect_reader::max_intensity( effect ),
+                      static_cast<long long>( to_turns<int64_t>( ::oracle_effect_reader::max_duration( effect ) ) ),
+                      ::oracle_effect_reader::dur_add_perc( effect ), ::oracle_effect_reader::int_add_val( effect ),
+                      ::oracle_effect_reader::int_decay_step( effect ), ::oracle_effect_reader::int_decay_tick( effect ),
+                      static_cast<long long>( to_turns<int64_t>( ::oracle_effect_reader::int_dur_factor( effect ) ) ),
+                      ::oracle_effect_reader::int_decay_remove( effect ) ? "true" : "false",
+                      ::oracle_effect_reader::main_parts_only( effect ) ? "true" : "false",
+                      ::oracle_effect_reader::show_in_info( effect ) ? "true" : "false",
+                      ::oracle_effect_reader::show_intensity( effect ) ? "true" : "false",
+                      ::oracle_effect_reader::pain_sizing( effect ) ? "true" : "false",
+                      ::oracle_effect_reader::hurt_sizing( effect ) ? "true" : "false",
+                      ::oracle_effect_reader::harmful_cough( effect ) ? "true" : "false",
+                      ::oracle_effect_reader::impairs_movement( effect ) ? "true" : "false",
+                      ::oracle_effect_reader::pkill_addict_reduces( effect ) ? "true" : "false",
+                      static_cast<int>( effect.get_rating() ),
+                      list( ::oracle_effect_reader::flags( effect ) ).c_str(),
+                      list( ::oracle_effect_reader::resist_traits( effect ) ).c_str(),
+                      list( ::oracle_effect_reader::resist_effects( effect ) ).c_str(),
+                      list( ::oracle_effect_reader::removes_effects( effect ) ).c_str(),
+                      list( ::oracle_effect_reader::blocks_effects( effect ) ).c_str() );
+        first_type = false;
+    }
+    std::fprintf( out, "\n],\"count\":%d}\n", count );
+    std::fclose( out );
+}
