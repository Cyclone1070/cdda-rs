+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+    std::fprintf( out, "{\"harness\":\"skills\",\"version\":1,\n\"skills\":[\n" );
+    bool first = true;
+    for( const Skill &skill : Skill::skills ) {
+        const time_info_t &time = skill.time_to_attack();
+        std::fprintf( out, "%s\n{\"id\":\"%s\",\"name\":\"%s\",\"min_time\":%d,\"base_time\":%d,\"time_reduction_per_level\":%d}",
