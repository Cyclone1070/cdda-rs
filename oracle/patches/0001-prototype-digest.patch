+namespace
+{
+/// One prototype in the shape `map_data_common_t::load` reads: `type` rather than `kind`, and `symbol`
+/// as a string rather than code points. The other dumps describe what the reference holds; this one is
+/// the file the game itself would load, which is what lets the port's loader be pointed at the
+/// reference's own data instead of at a hand-written fixture.
+/// Escapes a string for JSON. Terrain symbols include `"` and `\\` in the real data - a railroad tie
+/// has a backslash - so a dump that prints them raw is not JSON at all.
+std::string escaped( const std::string &raw )
+{
+    std::string out;
+    for( const char c : raw ) {
+        if( c == '"' || c == '\\' ) {
+            out.push_back( '\\' );
+        }
+        out.push_back( c );
+    }
+    return out;
+}
+
+template<typename T>
+void write_for_loader( std::FILE *out, const T &proto, const char *type, bool &first )
+{
+    std::fprintf( out, "%s\n{\"type\":\"%s\",\"id\":\"%s\",\"name\":\"%s\",",
+                  first ? "" : ",", type, escaped( proto.id.str() ).c_str(),
+                  escaped( proto.name() ).c_str() );
+    std::fprintf( out, "\"symbol\":\"%s\",\"color\":\"%s\",\"move_cost\":%d,"
+                  "\"light\":%d,\"coverage\":%d,\"transparent\":%s,\"flags\":[",
+                  escaped( std::string( 1, static_cast<char>( proto.symbol_[0] ) ) ).c_str(),
+                  string_from_color( proto.color() ).c_str(), proto.movecost,
+                  proto.light_emitted, proto.coverage,
+                  proto.transparent ? "true" : "false" );
+    bool first_flag = true;
+    for( const std::string &flag : proto.get_flags() ) {
+        std::fprintf( out, "%s\"%s\"", first_flag ? "" : ",", flag.c_str() );
+        first_flag = false;
+    }
+    std::fprintf( out, "]}" );
+    first = false;
+}
