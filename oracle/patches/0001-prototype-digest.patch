+/// What each comestible is worth to an eater in each of those states.
+///
+/// Reference: `Character::fun_for` (`src/consumption.cpp:483`). The transcribed upstream cases in `tests/food_fun_for_test.cpp` are inequalities - "less than half",
+/// "greater than zero" - because the reference had no recording of the exact numbers. This is that recording: every comestible, every branch, both numbers.
+void dump_fun_for( const std::string &path )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+    avatar &u = get_avatar();
+    u.set_body();
+    // One row of results per comestible, filled one configuration at a time: the avatar's state is set once per configuration rather than once per food.
+    std::vector<itype_id> ids;
+    std::vector<std::vector<std::pair<int, int>>> results;
+    // The two inputs that cannot be recovered from the answers: what the item is worth to itself (`get_comestible_fun`, which adds each flag's `taste_mod` and
+    // floors a mushy item at -5), and where its rot actually sits after `set_relative_rot` - which is **not** 1.5 for everything, because a food that does not
+    // spoil has no rot at all.
+    std::vector<int> item_fun;
+    std::vector<float> rot_set;
+    for( const itype *type : item_controller->all() ) {
+        if( type == nullptr || !type->comestible ) {
+            continue;
+        }
+        ids.push_back( type->get_id() );
+        results.emplace_back();
+        item fresh( type->get_id(), calendar::turn, 1 );
+        item_fun.push_back( fresh.get_comestible_fun() );
+        fresh.set_relative_rot( 1.5f );
+        rot_set.push_back( fresh.get_relative_rot() );
+    }
+    for( const fun_configuration &config : fun_configurations ) {
+        if( config.trait_id != nullptr ) {
+            u.toggle_trait( trait_id( config.trait_id ) );
+        }
+        if( config.effect_id != nullptr ) {
+            u.add_effect( efftype_id( config.effect_id ), 1_hours );
+        }
+        if( config.bionic_id != nullptr ) {
+            u.add_bionic( bionic_id( config.bionic_id ) );
+            if( config.bionic_active ) {
+                for( int i = 0; i < u.num_bionics(); ++i ) {
+                    if( u.bionic_at_index( i ).id == bionic_id( config.bionic_id ) ) {
+                        u.activate_bionic( u.bionic_at_index( i ) );
+                    }
+                }
+            }
+        }
+        if( config.power_kj > 0 ) {
+            u.set_max_power_level( units::from_kilojoule( 100 ) );
+            u.set_power_level( units::from_kilojoule( config.power_kj ) );
+        }
+        for( size_t i = 0; i < ids.size(); ++i ) {
+            item it( ids[i], calendar::turn, 1 );
+            if( config.item_flag != nullptr ) {
+                it.set_flag( flag_id( config.item_flag ) );
+            }
+            if( config.relative_rot > 0.0f ) {
+                it.set_relative_rot( config.relative_rot );
+            }
+            results[i].push_back( u.fun_for( it ) );
+        }
+        // Put the avatar back the way it was, so the next row starts from a plain character.
+        if( config.trait_id != nullptr ) {
+            u.toggle_trait( trait_id( config.trait_id ) );
+        }
+        u.clear_effects();
+        if( config.bionic_id != nullptr ) {
+            u.clear_bionics();
+            u.set_max_power_level( 0_kJ );
+            u.set_power_level( 0_kJ );
+        }
+    }
+
+    std::fprintf( out, "{\"harness\":\"fun-for\",\"version\":1,\n\"configurations\":[" );
+    bool first_config = true;
+    for( const fun_configuration &config : fun_configurations ) {
+        std::fprintf( out, "%s\"%s\"", first_config ? "" : ",", config.name );
+        first_config = false;
+    }
+    std::fprintf( out, "],\n\"foods\":[\n" );
+    bool first = true;
+    for( size_t i = 0; i < ids.size(); ++i ) {
+        const itype *type = item::find_type( ids[i] );
+        std::fprintf( out, "%s{\"id\":\"%s\",\"fun\":%d,\"item_fun\":%d,\"rot_set\":%.6g,\"is_food\":%s,\"pairs\":[",
+                      first ? "" : ",\n", harness_escape( ids[i].str() ).c_str(),
+                      type->comestible->harness_fun(), item_fun[i], rot_set[i],
+                      item( ids[i] ).is_food() ? "true" : "false" );
+        bool first_pair = true;
+        for( const std::pair<int, int> &pair : results[i] ) {
+            std::fprintf( out, "%s[%d,%d]", first_pair ? "" : ",", pair.first, pair.second );
+            first_pair = false;
+        }
+        std::fprintf( out, "]}" );
+        first = false;
+    }
+    std::fprintf( out, "\n],\"count\":%d}\n", static_cast<int>( ids.size() ) );
+    std::fclose( out );
+}
