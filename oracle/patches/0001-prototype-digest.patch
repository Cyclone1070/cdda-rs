+void dump_vehicle_mass( const std::string &path )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+
+    map &here = get_map();
+    const vproto_id type( "bicycle" );
+    if( !type.is_valid() ) {
+        std::fprintf( stderr, "harness: bicycle is not a valid prototype\n" );
+        std::fclose( out );
+        return;
+    }
+
+    const tripoint_bub_ms origin = get_player_character().pos_bub( here );
+    for( int dx = -12; dx <= 12; dx++ ) {
+        for( int dy = -12; dy <= 12; dy++ ) {
+            const tripoint_bub_ms square = origin + tripoint_rel_ms( dx, dy, 0 );
+            here.ter_set( square, ter_id( "t_floor" ) );
+            here.furn_set( square, furn_str_id::NULL_ID() );
+        }
+    }
+
+    vehicle *veh = here.add_vehicle( type, origin, 0_degrees, 0, 0, false, true );
+    if( veh == nullptr ) {
+        std::fprintf( stderr,
+                      "harness: mass placement failed at %d,%d,%d: valid=%d inbounds=%d ter=%s furn=%s impassable=%d veh=%d\n",
+                      origin.x(), origin.y(), origin.z(), type.is_valid(), here.inbounds( origin ),
+                      here.ter( origin ).id().str().c_str(), here.furn( origin ).id().str().c_str(),
+                      here.impassable( origin ), here.veh_at( origin ) ? 1 : 0 );
+        std::fclose( out );
+        return;
+    }
+
+    // Fifty rocks in the basket: a real cargo mass that still leaves room (50 x 250 ml of the basket's 20 L).
+    int basket = -1;
+    for( const vpart_reference &vpr : veh->get_all_parts() ) {
+        if( vpr.info().id.str() == "basketsm" ) {
+            basket = vpr.part_index();
+            break;
+        }
+    }
+    int rocks = 0;
+    if( basket >= 0 ) {
+        for( int i = 0; i < 50; i++ ) {
+            if( veh->add_item( here, veh->part( basket ), item( itype_id( "rock" ), calendar::turn ) ) ) {
+                rocks++;
+            }
+        }
+    }
+
+    std::fprintf( out, "{\"harness\":\"vehicle_mass\",\"version\":1,\"vehicle\":\"%s\",\"name\":\"%s\",",
+                  type.str().c_str(), veh->name.c_str() );
+    std::fprintf( out, "\"origin\":[%d,%d,%d],\"basket\":%d,\"rocks\":%d,\"parts\":[", origin.x(), origin.y(),
+                  origin.z(), basket, rocks );
+    bool first = true;
+    for( const vpart_reference &vpr : veh->get_all_parts() ) {
+        units::mass items = 0_gram;
+        for( const item &j : veh->get_items( vpr.part() ) ) {
+            items += j.weight();
+        }
+        std::fprintf( out,
+                      "%s{\"part\":\"%s\",\"mount\":[%d,%d],\"base_mass_g\":%d,\"items_mass_g\":%d,"
+                      "\"cargo_weight_modifier\":%d}",
+                      first ? "" : ",", vpr.info().id.str().c_str(), vpr.mount_pos().x(), vpr.mount_pos().y(),
+                      units::to_gram<int>( vpr.part().get_base().weight() ), units::to_gram<int>( items ),
+                      vpr.info().cargo_weight_modifier );
+        first = false;
+    }
+    units::mass cargo = 0_gram;
+    for( const vpart_reference &vpr : veh->get_all_parts() ) {
+        for( const item &j : veh->get_items( vpr.part() ) ) {
+            cargo += j.weight();
+        }
+    }
+    std::fprintf( out, "],\"unloaded_mass_g\":%d,\"cargo_mass_g\":%d,\"total_mass_g\":%d}\n",
+                  units::to_gram<int>( veh->unloaded_mass() ), units::to_gram<int>( cargo ),
+                  units::to_gram<int>( veh->total_mass( here ) ) );
+    std::fclose( out );
+}
