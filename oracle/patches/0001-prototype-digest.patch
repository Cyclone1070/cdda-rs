+void dump_recipes( const std::string &path )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+    std::fprintf( out, "{\"harness\":\"recipes\",\"version\":1,\n\"recipes\":[\n" );
+    bool first = true;
+    for( auto it = recipe_dict.begin(); it != recipe_dict.end(); ++it ) {
+        const recipe &r = it->second;
+        std::fprintf( out, "%s{\"id\":\"%s\",\"result\":\"%s\",\"blacklisted\":%s,\"never_learn\":%s,\"components\":[",
+                      first ? "" : ",\n", r.ident().str().c_str(), r.result().str().c_str(),
+                      r.is_blacklisted() ? "true" : "false", r.never_learn ? "true" : "false" );
+        // Alternatives are the structure that matters: each inner list is a set of things any
+        // one of which satisfies that requirement, so flattening them would change the recipe.
+        bool first_group = true;
+        for( const auto &group : r.simple_requirements().get_components() ) {
+            std::fprintf( out, "%s[", first_group ? "" : "," );
+            first_group = false;
+            bool first_alt = true;
+            for( const item_comp &comp : group ) {
+                std::fprintf( out, "%s{\"item\":\"%s\",\"count\":%d}",
+                              first_alt ? "" : ",", comp.type.str().c_str(), comp.count );
+                first_alt = false;
+            }
+            std::fprintf( out, "]" );
+        }
+        std::fprintf( out, "],\"tools\":[" );
+        bool first_tool_group = true;
+        for( const auto &group : r.simple_requirements().get_tools() ) {
+            std::fprintf( out, "%s[", first_tool_group ? "" : "," );
+            first_tool_group = false;
+            bool first_tool = true;
+            for( const tool_comp &tool : group ) {
+                std::fprintf( out, "%s{\"item\":\"%s\",\"count\":%d}",
+                              first_tool ? "" : ",", tool.type.str().c_str(), tool.count );
+                first_tool = false;
+            }
+            std::fprintf( out, "]" );
+        }
+        std::fprintf( out, "],\"qualities\":[" );
+        bool first_quality_group = true;
+        for( const auto &group : r.simple_requirements().get_qualities() ) {
+            std::fprintf( out, "%s[", first_quality_group ? "" : "," );
+            first_quality_group = false;
+            bool first_quality = true;
+            for( const quality_requirement &quality : group ) {
+                std::fprintf( out, "%s{\"quality\":\"%s\",\"level\":%d,\"count\":%d}",
+                              first_quality ? "" : ",", quality.type.str().c_str(), quality.level,
+                              quality.count );
+                first_quality = false;
+            }
+            std::fprintf( out, "]" );
+        }
+        // What the recipe asks of the crafter: the skill it trains, how hard it is, and how long one batch takes
+        // (`recipe.h:133-137`, `:188`, and `time`, which is a `time_duration` in moves).
+        // What one batch makes, what each result holds, and what is left over: `result_mult` and `charges` are private fields whose effect is only visible in what
+        // `create_result` returns, so the dump asks the rules rather than the members (`recipe.cpp:737-825`).
+        std::map<std::string, int> one_made;
+        for( const item &produced : r.create_results( 1 ) ) {
+            one_made[produced.typeId().str()] += produced.count();
+        }
+        int made_count = 0;
+        if( one_made.size() == 1 && one_made.begin()->first == r.result().str() ) {
+            made_count = one_made.begin()->second;
+        }
+        // The **item** the rule produces, which is the container for a `contained` recipe (`create_result`, `recipe.cpp:768-771`) - the field cannot be read directly
+        // because the members are private, and asking the rule is the same discipline the rest of this dump follows.
+        const std::string made_item = one_made.empty() ? std::string() : one_made.begin()->first;
+        std::fprintf( out, "],\"skill\":\"%s\",\"difficulty\":%d,\"time_moves\":%d,\"made_item\":\"%s\",\"made_per_batch\":%d,\"byproducts\":[",
+                      harness_escape( r.skill_used.str() ).c_str(), r.difficulty,
+                      // The moves one batch takes for an ordinary crafter: `time_to_craft_moves` returns `time`
+                      // itself when proficiencies are ignored (`recipe.cpp:100-106`), and `time` is private.
+                      static_cast<int>( r.time_to_craft_moves(
+                                            get_player_character(), recipe_time_flag::ignore_proficiencies ) ),
+                      harness_escape( made_item ).c_str(), made_count );
+        bool first_spare = true;
+        for( const auto &entry : byproducts_of( r ) ) {
+            std::fprintf( out, "%s[\"%s\",%d]", first_spare ? "" : ",", harness_escape( entry.first ).c_str(),
+                          entry.second );
+            first_spare = false;
+        }
+        // The byproduct array closes first, then the **practice block** when the recipe has one (`recipe.h:72-84`): a practice recipe sets its difficulty from
+        // the crafter's skill between `min_difficulty` and `max_difficulty`, and stops teaching at `skill_limit`. Dumped as three numbers so the port's clamp has
+        // the reference's own range - and printed **after** the array closes, so a recipe with no byproducts is still valid JSON.
+        std::fprintf( out, "]" );
+        if( r.practice_data ) {
+            std::fprintf( out, ",\"practice\":{\"min_difficulty\":%d,\"max_difficulty\":%d,\"skill_limit\":%d}",
+                          r.practice_data->min_difficulty, r.practice_data->max_difficulty,
+                          r.practice_data->skill_limit );
+        }
+        std::fprintf( out, "}" );
+        first = false;
+    }
+    std::fprintf( out, "\n],\"count\":%zu}\n", recipe_dict.size() );
+    std::fclose( out );
+}
