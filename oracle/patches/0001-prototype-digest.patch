+/// A fixed set of zones and the manager's answers about them.
+///
+/// The zone manager is the first thing in the port whose answers depend on **order**: `get_zone_at` returns the first zone that contains a square, `get_bottom_zone` returns
+/// the last one drawn, and the two take different views of the same list. A dump that only recorded "some zone contains this square" would pass with the list reversed, so
+/// the fixture is built to overlap: one plain rectangle, one overlapping it, one nested inside both, one of another faction, one inverted, one disabled, and a drink zone
+/// among food ones for the loot-only query.
+void dump_zones_probe( const std::string &path )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+    zone_manager &mgr = zone_manager::get_manager();
+    mgr.clear();
+    struct spec {
+        const char *name;
+        const char *type;
+        const char *faction;
+        bool invert;
+        bool enabled;
+        int sx, sy, ex, ey;
+    };
+    // The set, in the order the manager holds it. `end` is **inclusive** on both axes, and a zone whose corners are written the other way round is the same zone.
+    const spec specs[] = {
+        { "Kitchen", "LOOT_FOOD", your_fac.str().c_str(), false, true, 0, 0, 4, 3 },
+        { "Overlap", "LOOT_FOOD", your_fac.str().c_str(), false, true, 2, 1, 6, 5 },
+        { "Nested", "LOOT_FOOD", your_fac.str().c_str(), false, true, 1, 1, 2, 2 },
+        { "Somebody else's", "LOOT_FOOD", "no_faction", false, true, 3, 3, 8, 8 },
+        { "Everything but", "LOOT_FOOD", your_fac.str().c_str(), true, true, 10, 10, 12, 12 },
+        { "Switched off", "LOOT_FOOD", your_fac.str().c_str(), false, false, 5, 0, 7, 2 },
+        { "Water", "LOOT_DRINK", your_fac.str().c_str(), false, true, 3, 2, 4, 4 },
+        // **A zone that is not a loot zone at all**, laid over a square a loot zone already covers. Without it `get_zone_at( loot_only )` returns the same zone as
+        // `get_bottom_zone` everywhere and the loot filter is never exercised.
+        { "Fishing spot", "FISHING_SPOT", your_fac.str().c_str(), false, true, 4, 4, 6, 6 },
+    };
+    for( const spec &one : specs ) {
+        mgr.add( one.name, zone_type_id( one.type ), faction_id( one.faction ), one.invert, one.enabled,
+                 tripoint_abs_ms( one.sx, one.sy, 0 ), tripoint_abs_ms( one.ex, one.ey, 0 ), nullptr, true );
+    }
+    std::fprintf( out, "{\"harness\":\"zones_probe\",\"version\":1,\"zones\":[\n" );
+    bool first = true;
+    // The no-argument overload hands back **references**: the manager's own zones, which is what a dump wants - a copy would not tell the port anything about the order.
+    const std::vector<zone_manager::ref_zone_data> held = mgr.get_zones();
+    for( const zone_manager::ref_zone_data &reference : held ) {
+        const zone_data &zone = reference.get();
+        const tripoint_abs_ms start = zone.get_start_point();
+        const tripoint_abs_ms end = zone.get_end_point();
+        std::fprintf( out,
+                      "%s{\"name\":\"%s\",\"type\":\"%s\",\"faction\":\"%s\",\"invert\":%s,\"enabled\":%s,"
+                      "\"start\":[%d,%d,%d],\"end\":[%d,%d,%d]}",
+                      first ? "" : ",\n",
+                      harness::harness_escape( zone.get_name() ).c_str(),
+                      harness::harness_escape( zone.get_type().str() ).c_str(),
+                      harness::harness_escape( zone.get_faction().str() ).c_str(),
+                      zone.get_invert() ? "true" : "false",
+                      zone.get_enabled() ? "true" : "false",
+                      start.x(), start.y(), start.z(), end.x(), end.y(), end.z() );
+        first = false;
+    }
+    // **The others**, which the owner's list leaves out. A dump that showed only `your_followers` would leave the faction filter untested: the port could ignore the faction
+    // entirely and still match every number below.
+    std::fprintf( out, "\n],\"others\":[\n" );
+    const std::vector<zone_manager::ref_zone_data> others = mgr.get_zones( faction_id( "no_faction" ) );
+    first = true;
+    for( const zone_manager::ref_zone_data &reference : others ) {
+        const zone_data &zone = reference.get();
+        const tripoint_abs_ms other_start = zone.get_start_point();
+        const tripoint_abs_ms other_end = zone.get_end_point();
+        std::fprintf( out,
+                      "%s{\"name\":\"%s\",\"type\":\"%s\",\"faction\":\"%s\",\"invert\":%s,\"enabled\":%s,"
+                      "\"start\":[%d,%d,%d],\"end\":[%d,%d,%d]}",
+                      first ? "" : ",\n", harness::harness_escape( zone.get_name() ).c_str(),
+                      harness::harness_escape( zone.get_type().str() ).c_str(),
+                      harness::harness_escape( zone.get_faction().str() ).c_str(),
+                      zone.get_invert() ? "true" : "false", zone.get_enabled() ? "true" : "false",
+                      other_start.x(), other_start.y(), other_start.z(),
+                      other_end.x(), other_end.y(), other_end.z() );
+        first = false;
+    }
+    std::fprintf( out, "\n],\"probes\":[\n" );
+    first = true;
+    first = true;
+    for( int y = -1; y <= 13; y++ ) {
+        for( int x = -1; x <= 14; x++ ) {
+            const tripoint_abs_ms where( x, y, 0 );
+            // Every zone that contains the square, in the manager's own order.
+            std::string inside;
+            for( std::size_t i = 0; i < held.size(); i++ ) {
+                if( held[i].get().has_inside( where ) ) {
+                    inside += ( inside.empty() ? "" : "," );
+                    inside += std::to_string( i );
+                }
+            }
+            // The same question asked of a type.
+            std::vector<zone_data> food = mgr.get_zones( zone_type_id( "LOOT_FOOD" ), where, faction_id( your_fac.str().c_str() ) );
+            std::string first_food;
+            for( std::size_t i = 0; i < food.size(); i++ ) {
+                first_food += ( first_food.empty() ? "" : "," );
+                first_food += std::to_string( i );
+            }
+            const zone_data *top = mgr.get_zone_at( where, zone_type_id( "LOOT_FOOD" ), faction_id( your_fac.str().c_str() ) );
+            const zone_data *bottom = mgr.get_bottom_zone( where, faction_id( your_fac.str().c_str() ) );
+            const zone_data *loot = mgr.get_zone_at( where, true, faction_id( your_fac.str().c_str() ) );
+            std::fprintf( out,
+                          "%s{\"x\":%d,\"y\":%d,\"inside\":[%s],\"food_count\":%zu,"
+                          "\"food_first\":\"%s\",\"bottom\":\"%s\",\"loot_first\":\"%s\",\"other_inside\":%zu,"
+                          "\"has_food\":%s,\"has_water\":%s,\"has_fishing\":%s,\"near_food_2\":%s,\"near_water_1\":%s}",
+                          first ? "" : ",\n", x, y, inside.c_str(), food.size(),
+                          top == nullptr ? "" : harness::harness_escape( top->get_name() ).c_str(),
+                          bottom == nullptr ? "" : harness::harness_escape( bottom->get_name() ).c_str(),
+                          loot == nullptr ? "" : harness::harness_escape( loot->get_name() ).c_str(),
+                          mgr.get_zones( zone_type_id( "LOOT_FOOD" ), where, faction_id( "no_faction" ) ).size(),
+                          // The **cached** question. `cache_data` skips a zone that is switched off (`src/clzones.cpp:897-900`), which is the opposite of what the
+                          // queries above do - so the "Switched off" zone is found by `get_zone_at` and not by `has`.
+                          mgr.has( zone_type_id( "LOOT_FOOD" ), where, your_fac ) ? "true" : "false",
+                          mgr.has( zone_type_id( "LOOT_DRINK" ), where, your_fac ) ? "true" : "false",
+                          mgr.has( zone_type_id( "FISHING_SPOT" ), where, your_fac ) ? "true" : "false",
+                          mgr.has_near( zone_type_id( "LOOT_FOOD" ), where, 2, your_fac ) ? "true" : "false",
+                          mgr.has_near( zone_type_id( "LOOT_DRINK" ), where, 1, your_fac ) ? "true" : "false" );
+            first = false;
+        }
+    }
+    std::fprintf( out, "\n]}\n" );
+    std::fclose( out );
+    mgr.clear();
+}
