+void dump_engine_power( const std::string &path )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+
+    map &here = get_map();
+    const tripoint_bub_ms origin = get_player_character().pos_bub( here );
+    for( int dx = -12; dx <= 12; dx++ ) {
+        for( int dy = -12; dy <= 12; dy++ ) {
+            const tripoint_bub_ms square = origin + tripoint_rel_ms( dx, dy, 0 );
+            here.ter_set( square, ter_id( "t_floor" ) );
+            here.furn_set( square, furn_str_id::NULL_ID() );
+        }
+    }
+
+    std::fprintf( out, "{\"harness\":\"engine_power\",\"version\":1,\"origin\":[%d,%d,%d],"
+                  "\"cases\":[", origin.x(), origin.y(), origin.z() );
+    bool first_case = true;
+
+    // An engine's power is `part_vpower_w` (`vehicle.cpp:1125-1190`): its `power`, scaled by `damaged_power_factor + ( 1 - damaged_power_factor ) * health_percent`
+    // once it is hurt. That function is private, so the dump reads the public total on a vehicle with exactly **one** engine - which is the same number - and walks
+    // it from whole to broken. Wherever the integer power unit truncates is therefore the reference's own arithmetic.
+    vehicle *veh = here.add_vehicle( vproto_id( "quad_bike" ), origin, 0_degrees, 0, 0, false, true );
+    if( veh == nullptr ) {
+        std::fprintf( stderr, "harness: the quad bike did not place\n" );
+        std::fclose( out );
+        return;
+    }
+    int engine = -1;
+    for( int p = 0; p < veh->part_count(); p++ ) {
+        if( veh->part( p ).info().has_flag( VPFLAG_ENGINE ) ) {
+            engine = p;
+            break;
+        }
+    }
+    if( engine < 0 ) {
+        std::fprintf( stderr, "harness: the quad bike has no engine\n" );
+        std::fclose( out );
+        return;
+    }
+    const int durability = veh->part( engine ).info().durability;
+    const std::vector<int> up_to = { durability, durability * 9 / 10, durability * 3 / 4, durability / 2,
+                                     durability / 4, durability / 10, 1, 0
+                                   };
+    for( const int hp : up_to ) {
+        veh->set_hp( veh->part( engine ), hp, false );
+        const vehicle_part &vp = veh->part( engine );
+        std::fprintf( out,
+                      "%s{\"name\":\"hp_%d\",\"vehicle\":\"quad_bike\",\"engine_part\":%d,\"part_id\":\"%s\","
+                      "\"durability\":%d,\"hp\":%d,\"health\":%.17g,\"damaged_power_factor\":%.9g,"
+                      "\"total_power_w\":%d,\"broken\":%d}",
+                      first_case ? "" : ",", hp, engine, vp.info().id.str().c_str(), durability, hp,
+                      vp.health_percent(), static_cast<double>( vp.info().engine_info->damaged_power_factor ),
+                      units::to_watt( veh->total_power( here, false ) ), vp.is_broken() ? 1 : 0 );
+        first_case = false;
+    }
+    here.destroy_vehicle( veh );
+
+    std::fprintf( out, "]}\n" );
+    std::fclose( out );
+}
