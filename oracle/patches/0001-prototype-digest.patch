+/// What a corpse takes up, for every creature, and what taking it apart does to that.
+///
+/// Reference: `item::corpse_volume` (`src/item.cpp:7455-7479`) and the corpse branch of `item::volume` (`src/item.cpp:7518-7520`). The rule is one volume multiplied by four
+/// fractions in a fixed order - quartered by 4, field-dressed by 3/4, gibbed by 0.85, skinned by 0.85 - with a truncation after each because the arithmetic is on whole
+/// millilitres, and a cap at the largest item. It is recorded per creature because the volume starts from the **monster's** own.
+void dump_corpse_volume( const std::string &path )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+    std::fprintf( out, "{\"harness\":\"corpse-volume\",\"version\":1,\n\"creatures\":[\n" );
+    bool first = true;
+    for( const mtype &monster_ref : MonsterGenerator::generator().get_all_mtypes() ) {
+        const mtype *monster = &monster_ref;
+        auto corpse_with = [&monster]( const std::vector<std::string> &flags ) {
+                               item made = item::make_corpse( monster->id );
+                               for( const std::string &flag : flags ) {
+                                   made.set_flag( flag_id( flag ) );
+                               }
+                               return made;
+                           };
+        item plain = corpse_with( {} );
+        item quartered = corpse_with( { "QUARTERED" } );
+        item dressed = corpse_with( { "FIELD_DRESS" } );
+        item dressed_badly = corpse_with( { "FIELD_DRESS_FAILED" } );
+        item gibbed = corpse_with( { "GIBBED" } );
+        item skinned = corpse_with( { "SKINNED" } );
+        item all = corpse_with( { "QUARTERED", "FIELD_DRESS", "GIBBED", "SKINNED" } );
+        std::fprintf( out,
+                      "%s{\"id\":\"%s\",\"monster_volume\":%lld,"
+                      "\"plain\":%lld,\"quartered\":%lld,\"dressed\":%lld,\"dressed_badly\":%lld,"
+                      "\"gibbed\":%lld,\"skinned\":%lld,\"all\":%lld}",
+                      first ? "" : ",\n", harness_escape( monster->id.str() ).c_str(),
+                      static_cast<long long>( units::to_milliliter( monster->volume ) ),
+                      static_cast<long long>( units::to_milliliter( plain.volume() ) ),
+                      static_cast<long long>( units::to_milliliter( quartered.volume() ) ),
+                      static_cast<long long>( units::to_milliliter( dressed.volume() ) ),
+                      static_cast<long long>( units::to_milliliter( dressed_badly.volume() ) ),
+                      static_cast<long long>( units::to_milliliter( gibbed.volume() ) ),
+                      static_cast<long long>( units::to_milliliter( skinned.volume() ) ),
+                      static_cast<long long>( units::to_milliliter( all.volume() ) ) );
+        first = false;
+    }
+    std::fprintf( out, "\n]}\n" );
+    std::fclose( out );
+}
