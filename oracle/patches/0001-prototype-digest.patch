+// Every resolved monster type, with the fields the port loads first.
+/// Every anatomy and the numbers a blow's landing place is chosen from.
+///
+/// Reference: `anatomy` (`src/anatomy.h:20-64`) holds a list of `bodypart_id`, and `anatomy::select_body_part`
+/// (`anatomy.cpp:208-256`) weighs each by `bodypart_type::hit_size`, filters on `min_hit`/`max_hit`, drops
+/// `LIMB_UPPER` parts for a short attacker, triples `LIMB_LOWER` ones and scales by
+/// `hit_roll ^ hit_difficulty`. A gate that built its own parts would prove the arithmetic and not the data, so
+/// this dumps both: which parts each anatomy has, and what each part states.
+void dump_anatomy( const std::string &path )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+    std::fprintf( out, "{\"harness\":\"anatomy\",\"version\":1,\n\"parts\":[\n" );
+    bool first = true;
+    for( const body_part_type &part : body_part_type::get_all() ) {
+        const bool upper = part.has_flag( json_character_flag( "LIMB_UPPER" ) );
+        const bool lower = part.has_flag( json_character_flag( "LIMB_LOWER" ) );
+        std::fprintf( out,
+                      "%s\n{\"id\":\"%s\",\"name\":\"%s\",\"hit_size\":%.6f,"
+                      "\"hit_difficulty\":%.6f,\"upper\":%s,\"lower\":%s",
+                      first ? "" : ",", harness_escape( part.id.str() ).c_str(),
+                      harness_escape( part.name.translated() ).c_str(),
+                      static_cast<double>( part.hit_size ),
+                      static_cast<double>( part.hit_difficulty ),
+                      upper ? "true" : "false", lower ? "true" : "false" );
+        // **What the part contributes to each limb score**, which is the input of the dodge, attack-speed and carrying rules:
+        // `body_part_type::limb_scores` holds a score and a max per id (`bodypart.cpp:424-434`), and `limbtypes` holds the part's
+        // limb types with the weight of each (`:331-370`).
+        // **Asked through the public getters, because the map itself is private** (`bodypart.h:211-213`): the score and its max are a method each (`:356-358`), and the
+        // reference's own `limb_score::get_all` is what says which scores exist at all.
+        std::fprintf( out, ",\"limb_scores\":[" );
+        bool first_score = true;
+        for( const limb_score &scored : limb_score::get_all() ) {
+            if( !part.has_limb_score( scored.getId() ) ) {
+                continue;
+            }
+            std::fprintf( out, "%s[\"%s\",%.6f,%.6f]", first_score ? "" : ",",
+                          harness_escape( scored.getId().str() ).c_str(),
+                          static_cast<double>( part.get_limb_score( scored.getId() ) ),
+                          static_cast<double>( part.get_limb_score_max( scored.getId() ) ) );
+            first_score = false;
+        }
+        std::fprintf( out, "],\"limb_types\":[" );
+        bool first_type = true;
+        for( const auto &typed : part.limbtypes ) {
+            std::fprintf( out, "%s[\"%s\",%.6f]", first_type ? "" : ",",
+                          io::enum_to_string<body_part_type::type>( typed.first ).c_str(),
+                          static_cast<double>( typed.second ) );
+            first_type = false;
+        }
+        // **How much health the part has**, which is what the wound adjustment scales a score by (`bodypart.cpp:967-976`): `base_hp` is the type's own figure, and a body's part
+        // starts there rather than at a number the port would have to guess.
+        // **The part's own limits** (`bodypart.h:265-273`): `health_limit` is the hit points below which a limb stops counting towards a move's needs (`martialarts.cpp:1495-1515`), and
+        // `encumbrance_limit` is where a limb stops contributing its scores. Both default to 0 in the struct and `health_limit` loads as 1 (`bodypart.cpp:410-415`).
+        std::fprintf( out, "],\"health_limit\":%d,\"encumbrance_limit\":%d,\"encumbrance_threshold\":%d,\"base_hp\":%d,\"primary_limb_type\":%s",
+                      part.health_limit, part.encumbrance_limit, part.encumbrance_threshold, part.base_hp,
+                      part.primary_limb_type() == body_part_type::type::num_types ? "null" :
+                      ("\"" + io::enum_to_string<body_part_type::type>( part.primary_limb_type() ) + "\"").c_str() );
+        std::fprintf( out, "}" );
+        first = false;
+    }
+    // The anatomy list is deliberately not dumped: `anatomy_factory` is a file-local static in `anatomy.cpp`
+    // and the harness may not reach into the reference's internals. Which parts an anatomy has is data the port
+    // loads from the game's JSON; what those parts *are* is what this file answers.
+    std::fprintf( out, "\n]}\n" );
+    std::fclose( out );
+}
+
+/// Every weak-point set the game defines, with the figures its rules read.
+///
+/// A set is a **list of weak points plus a default one**, and each entry carries its own coverage, which way it cuts, its armour and damage multipliers, and the difficulty of hitting it with each
+/// kind of attack (`weakpoint.h:132-166`, `:180-205`). The port loads these rather than writing them down: 48 sets exist, and a hand-copied one would be wrong the day the data changed.
+///
+/// The entries are written through the public struct's own fields - a `weakpoints` hands out its list and its default, not a reader for either - and the attack-type difficulty is written as the
+/// five figures the array holds, in the array's own order (`NONE`, `MELEE_BASH`, `MELEE_CUT`, `MELEE_STAB`, `PROJECTILE`).
+static void dump_one_weakpoint( std::FILE *out, const weakpoint &weakpoint )
+{
+    std::fprintf( out, "{\"id\":\"%s\",\"coverage\":%.6f,\"is_good\":%s,\"is_head\":%s",
+                  harness_escape( weakpoint.id ).c_str(), static_cast<double>( weakpoint.coverage ),
+                  weakpoint.is_good ? "true" : "false", weakpoint.is_head ? "true" : "false" );
+    std::fprintf( out, ",\"armor_mult\":{" );
+    bool first = true;
+    for( const auto &entry : weakpoint.armor_mult ) {
+        std::fprintf( out, "%s\"%s\":%.6f", first ? "" : ",", harness_escape( entry.first.str() ).c_str(),
+                      static_cast<double>( entry.second ) );
+        first = false;
+    }
+    std::fprintf( out, "},\"armor_penalty\":{" );
+    first = true;
+    for( const auto &entry : weakpoint.armor_penalty ) {
+        std::fprintf( out, "%s\"%s\":%.6f", first ? "" : ",", harness_escape( entry.first.str() ).c_str(),
+                      static_cast<double>( entry.second ) );
+        first = false;
+    }
+    std::fprintf( out, "},\"damage_mult\":{" );
+    first = true;
+    for( const auto &entry : weakpoint.damage_mult ) {
+        std::fprintf( out, "%s\"%s\":%.6f", first ? "" : ",", harness_escape( entry.first.str() ).c_str(),
+                      static_cast<double>( entry.second ) );
+        first = false;
+    }
+    std::fprintf( out, "},\"crit_mult\":{" );
+    first = true;
+    for( const auto &entry : weakpoint.crit_mult ) {
+        std::fprintf( out, "%s\"%s\":%.6f", first ? "" : ",", harness_escape( entry.first.str() ).c_str(),
+                      static_cast<double>( entry.second ) );
+        first = false;
+    }
+    std::fprintf( out, "},\"coverage_mult\":[" );
+    for( int i = 0; i < static_cast<int>( weakpoint_attack::attack_type::NUM ); i++ ) {
+        std::fprintf( out, "%s%.6f", i == 0 ? "" : ",", static_cast<double>( weakpoint.coverage_mult.difficulty[i] ) );
+    }
+    std::fprintf( out, "],\"difficulty\":[" );
+    for( int i = 0; i < static_cast<int>( weakpoint_attack::attack_type::NUM ); i++ ) {
+        std::fprintf( out, "%s%.6f", i == 0 ? "" : ",", static_cast<double>( weakpoint.difficulty.difficulty[i] ) );
+    }
+    // **What a struck weak point can trigger** (`weakpoint_effect`, `weakpoint.h:68-92`): an effect id, the chance, the share of the body it must take, the duration and intensity ranges, and
+    // whether it is permanent. Without this column a port can find a head and has nothing to do to the body it found.
+    std::fprintf( out, "],\"effects\":[" );
+    bool first_effect = true;
+    for( const weakpoint_effect &effect : weakpoint.effects ) {
+        std::fprintf( out,
+                      "%s{\"effect\":\"%s\",\"chance\":%.6f,\"permanent\":%s,"
+                      "\"duration\":[%d,%d],\"intensity\":[%d,%d],\"damage_required\":[%.6f,%.6f]}",
+                      first_effect ? "" : ",", harness_escape( effect.effect.str() ).c_str(),
+                      static_cast<double>( effect.chance ), effect.permanent ? "true" : "false",
+                      effect.duration.first, effect.duration.second, effect.intensity.first,
+                      effect.intensity.second, static_cast<double>( effect.damage_required.first ),
+                      static_cast<double>( effect.damage_required.second ) );
+        first_effect = false;
+    }
+    std::fprintf( out, "]}" );
+}
