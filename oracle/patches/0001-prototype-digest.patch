+/// `coord_translate`'s answer for a grid of mounts at five facings - `--dump-vehicle-rotation`.
+///
+/// The port turns a mount into a square with the reference's `vehicle::coord_translate` (`vehicle.cpp:3598-3615`), which advances a `tileray` by `mount.x`, then offsets it
+/// sideways by `mount.y` with `ortho_dx`/`ortho_dy` (`tileray.cpp:86-113`). A rule that is only read is a rule that is only guessed, so this records the reference's own integers
+/// over the mounts a vehicle uses and a margin around them, at five facings - including 45 degrees, where no exact lattice answer exists and only the reference's rounding
+/// decides. `vehicle::precalc_mounts` calls this same function with `pivot = (0,0)` for a placed vehicle (`mapgen.cpp:7543-7550`), so the table is the whole rule.
+void dump_vehicle_rotation( const std::string &path )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+    std::fprintf( out, "{\"harness\":\"vehicle_rotation\",\"version\":1,\"facings\":[\n" );
+    const int facings[] = { 0, 45, 90, 180, 270 };
+    bool first_facing = true;
+    for( const int degrees : facings ) {
+        std::fprintf( out, "%s{\"degrees\":%d,\"squares\":[", first_facing ? "" : ",\n", degrees );
+        bool first = true;
+        for( int x = -6; x <= 4; x++ ) {
+            for( int y = -3; y <= 3; y++ ) {
+                tileray tdir( units::from_degrees( degrees ) );
+                tdir.advance( x );
+                const int qx = tdir.dx() + tdir.ortho_dx( y );
+                const int qy = tdir.dy() + tdir.ortho_dy( y );
+                std::fprintf( out, "%s{\"mount\":[%d,%d],\"at\":[%d,%d]}", first ? "" : ",", x, y, qx,
+                              qy );
+                first = false;
+            }
+        }
+        std::fprintf( out, "]}" );
+        first_facing = false;
+    }
+    std::fprintf( out, "\n]}\n" );
+    std::fclose( out );
+}
