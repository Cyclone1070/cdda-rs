+}
+
+std::string harness_escape( const std::string &value )
+{
+    std::string out;
+    out.reserve( value.size() + 2 );
+    for( const char c : value ) {
+        switch( c ) {
+            case '"':
+                out += "\\\"";
+                break;
+            case '\\':
+                out += "\\\\";
+                break;
+            case '\n':
+                out += "\\n";
+                break;
+            case '\t':
+                out += "\\t";
+                break;
+            case '\r':
+                out += "\\r";
+                break;
+            default:
+                out += c;
+        }
+    }
+    return out;
+}
+
+} // namespace
