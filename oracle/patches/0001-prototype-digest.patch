+/// What the standard library's shuffle makes of a run of numbers.
+///
+/// `put_into_container` shuffles the items it is about to offer a container (`src/item_group.cpp:127-129`) so that it is not always the last drawn items that are
+/// rejected, and it does so with **`std::shuffle` over the game's own engine** - not with `rng()`, so the game's dice hooks never see it. A port that wants the same
+/// permutations has to reproduce the standard library's algorithm and its distribution, and the only way to know it has is to compare permutations.
+///
+/// Each entry is one shuffle: a length, a seed, and the permutation of `0..n-1` that came out. Short runs are included because the interesting cases are the degenerate
+/// ones - a run of one is not shuffled at all, and a run of two asks the distribution exactly once.
+void dump_shuffle( const std::string &path )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+    std::fprintf( out, "{\"harness\":\"shuffle\",\"version\":1,\"cases\":[" );
+    bool first_case = true;
+    for( int length = 1; length <= 9; length++ ) {
+        for( unsigned seed : { 1u, 2u, 12345u, 99991u } ) {
+            rng_set_engine_seed( seed );
+            std::vector<int> order;
+            order.reserve( static_cast<std::size_t>( length ) );
+            for( int i = 0; i < length; i++ ) {
+                order.push_back( i );
+            }
+            std::shuffle( order.begin(), order.end(), rng_get_engine() );
+            std::fprintf( out, "%s{\"length\":%d,\"seed\":%u,\"order\":[", first_case ? "" : ",", length,
+                          seed );
+            for( std::size_t i = 0; i < order.size(); i++ ) {
+                std::fprintf( out, "%s%d", i == 0 ? "" : ",", order[i] );
+            }
+            std::fprintf( out, "]}" );
+            first_case = false;
+        }
+    }
+    std::fprintf( out, "]}\n" );
+    std::fclose( out );
+}
