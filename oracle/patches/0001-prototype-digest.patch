+/// The small rules an effect answers about itself: its average modifier, its kill chance, and the two flags that adjust them.
+///
+/// `get_avg_mod` is `get_mod` without the dice: the same "a stated maximum that is not zero" gate, the same effective intensity, but the answer is the **mean of the
+/// range** rather than a draw from it. `kill_roll` is a list of `( numerator, denominator )` pairs indexed by **intensity**, not by the list's own order, and the
+/// index is capped so an effect past its last entry uses the last entry. Both are recorded with the die the reference rolled, so the port replays the same one.
+void dump_effect_derived( const std::string &path )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+    constexpr unsigned seed = 12345;
+    std::fprintf( out, "{\"harness\":\"effect-derived\",\"version\":1,\"seed\":%u,\"types\":[\n", seed );
+    bool first_type = true;
+    int cases = 0;
+    int fired = 0;
+    for( const std::pair<const efftype_id, effect_type> &entry : get_effect_types() ) {
+        const effect_type &type = entry.second;
+        const auto &kill = ::oracle_effect_reader::kill_chance( type );
+        const auto &red_kill = ::oracle_effect_reader::red_kill_chance( type );
+        std::vector<std::string> args;
+        for( const auto &group : ::oracle_effect_reader::mod_data( type ) ) {
+            for( const auto &cell : group.second ) {
+                const uint8_t action = static_cast<uint8_t>( cell.first & 0xFFU );
+                if( action == static_cast<uint8_t>( mod_action::MIN ) ||
+                    action == static_cast<uint8_t>( mod_action::MAX ) ) {
+                    args.push_back( group.first );
+                    break;
+                }
+            }
+        }
+        std::sort( args.begin(), args.end() );
+        args.erase( std::unique( args.begin(), args.end() ), args.end() );
+        if( args.empty() && kill.empty() && red_kill.empty() ) {
+            continue;
+        }
+        std::fprintf( out, "%s{\"id\":\"%s\",\"harmful_cough\":%s,\"avg\":[", first_type ? "" : ",\n",
+                      harness_escape( entry.first.str() ).c_str(),
+                      ::oracle_effect_reader::harmful_cough( type ) ? "true" : "false" );
+        first_type = false;
+        bool first_avg = true;
+        for( const std::string &arg : args ) {
+            for( int intensity = 1; intensity <= 4; ++intensity ) {
+                effect held( effect_source::empty(), &type, 1_hours, bodypart_str_id( "torso" ), false,
+                             intensity, calendar::turn_zero );
+                for( uint8_t level = 0; level < 2; ++level ) {
+                    std::fprintf( out, "%s{\"arg\":\"%s\",\"intensity\":%d,\"level\":%u,\"average\":%d}",
+                                  first_avg ? "" : ",", harness_escape( arg ).c_str(), intensity,
+                                  static_cast<unsigned>( level ),
+                                  held.get_avg_mod( arg, level != 0 ) );
+                    first_avg = false;
+                    ++cases;
+                }
+            }
+        }
+        std::fprintf( out, "],\"kill\":[" );
+        bool first_kill = true;
+        for( int intensity = 1; intensity <= 4; ++intensity ) {
+            effect held( effect_source::empty(), &type, 1_hours, bodypart_str_id( "torso" ), false, intensity,
+                         calendar::turn_zero );
+            for( uint8_t level = 0; level < 2; ++level ) {
+                // One die, recorded, then the engine put back so the rule rolls the same one itself.
+                rng_set_engine_seed( seed + static_cast<unsigned>( cases ) );
+                const double roll = rng_float( 0.0, 1.0 );
+                rng_set_engine_seed( seed + static_cast<unsigned>( cases ) );
+                const bool answer = held.kill_roll( level != 0 );
+                if( answer ) {
+                    ++fired;
+                }
+                ++cases;
+                std::fprintf( out, "%s{\"intensity\":%d,\"level\":%u,\"roll\":%.17g,\"answer\":%s}",
+                              first_kill ? "" : ",", intensity, static_cast<unsigned>( level ), roll,
+                              answer ? "true" : "false" );
+                first_kill = false;
+            }
+        }
+        std::fprintf( out, "],\"chances\":[" );
+        for( std::size_t i = 0; i < kill.size(); ++i ) {
+            std::fprintf( out, "%s[%d,%d]", i == 0 ? "" : ",", kill[i].first, kill[i].second );
+        }
+        std::fprintf( out, "],\"red_chances\":[" );
+        for( std::size_t i = 0; i < red_kill.size(); ++i ) {
+            std::fprintf( out, "%s[%d,%d]", i == 0 ? "" : ",", red_kill[i].first, red_kill[i].second );
+        }
+        std::fprintf( out, "]}" );
+    }
+    std::fprintf( out, "\n],\"count\":%d,\"fired\":%d}\n", cases, fired );
+    std::fclose( out );
+}
