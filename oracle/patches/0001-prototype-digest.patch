+/// What a `transform` action **does** to the item that carries it: the item-level half of `do_transform`.
+///
+/// Reference: `iuse_transform::do_transform` (`src/iuse_actor.cpp:347-419`). The character half of `use` - the moves, the messages, the pyromania - belongs to P4, but
+/// everything that happens to the **item** is here, and it is not obvious: `do_transform` goes through `item::convert` (`src/item.cpp:660-693`), which keeps the mods,
+/// rebuilds the contents in the new type's pockets, resets the charges when the type's charge-per-count-ness changes, arms the countdown of a type that has an interval,
+/// and resets the item counter. Then the actor sets the countdown from `target_timer` and the active flag from the union of three conditions.
+///
+/// Each type is dumped with the charges it would carry at spawn, so a replay knows the input as well as the answer.
+void dump_transform_applies( const std::string &path )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+    std::fprintf( out, "{\"harness\":\"transform-applies\",\"version\":1,\"now\":%d,\n\"types\":[\n",
+                  to_turn<int>( calendar::turn ) );
+    bool first = true;
+    int count = 0;
+    avatar &u = get_avatar();
+    for( const itype *type : item_controller->all() ) {
+        if( type == nullptr ) {
+            continue;
+        }
+        for( const std::pair<const std::string, use_function> &method : type->use_methods ) {
+            const iuse_transform *transform =
+                dynamic_cast<const iuse_transform *>( method.second.get_actor_ptr() );
+            if( transform == nullptr ) {
+                continue;
+            }
+            ++count;
+            item it( type->get_id() );
+            // The item as it is when the action is used: spawned with its own default charges, which is the only charge count a recording can name without inventing one.
+            item &spawned = it;
+            const int charges_before = spawned.count_by_charges() ? spawned.charges : spawned.ammo_remaining();
+            const bool cbc_before = spawned.count_by_charges();
+            transform->harness_do_transform( &u, spawned );
+            std::fprintf( out,
+                          "%s{\"id\":\"%s\",\"action\":\"%s\",\"target\":\"%s\",\"result\":\"%s\","
+                          "\"ammo_qty\":%d,\"target_charges\":%d,\"target_timer_seconds\":%lld,"
+                          "\"active_before\":false,\"charges_before\":%d,\"count_before\":%d,"
+                          "\"charges_after\":%d,\"count_after\":%d,\"cbc_after\":%s,\"active_after\":%s,"
+                          "\"countdown_after\":%d,\"since_after\":%d,\"contents_after\":%zu,\"sealed_after\":%s,"
+                          "\"item_counter_after\":%d,\"phase_solid\":%s,\"phase_liquid\":%s}",
+                          first ? "" : ",\n", harness_escape( type->get_id().str() ).c_str(),
+                          harness_escape( method.first ).c_str(),
+                          harness_escape( transform->target.str() ).c_str(),
+                          harness_escape( spawned.typeId().str() ).c_str(),
+                          transform->ammo_qty, transform->ammo_qty,
+                          static_cast<long long>( to_seconds<int64_t>( transform->target_timer ) ),
+                          cbc_before ? charges_before : spawned.ammo_remaining(),
+                          static_cast<int>( cbc_before ? 1 : spawned.count() ),
+                          spawned.count_by_charges() ? spawned.charges : spawned.ammo_remaining(),
+                          static_cast<int>( spawned.count() ), spawned.count_by_charges() ? "true" : "false",
+                          spawned.active ? "true" : "false",
+                          static_cast<int>( to_turns<int>( spawned.countdown_point - calendar::turn ) ),
+                          static_cast<int>( to_turns<int>( type->countdown_interval ) ),
+                          spawned.num_item_stacks(), spawned.all_pockets_sealed() ? "true" : "false",
+                          spawned.item_counter,
+                          spawned.made_of( phase_id::SOLID ) ? "true" : "false",
+                          spawned.made_of( phase_id::LIQUID ) ? "true" : "false" );
+            first = false;
+        }
+    }
+    std::fprintf( out, "\n],\"count\":%d}\n", count );
+    std::fclose( out );
+}
