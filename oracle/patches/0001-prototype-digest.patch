+/// What an item's damage numbers are, for every type.
+///
+/// Reference: `itype::damage_max` (`src/itype.h:1572-1574`), `itype::damage_level` (`src/itype.cpp:117-126`) and the `degrade_increments` finalisation in
+/// `item_factory.cpp:4115-4126`. The last one is the interesting one: every type states a `degradation_multiplier`, but the loader **zeroes it** unless the type is a
+/// vehicle part and not charge-counted, so almost nothing in the game degrades and the increments are the rule rather than the data.
+void dump_damage( const std::string &path )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
