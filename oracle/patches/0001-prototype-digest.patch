+void dump_spells( const std::string &path )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+    std::fprintf( out, "{\"harness\":\"spells\",\"version\":1,\n\"spells\":[\n" );
+    bool first_spell = true;
+    for( const spell_type &spell : spell_type::get_all() ) {
+        if( spell.id.is_null() ) {
+            continue;
+        }
+        std::fprintf( out, "%s\n{\"id\":\"%s\",\"name\":\"%s\",\"effect_name\":\"%s\"",
+                      first_spell ? "" : ",", harness_escape( spell.id.str() ).c_str(),
+                      harness_escape( spell.name.translated() ).c_str(),
+                      harness_escape( spell.effect_name ).c_str() );
+        bool first = false;
+        std::fprintf( out, ",\"effect_str\":\"%s\"", harness_escape( spell.effect_str ).c_str() );
+        std::fprintf( out, ",\"damage_type\":\"%s\"", harness_escape( spell.dmg_type.str() ).c_str() );
+        std::fprintf( out, ",\"shape\":\"%s\"",
+                      harness_escape( io::enum_to_string( spell.spell_area ) ).c_str() );
+        dump_one_number( out, "min_damage", spell.min_damage, first );
+        // The effect's duration, which `add_effect_to_target` (`magic_spell_effect.cpp:499-520`) needs and the dump did
+        // not carry: without it a port can say a spell applies an effect but not for how long.
+        dump_one_number( out, "min_duration", spell.min_duration, first );
+        dump_one_number( out, "duration_increment", spell.duration_increment, first );
+        dump_one_number( out, "max_duration", spell.max_duration, first );
+        dump_one_number( out, "damage_increment", spell.damage_increment, first );
+        dump_one_number( out, "max_damage", spell.max_damage, first );
+        dump_one_number( out, "min_range", spell.min_range, first );
+        dump_one_number( out, "range_increment", spell.range_increment, first );
+        dump_one_number( out, "max_range", spell.max_range, first );
+        dump_one_number( out, "min_aoe", spell.min_aoe, first );
+        dump_one_number( out, "aoe_increment", spell.aoe_increment, first );
+        dump_one_number( out, "max_aoe", spell.max_aoe, first );
+        dump_one_number( out, "base_energy_cost", spell.base_energy_cost, first );
+        dump_one_number( out, "energy_increment", spell.energy_increment, first );
+        dump_one_number( out, "final_energy_cost", spell.final_energy_cost, first );
+        dump_one_number( out, "difficulty", spell.difficulty, first );
+        dump_one_number( out, "max_level", spell.max_level, first );
+        dump_one_number( out, "base_casting_time", spell.base_casting_time, first );
+        dump_one_number( out, "casting_time_increment", spell.casting_time_increment, first );
+        dump_one_number( out, "final_casting_time", spell.final_casting_time, first );
+        std::fprintf( out, ",\"energy_source\":\"%s\"",
+                      harness_escape( io::enum_to_string( spell.get_energy_source() ) ).c_str() );
+        // The spell's own flags, which five ported effects read and the dump did not carry: `SILENT` decides whether a bash is heard, `IGNORE_WALLS` whether a
+        // cone or a line stops at a wall, `RECHARM` whether a charm stacks, `UNSAFE_TELEPORT` whether a jump may kill, and `TARGET_TELEPORT` whether the caster or
+        // the aim point moves. Written as the raw names the data uses, because that is what a port has to match.
+        std::fprintf( out, ",\"flags\":[" );
+        bool first_flag = true;
+        for( const std::string &flag : spell.flags ) {
+            std::fprintf( out, "%s\"%s\"", first_flag ? "" : ",", harness_escape( flag ).c_str() );
+            first_flag = false;
+        }
+        std::fprintf( out, "]" );
+        // **Which things the spell may be aimed at**, and the species and monster filters on top (`spell::is_valid_target`, `magic.cpp:1671-1745`). The rule is
+        // `valid_targets[ t ]` for a target class, then `target_by_monster_id`, `target_by_species_id` and `ignore_by_species_id` narrowing it. Written with the names the data
+        // uses, because those are the names a port has to match; the classes are the enum's own order.
+        static const std::pair<spell_target, const char *> target_names[] = {
+            { spell_target::ally, "ally" },
+            { spell_target::hostile, "hostile" },
+            { spell_target::self, "self" },
+            { spell_target::ground, "ground" },
+            { spell_target::none, "none" },
+            { spell_target::item, "item" },
+            { spell_target::field, "field" },
+            { spell_target::vehicle, "vehicle" },
+        };
+        std::fprintf( out, ",\"valid_targets\":[" );
+        bool first_target = true;
+        for( const auto &entry : target_names ) {
+            if( spell.valid_targets[ entry.first ] ) {
+                std::fprintf( out, "%s\"%s\"", first_target ? "" : ",", entry.second );
+                first_target = false;
+            }
+        }
+        std::fprintf( out, "]" );
+        std::fprintf( out, ",\"targeted_monster_ids\":[" );
+        bool first_mon = true;
+        for( const mtype_id &id : spell.targeted_monster_ids ) {
+            std::fprintf( out, "%s\"%s\"", first_mon ? "" : ",", harness_escape( id.str() ).c_str() );
+            first_mon = false;
+        }
+        std::fprintf( out, "]" );
+        std::fprintf( out, ",\"targeted_species_ids\":[" );
+        bool first_sp = true;
+        for( const species_id &id : spell.targeted_species_ids ) {
+            std::fprintf( out, "%s\"%s\"", first_sp ? "" : ",", harness_escape( id.str() ).c_str() );
+            first_sp = false;
+        }
+        std::fprintf( out, "]" );
+        std::fprintf( out, ",\"ignored_species_ids\":[" );
+        bool first_ign = true;
+        for( const species_id &id : spell.ignored_species_ids ) {
+            std::fprintf( out, "%s\"%s\"", first_ign ? "" : ",", harness_escape( id.str() ).c_str() );
+            first_ign = false;
+        }
+        std::fprintf( out, "]" );
+        std::fprintf( out, "}" );
+        first_spell = false;
+    }
+    std::fprintf( out, "\n]}\n" );
+    std::fclose( out );
+}
+
+/// What a spell costs a caster who carries nothing and wears nothing, at five levels.
+///
+/// Reference: `spell::energy_cost` (`magic.cpp:1163-1195`) - three branches on where `base_energy_cost` sits against `final_energy_cost`, each rounding
+/// `base + increment * effective_level`, then a somatic term for hand encumbrance, then a multiplier an enchantment may set. The encumbrance is recorded
+/// per case so a port can see whether that term was live rather than guess that it was not.
+void dump_spell_costs( const std::string &path )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+    std::fprintf( out, "{\"harness\":\"spell_costs\",\"version\":1,\n\"cases\":[\n" );
+    avatar &u = get_avatar();
+    const int levels[] = { 0, 1, 2, 5, 10 };
+    bool first = true;
+    for( const spell_type &type : spell_type::get_all() ) {
+        if( type.id.is_null() ) {
+            continue;
+        }
+        for( const int level : levels ) {
+            spell sp( type.id );
+            // Reference: `spell::set_level( const Character &, int )` clamps to the spell's own ceiling, which is why it wants the caster.
+            sp.set_level( u, level );
+            const int cost = sp.energy_cost( u );
+            std::fprintf( out,
+                          "%s{\"id\":\"%s\",\"level\":%d,\"energy_cost\":%d,\"somatic_encumbrance\":%f,"
+                          "\"energy_source\":\"%s\",\"no_hands\":%s}",
+                          first ? "" : ",", harness_escape( type.id.str() ).c_str(), level, cost,
+                          static_cast<double>( u.avg_encumb_of_limb_type( body_part_type::type::hand ) ),
+                          harness_escape( io::enum_to_string( type.get_energy_source() ) ).c_str(),
+                          sp.no_hands() ? "true" : "false" );
+            first = false;
+        }
+    }
+    std::fprintf( out, "\n]}\n" );
+    std::fclose( out );
+}
+
+/// Whether a string id is a **name** rather than the debug marker an inline group is given when it loads.
+///
+/// Interned anonymous ids come back as `<marker> <number>`; a name is the data's own text. The marker is U+01F7, two bytes in UTF-8, which is why the test is on the bytes.
+static bool is_named_group( const std::string &id )
+{
+    return !id.empty() && !( id.size() > 1 && static_cast<unsigned char>( id[0] ) == 0xC7 &&
+                             static_cast<unsigned char>( id[1] ) == 0xB7 );
+}
+
+static void dump_one_weakpoint( std::FILE *out, const weakpoint &weakpoint );
+
+void dump_monsters( const std::string &path )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot open %s\n", path.c_str() );
+        return;
+    }
+    std::fprintf( out, "{\"harness\":\"monsters\",\"version\":12,\n\"prototypes\":[\n" );
+    bool first = true;
+    std::set<std::string> species_named_by_monsters;
+    for( const mtype &proto : MonsterGenerator::generator().get_all_mtypes() ) {
+        for( const species_id &entry : proto.species ) {
+            species_named_by_monsters.insert( entry.str() );
+        }
+        std::fprintf( out, "%s\n{\"id\":\"%s\",\"name\":\"%s\",\"symbol\":\"%s\",\"color\":\"%s\","
+                      "\"bodytype\":\"%s\",\"hp\":%d,\"speed\":%d,\"diff\":%d,\"melee_skill\":%d,"
+                      "\"dodge\":%d,\"morale\":%d,\"aggression\":%d,\"weight\":%lld,\"volume\":%lld,"
+                      "\"species\":[",
+                      first ? "" : ",", harness_escape( proto.id.str() ).c_str(),
+                      harness_escape( proto.nname( 1 ) ).c_str(),
+                      harness_escape( proto.sym ).c_str(),
+                      string_from_color( proto.color ).c_str(),
+                      harness_escape( proto.bodytype ).c_str(),
+                      proto.hp, proto.speed, proto.difficulty_base, proto.melee_skill,
+                      proto.sk_dodge, proto.morale, proto.agro,
+                      static_cast<long long>( units::to_gram( proto.weight ) ),
+                      static_cast<long long>( units::to_milliliter( proto.volume ) ) );
+        bool first_species = true;
+        for( const species_id &entry : proto.species ) {
+            std::fprintf( out, "%s\"%s\"", first_species ? "" : ",",
+                          harness_escape( entry.str() ).c_str() );
+            first_species = false;
+        }
+        std::fprintf( out, "],\"categories\":[" );
+        bool first_category = true;
+        for( const std::string &entry : proto.categories ) {
+            std::fprintf( out, "%s\"%s\"", first_category ? "" : ",",
+                          harness_escape( entry ).c_str() );
+            first_category = false;
+        }
+        std::fprintf( out, "],\"materials\":[" );
+        bool first_material = true;
+        for( const std::pair<const material_id, int> &entry : proto.mat ) {
+            std::fprintf( out, "%s[\"%s\",%d]", first_material ? "" : ",",
+                          harness_escape( entry.first.str() ).c_str(), entry.second );
+            first_material = false;
+        }
+        // `creature_size` has no `enum_to_string` specialisation linked into this build, so the size is named
+        // here rather than guessed at with a cast.
+        const char *size_name = "medium";
+        switch( proto.size ) {
+            case creature_size::tiny:  size_name = "tiny";  break;
+            case creature_size::small: size_name = "small"; break;
+            case creature_size::medium: size_name = "medium"; break;
+            case creature_size::large: size_name = "large"; break;
+            case creature_size::huge:  size_name = "huge";  break;
+            default: break;
+        }
+        // Version two adds what an attack needs and what armour it must get through: the melee dice and
+        // their faces, the dice's armour penetration, and the monster's own resistance to bash and cut.
+        // Version three adds the type's **flags**. They are the whole of what a monster can do that is not a number: `HEARS` is what makes it hear a thrown rock,
+        // `SEES` what makes it see, and `GOODHEARING` doubles both its earshot and how long it remembers. A dump without them gives every monster in the port a body
+        // with hit points and no senses.
+        std::fprintf( out, "],\"flags\":[" );
+        // The flag set is a bitset with no iteration of its own, so the flags the data defines are walked and each is asked of the monster: `mon_flag::get_all()` is the
+        // registry every string flag was loaded into, which is the only complete list. The set is not the list, and asking it for its members is not possible.
+        bool first_flag = true;
+        for( const mon_flag &flag : mon_flag::get_all() ) {
+            if( !proto.has_flag( flag.id ) ) {
+                continue;
+            }
+            std::fprintf( out, "%s\"%s\"", first_flag ? "" : ",",
+                          harness_escape( flag.id.str() ).c_str() );
+            first_flag = false;
+        }
+        std::fprintf( out, "],\"harvest\":\"%s\",\"dissect\":\"%s\",\"size\":\"%s\","
+                      "\"melee_dice\":%d,\"melee_sides\":%d,\"melee_dice_ap\":%d,"
+                      "\"armor_bash\":%d,\"armor_cut\":%d,\"armor_stab\":%d,\"regenerates\":%.6g,"
+                      "\"melee_bash\":%.6g,\"melee_cut\":%.6g,\"melee_stab\":%.6g,\"attack_cost\":%d,"
+                      "\"regen_morale\":%s,\"bleed_rate\":%d,"
+                      "\"death_message\":\"%s\",\"corpse_type\":\"%s\","
+                      "\"broken_itype\":\"%s\",\"death_drops\":\"%s\",\"regenerates_in_dark\":%s,"
+                      // **Version twelve adds the weak points a monster's body has** (`mtype::weakpoints`, an **inline** set rather than an id, read by `monster::deal_damage` through
+                      // `select_weakpoint`: `creature.cpp:1146`). It is written as the set itself - its entries and its default - because an inline set has no id to name.
+                      "\"weakpoints\":{",
+                      harness_escape( proto.harvest.str() ).c_str(),
+                      harness_escape( proto.dissect.str() ).c_str(),
+                      size_name,
+                      proto.melee_dice, proto.melee_sides, proto.melee_dice_ap,
+                      static_cast<int>( proto.armor.type_resist( damage_type_id( "bash" ) ) ),
+                      static_cast<int>( proto.armor.type_resist( damage_type_id( "cut" ) ) ),
+                      // Version five adds the third of the melee damage types. A blow is worth its bash, its cut **and** its stab (round 1092), so a monster's resistance to the
+                      // third is not optional: the port was setting it to zero and every monster was softer than its data says.
+                      static_cast<int>( proto.armor.type_resist( damage_type_id( "stab" ) ) ),
+                      // Version four adds the hit points a monster mends per hour on its own (`monster::regenerate`, `monster.cpp:4094-4103`). Without it a port can
+                      // only ever use the two fallbacks - the flesh rate and the reviving rate - and every monster type that states its own would mend at the wrong pace.
+                      static_cast<double>( proto.regenerates ),
+                      // Version six adds the type's **fixed** melee damage (`mtype::melee_damage`), which `monster::melee_attack` starts from before adding its dice as bash
+                      // (`monster.cpp:2149`). The port had no column for it, so a monster whose data states a flat part hit for its dice alone.
+                      static_cast<double>( proto.melee_damage.type_damage( damage_type_id( "bash" ) ) ),
+                      static_cast<double>( proto.melee_damage.type_damage( damage_type_id( "cut" ) ) ),
+                      static_cast<double>( proto.melee_damage.type_damage( damage_type_id( "stab" ) ) ),
+                      // Version seven adds what a blow costs the monster in moves (`mtype::attack_cost`, charged by `monster::melee_attack` before it even swings:
+                      // `monster.cpp:2108`). Without it a port can only assume the default and a fast attacker would be charged as if it were a slow one.
+                      proto.attack_cost,
+                      // Version eight adds the flag that decides whether a monster gets its nerve back at all (`mtype::regen_morale`, read by `monster::process_turn`:
+                      // `monster.cpp:3494`). Without it a port either regenerates nerve for every monster or for none, and the data says which.
+                      proto.regen_morale ? "true" : "false",
+                      // Version nine adds `mtype::bleed_rate`, the gate `mtype::get_bleed_type` checks before it looks at a species at all (`mtype.cpp:412-422`): a monster whose
+                      // rate is zero never bleeds its species' blood however its species is written.
+                      proto.bleed_rate,
+                      // Version ten adds the type's **death line** and what it leaves: `mdeath_effect.death_message` is the data's own sentence ("The %s dies!" is only the fallback
+                      // `mdeath::normal` prints), and `corpse_type` decides between a normal corpse, a broken one, a splatter and nothing at all (`monster.cpp:3093-3106`).
+                      harness_escape( proto.mdeath_effect.death_message.translated() ).c_str(),
+                      proto.mdeath_effect.corpse_type == mdeath_type::BROKEN ? "broken"
+                      : proto.mdeath_effect.corpse_type == mdeath_type::SPLATTER ? "splatter"
+                      : proto.mdeath_effect.corpse_type == mdeath_type::NO_CORPSE ? "none"
+                      : "normal",
+                      // Version eleven adds what the broken branch leaves, when the data names it itself (`mtype::broken_itype`, `mtype.h:367`) - the rest of the corpus leaves the
+                      // id to `mdeath::broken`'s string rule - and the **item group** a body drops when it dies (`mtype::death_drops`, `mtype.h:404`), which is where a monster's
+                      // loot actually comes from.
+                      harness_escape( proto.broken_itype.str() ).c_str(),
+                      // **Only a named group is dumped.** An inline `death_drops` is given a generated id when the data loads, and that id is a debug marker (`\u01F7 <n>`) rather
+                      // than a name - dumping it would put a number that changes between loads into the corpus and call it parity. The named groups are the ones a reader can follow.
+                      harness_escape( is_named_group( proto.death_drops.str() ) ? proto.death_drops.str() : std::string() ).c_str(),
+                      // Version twelve adds `mtype::regenerates_in_dark` (`mtype.h:541`): a type that mends by the dark instead of in it. Without it the port cannot tell a monster that
+                      // gains `50 * e^(-light^2/10000)` in the dark from one that gains nothing and simply does not mend.
+                      proto.regenerates_in_dark ? "true" : "false" );
+                  std::fprintf( out, "\"list\":[" );
+                  bool first_wp = true;
+                  for( const weakpoint &one : proto.weakpoints.weakpoint_list ) {
+                      std::fprintf( out, "%s", first_wp ? "" : "," );
+                      dump_one_weakpoint( out, one );
+                      first_wp = false;
+                  }
+                  std::fprintf( out, "],\"default\":" );
+                  dump_one_weakpoint( out, proto.weakpoints.default_weakpoint );
+                  std::fprintf( out, ",\"families\":[" );
+                  {
+                      bool first_family = true;
+                      for( const weakpoint_family &family : proto.families.families ) {
+                          const proficiency &known = family.proficiency.obj();
+                          std::fprintf( out,
+                                        "%s{\"id\":\"%s\",\"proficiency\":\"%s\",\"bonus\":%.6f,\"penalty\":%.6f}",
+                                        first_family ? "" : ",", harness_escape( family.id ).c_str(),
+                                        harness_escape( family.proficiency.str() ).c_str(),
+                                        static_cast<double>( family.bonus.value_or( known.default_weakpoint_bonus() ) ),
+                                        static_cast<double>( family.penalty.value_or( known.default_weakpoint_penalty() ) ) );
+                          first_family = false;
+                      }
+                  }
+                  // One brace closes the weakpoints object and the second closes the prototype's row.
+                  std::fprintf( out, "]}}" );
+        first = false;
+    }
+    // The **species table**, because `get_bleed_type` reads `species.bleeds` and the monster only names its species. The species the monsters name are the ones that matter, so they are
+    // gathered while walking the types and each is asked for its own `bleeds` field - the generator has no public iterator over the species factory.
+    std::fprintf( out, "],\n\"species\":[" );
+    bool first_kind = true;
+    for( const std::string &name : species_named_by_monsters ) {
+        const std::string bleeds = species_id( name ).obj().bleeds.str();
+        std::fprintf( out, "%s{\"id\":\"%s\",\"bleeds\":\"%s\"}", first_kind ? "" : ",",
+                      harness_escape( name ).c_str(), harness_escape( bleeds ).c_str() );
+        first_kind = false;
+    }
+    std::fprintf( out, "]}\n" );
+    std::fclose( out );
+}
+
+/// Every zone type, as the game holds it.
+///
+/// Reference: `zone_type` (`src/clzones.h:40-72`) with its loader (`src/clzones.cpp:157-166`), which is registered under the JSON type `LOOT_ZONE` and reads `name`, `id`,
+/// `display_field` mandatorily and `description`, `can_be_personal` and `hidden` optionally. The port needs all six, because a zone the map cannot draw, or one that a
+/// character may own, is a different zone - and `id` is an enum the reference interns, so the order the factory returns is an implementation detail the gate must not pin.
+void dump_zone_types( const std::string &path )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+    std::fprintf( out, "{\"harness\":\"zone_types\",\"version\":1,\"zones\":[\n" );
+    bool first = true;
+    for( const zone_type &zone : zone_type::get_all() ) {
+        std::fprintf( out,
+                      "%s{\"id\":\"%s\",\"name\":\"%s\",\"desc\":\"%s\",\"display_field\":\"%s\","
+                      "\"can_be_personal\":%s,\"hidden\":%s}",
+                      first ? "" : ",\n",
+                      harness::harness_escape( zone.id.str() ).c_str(),
+                      harness::harness_escape( zone.name() ).c_str(),
+                      harness::harness_escape( zone.desc() ).c_str(),
+                      harness::harness_escape( zone.get_field().str() ).c_str(),
+                      zone.can_be_personal ? "true" : "false",
+                      zone.hidden ? "true" : "false" );
+        first = false;
+    }
+    std::fprintf( out, "\n]}\n" );
+    std::fclose( out );
+}
