+/// Applies effects to an avatar over and over, and records what the intensity and the duration become.
+///
+/// `Creature::add_effect` (`src/creature.cpp:1731-1856`) has two halves, and both are arithmetic a player feels: an effect the creature **does not** have is created
+/// with the intensity asked for, and one it **does** have has its duration grown by a percentage of the new duration and its intensity stepped by the type's own step
+/// size. The ceilings come from the type. Everything is integer turns, so the percentage is where truncation lives.
+///
+/// The effect types are **synthesised** through the real loader (`load_effect_type`) rather than picked from the data, so a profile can say exactly what it needs
+/// — and the loader gets exercised at the same time.
+void dump_effect_merge( const std::string &path )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+    avatar &u = get_avatar();
+    const bodypart_str_id torso( "torso" );
+
+    struct profile {
+        int max_intensity;
+        const char *max_duration;
+        int dur_add_perc;
+        int int_add_val;
+        const char *int_dur_factor;
+        bool int_decay_remove;
+    };
+    // Six shapes: the plain one, a capped one, the step-sized one, the duration-sized one, and the ones that can and cannot reach zero.
+    static const std::array<profile, 6> profiles = { {
+            { 1, "1 hours", 100, 0, "0 turns", false },
+            { 3, "1 hours", 100, 1, "0 turns", false },
+            { 10, "6 hours", 50, 2, "0 turns", false },
+            { 5, "6 hours", 200, 0, "0 turns", true },
+            { 30, "6 hours", 100, 0, "10 minutes", false },
+            { 2, "30 minutes", 0, 0, "0 turns", true },
+        }
+    };
+    // Three applications per profile, mixing the ways a caller adds an effect: with an intensity, without one, and with a long one.
+    struct application {
+        int minutes;
+        int intensity;
+    };
+    static const std::array<std::array<application, 3>, 5> sequences = { {
+            { { { 5, 0 }, { 5, 0 }, { 5, 0 } } },
+            { { { 5, 1 }, { 5, 0 }, { 5, 2 } } },
+            { { { 60, 0 }, { 60, 0 }, { 60, 0 } } },
+            { { { 20, 5 }, { 120, 0 }, { 1, 3 } } },
+            // Durations that are **not** a whole number of the ten-minute factor: the difference between a ceil of a ratio and a ceil of an integer.
+            { { { 7, 0 }, { 13, 0 }, { 1, 1 } } },
+        }
+    };
+
+    // The profiles are written out first: the recording has to say what the runs were run against, or the replay is guesswork.
+    std::fprintf( out, "{\"harness\":\"effect-merge\",\"version\":1,\"profiles\":[\n" );
+    for( std::size_t p = 0; p < profiles.size(); ++p ) {
+        const profile &prof = profiles[p];
+        std::fprintf( out,
+                      "%s{\"max_intensity\":%d,\"max_duration\":\"%s\",\"dur_add_perc\":%d,\"int_add_val\":%d,"
+                      "\"int_dur_factor\":\"%s\",\"int_decay_remove\":%s}",
+                      p == 0 ? "" : ",\n", prof.max_intensity, prof.max_duration, prof.dur_add_perc,
+                      prof.int_add_val, prof.int_dur_factor, prof.int_decay_remove ? "true" : "false" );
+    }
+    std::fprintf( out, "],\"runs\":[\n" );
+    bool first_run = true;
+    int runs = 0;
+    for( std::size_t p = 0; p < profiles.size(); ++p ) {
+        const profile &prof = profiles[p];
+        const std::string id = string_format( "harness_merge_%d", static_cast<int>( p ) );
+        const std::string json = string_format(
+                                     "{\"id\":\"%s\",\"max_intensity\":%d,\"max_duration\":\"%s\",\"dur_add_perc\":%d,"
+                                     "\"int_add_val\":%d,\"int_dur_factor\":\"%s\",\"int_decay_remove\":%s}",
+                                     id.c_str(), prof.max_intensity, prof.max_duration, prof.dur_add_perc,
+                                     prof.int_add_val, prof.int_dur_factor, prof.int_decay_remove ? "true" : "false" );
+        JsonValue parsed = json_loader::from_string( json );
+        JsonObject object = parsed.get_object();
+        load_effect_type( object, "harness" );
+        const efftype_id effect_id( id );
+        if( !effect_id.is_valid() ) {
+            std::fprintf( stderr, "harness: the synthesised effect %s did not load\n", id.c_str() );
+            std::fclose( out );
+            return;
+        }
+
+        for( std::size_t s = 0; s < sequences.size(); ++s ) {
+            u.remove_effect( effect_id );
+            ++runs;
+            std::fprintf( out, "%s{\"profile\":%d,\"sequence\":%d,\"steps\":[",
+                          first_run ? "" : ",\n", static_cast<int>( p ), static_cast<int>( s ) );
+            first_run = false;
+            const auto &sequence = sequences[s];
+            for( std::size_t step = 0; step < sequence.size(); ++step ) {
+                const application &app = sequence[step];
+                u.add_effect( effect_source::empty(), effect_id, time_duration::from_minutes( app.minutes ),
+                              torso, false, app.intensity );
+                const effect &applied = u.get_effect( effect_id, torso );
+                std::fprintf( out,
+                              "%s{\"minutes\":%d,\"intensity\":%d,\"after_intensity\":%d,\"after_turns\":%lld}",
+                              step == 0 ? "" : ",", app.minutes, app.intensity,
+                              u.get_effect_int( effect_id, torso ),
+                              static_cast<long long>( to_turns<int64_t>( u.get_effect_dur( effect_id, torso ) ) ) );
+                ( void )applied;
+            }
+            std::fprintf( out, "]}" );
+        }
+    }
+    std::fprintf( out, "\n],\"count\":%d}\n", runs );
+    std::fclose( out );
+}
