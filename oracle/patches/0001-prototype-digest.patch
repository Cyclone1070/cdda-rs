+/// Whether a line of fire is clear, on a map small enough to say what the answer should be.
+///
+/// `map::clear_path` (`src/map.cpp:7723-7800`) is the rule a ranged attack asks before it is allowed: it walks the line, skips the **last** square - "it's still reachable
+/// even if it is an obstacle" - and refuses when the range is short, the target is out of bounds, or the levels are more than `fov_3d_z_range` apart. The last-square rule
+/// is the one that surprises people, so the fixture puts a target **on** the wall: the answer is yes.
+///
+/// The map is a 31-square square of `t_floor` at z=0 with one wall column at `origin.x + 5`, every square of the column from `origin.y - 4` to `origin.y + 4`, and a
+/// second level above it: floor over most of it, open air over the column at `origin.x + 8`, so a climb can be clear or not depending on where it goes.
+void dump_clear_path( const std::string &path )
+{
+    map &here = get_map();
+    const tripoint_bub_ms origin = get_avatar().pos_bub();
+    for( int dx = -15; dx <= 15; dx++ ) {
+        for( int dy = -15; dy <= 15; dy++ ) {
+            const tripoint_bub_ms at = origin + tripoint_rel_ms( dx, dy, 0 );
+            here.ter_set( at, ter_str_id( "t_floor" ) );
+            here.furn_set( at, furn_str_id::NULL_ID() );
+            here.i_clear( at );
+            here.field_at( at ).clear();
+            // The level above: floor everywhere, open air over one column.
+            const tripoint_bub_ms above = at + tripoint_rel_ms( 0, 0, 1 );
+            here.ter_set( above, ter_str_id( dx == 8 ? "t_open_air" : "t_floor" ) );
+            here.furn_set( above, furn_str_id::NULL_ID() );
+            here.i_clear( above );
+            here.field_at( above ).clear();
+        }
+    }
+    // The wall: one column, five squares tall, thick enough that a diagonal has to go round it.
+    for( int dy = -4; dy <= 4; dy++ ) {
+        here.ter_set( origin + tripoint_rel_ms( 5, dy, 0 ), ter_str_id( "t_concrete_wall" ) );
+    }
+
+    // A cost window that admits a floor (2) and refuses a wall (0).
+    constexpr int cost_min = 2;
+    constexpr int cost_max = 2;
+    struct case_t {
+        int fx, fy, fz, tx, ty, tz, range;
+        const char *shape;
+    };
+    const std::vector<case_t> cases = {
+        // Straight at the wall, and stopping before it.
+        { 0, 0, 0, 10, 0, 0, -1, "through-the-wall" },
+        { 0, 0, 0, 4, 0, 0, -1, "before-the-wall" },
+        // The target is **on** the wall: the last square is not checked, so this is clear.
+        { 0, 0, 0, 5, 0, 0, -1, "target-on-the-wall" },
+        // The same wall, walked diagonally round its end.
+        { 0, 0, 0, 10, 10, 0, -1, "diagonal-round-the-wall" },
+        { 0, 6, 0, 10, 6, 0, -1, "past-the-wall-s-end" },
+        // Range and bounds.
+        { 0, 0, 0, 10, 0, 0, 3, "range-too-short" },
+        { 0, 0, 0, 10, 0, 0, 10, "range-exactly-enough" },
+        // Up a level, over floor, and over the open-air column.
+        { 0, 0, 0, 3, 0, 1, -1, "climb-over-floor" },
+        { 0, 8, 0, 8, 0, 0, -1, "climb-over-open-air" },
+        { 0, 0, 0, 0, 0, 11, -1, "too-far-in-z" },
+    };
+
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+    // Two cost windows. The tight one is a single value, and the reference's climbing branch compares with **strict** inequalities
+    // (`cost > cost_min && cost < cost_max`), so a window of one value can never be clear when the line climbs - while the flat branch, which compares inclusively,
+    // is happy with it. That asymmetry is why both windows are here.
+    struct window_t {
+        int cost_min;
+        int cost_max;
+    };
+    const std::vector<window_t> windows = { { cost_min, cost_max }, { 1, 3 } };
+    std::fprintf( out, "{\"harness\":\"clear-path\",\"version\":1,\"cases\":[" );
+    bool first_case = true;
+    for( const window_t &w : windows ) {
+        for( const case_t &c : cases ) {
+            const tripoint_bub_ms from = origin + tripoint_rel_ms( c.fx, c.fy, c.fz );
+            const tripoint_bub_ms to = origin + tripoint_rel_ms( c.tx, c.ty, c.tz );
+            const bool clear = here.clear_path( from, to, c.range, w.cost_min, w.cost_max );
+            std::fprintf( out,
+                          "%s{\"shape\":\"%s\",\"from\":[%d,%d,%d],\"to\":[%d,%d,%d],\"range\":%d,"
+                          "\"cost_min\":%d,\"cost_max\":%d,\"clear\":%s}",
+                          first_case ? "" : ",", c.shape, c.fx, c.fy, c.fz, c.tx, c.ty, c.tz, c.range,
+                          w.cost_min, w.cost_max, clear ? "true" : "false" );
+            first_case = false;
+        }
+    }
+    std::fprintf( out, "]}\n" );
+    std::fclose( out );
+}
