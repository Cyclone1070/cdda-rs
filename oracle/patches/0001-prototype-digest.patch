+void dump_map_at( const std::string &path, const tripoint_abs_omt &omt )
+{
+    std::FILE *out = std::fopen( path.c_str(), "wb" );
+    if( out == nullptr ) {
+        std::fprintf( stderr, "harness: cannot write %s\n", path.c_str() );
+        return;
+    }
+    // Exactly this chunk, loaded into a scratch map. `place_player_overmap` is not used: it lands the player on a
+    // *nearby suitable square*, which is fine for playing and useless for checking a named chunk.
+    map scratch;
+    const tripoint_abs_sm corner = project_to<coords::sm>( omt );
+    scratch.load( corner, false );
+    const oter_id &oter = overmap_buffer.ter( omt );
+    std::fprintf( out, "{\"harness\":\"map\",\"version\":1,\"oter\":\"%s\",\"omt\":[%d,%d,%d],\"size\":%d,\"rows\":[\n",
+                  harness::harness_escape( oter.id().str() ).c_str(), omt.x(), omt.y(), omt.z(),
+                  SEEX * 2 );
+    for( int y = 0; y < SEEY * 2; y++ ) {
+        std::fprintf( out, "%s[", y == 0 ? "" : ",\n" );
+        for( int x = 0; x < SEEX * 2; x++ ) {
+            const ter_id &ter = scratch.ter( tripoint_bub_ms( x, y, 0 ) );
+            std::fprintf( out, "%s\"%s\"", x == 0 ? "" : ",", harness::harness_escape( ter.id().str() ).c_str() );
+        }
+        std::fprintf( out, "]" );
+    }
+    std::fprintf( out, "\n]}\n" );
+    std::fclose( out );
+}
